{
  "name": "defranceschi-archive",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "npm run check:pin && npm run check:records && npm run publish:index && astro build && npm run autolink && npm run check:names-index && npm run sitemap && npm run check:book && npm run check:living && npm run check:living-v2 && npm run check:prose && npm run check:kin && npm run check:templates && npm run check:kit && npm run check:worklist && npm run check:covers && npm run check:evidence && npm run check:names && npm run check:places && npm run check:pages && npm run check:sources && npm run check:inline && npm run check:rows && npm run check:nav && npm run check:lines && npm run check:alsoin && npm run check:links && npm run check:rec && npm run check:standard && npm run check:era-ground && npm run check:era && npm run check:era:selftest",
    "preview": "astro preview --port 4321",
    "sitemap": "python3 node_modules/@daviddef/archive-kit/kit/tools/sitemap.py",
    "publish:index": "node -e \"const f=require('fs');f.copyFileSync('src/data/searchindex.json','public/searchindex.json');const a=JSON.parse(f.readFileSync('src/data/atlas.json','utf8'));const m=JSON.parse(f.readFileSync('src/data/movements.json','utf8'));const g=JSON.parse(f.readFileSync('src/data/mymap.json','utf8'));const areas=[];g.layers.forEach(L=>L.areas.forEach(x=>areas.push({n:x.n||L.name,layer:L.name,ring:x.ring})));f.writeFileSync('public/atlas-data.json',JSON.stringify({places:a.places,stats:a.stats,moves:m.moves,spine:m.spine,areas:areas,mnote:m.note,mcaution:m.caution}));\"",
    "check:book": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkbook.py --dist dist --book src/data/book.json",
    "check:kit": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkarchive.py --dist dist",
    "check:living": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkliving.py --dist dist --data src/data --policy named-bare --years --strict-allow --config standard.json",
    "check:living-v2": "python3 ../scripts/check-living-v2.py --dist dist && python3 ../scripts/test-living-v2.py",
    "check:worklist": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkworklist.py --root .",
    "check:covers": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkcovers.py --root .",
    "check:evidence": "python3 ../scripts/check-evidence.py --dist dist",
    "check:names": "python3 ../scripts/name-forms-audit.py --check",
    "check:places": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkplaces.py --data public/atlas-data.json",
    "check:templates": "python3 node_modules/@daviddef/archive-kit/kit/tools/checktemplates.py --root .",
    "check:pages": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkpages.py --root . --estate ../.. --max-bespoke 0",
    "autolink": "python3 ../scripts/build-names-index.py && python3 node_modules/@daviddef/archive-kit/kit/tools/autolink.py --dist dist --index ../private/autolink/names-index.json --living ../private/autolink/living.json --allow-prefix /person/ --allow-prefix /who/ --allow-prefix /search/",
    "check:names-index": "python3 ../scripts/check-names-index.py --dist dist && python3 ../scripts/check-names-index.py --self-test",
    "check:links": "python3 node_modules/@daviddef/archive-kit/kit/tools/checklinks.py --dist dist --index ../private/autolink/names-index.json --living ../private/autolink/living.json --allow-prefix /person/ --allow-prefix /who/ --allow-prefix /search/ --floor .linkfloor.json",
    "check:records": "python3 ../scripts/build-records.py --check && python3 ../scripts/build-read-names.py --check",
    "check:rec": "python3 ../scripts/check-rec.py --dist dist && python3 ../scripts/check-rec.py --self-test",
    "check:standard": "python3 ../scripts/standard-run.py",
    "check:era-ground": "python3 ../scripts/build-era.py --check",
    "check:era": "python3 ../scripts/build-era.py --living-urls ../private/era-living.json && python3 node_modules/@daviddef/archive-kit/kit/tools/checkera.py --dist dist --snapshot src/data/era-snapshot.json --living-urls ../private/era-living.json --require-tracked",
    "check:era:selftest": "python3 node_modules/@daviddef/archive-kit/kit/tools/era_selftest.py",
    "check:standard-selftest": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkstandard_selftest.py",
    "check:pin": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkpin.py --root .",
    "check:lines": "python3 ../scripts/build-rivers-members.py --check && python3 ../scripts/build-lines-living.py && python3 node_modules/@daviddef/archive-kit/kit/tools/checklines.py --lines src/data/rivers.json --dist ${ARCHIVE_OUT:-dist} --config standard.json --living ../private/lines-living.json && python3 node_modules/@daviddef/archive-kit/kit/tools/checklines.py --selftest",
    "check:nav": "python3 node_modules/@daviddef/archive-kit/kit/tools/checknav.py --dist dist --strict",
    "check:inline": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkinline.py --root . --max-inline 2",
    "check:rows": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkrows.py --root .",
    "check:sources": "python3 node_modules/@daviddef/archive-kit/kit/tools/checksources.py --root . --dist dist",
    "check:alsoin": "python3 ../scripts/check_also_in.py && python3 ../scripts/check_also_in.py --self-test",
    "check:prose": "python3 ../scripts/check-prose.py",
    "check:prose-strict": "python3 ../scripts/check-prose.py --require-tree",
    "check:kin": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkkin.py --data src/data/roster.json --born b --died d --max 0"
  },
  "dependencies": {
    "@daviddef/archive-kit": "github:daviddef/TheArchiveKit#d88b11e914e433d9d2c6bd750b8d8e707d1a0b65",
    "astro": "^5.18.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.2",
    "typescript": "^5.9.3"
  }
}
