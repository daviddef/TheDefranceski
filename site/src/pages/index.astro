---
import { u } from "../lib/url.js";
import Rule from "../components/Rule.astro";
import Base from "../layouts/Base.astro";
import WaysIn from "@daviddef/archive-kit/components/WaysIn.astro";
import Numbers from "@daviddef/archive-kit/components/Numbers.astro";
import PlaceSpark from "@daviddef/archive-kit/components/PlaceSpark.astro";
import MarriageChart from "@daviddef/archive-kit/components/MarriageChart.astro";
import { chartGroups } from "../lib/marriedin.js";
import placesRaw from "../data/places.json";
/* This archive stores a place as coords:[lat,lon] and a `lane` for its region;
   PlaceSpark wants lat, lon and cat. Mapped here rather than in the component,
   because the shape of an archive\u2019s own data is the archive\u2019s business. */
const sparkPlaces = (Array.isArray(placesRaw) ? placesRaw : placesRaw.rows || [])
  .filter((x) => Array.isArray(x.coords) && x.coords.length === 2)
  .map((x) => ({ name: x.name, lat: x.coords[0], lon: x.coords[1], cat: x.lane, n: x.n || 0 }));
import SovereigntyTimeline from "@daviddef/archive-kit/components/SovereigntyTimeline.astro";
import sov from "../data/sovereignty.json";
import BranchRivers from "@daviddef/archive-kit/components/BranchRivers.astro";
import Spine from "@daviddef/archive-kit/components/Spine.astro";
import dline from "../data/directline.json";
import rivers from "../data/rivers.json";
import Chip from "../components/Chip.astro";
import lines from "../data/lines.json";
import dossiers from "../data/dossiers.json";
import reg from "../data/register.json";
import searched from "../data/searched.json";
import corrections from "../data/corrections.json";
import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";
const BANNER = "/art/banner.webp";
const hasBanner = fs.existsSync(path.join(path.dirname(fileURLToPath(import.meta.url)), "..", "..", "public", BANNER));

/* Every number links to the page that earns it. */
/* Six tiles, and every one of them a measure of the work rather than a date out
   of the story. The three years that used to sit here — 1679, 1711, 1787 — are
   the best facts on the page and they belong in the hero and the cards, where
   they have room to say what they mean. A tile that reads "1711" tells a reader
   nothing about how far this archive has got.

   Counted at build time, so they stay true as the work grows instead of being
   re-typed and quietly going stale. */
const nothing = searched.rows.filter((r) => ["nothing", "miss"].includes(r.outcome)).length;
const stats = [
  [Object.keys(dossiers.people).length.toLocaleString(), "people published, each carrying what is known of them and how well", "/people/"],
  ["18,840", "records read to build the census of where the name actually was", "/istria-sweep/"],
  [reg.stat.entries.toLocaleString(), "register entries transcribed and set out one by one", "/register/"],
  [searched.rows.length, `searches written down, ${nothing} of which found nothing — a negative result is still a finding`, "/searched/"],
  [corrections.rows.length, "claims this archive has corrected or withdrawn, kept visible", "/corrections/"],
  ["~10", "of the name left in Croatia today, against 25 families in Istria in 1945", "/diaspora/"],
];

const finds = [
  ["Sept 2026", "Svetvinčenat, from 1666", "A rebuilt sweep of 18,840 records found a third Carnian household of the name, in Venetian Istria — two children to the font in one autumn, sixty-eight years before the household book anyone had looked at.", "/istria-sweep/"],
  ["Sept 2026", "What they actually were at Gologorica", "Not tenants. They held the lease on the bishop of Pedena's «affitto fermo» and collected it, renewed by every bishop, until the see was suppressed in 1788.", "/carlos-letter/"],
  ["Sept 2026", "The day they sailed", "Anton's index card reads «Emigré Australie le 8.3.49», stamped CM/1 destroyed. That is the morning Zdravko, Ruža and the child left Germany for good.", "/pfullingen/"],
];

/* 22 September 2026. The homepage drew the RIVERS — five families arriving in
   Istria from five directions — and never drew this archive's own LINE. They
   answer different questions and a front page wants both: where the name came
   from, and how far back this particular descent runs.

   Compact Spine, mirroring the field mapping direct-line.astro already uses.
   It links each row to that page's generation anchor rather than to a
   dossier: the full spine links dossiers and can, because it has one per
   generation, but a compact ladder is the wrong place to assert identity and
   five of the estate's seven spines carry a repeating forename. */
const spineRows = dline.generations.map((g) => ({
  gen: g.n,
  name: g.name,
  born: g.bornExact || (g.born != null ? String(g.born) : ""),
  died: g.diedExact || (g.died != null ? String(g.died) : ""),
  bornPlace: g.place || "",
  living: g.confidence === "living",
  weak: g.confidence === "family",
  weakNote: "Carried on the family's own descent chart; no register page names this generation yet.",
}));
---
<Base title="The Defranceschi Archive" eyebrow="Istria · Kvarner · Carnia · and the diaspora"
      dek="Not one family — a surname, and every line that carries it. Written down under eight sovereigns, in four languages, and spelled at least nine different ways. This is the evidence, and what is still missing."
      bare={true}>

<section class="hero">
  <img src={u(hasBanner ? BANNER : "/art/gologorica-house-1711.webp")}
       alt="The house at Gologorica, built in 1711, with the builder's tablet over its door."
       loading="eager" decoding="async" />
  <div class="cap">
    <div class="kick">A family history, kept honestly</div>
    <h1>Six generations back, a stonemason on an Istrian hill.</h1>
    <p class="sub">Istria · Kvarner · Carnia · and the diaspora — a family written down under eight sovereigns, in four languages, and spelled at least nine ways.</p>
  </div>
</section>

<section class="opener">
  <p class="lede">
    This archive was built by <b>David Defranceski</b>, born in Johannesburg, living in Brisbane —
    and it runs backwards from him: to <b>Senj</b>, where his grandfather Ivan is buried; to
    <b>Crikvenica</b>, where the household came ashore; to <b>Gračišće</b> in Istria, where in 1863 a
    stonecutter's son called Josephus was baptised; and to the mountains of <b>Carnia</b>, where the
    family says it began and where the documents run out.
  </p>
  <p class="lede" style="margin-top:14px">
    It is a public archive with one rule: <b>a living person is named and nothing more</b> — no
    dates, no places, no photographs. It used to say they were left out altogether, which stopped
    being true the day the blood-relatives chart drew the living generation in Brisbane. And a
    second rule, which is harder: <b>every claim says how well it is known</b>.
    <span class="chip doc" style="padding:2px 8px;font-size:10px">Documented</span>
    <span class="chip inf" style="padding:2px 8px;font-size:10px">Inferred</span>
    <span class="chip lore" style="padding:2px 8px;font-size:10px">Family lore</span>
  </p>

  <WaysIn doors={[
    { href: u("/story/"), name: "Read the main story", blurb: "Nine chapters, 1679 to Brisbane — the line this archive descends from, told once, in order, with the document behind every claim. The other three families have pages of their own.", cta: "Start at Mione →" },
    { href: u("/tree/"), name: "Look up a person", blurb: "The family tree, openable generation by generation — or search 594 people, places, records and plates at once.", cta: "Open the tree →" },
    { href: u("/map/"), name: "See where it happened", blurb: "Every place the archive can put a document in, on one map — from the Gorto valley to the Wimmera.", cta: "Open the atlas →" },
  ]} />
</section>

<section class="feat" style="margin-top:38px">
  <div class="kicker" style="color:var(--accent)">Six families, one surname</div>
  <h2 style="margin-top:6px">Where each of them came from, and where each of them went</h2>
  <p class="dek" style="margin-top:10px">They are not one family and they never were. They arrive from different directions for different reasons — one for work, one as soldiers paid off in ruined land, one as refugees off a wrecked fleet. And the fifth, drawn dashed at the bottom, never came to Istria at all: a fully documented family of the same name that runs from a poor cape in Corsica to the Caribbean, put beside the others so it can be told apart from them.</p>
  <div style="margin-top:24px"><BranchRivers rivers={rivers} /></div>
  <p class="cap" style="margin-top:14px"><a href={u("/lines/")}>The four families, the households still unplaced, and which diaspora belongs to whom →</a></p>
</section>
<Rule name="arrows" />

<section class="feat">
  <div class="kicker" style="color:var(--terra)">Eight hundred years, four countries, six families</div>
  <h2 style="margin-top:6px">What they were living under, and what they were up against</h2>
  <p class="dek" style="margin-top:10px">The ancestral places do not share a past. Gologorica was Habsburg from 1374 and Italian between the wars; Senj was never Italian at all; Mione was Venetian for three hundred and seventy-seven years. <strong>Red above the lanes is the people of the name. Ochre below is the wars, plagues, treaties and regime changes they were lived through.</strong> Hover or tab any marker and it tells you what it is.</p>
  <div style="margin-top:26px"><SovereigntyTimeline sov={sov} events={true} /></div>
  <p class="cap" style="margin-top:16px"><a href={u("/timeline/")}>The full timeline, with lives and pressures →</a></p>
</section>
<Rule name="helm" />


<section class="blk">
  <h2>Recently found</h2>
  <p class="dek">What the last stretch of work turned up. The research log has the rest.</p>
  <div class="finds">
    {finds.map(([w, h, t, href]) => (
      <a class="find" href={u(href)}>
        <div class="fw">{w}</div>
        <div class="fh">{h}</div>
        <div class="ft">{t}</div>
      </a>
    ))}
  </div>
  <p class="cap"><a href={u("/research-log/")}>The research log →</a></p>
</section>
<Rule name="pomegranate" />

<section class="blk">
  <h2>There is no single Defranceschi family</h2>
  <div class="prose" style="margin-top:14px">
    <p><em>De Franceschi</em> means only ‘of the Franceschi’ — the household of a man called Francesco. The name was therefore invented independently, many times over, wherever an Italian-speaking clerk needed to tell one Francesco's sons from another's. <strong>Six families are followed here and five of them have an origin in documents.</strong> The newest, <strong>Vodnjan</strong>, was a number in a 1945 cadastre until its marriage register — indexed nowhere on earth — was read by eye in September 2026 and gave up five generations. Beside them sit four clusters of real households that must belong to one of the others and cannot yet be told which — and a great many people who simply share the commonest patronymic in Italy.</p>
    <p>That is this archive's organising idea rather than its disappointment. And it means being strict about three different things: <strong>a family is an origin</strong>; <strong>a station — Gologorica, Crikvenica, Senj, Pfullingen — is a stop on one family's road</strong>, not a family of its own; and <strong>a namesake in Corsica or Brazil is not a relative</strong> until a document says so.</p>
    <p><a href={u("/lines/")}>The five families, and everything that is not one →</a></p>
  </div>
</section>
<Rule name="helm" />


  
<section class="blk">
  <section class="feat">
    <h2 style="margin-top:6px">Where this family can actually be put</h2>
    <p class="dek" style="margin-top:10px">Istria, the Kvarner, Carnia, and the places the name went
    afterwards. <strong>Every dot is a place this archive can put a named person in.</strong> The
    coast and the borders under them are real — Natural Earth, clipped to this frame — which for
    this archive matters more than most: the whole argument here is which empire held which town,
    and the borders are drawn.</p>
    <PlaceSpark places={sparkPlaces} href={u("/map/")}
                label={`${sparkPlaces.length} places across Istria, the Kvarner and Carnia`} />
  </section>
</section>


<section class="blk">
  <section class="blk">
    <h2>The line itself, eight generations</h2>
    <p class="dek">The rivers above are five families arriving in Istria. This is the one this
    archive descends from — Gologorica to Gračišće and out — with the generation the family chart
    asserts and no register names marked where it falls.</p>
    <Spine rows={spineRows} u={u} compact={true} full="/direct-line/" />
    <p class="cap" style="margin-top:14px"><a href={u("/direct-line/")}>The full spine, with the
    register page under each generation →</a></p>
  </section>

  <h2>The families who married in</h2>
  <p class="dek">Seventy-four surnames married into this one, each routed to the empire that held its town.
  <a href={u("/marriages/")}>The marriages, in full →</a></p>
  <MarriageChart groups={chartGroups} subject="Defranceschi" unit="indexed marriages" />
</section>

<section class="blk">
    <h2>What this archive has established</h2>
    <div class="grid two" style="margin-top:1rem">
      <div class="card">
        <h3>There is no single Defranceschi family</h3>
        <p>Six families carry the name and this archive follows all six. They are not one family,
        and the weight of the surname in a parish is <strong>not evidence of kinship</strong> with
        any of them. <a href={u("/lines/")}>All six, compared →</a></p>
      </div>
      <div class="card">
        <h3>Eight sovereigns, four languages, nine spellings</h3>
        <p>The same people were written down under Venice, Austria, France, Austria again, Italy,
        Yugoslavia and Croatia. Most of what looks like a different family is a different clerk.
        <a href={u("/name/")}>The name →</a></p>
      </div>
      <div class="card">
        <h3>Gračišće, 1863</h3>
        <p>A stonecutter's son called <strong>Josephus</strong> baptised on an Istrian hill — the
        oldest link in this descent that rests on a register rather than on a tree.
        <a href={u("/direct-line/")}>The line, act by act →</a></p>
      </div>
      <div class="card">
        <h3>Every number here is a link</h3>
        <p>160 places, 956 people placed and 408 register volumes are reachable from the map, and
        each figure on this page opens the page that earns it. <a href={u("/map/")}>The atlas →</a></p>
      </div>
    </div>
  </section>

<Rule name="arrows" />
<Numbers rows={stats.map(([n, l, h]) => [n, l, u(h)])} />

  <section class="blk" style="border-bottom:0">
    <h2>What is still missing</h2>
    <p class="dek"><strong>36 questions this archive cannot answer</strong> — thirty open, six
    blocked. When Agostino De Franceschi of Gorto lived; whether anything is carved on the 1711
    house; whether the Valentino and Giovanni Battista lines are one family; and whether the
    Dalmatian Franceschi are related to this one at all. The two hundred kilometres between Mione in
    1679 and Gologorica in 1711 remain the one thing this archive cannot prove. All of it, with the
    searches that have already failed, is at <a href={u("/open-questions/")}>Open questions</a> and
    <a href={u("/searched/")}>Searched</a>.</p>
    <p class="small" style="margin-top:1rem">Nothing here is taken on trust because it appears in a
    family tree. Where a record has been seen, it is cited; where it has not, the claim is marked.
    See <a href={u("/method/")}>Method</a>.</p>
  </section>
</Base>
