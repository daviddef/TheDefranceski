---
import { u } from "../lib/url.js";
import Rule from "../components/Rule.astro";
import Base from "../layouts/Base.astro";
import SovereigntyTimeline from "../components/SovereigntyTimeline.astro";
import BranchRivers from "../components/BranchRivers.astro";
import Chip from "../components/Chip.astro";
import lines from "../data/lines.json";
import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";
const BANNER = "/art/banner.webp";
const hasBanner = fs.existsSync(path.join(path.dirname(fileURLToPath(import.meta.url)), "..", "..", "public", BANNER));

/* Every number links to the page that earns it. */
const stats = [
  ["1679", "a De Franceschi of Mione, weaving in the County of Pazin", "/carnia/"],
  ["1711", "the year cut on the house Carlo's great-great-grandfather built", "/gologorica-line/"],
  ["1787", "the farmer of house 5, Gallignana — the line's earliest dated ancestor", "/direct-line/"],
  ["18,840", "records read to build the census of where the name actually was", "/istria-sweep/"],
  ["25", "Defranceschi families left in Istria on 1 October 1945", "/name/"],
  ["~10", "left in Croatia today", "/diaspora/"],
];

const finds = [
  ["Sept 2026", "Svetvinčenat, from 1666", "A rebuilt sweep of 18,840 records found a third Carnian household of the name, in Venetian Istria — two children to the font in one autumn, sixty-eight years before the household book anyone had looked at.", "/istria-sweep/"],
  ["Sept 2026", "What they actually were at Gologorica", "Not tenants. They held the lease on the bishop of Pedena's «affitto fermo» and collected it, renewed by every bishop, until the see was suppressed in 1788.", "/carlos-letter/"],
  ["Sept 2026", "The day they sailed", "Anton's index card reads «Emigré Australie le 8.3.49», stamped CM/1 destroyed. That is the morning Zdravko, Ruža and the child left Germany for good.", "/pfullingen/"],
];
---
<Base title="The Defranceschi Archive" eyebrow="Istria · Kvarner · Carnia · and the diaspora"
      dek="A family written down under eight sovereigns, in four languages, and spelled at least nine different ways. This is the evidence, and what is still missing."
      bare={true}>

<section class="hero">
  <img src={u(hasBanner ? BANNER : "/art/gologorica-house-1711.webp")}
       alt="The house at Gologorica, built in 1711, with the builder's tablet over its door."
       loading="eager" decoding="async" />
  <div class="cap">
    <div class="kick">A family history, kept honestly</div>
    <h1>Six generations back, a stonemason on an Istrian hill.</h1>
    <p class="sub">Istria · Kvarner · Carnia · and the diaspora — a family written down under eight sovereigns, in four languages, and spelled at least nine ways.</p>
  </div>
</section>

<section class="opener">
  <p class="lede">
    This archive was built by <b>David Defranceski</b>, born in Johannesburg, living in Brisbane —
    and it runs backwards from him: to <b>Senj</b>, where his grandfather Ivan is buried; to
    <b>Crikvenica</b>, where the household came ashore; to <b>Gračišće</b> in Istria, where in 1863 a
    stonecutter's son called Josephus was baptised; and to the mountains of <b>Carnia</b>, where the
    family says it began and where the documents run out.
  </p>
  <p class="lede" style="margin-top:14px">
    It is a public archive with one rule: <b>the living are left out</b> — omitted, not hidden. And a
    second rule, which is harder: every claim says how well it is known.
    <span class="chip doc" style="padding:2px 8px;font-size:10px">Documented</span>
    <span class="chip inf" style="padding:2px 8px;font-size:10px">Inferred</span>
    <span class="chip lore" style="padding:2px 8px;font-size:10px">Family lore</span>
  </p>

  <div class="doors">
    <a class="door" href={u("/story/")}>
      <div class="dn">Read the main story</div>
      <div class="dd">Nine chapters, 1679 to Brisbane — the line this archive descends from, told once, in order, with the document behind every claim. The other three families have pages of their own.</div>
      <div class="go">Start at Mione →</div>
    </a>
    <a class="door" href={u("/tree/")}>
      <div class="dn">Look up a person</div>
      <div class="dd">The family tree, openable generation by generation — or search 594 people, places, records and plates at once.</div>
      <div class="go">Open the tree →</div>
    </a>
    <a class="door" href={u("/atlas/")}>
      <div class="dn">See where it happened</div>
      <div class="dd">Every place the archive can put a document in, on one map — from the Gorto valley to the Wimmera.</div>
      <div class="go">Open the atlas →</div>
    </a>
  </div>
</section>

<section class="feat" style="margin-top:38px">
  <div class="kicker" style="color:var(--accent)">Five families, one surname</div>
  <h2 style="margin-top:6px">Where each of them came from, and where each of them went</h2>
  <p class="dek" style="margin-top:10px">They are not one family and they never were. They arrive from different directions for different reasons — one for work, one as soldiers paid off in ruined land, one as refugees off a wrecked fleet. And the fifth, drawn dashed at the bottom, never came to Istria at all: a fully documented family of the same name that runs from a poor cape in Corsica to the Caribbean, put beside the others so it can be told apart from them.</p>
  <div style="margin-top:24px"><BranchRivers /></div>
  <p class="cap" style="margin-top:14px"><a href={u("/lines/")}>The four families, the households still unplaced, and which diaspora belongs to whom →</a></p>
</section>
<Rule name="arrows" />

<section class="feat">
  <div class="kicker" style="color:var(--terra)">Eight hundred years, four countries, one family</div>
  <h2 style="margin-top:6px">What they were living under, and what they were up against</h2>
  <p class="dek" style="margin-top:10px">The ancestral places do not share a past. Gologorica was Habsburg from 1374 and Italian between the wars; Senj was never Italian at all; Mione was Venetian for three hundred and seventy-seven years. <strong>Red above the lanes is this family. Ochre below is the wars, plagues, treaties and regime changes they were lived through.</strong> Hover or tab any marker and it tells you what it is.</p>
  <div style="margin-top:26px"><SovereigntyTimeline events={true} /></div>
  <p class="cap" style="margin-top:16px"><a href={u("/timeline/")}>The full timeline, with lives and pressures →</a></p>
</section>
<Rule name="helm" />

<section class="blk">
  <h2>The archive in numbers</h2>
  <p class="dek">Every one of these is a link to the page that earns it.</p>
  <div class="statgrid">
    {stats.map(([n, l, href]) => (
      <a class="stat" href={u(href)}>
        <div class="n">{n}</div>
        <div class="l">{l}</div>
        <div class="go">See the evidence →</div>
      </a>
    ))}
  </div>
</section>
<Rule name="arrows" />

<section class="blk">
  <h2>Recently found</h2>
  <p class="dek">What the last stretch of work turned up. The research log has the rest.</p>
  <div class="finds">
    {finds.map(([w, h, t, href]) => (
      <a class="find" href={u(href)}>
        <div class="fw">{w}</div>
        <div class="fh">{h}</div>
        <div class="ft">{t}</div>
      </a>
    ))}
  </div>
  <p class="cap"><a href={u("/research-log/")}>The research log →</a></p>
</section>
<Rule name="pomegranate" />

<section class="blk">
  <h2>There is no single Defranceschi family</h2>
  <div class="prose" style="margin-top:14px">
    <p><em>De Franceschi</em> means only ‘of the Franceschi’ — the household of a man called Francesco. The name was therefore invented independently, many times over, wherever an Italian-speaking clerk needed to tell one Francesco's sons from another's. <strong>Five families are followed here and four of them have an origin in documents.</strong> Beside them sit five clusters of real households that must belong to one of the four and cannot yet be told which — and a great many people who simply share the commonest patronymic in Italy.</p>
    <p>That is this archive's organising idea rather than its disappointment. And it means being strict about three different things: <strong>a family is an origin</strong>; <strong>a station — Gologorica, Crikvenica, Senj, Pfullingen — is a stop on one family's road</strong>, not a family of its own; and <strong>a namesake in Corsica or Brazil is not a relative</strong> until a document says so.</p>
    <p><a href={u("/lines/")}>The five families, and everything that is not one →</a></p>
  </div>
</section>
<Rule name="helm" />

</Base>
