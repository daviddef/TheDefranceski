---
import { u } from "../lib/url.js";
import Base from "../layouts/Base.astro";
import SovereigntyTimeline from "../components/SovereigntyTimeline.astro";
import Chip from "../components/Chip.astro";
import lines from "../data/lines.json";

/* Every number links to the page that earns it. */
const stats = [
  ["1679", "a De Franceschi of Mione, weaving in the County of Pazin", "/carnia/"],
  ["1615", "the earliest the name is indexed anywhere in Istria — at Labin", "/istria-sweep/"],
  ["1711", "the year cut on the house Carlo's great-great-grandfather built", "/carlos-letter/"],
  ["1787", "the farmer of house 5, Gallignana — the line's earliest dated ancestor", "/direct-line/"],
  ["zavičaj", "the word in the 1890 register that ties the coast to Istria", "/direct-line/"],
  ["1364", "the date on a bell in the family's own parish tower", "/carlos-letter/"],
  ["25", "Defranceschi families in Istria on 1 October 1945", "/name/"],
  ["~10", "left in Croatia today", "/diaspora/"],
  ["66", "indexed entries at Rijeka — the heaviest cluster in Istria", "/istria-sweep/"],
  ["99", "burials recovered from the registers of the dead", "/burials/"],
  ["96", "graves found worldwide — exactly one of them in Croatia", "/graves/"],
  ["11", "children of Josip's brother, scattered across five countries", "/the-eleven/"],
  ["28", "colonist households on the Seget estate, named in 1764", "/carlos-book/"],
  ["148.901", "and 148.902 — two brothers' refugee numbers, one apart", "/pfullingen/"],
  ["77", "plates of the family's own paper, published here", "/gallery/"],
  ["594", "entries in one searchable index", "/search/"],
];

const finds = [
  ["Sept 2026", "The day they sailed", "Anton's index card reads «Emigré Australie le 8.3.49», and is stamped CM/1 destroyed. That is the morning Zdravko, Ruža and the child left Germany for good.", "/pfullingen/"],
  ["Sept 2026", "A governor we do not have", "The family's online tree descends this house from a Venetian governor of Imotski. It is a mis-splice, and the tree records its own doubt in the names.", "/imotski/"],
  ["Sept 2026", "What they did at Gologorica", "Not landowners, not peasants. They farmed the bishop of Pedena's rent — wine, wheat, oats, lambs, hens and eggs — on a lease renewed at every episcopal succession.", "/carlos-letter/"],
  ["Sept 2026", "Svetvinčenat, 1674", "A sweep of sixty Istrian parishes found a De Franceschi household nobody here had looked for — older than the Mione list, older than the arrival Carlo claims.", "/istria-sweep/"],
  ["Sept 2026", "Ivan, aged two", "The file marked as a birth is a death. He was buried on 28 March 1896, and his sister Zorica was conceived the month he died.", "/crikvenica-house/"],
  ["Sept 2026", "The other half", "Behind the Senj marriage stands a line of packhorse carriers and tobacco-factory workers, and a Karlobag ancestry reaching people born about 1690.", "/senj-line/"],
];
---
<Base title="The Defranceschi Archive" eyebrow="Istria · Kvarner · Carnia · and the diaspora"
      dek="A family written down under eight sovereigns, in four languages, and spelled at least nine different ways. This is the evidence, and what is still missing."
      bare={true}>

<section class="opener">
  <div class="kicker">A family history, kept honestly</div>
  <h1>Six generations back, a stonemason on an Istrian hill.</h1>
  <p class="lede">
    This archive was built for <b>David Defranceski</b>, born in Johannesburg, living in Brisbane —
    and it runs backwards from him: to <b>Senj</b>, where his grandfather Ivan is buried; to
    <b>Crikvenica</b>, where the household came ashore; to <b>Gračišće</b> in Istria, where in 1863 a
    stonecutter's son called Josephus was baptised; and to the mountains of <b>Carnia</b>, where the
    family says it began and where the documents run out.
  </p>
  <p class="lede" style="margin-top:14px">
    It is a public archive with one rule: <b>the living are left out</b> — omitted, not hidden. And a
    second rule, which is harder: every claim says how well it is known.
    <span class="chip doc" style="padding:2px 8px;font-size:10px">Documented</span>
    <span class="chip inf" style="padding:2px 8px;font-size:10px">Inferred</span>
    <span class="chip lore" style="padding:2px 8px;font-size:10px">Family lore</span>
  </p>

  <div class="doors">
    <a class="door" href={u("/story/")}>
      <div class="dn">Read the story</div>
      <div class="dd">Nine chapters, 1679 to Brisbane. The whole descent told once, in order, with the document behind every claim.</div>
      <div class="go">Start at Mione →</div>
    </a>
    <a class="door" href={u("/tree/")}>
      <div class="dn">Look up a person</div>
      <div class="dd">The family tree, openable generation by generation — or search 594 people, places, records and plates at once.</div>
      <div class="go">Open the tree →</div>
    </a>
    <a class="door" href={u("/atlas/")}>
      <div class="dn">See where it happened</div>
      <div class="dd">Every place the archive can put a document in, on one map — from the Gorto valley to the Wimmera.</div>
      <div class="go">Open the atlas →</div>
    </a>
  </div>
</section>

<section class="blk">
  <h2>The archive in numbers</h2>
  <p class="dek">Every one of these is a link to the page that earns it.</p>
  <div class="statgrid">
    {stats.map(([n, l, href]) => (
      <a class="stat" href={u(href)}>
        <div class="n">{n}</div>
        <div class="l">{l}</div>
        <div class="go">See the evidence →</div>
      </a>
    ))}
  </div>
</section>

<section class="blk">
  <h2>Recently found</h2>
  <p class="dek">What the last stretch of work turned up. The research log has the rest.</p>
  <div class="finds">
    {finds.map(([w, h, t, href]) => (
      <a class="find" href={u(href)}>
        <div class="fw">{w}</div>
        <div class="fh">{h}</div>
        <div class="ft">{t}</div>
      </a>
    ))}
  </div>
  <p class="cap"><a href={u("/research-log/")}>The research log →</a></p>
</section>

<section class="blk">
  <h2>There is no single Defranceschi family</h2>
  <div class="prose" style="margin-top:14px">
    <p><em>De Franceschi</em> means only ‘of the Franceschi’ — the family of a man called Francesco. The name was therefore invented independently, many times over, wherever an Italian-speaking clerk needed to tell one Francesco's sons from another's.</p>
    <p>That is this archive's organising idea rather than its disappointment. The work is to establish which lines are actually connected, to say plainly where the evidence stops, and to keep the good stories without letting them pretend to be facts.</p>
  </div>
  <div class="grid g2" style="margin-top:24px">
    {lines.map(l => (
      <a class="cardlink" href={u("/lines/")}>
        <div class="nm">{l.name}</div>
        <div style="margin-top:9px"><Chip c={l.status} /></div>
        <div class="alt" style="margin-top:10px">{l.route}</div>
        <div class="txt">{l.note}</div>
      </a>
    ))}
  </div>
</section>

<section class="blk">
  <h2>Three places, three histories</h2>
  <p class="dek">The ancestral places do not share a past. Gologorica was Habsburg from 1374 and Italian between the wars; Senj was never Italian at all; Mione was Venetian for 377 years. Every date in this archive has to be read against this chart.</p>
  <div style="margin-top:26px"><SovereigntyTimeline events={true} /></div>
  <p class="cap"><a href={u("/timeline/")}>The full timeline, with lives and pressures →</a></p>
</section>
</Base>
