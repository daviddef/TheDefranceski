---
/* The blood relatives of one person, drawn, with every line carrying the
   evidence that produced it. Derived from the dossiers — see lib/bloodline.js
   for why there is no data file of its own. */
import Base from "../layouts/Base.astro";
import Bloodline from "@daviddef/archive-kit/components/Bloodline.astro";
import Sources from "../components/Sources.astro";
import Rule from "../components/Rule.astro";
import ex from "../data/explorer.json";
import dossiers from "../data/dossiers.json";
import { u } from "../lib/url.js";
import { graph, components } from "../lib/bloodline.js";
import "@daviddef/archive-kit/styles/bloodline.css";

/* The renderer comes from the kit, inlined, rather than from this archive's own
   public/ folder. It used to live here because this is where the chart was
   invented — and that is exactly how it went stale: the other six archives took
   the shared component, the shared one was rewritten when a 217-person family
   broke the layout, and this page alone kept drawing the old way. Reading it
   out of node_modules means there is one renderer again and no version to
   hash, because the script is part of the page. */


const people = graph();
const comps = components(people);
const linked = Object.fromEntries(
  Object.entries(people).filter(([, p]) =>
    p.parents.length || p.children.length || p.siblings.length));

/* Open on someone who has all three lanes filled — parents above, brothers
   and sisters beside, children below. Raw connectedness picks a person with
   twenty children and no known parents, which draws a chart that teaches the
   reader nothing about what the page is for. */
const shape = (s) => {
  const p = linked[s];
  if (!p) return -1;
  const up = p.parents.length, side = p.siblings.length, down = p.children.filter((c) => c.slug).length;
  return (up ? 1000 : 0) + (down ? 1000 : 0) + (side ? 500 : 0) + up + side + down;
};
const start = [...comps[0]].sort((a, b) => shape(b) - shape(a))[0];

const edges = Object.values(linked).reduce(
  (n, p) => n + p.parents.length + p.children.length + p.siblings.length, 0);
const viaCount = {};
for (const p of Object.values(linked))
  for (const k of [...p.parents, ...p.children, ...p.siblings])
    viaCount[k.via] = (viaCount[k.via] || 0) + 1;

const big = comps.filter((c) => c.length >= 3);
const S = linked[start];

/* ---- the households section: this was /explorer/ ---- */
/* A household is a set of baptisms naming the same two parents. The blood graph
   is a set of people with edges between them. Nothing joined the two, so opening
   a household was the end of the road for forty-three of the fifty-two — and the
   obvious join, the father's name, is the one this archive refuses to make. The
   key it was already carrying is a forename: "giovanni antonio", "francesco",
   "bartolo". Matching on that is how one Pietro once ended up with five mothers.

   What DOES join them is an identifier. A child recorded here carries the
   FamilySearch id of the record they came from, and so does the dossier of the
   person that record is about. Where one id belongs to exactly one dossier, the
   two are the same person and the link is a fact rather than a guess.

   Where an id appears on more than one dossier — 42 of them do — nothing is
   drawn. That is the same rule the chart above uses for ambiguous candidates,
   and it is the rule that makes the rest of the links worth anything. */
const FSID = /"([A-Z0-9]{4}-[A-Z0-9]{4})"/g;
const byId = new Map();
for (const [slug, person] of Object.entries(dossiers.people)) {
  const blob = JSON.stringify(person);
  for (const m of blob.matchAll(FSID)) {
    const set = byId.get(m[1]) || new Set();
    set.add(slug);
    byId.set(m[1], set);
  }
}
/* the chart only opens on somebody who has an edge — the same filter the
   bloodline page applies before drawing. Linking to anyone else would look
   like a link and do nothing. */
const drawn = new Set(Object.entries(graph())
  .filter(([, q]) => q.parents.length || q.children.length || q.siblings.length)
  .map(([slug]) => slug));
const slugOf = (id) => {
  const set = id && byId.get(id);
  if (!set || set.size !== 1) return null;          // ambiguous, or unknown
  const slug = [...set][0];
  return drawn.has(slug) ? slug : null;             // only where the chart can open
};

const nodes = ex.nodes.map((n) => ({
  ...n,
  children: n.children.map((c) => {
    const slug = slugOf(c.id);
    return slug ? { ...c, href: u("/bloodline/?p=" + slug) } : c;
  }),
}));
const joined = nodes.reduce((t, n) => t + n.children.filter((c) => c.href).length, 0);
const openable = nodes.filter((n) => n.children.some((c) => c.href)).length;
const floating = ex.nodes.filter((n) => !n.up.length && !n.down.length);
const rescued = floating.filter((n) =>
  n.children.some((c) => slugOf(c.id))).length;
const years = nodes.map(n => n.from).filter(Boolean);
const minY = Math.min(...years), maxY = Math.max(...years);
const regions = [...new Set(nodes.map(n => n.region).filter(Boolean))].sort();
const exLinked = nodes.filter(n => n.up.length || n.down.length).length;
const kids = nodes.reduce((s, n) => s + n.children.length, 0);
---
<Base
  title="Blood relatives"
  eyebrow={`${Object.keys(linked).length} people joined by ${edges / 2 | 0} links · largest family ${comps[0].length}`}
  dek="Choose a person and they go to the middle of the chart: parents above, brothers and sisters beside them, children below. Every line is drawn in the colour of the evidence that made it, and a line is always drawn at the weaker grade of the two records behind it.">

  <section class="prose">
    <p>The eight generations of the archive's own direct line are here, from Giovanni at Gologorica
    in 1750 to the living generation in Brisbane — start at <a href={u("/bloodline/?p=line-8")}>the
    most recent</a> and walk up. The living are carried by name, relationship and town and nothing else, no dates, which is
    the rule everywhere on this site: the person most likely to want to see their own line is alive,
    and leaving them off the drawing entirely would have been a strange way to honour that.</p>
    <p>This archive has always said, in words, how well each claim is known. This page is the first
    that says it in a picture. Choosing a person draws <b>everyone the archive can join to them by
    blood</b> — parents and children, brothers and sisters, and through them aunts, uncles, cousins
    and their children, as far as the records reach. Hover any box and it says how they are related.
    A solid line means a register was read and it names the relationship.
    A lighter line means an index says so. A dashed line means the family tree asserts it and nothing
    has been read that confirms it — and those are the ones worth your suspicion, because they are
    the ones that have been wrong before.</p>
    <p><strong>{Object.keys(linked).length} of the {Object.keys(people).length} people this archive
    can name</strong> are joined to at least one other by a link it can show you. They fall into
    {big.length} families of three or more; the largest holds <strong>{comps[0].length}</strong>.
    The rest stand alone — not because they are unrelated, but because the register that would join
    them has not been read.</p>
  </section>

  <div class="bl-ctl">
    <label for="who">Choose a person</label>
    <input id="who" type="search" placeholder="A name, or just a surname — Franceschi, Pietro, Bonetta…" autocomplete="off" />
    <p id="bl-none" class="cap" hidden>Nobody of that name is drawn here — and if you were looking
      for someone alive, they are here — carried by <b>name and nothing else</b>, no dates and no
      detail, which is the rule across all seven archives. <a href={u("/about/")}>How that works →</a><br />
      If it was somebody long dead, it may be the spelling. These registers say
      <b>Defranceschi</b> and <b>De Franceschi</b> far more often than Defranceski —
      <b>Franceschi</b> finds every one of them.</p>
  </div>

  <Bloodline people={people} start={start} total={Object.keys(linked).length} />


  <Rule name="arrows" label="The households" />
  {/* 12 November 2026 (the page merges, PR B): /explorer/ ("Household Explorer") is this section now; /explorer/ redirects to /bloodline/#households.
      The old page's title, eyebrow and dek are the heading, label and lead below; the rest is the old page in its own order. */}
  <section class="blk" id="households">
    <h2 style="font-size:30px;margin:6px 0 4px">Household Explorer</h2>
    <p class="lab">{nodes.length} households · {kids} children · {minY}–{maxY}</p>
    <p class="dek">Every parent pair this archive has reconstructed from the registers, with the children recorded under them. Search a name, drag the year, pick a region — then open a household and walk to the ones it connects to.</p>
  </section>


  <section class="prose">
    <p>A household here is not a guess about a family. It is a set of baptisms that name the same two parents, gathered under those parents and sorted by date. That is the smallest honest unit the registers will give you: a father, a mother, and the children a priest wrote down between two dates in one parish.</p>
    <p>Some of these households can be linked to another — a son in one becomes the father in the next, at the right remove, in the right parish. <strong>{exLinked} of {nodes.length}</strong> sit in a chain; the rest float. Households that float are not failures. They are the shape of what survives when a parish's register begins in 1750 and the family arrived in 1700.</p>
  </section>

  <div class="controls" style="margin-top:26px">
    <div class="ctl">
      <label for="q">Search names and places</label>
      <input type="search" id="q" placeholder="Valentino, Rijeka, Elena…" autocomplete="off" />
    </div>
    <div class="ctl">
      <label for="reg">Region</label>
      <select id="reg">
        <option value="">All regions</option>
        {regions.map(r => <option value={r}>{r}</option>)}
      </select>
    </div>
    <div class="ctl">
      <label for="yr">Households beginning after</label>
      <input type="range" id="yr" min={minY} max={maxY} value={minY} step="5" />
    </div>
    <div class="ctl">
      <label for="lk">Show</label>
      <select id="lk">
        <option value="">All households</option>
        <option value="1">Only those in a chain</option>
      </select>
    </div>
    <div class="yearout" id="yout"></div>
  </div>

  <div class="exp">
    <div>
      <div class="hcards" id="cards" data-nodes={JSON.stringify(nodes)}>
        {nodes.map(n => (
          <button class={`hc ${n.region}${n.up.length || n.down.length ? " linked" : ""}`}
                  type="button" data-id={n.id} aria-current="false">
            <span class="f">{n.father}</span>
            <span class="m">{n.mother}</span>
            <span class="w"><span>{n.place}</span><span>{n.from}–{n.to}</span><span>{n.n} ch.</span></span>
          </button>
        ))}
      </div>
      <p class="empty" id="none" hidden>Nothing matches. Clear the search, or drag the year back.</p>
    </div>

    <aside class="detail" id="detail" aria-live="polite">
      <div class="lab">Open a household</div>
      <p class="sub">Pick any card. You will get the parents as the register spells them, the children in birth order, and any household this one links up or down to. <b>A child whose name is a link</b> has been identified to a person this archive holds a dossier for — open it and you get everyone they can be joined to by blood.</p>
    </aside>
  </div>

  <section class="prose" style="margin-top:44px">
    <h3>How the links were made</h3>
    <p><b>Two households are joined by the chart above. A child is joined to the rest of the archive
    by an identifier.</b> {joined} of the {kids} children here carry the FamilySearch id of the record
    they came from, and so does the dossier of the person that record is about — where one id belongs
    to exactly one dossier, they are the same person and the name becomes a link into the blood
    relatives chart. That covers {openable} of the {nodes.length} households, and gives {rescued} of
    the households that stand in no chain at all a way through to the rest of the archive.</p>

    <p><b>Where an id belongs to more than one dossier, nothing is drawn.</b> Forty-two do. The
    tempting join here was the father's name — and the key this data already carries is a forename,
    «giovanni antonio», «francesco», «bartolo». Matching on that would connect almost every household
    to almost every other, and it is precisely how one Pietro in this archive once acquired five
    mothers. An identifier is a fact about a record; a forename is a coincidence waiting to happen.</p>

    <p>A link is drawn only when a child in one household carries the surname, appears as the parent heading another household in the same region, the parishes are compatible, and the gap between the two households falls between 17 and 48 years. Where more than one candidate fits, the link is not drawn at all — those cases are listed as ambiguous rather than resolved by preference. Confidence is <em>strong</em> when the candidate is unique, the parish is the same, and the gap sits between 20 and 45.</p>
    <h3>What the colours mean</h3>
    <p>The stripe down the left of each card is the region: Kvarner, Istria, Dalmatia, Tyrol. The word <em>linked</em> appears on any household that stands in a chain.</p>
  </section>

  {/* the links drawn above come out of the register readings and the indexes
      behind them, which is exactly what these three are */}
  <Sources ids={["familysearch", "matricula", "dapa"]} />



</Base>

<script>
  const cards = document.getElementById("cards");
  if (cards) {
    const nodes = JSON.parse(cards.getAttribute("data-nodes"));
    const by = Object.fromEntries(nodes.map(n => [n.id, n]));
    const btns = [...cards.querySelectorAll(".hc")];
    const detail = document.getElementById("detail");
    const none = document.getElementById("none");
    const q = document.getElementById("q");
    const reg = document.getElementById("reg");
    const yr = document.getElementById("yr");
    const lk = document.getElementById("lk");
    const yout = document.getElementById("yout");

    const esc = (s) => String(s ?? "").replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));

    const hay = (n) =>
      (n.father + " " + n.mother + " " + n.place + " " +
       n.children.map(c => c.name).join(" ")).toLowerCase();

    const filter = () => {
      const t = q.value.trim().toLowerCase();
      const r = reg.value, y = +yr.value, only = lk.value;
      let shown = 0;
      btns.forEach((b, i) => {
        const n = nodes[i];
        const on =
          (!t || hay(n).includes(t)) &&
          (!r || n.region === r) &&
          (!n.from || n.from >= y) &&
          (!only || n.up.length || n.down.length);
        b.hidden = !on;
        if (on) shown++;
      });
      none.hidden = shown > 0;
      yout.textContent = `${shown} shown · from ${y}`;
    };

    const open = (id) => {
      const n = by[id];
      if (!n) return;
      btns.forEach(b => b.setAttribute("aria-current", String(b.dataset.id === id)));
      /* a child whose record carries an identifier this archive also holds a
         dossier for opens their blood relatives; the rest are plain text */
      const kid = (c) => c.href
        ? `<a class="kid named${c.ours ? " line" : ""}" href="${c.href}"
             title="Everyone this archive can join them to by blood">${esc(c.name)}${c.y ? `<i>${c.y}</i>` : ""}</a>`
        : `<span class="kid${c.ours ? " line" : ""}">${esc(c.name)}${c.y ? `<i>${c.y}</i>` : ""}</span>`;
      const rel = (l, dir) => {
        const o = by[l.id];
        return `<button class="linkbtn" data-go="${l.id}">
          <b>${dir} · ${esc(o.father)}</b>
          ${esc(o.place)} ${o.from}–${o.to} · through ${esc(l.via)} · ${l.gap} years · ${l.conf}
        </button>`;
      };
      detail.innerHTML = `
        <div class="lab">${esc(n.place)} · ${esc(n.region || "region unknown")}</div>
        <h3>${esc(n.father)}</h3>
        <p class="sub">and ${esc(n.mother)}</p>
        <div class="stats">
          <span>${n.from}–${n.to}</span><span>${n.n} children</span>
          <span>${n.line === "female" ? "surname through the mother" : "surname through the father"}</span>
        </div>
        <div class="hl lab" style="margin-top:6px">Children, in the order baptised</div>
        <div class="kids">${n.children.map(kid).join("")}</div>
        ${n.up.length ? `<div class="hl lab" style="margin-top:14px">Descends from</div>
          <div class="linkrow">${n.up.map(l => rel(l, "Parent household")).join("")}</div>` : ""}
        ${n.down.length ? `<div class="hl lab" style="margin-top:14px">Leads to</div>
          <div class="linkrow">${n.down.map(l => rel(l, "Child household")).join("")}</div>` : ""}
        ${!n.up.length && !n.down.length
          ? `<p class="sub" style="margin-top:14px;color:var(--ink-3)">This household stands alone. No household in the data can be joined to it at a defensible remove.</p>`
          : ""}
      `;
      detail.querySelectorAll("[data-go]").forEach(b =>
        b.addEventListener("click", () => {
          const t = b.dataset.go;
          const card = btns.find(x => x.dataset.id === t);
          if (card) { card.hidden = false; card.scrollIntoView({ block: "nearest" }); }
          open(t);
        }));
    };

    cards.addEventListener("click", e => {
      const b = e.target.closest(".hc");
      if (b) open(b.dataset.id);
    });
    [q, reg, lk].forEach(el => el.addEventListener("input", filter));
    yr.addEventListener("input", filter);
    filter();
    open(nodes.find(n => n.down.length)?.id || nodes[0].id);
  }
</script>
