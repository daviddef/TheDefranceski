---
import Base from "../../layouts/Base.astro";
import Rule from "../../components/Rule.astro";
import { u } from "../../lib/url.js";
import mi from "../../data/marriedin.json";
const md = (x) => String(x ?? "")
  .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
  .replace(/«(.+?)»/g, "<em>«$1»</em>")
  .replace(/(^|[^*])\*([^*\n]+?)\*/g, "$1<em>$2</em>");
const byRoute = {};
for (const r of mi.rows) (byRoute[r.route] = byRoute[r.route] || []).push(r);
const ORD = ["hungarian-littoral", "istria-austrian", "dalmatia", "carnia", "venice"];
---
<Base title={mi.heading}
  eyebrow={`${mi.rows.length} surnames · ${mi.rows.reduce((a,b)=>a+b.c,0)} indexed marriages`}
  dek="Seventy-one families married into this one. This page routes each of them to the empire that held its town — because that, and not the surname, decides which archive still has them.">

  <section class="prose"><p set:html={md(mi.lead)} /><p set:html={md(mi.why)} /></section>

  <Rule name="arrows" label="Five jurisdictions, five sets of records" />

  {ORD.filter(k => mi.routes[k]).map(k => {
    const R = mi.routes[k], fams = (byRoute[k] || []).sort((a,b) => b.c - a.c);
    return (
      <section class={"rt" + (R.proved ? " proved" : "")}>
        <div class="rt-h">
          <h2 class="rt-n">{R.label}</h2>
          {R.proved && <span class="rt-b">already paid off</span>}
        </div>
        <div class="rt-p">{R.places}</div>
        <dl class="rt-d">
          <dt>Who held it</dt><dd set:html={md(R.held)}></dd>
          <dt>The registers</dt><dd set:html={md(R.registers)}></dd>
          <dt>Beyond the registers</dt><dd set:html={md(R.beyond)}></dd>
          <dt>Where this archive stands</dt><dd set:html={md(R.gap)}></dd>
        </dl>
        <div class="rt-f">
          {fams.map(f => f.detail
            ? <a class={"fam on" + (f.ours ? " ours" : "")} href={u(`/married-in/${f.slug}/`)}>
                <span class="fam-n">{f.name}</span><span class="fam-c">{f.notindexed ? "—" : f.c}</span>
              </a>
            : <span class="fam"><span class="fam-n">{f.name}</span><span class="fam-c">{f.c}</span></span>)}
        </div>
      </section>
    );
  })}

  <p class="prose note" style="margin-top:26px" set:html={md(mi.close)}></p>

  <p class="cap" style="margin-top:22px">Counts are of indexed marriages, from FamilySearch's Croatia Church Books. The grouping by origin is the archive's existing reading from surname morphology and the Carnian emigration literature — <strong>a reading, not a finding</strong> — and the routing here inherits that uncertainty. Families with a page of their own are linked; the rest carry their count and nothing more, because that is all this archive knows about them. Names in <span class="ink">this colour</span> married into our own direct line.</p>

</Base>

<style>
.rt{border:1px solid var(--rule);border-left:3px solid var(--rule-strong);border-radius:2px;
  padding:16px 20px 18px;margin-bottom:18px}
.rt.proved{border-left-color:var(--accent)}
.rt-h{display:flex;flex-wrap:wrap;align-items:baseline;gap:12px}
.rt-n{margin:0;font-family:var(--serif);font-weight:400;font-size:23px;color:var(--ink)}
.rt-b{font-family:var(--sans);font-size:9.5px;font-weight:600;letter-spacing:.12em;
  text-transform:uppercase;color:var(--accent);border:1px solid var(--accent);
  background:var(--accent-wash);border-radius:2px;padding:2px 8px}
.rt-p{font-family:var(--mono);font-size:11.5px;line-height:1.6;color:var(--ink-3);margin-top:7px}
.rt-d{display:grid;grid-template-columns:auto 1fr;gap:6px 18px;margin:14px 0 0}
.rt-d dt{font-family:var(--sans);font-size:9.5px;font-weight:600;letter-spacing:.12em;
  text-transform:uppercase;color:var(--ink-3);padding-top:3px;white-space:nowrap}
.rt-d dd{margin:0;font-family:var(--sans);font-size:13.5px;line-height:1.62;color:var(--ink-2);max-width:78ch}
.rt-f{display:flex;flex-wrap:wrap;gap:7px;margin-top:16px;padding-top:14px;border-top:1px solid var(--rule)}
.fam{display:inline-flex;align-items:baseline;gap:7px;border:1px solid var(--rule);
  border-radius:2px;padding:3px 9px;font-family:var(--sans);font-size:12.5px;color:var(--ink-3);
  text-decoration:none}
.fam-c{font-family:var(--mono);font-size:10.5px;opacity:.8}
.fam.on{color:var(--ink);border-color:var(--rule-strong)}
.fam.on:hover{border-color:var(--accent);color:var(--accent)}
.fam.ours{border-color:var(--accent);color:var(--accent);background:var(--accent-wash)}
.ink{color:var(--accent)}
@media (max-width:560px){ .rt-d{grid-template-columns:1fr;gap:2px 0} .rt-d dt{padding-top:9px} }
</style>
