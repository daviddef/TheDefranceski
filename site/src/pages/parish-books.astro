---
import AtlasNote from "../components/AtlasNote.astro";
import Base from "../layouts/Base.astro";
import Rule from "../components/Rule.astro";
import Sources from "../components/Sources.astro";
import { md as _mdx, mdp as _mdp, mdHtml } from "../lib/md.js";
import { u } from "../lib/url.js";
import kv from "../data/kvarner-books.json";
import pb from "../data/parishbooks.json";
import hda from "../data/hda1448.json";
import dal from "../data/dalmatia-books.json";
import car from "../data/carnia-books.json";
import ap from "../data/atlas-places.json";
const RING = ["Pazin","Stari Pazin","Tinjan","Kringa","Krbune","Boljun","Lupoglav (Pazin)","Petar u Šumi","Polje Čepić","Kršan"];
const ring = pb.list.filter(p => RING.includes(p.parish));
const rest = pb.list.filter(p => !RING.includes(p.parish));
/* Every volume's own address at FamilySearch, harvested from the image
   waypoints in September 2026. Until then this page listed 263 books and
   offered no way to open one of them. */
const film = (parish, title) => {
  const rec = (pb.links || {})[parish];
  const hit = rec && rec[title];
  return hit ? `https://www.familysearch.org/ark:/61903/${hit.ark}?cc=2040054&wc=${encodeURIComponent(hit.wc)}` : null;
};
const linked = pb.linked || 0;
/* 12 November 2026 (the Atlas-overlap trim). The Record Atlas lists every one of these volumes, with its FamilySearch waypoint, on the
   parish's own page (checked: 1,359 of 1,359 waypoints of the linked parishes are on the page of the Atlas place they link to), so a parish
   the Atlas knows is a short row here: where it begins, how many volumes, and the link. A parish the Atlas has no place for (names in
   neither list: scripts/build-atlas-place-ids.py) keeps its full list, so nothing is dropped that is not somewhere else. */
const atlas = (name) => ap.ids[name] ? `https://recordatlas.org/place/${ap.ids[name]}/` : null;
const nvol = (n) => n === 1 ? "1 volume" : `${n} volumes`;
const ATLAS_ROW = "on the Atlas";
---
<Base title="Parish Books"
      eyebrow={`${pb.volumes + kv.linked + dal.volumes + car.volumes} volumes · Istria, the Kvarner, Dalmatia and Carnia`}
      dek="Every register volume photographed for the places this family came from, walked parish by parish through the image waypoints. This is what exists to be read — as against the quarter of it that can be found by typing a name. The volumes themselves, with their FamilySearch links, are on each parish's page of the Record Atlas; the Carnian ones name the volume but their images are restricted.">

  <AtlasNote only={[["The ring around Gologorica, and the volumes still to read", "#ring", "which parishes to open next, and why"], ["The Kvarner, Dalmatia and Carnia, parish by parish", "#kvarner", "why each one matters to this family, and what is not on film"], ["HR-HDA-1448: what to order, in order", "#hda", "the register holdings, the rolls and the marks, and the order to ask in"], ["Which have been read here", "/searched/", "every volume's reading is a row of the Search Register"]]} atlas={[["Register volumes by place, on the Atlas", "https://recordatlas.org/places/"], ["Pazin, on the Atlas", "https://recordatlas.org/place/pazin/"], ["Gologorica, on the Atlas", "https://recordatlas.org/place/gologorica/"], ["Svetvinčenat, on the Atlas", "https://recordatlas.org/place/svetvincenat/"]]} closing={`Every parish below that has a ↗ link opens its page on the <a href="https://recordatlas.org/" target="_blank" rel="noopener">Record Atlas</a>, which lists each of its volumes with the FamilySearch waypoint. This page keeps what the Atlas does not: why each parish matters to this family, what is not on film, and the HDA holdings and what to order.`} />

<section class="blk">
  <p class="dek" style="margin-bottom:18px">This page is the <strong>inventory</strong> — the volumes that exist for the places this family came from. <a href={u("/map/")}>The Research Map</a> is the same question asked of the whole country: <strong>1,196 record-book places across Croatia</strong>, every confession, with a colour for how far this archive has got with each one. It is rebuilt from David's own Google My Map, which cannot otherwise be kept.</p>
  <div class="note">Gologorica and Gračišće are not here, and neither is Pićan, Cerovlje, Vodnjan, Motovun or Lindar. But <strong>the ring of parishes around them is</strong>, and a family at Gologorica married, buried and stood godparent across that ring constantly. These are the books to read next, and none of their contents is name-indexed — a search returns nothing while the pages may be full of the surname.</div>

  <h2 id="ring" style="margin-top:38px">The ring around Gologorica</h2>
  <div class="scroll" style="margin-top:20px">
    <table>
      <thead><tr><th>Parish</th><th class="m">From</th><th>Volumes</th></tr></thead>
      <tbody>{ring.map(p => (
        <tr><td>{p.parish}</td><td class="m">{p.earliest}</td>
          <td>{atlas(p.parish)
            ? <a href={atlas(p.parish)} rel="noopener" target="_blank">{nvol(p.books.length)}, {ATLAS_ROW} &#8599;</a>
            : p.books.map(b => {
                const href = film(p.parish, b);
                return <div style="padding:1px 0">{href
                  ? <a href={href} rel="noopener" target="_blank">{b} &#8599;</a>
                  : <span>{b}</span>}</div>;
              })}</td></tr>
      ))}</tbody>
    </table>
  </div>
  <div class="prose" style="margin-top:26px">
    <p><strong>Pazin</strong> is the prize. Births reaching back to <strong>1582</strong> with a continuous run from 1685 to 1847, marriages from 1597 to 1852, deaths from 1655. Gračišće is four kilometres away and Gologorica about eight; Pazin was their market, their court and their county town, and it is the parish a Gologorica family would most often turn up in.</p>
    <p><strong>Tinjan</strong> is the other one to open — births 1703–1880 and marriages 1703–1896, an unbroken two-century run six kilometres from Gračišće. <strong>Lupoglav</strong> has births from 1656. <strong>Krbune</strong>, the small village that already yielded six indexed records, has a single combined volume covering births, deaths and marriages 1803–1870.</p>
    <p>And the marriage books matter more than the baptisms here. The Gologorica registers show that <em>no Defranceschi married in their own parish between 1771 and 1789</em> — the men married in their brides' parishes. Those marriages are in this ring.</p>
  </div>
</section>
<Rule name="arrows" />

<section class="blk">
  <h2>The rest of Istria</h2>
  <p class="dek">Sorted by the earliest year the parish holds. Labin opens in 1536; Rovinj has twenty-nine volumes; Poreč has thirty-two.</p>
  <div class="scroll" style="margin-top:22px">
    <table>
      <thead><tr><th style="width:18%">Parish</th><th class="m" style="width:9%">From</th><th class="m" style="width:9%">Volumes</th><th>Open them</th></tr></thead>
      <tbody>{rest.map(p => (
        <tr>
          <td>{p.parish}</td>
          <td class="m">{p.earliest || "—"}</td>
          <td class="m">{p.volumes}</td>
          <td>{atlas(p.parish)
            ? <a href={atlas(p.parish)} rel="noopener" target="_blank">All {p.volumes}, {ATLAS_ROW} &#8599;</a>
            : p.books.map(b => {
                const href = film(p.parish, b);
                return <div style="padding:1px 0">{href
                  ? <a href={href} rel="noopener" target="_blank">{b} &#8599;</a>
                  : <span>{b}</span>}</div>;
              })}</td>
        </tr>
      ))}</tbody>
    </table>
  </div>
  <p class="cap">{pb.source}</p>
  <p class="cap" style="margin-top:8px"><strong>{linked} of {pb.volumes} volumes have an image waypoint at FamilySearch</strong>, which is how each one is opened at its first page. A volume without one returned no image and is not pointed anywhere. The Record Atlas lists each volume with that waypoint on its parish's page (the ↗ links), and a parish the Atlas has no place for keeps its volumes listed here. A FamilySearch account is needed to view the images, and it is free.</p>
</section>
<Rule name="pomegranate" />

<section class="blk">
  <h2 id="kvarner">The Kvarner coast and the Vinodol</h2>
  <p class="dek">The Istrian parishes above are where the line begins. These are the parishes it moved to — and unlike Gologorica and Gračišće, which have no film at all, every one of these is photographed. None of it is name-indexed. The point of the list is to say which volume to open.</p>
  <div class="scroll" style="margin-top:24px">
    <table>
      <thead><tr><th>Parish</th><th>What survives on film</th><th>Why it matters</th></tr></thead>
      <tbody>{kv.parishes.map(p => (
        <tr>
          <td>{p.name}</td>
          <td>{p.films && p.films.length && atlas(p.name)
            ? <a href={atlas(p.name)} rel="noopener" target="_blank">{nvol(p.films.length)}, {ATLAS_ROW} &#8599;</a>
            : p.films && p.films.length
            ? <ul style="margin:0;padding-left:16px">{p.films.map(f => (
                <li style="font-size:12.5px;line-height:1.5">
                  <a href={`https://www.familysearch.org/ark:/61903/${f.ark}?cc=2040054&wc=${encodeURIComponent(f.wc)}`} rel="noopener" target="_blank">{f.t} &#8599;</a>
                </li>))}</ul>
            : (p.books.length
                ? <ul style="margin:0;padding-left:16px">{p.books.map(b => <li style="font-size:12.5px;line-height:1.5">{b}</li>)}</ul>
                : <span style="color:var(--ink-3)">not listed in the map extract</span>)}</td>
          <td>{p.why}</td>
        </tr>
      ))}</tbody>
    </table>
  </div>
  <div class="note" style="margin-top:24px">{kv.gap}</div>
  <p class="cap" style="margin-top:16px" set:html={mdHtml(kv.note)}></p>
  <p class="cap" style="margin-top:8px"><strong>{kv.linked} volumes here have an image waypoint.</strong> {kv.harvested} The Atlas lists them parish by parish (the ↗ links).</p>
</section>

<Rule name="loom" label="Dalmatia" />

<section class="blk">
  <h2>{dal.heading}</h2>
  <p class="dek" set:html={_mdx(dal.lead)}></p>
  <div class="grid g3" style="margin-top:22px">
    <div class="stat"><div class="n">{dal.volumes}</div><div class="l">volumes, every one of them openable</div></div>
    <div class="stat"><div class="n">{dal.parishes.length}</div><div class="l">parishes — the Omiš, Split, Trogir, Imotski, Zadar and Dubrovnik groups</div></div>
    <div class="stat"><div class="n">{dal.earliest}</div><div class="l">earliest volume on film</div></div>
  </div>
  <div class="scroll" style="margin-top:22px">
    <table>
      <thead><tr><th style="width:18%">Parish</th><th class="m" style="width:9%">Volumes</th><th>Open them</th></tr></thead>
      <tbody>{dal.parishes.map(p => (
        <tr>
          <td>{p.name}</td>
          <td class="m">{p.films.length}</td>
          <td>{atlas(p.name)
            ? <a href={atlas(p.name)} rel="noopener" target="_blank">All {p.films.length}, {ATLAS_ROW} &#8599;</a>
            : p.films.map(f => (
            <div style="padding:1px 0">
              <a href={`https://www.familysearch.org/ark:/61903/${f.ark}?cc=2040054&wc=${encodeURIComponent(f.wc)}`} rel="noopener" target="_blank">{f.t} &#8599;</a>
            </div>))}</td>
        </tr>
      ))}</tbody>
    </table>
  </div>
  <p class="cap" style="margin-top:14px" set:html={mdHtml(dal.note)}></p>
</section>

<Rule name="pomegranate" label="Carnia" />

<section class="blk">
  <h2>{car.heading}</h2>
  <p class="dek" set:html={_mdx(car.lead)}></p>

  <div style="margin-top:22px;display:flex;flex-direction:column;gap:16px">
    {car.findings.map(r => (
      <div class="one" style={r.key ? "border-left-color:var(--terra)" : ""}>
        <div class="lab">{r.lab}</div>
        <p style="margin-top:8px" set:html={_mdp(r.text)}></p>
      </div>
    ))}
  </div>

  <div class="scroll" style="margin-top:24px">
    <table>
      <thead><tr><th style="width:18%">Comune</th><th class="m" style="width:9%">Volumes</th><th>The volume — images restricted</th></tr></thead>
      <tbody>{car.comuni.map(p => (
        <tr>
          <td>{p.name}</td>
          <td class="m">{p.films.length}</td>
          <td>{atlas(p.name)
            ? <a href={atlas(p.name)} rel="noopener" target="_blank">All {p.films.length}, with their register numbers, {ATLAS_ROW} &#8599;</a>
            : p.films.map(f => (
            <div style="padding:1px 0">
              <a href={`https://www.familysearch.org/ark:/61903/${f.ark}?cc=1939238&wc=${encodeURIComponent(f.wc)}`} rel="noopener" target="_blank">{f.t} &#8599;</a>
            </div>))}</td>
        </tr>
      ))}</tbody>
    </table>
  </div>
  <p class="cap" style="margin-top:14px" set:html={mdHtml(car.note)}></p>
</section>

<Rule name="tablet" label="HR-HDA-1448" />

<section class="blk">
  <h2 id="hda">{hda.heading}</h2>
  <p class="dek" style="margin-top:10px" set:html={mdHtml(hda.lead)}></p>

  <div style="margin-top:24px;display:flex;flex-direction:column;gap:16px">
    {hda.what.map(r => (
      <div class="one" style={r.key ? "border-left-color:var(--accent)" : ""}>
        <div class="lab">{r.lab}</div>
        <p style="margin-top:8px" set:html={mdHtml(r.text)}></p>
      </div>
    ))}
  </div>

  <p class="cap" style="margin-top:22px"><b>Kinds of register:</b> {hda.key}</p>

  {hda.tables.map(t => (
    <div style="margin-top:34px">
      <h3 style="font-size:21px">{t.title}</h3>
      <p class="prose note" style="margin-top:10px" set:html={mdHtml(t.note)}></p>
      <div class="scroll" style="margin-top:16px">
        <table>
          <thead><tr><th>Kind</th><th>Period</th><th>Held by</th><th>Roll</th><th>Mark</th><th>Digitised</th></tr></thead>
          <tbody>{t.rows.map(r => (
            <tr>
              <td style="font-weight:600">{r[0]}</td>
              <td style="font-variant-numeric:tabular-nums">{r[1]}</td>
              <td>{r[2]}</td>
              <td style="font-family:var(--mono,monospace);font-size:12.5px">{r[3]}</td>
              <td style="font-family:var(--mono,monospace);font-size:12.5px">{r[4]}</td>
              <td style={r[5]==="yes" ? "color:var(--accent);font-weight:600" : "color:var(--ink-3)"}>{r[5]==="yes" ? "yes" : "no"}</td>
            </tr>
          ))}</tbody>
        </table>
      </div>
    </div>
  ))}

  <h3 style="font-size:21px;margin-top:38px">What to order, in order</h3>
  <div style="margin-top:16px;display:flex;flex-direction:column;gap:16px">
    {hda.asks.map(r => (
      <div class="one" style={r.key ? "border-left-color:var(--accent)" : ""}>
        <div class="lab">{r.lab}</div>
        <p style="margin-top:8px" set:html={mdHtml(r.text)}></p>
      </div>
    ))}
  </div>
  <div class="one" style="margin-top:26px;border-left-color:var(--accent)">
    <div class="lab">{hda.method.heading}</div>
    <p style="margin-top:8px" set:html={mdHtml(hda.method.text)}></p>
  </div>
  <p class="cap" style="margin-top:18px">{hda.source_hda}</p>
</section>

  <Sources ids={["familysearch", "steiner", "dapa"]} />
</Base>
