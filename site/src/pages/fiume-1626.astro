---
import Base from "../layouts/Base.astro";
import { md as _md } from "../lib/md.js";
import Locator from "../components/Locator.astro";
import Rule from "../components/Rule.astro";
import { u } from "../lib/url.js";
import f from "../data/fiume.json";
import v from "../data/valentino.json";
import jb from "../data/jbaptista.json";
const md = (s) => String(s ?? "")
  .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
  .replace(/\*(.+?)\*/g, "<em>$1</em>")
  .replace(/«(.+?)»/g, "<em>«$1»</em>");
---
<Base title={f.title} eyebrow={f.eyebrow} dek={f.dek}>

  <section class="prose">{f.lead.map(p => <p set:html={md(p)} />)}</section>

  <Locator place="Rijeka" radius={32}
            note="Fiume — where the oldest household in this archive baptised six children between 1626 and 1632." />


  <Rule name="arrows" label="Liber Baptizatorum, Fiume" />

  <ol class="ents">{f.rows.map(r => (
    <li class={"ent" + (r.key ? " is-key" : "")}>
      <div class="lab">{r.lab}</div>
      <blockquote set:html={md(r.q)} />
      <p class="tr" set:html={_md(r.en)}></p>
      <p class="wh" set:html={md(r.why)} />
    </li>
  ))}</ol>

  <Rule />

  <h2 style="font-size:31px">{f.means.heading}</h2>
  <div style="margin-top:22px;display:flex;flex-direction:column;gap:16px">
    {f.means.rows.map(r => (
      <div class="one" style={r.key ? "border-left-color:var(--accent)" : ""}>
        <div class="lab">{r.lab}</div>
        <p style="margin-top:8px" set:html={md(r.text)} />
      </div>
    ))}
  </div>

  <h2 style="font-size:31px;margin-top:52px">{f.more.heading}</h2>
  <p class="dek" style="margin-top:8px" set:html={md(f.more.lead)}></p>
  <ol class="ents" style="margin-top:24px">{f.more.rows.map(r => (
    <li class={"ent" + (r.key ? " is-key" : "")}>
      <div class="lab">{r.lab}</div>
      {r.q && <blockquote set:html={md(r.q)} />}
      {r.en && <p class="tr" set:html={_md(r.en)}></p>}
      <p class={r.q ? "wh" : "wh nb"} style="white-space:pre-line" set:html={md(r.why || r.text || "")} />
      {r.link && <p class="mono" style="margin-top:10px"><a href={u(r.link)}>The Seget branch →</a></p>}
    </li>
  ))}</ol>
  <p class="prose note" style="margin-top:24px" set:html={md(f.more.close)}></p>

<Rule name="arrows" label="Valentino's household, 1737–1757" />

  <h2 id="valentino" style="font-size:31px">{v.heading}</h2>
  <p class="dek" style="margin-top:8px" set:html={_md(v.lead)}></p>
  <div class="scroll" style="margin-top:20px">
    <table>
      <thead><tr><th>Child</th><th>What the register says</th><th class="m">Sex</th><th>On this site</th></tr></thead>
      <tbody>{v.children.map(c => (
        <tr>
          <td>{c.name}</td>
          <td class="m">{c.says}</td>
          <td class="m">{c.sex}</td>
          <td><a href={u(`/who/${c.who}/`)}>their page →</a></td>
        </tr>
      ))}</tbody>
    </table>
  </div>
  <p class="prose note" style="margin-top:18px" set:html={_md(v.note)}></p>
  <p class="cap" style="margin-top:12px" set:html={_md(v.source)}></p>

<Rule name="arrows" label="The second household, 1748–1776" />

  <h2 id="jbaptista" style="font-size:31px">{jb.heading}</h2>
  <p class="dek" style="margin-top:8px" set:html={_md(jb.lead)}></p>

  <ol class="ents" style="margin-top:24px">{jb.rows.map(r => (
    <li class={"ent" + (r.key ? " is-key" : "")}>
      <div class="lab">{r.lab}</div>
      {r.q && <blockquote set:html={md(r.q)} />}
      {r.en && <p class="tr" set:html={_md(r.en)}></p>}
      <p class={r.q ? "wh" : "wh nb"} style="white-space:pre-line" set:html={_md(r.why)} />
    </li>
  ))}</ol>

  <div class="scroll" style="margin-top:24px">
    <table>
      <thead><tr><th>Who</th><th>What is known</th><th>On this site</th></tr></thead>
      <tbody>{jb.people.map(([name, what, who]) => (
        <tr>
          <td>{name}</td>
          <td class="m" set:html={md(what)}></td>
          <td>{who ? <a href={u(`/who/${who}/`)}>their page →</a> : <span class="m">no page — named only in the register</span>}</td>
        </tr>
      ))}</tbody>
    </table>
  </div>

  <p class="prose note" style="margin-top:18px" set:html={_md(jb.note)}></p>
  <p class="cap" style="margin-top:12px" set:html={_md(jb.source)}></p>

<Rule name="arrows" label="Rovinj, 1619" />

  <h2 style="font-size:31px">{f.rovinj.heading}</h2>
  <p class="dek" style="margin-top:8px" set:html={_md(f.rovinj.lead)}></p>
  <ol class="ents" style="margin-top:24px">{f.rovinj.rows.map(r => (
    <li class={"ent" + (r.key ? " is-key" : "")}>
      <div class="lab">{r.lab}</div>
      {r.q && <blockquote set:html={md(r.q)} />}
      {r.en && <p class="tr" set:html={_md(r.en)}></p>}
      <p class={r.q ? "wh" : "wh nb"} style="white-space:pre-line" set:html={md(r.why || r.text)} />
    </li>
  ))}</ol>
  <p class="cap" style="margin-top:16px" set:html={_md(f.rovinj.source)}></p>

  <Rule name="pomegranate" label="A correction" />

  <h2 style="font-size:31px">{f.vodnjan.heading}</h2>
  <p class="dek" style="margin-top:8px" set:html={_md(f.vodnjan.lead)}></p>
  <div style="margin-top:22px;display:flex;flex-direction:column;gap:16px">
    {f.vodnjan.rows.map(r => (
      <div class="one" style={r.key ? "border-left-color:var(--terra)" : ""}>
        <div class="lab">{r.lab}</div>
        {r.q && <blockquote class="doc2" set:html={md(r.q)} />}
        <p style="margin-top:10px;white-space:pre-line" set:html={md(r.why || r.text)}></p>
      </div>
    ))}
  </div>
  <p class="cap" style="margin-top:16px" set:html={_md(f.vodnjan.source)}></p>

    <p class="cap" style="margin-top:30px" set:html={_md(f.source)}></p>
  <p class="cap" style="margin-top:10px">
    See <a href={u("/carlos-letter/")}>Carlo's Letter</a> for Kobler's Fiume households and Valentino of 1739 ·
    <a href={u("/senj-line/")}>Senj</a> · <a href={u("/omis-line/")}>the Omiš line</a> ·
    <a href={u("/lines/#regions")}>where Fiume sits among the regions</a>.
  </p>
</Base>

<style>
  .ents{list-style:none;margin:26px 0 0;padding:0;display:flex;flex-direction:column;gap:22px}
  .ent{background:var(--panel);border:1px solid var(--rule);border-left:3px solid var(--rule-strong);
    border-radius:3px;padding:20px 24px;max-width:78ch}
  .ent.is-key{border-left-color:var(--accent)}
  .ent blockquote{margin:10px 0 0;font-size:17.5px;line-height:1.7;font-style:italic}
  .ent .tr{margin-top:12px;font-family:var(--sans);font-size:14px;line-height:1.6;color:var(--ink-2)}
  .ent .wh{margin-top:14px;padding-top:14px;border-top:1px dotted var(--rule);font-size:16.5px}
  blockquote.doc2{margin:12px 0 0;padding:12px 16px;background:var(--panel-2);border-radius:3px;
    font-family:var(--mono);font-size:13px;line-height:1.75;white-space:pre-line}
  .ent .wh.nb{margin-top:8px;padding-top:0;border-top:0}
</style>
