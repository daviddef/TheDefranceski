---
import Base from "../layouts/Base.astro";
import Gist from "../components/Gist.astro";
import gists from "../data/gists.json";
import { md as _md } from "../lib/md.js";
import Locator from "../components/Locator.astro";
import Plates from "../components/Plates.astro";
import Lightbox from "../components/Lightbox.astro";
import SceneGologorica from "../components/SceneGologorica.astro";
import Rule from "../components/Rule.astro";
import Sources from "../components/Sources.astro";
import DescentTree from "../components/DescentTree.astro";
import g from "../data/gologorica.json";
import j from "../data/josip1863.json";
import roots from "../data/gologorica_roots.json";
const yrs = g.people.map(p => p.birthYear).filter(Boolean);
---
<Base title="The Gologorica Line" eyebrow={`${g.counts.individuals} people · ${g.counts.families} families · ${Math.min(...yrs)}–${Math.max(...yrs)}`}
      dek="Read off the parish register itself, page by page, from microfilm of the Gologorica books held by the Pazin Records Office. This is the ancestral line, and it is the only part of this archive built from the pages rather than from an index.">


  <Gist g={gists.gists["gologorica-line"]} />
<section class="blk">
  {/* 30 September 2026. This sentence used to say the reels covered
      «Gologorica, Gračišće and Lindar». They do not. All 1,463 frames have
      now been located against the films' own printed title cards: LINDAR IS
      NOT ON THEM — it sits on ZM34K-219 and 220 — and CEROVLJE, which is on
      them, had never been named anywhere in this archive. The table further
      down is the evidence; the correction is on /corrections/. */}
  <div class="note">Everything on this page comes from two microfilm volumes, <span class="mono">ZM34K-214</span> and <span class="mono">ZM34K-215</span> — <strong>1,463 page images</strong> of the Roman Catholic registers for <strong>Gologorica, Gračišće and Cerovlje</strong>: baptisms, marriages, deaths, confirmations and household censuses. FamilySearch does not hold these films; they came from the Pazin Records Office directly. That is why this line exists and the rest of the archive's Istrian interior does not.</div>
  <div class="prose" style="margin-top:26px">
    <p>Two Defranceschi households sit in the 1780s baptism register, both headed by a <strong>Joannes Baptista</strong>, both with a wife called <strong>Mariana</strong>, living in different houses — <em>casa 31</em>, carrying the byname <em>“detti Leonardi”</em>, and <em>casa 36</em>, recorded as <em>son of the late Josephus</em>. By 1826 the household census shows three heads of that generation: <strong>Jacobus</strong> (b. 1761, a bachelor), <strong>Josephus</strong> (b. 1763) and <strong>Leonardus</strong> (b. 1766).</p>
    <p>Above them stands <strong>Dominus Josephus Defranceschi</strong> and his wife <strong>Helena</strong>, who appear through the 1760s and 1770s as godparents — the title <em>Dominus</em> marking the family's standing. And the parish priest of the 1780s was himself one of them: he signs <em>“Ego Joannes Mathias Franceschi Parochus.”</em></p>
  </div>
</section>

  <Locator place="Gologorica" radius={10}
            note="The house with 1711 over the door. Gračišće is four kilometres south — the two villages of our first four generations." />

<Rule name="arrows" />

{/* THE FRAME MAP. This page had stood for months on «about 1,465 page images»
    with no account of what was in them, which is how it came to name a parish
    the reels do not hold and miss one they do. Published as a table because
    the sizes are the argument: the household censuses are 43% of the run and
    three of the four have never been opened. */}
<section class="blk">
  <h2>{g.framemap.heading}</h2>
  <p class="prose" set:html={_md(g.framemap.lead)} style="margin-top:14px" />
  <p class="prose" set:html={_md(g.framemap.method)} style="margin-top:14px" />

  <div class="tbl-wrap" style="overflow-x:auto;margin-top:24px">
    <table class="tbl">
      <thead>
        <tr><th>Frames</th><th>Župa</th><th>Register</th><th>Years</th><th>Sig.</th><th style="text-align:right">Frames</th></tr>
      </thead>
      <tbody>
        {g.framemap.rows.map((r) => (
          <tr>
            <td class="mono" style="white-space:nowrap">{r[0]}</td>
            <td set:html={_md(r[1])} />
            <td set:html={_md(r[2])} />
            <td set:html={_md(r[3])} />
            <td class="mono">{r[4]}</td>
            <td class="mono" style="text-align:right">{r[5]}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="prose" set:html={_md(g.framemap.whatitmeans)} style="margin-top:26px" />

  {/* THE PRIESTS. House 1 of the 1826 census is the parish house, and it
      carries the whole succession with birthplaces. Published because this
      archive's central rule — a hand is only legible against itself — cannot
      be applied to a book whose hands have no names. */}
  <div style="margin-top:38px">
    <h3 style="font-size:21px">{g.priests.heading}</h3>
    <p class="prose" set:html={_md(g.priests.lead)} style="margin-top:12px" />
    <div class="tbl-wrap" style="overflow-x:auto;margin-top:18px">
      <table class="tbl">
        <thead><tr><th>Priest</th><th>Office</th><th>Born</th><th>From</th><th>Died</th></tr></thead>
        <tbody>
          {g.priests.rows.map((r) => (
            <tr>
              <td set:html={_md(r[0])} />
              <td>{r[1]}</td>
              <td class="mono" style="white-space:nowrap">{r[2]}</td>
              <td set:html={_md(r[3])} />
              <td set:html={_md(r[4])} />
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="prose" set:html={_md(g.priests.note)} style="margin-top:16px" />
    <div style="margin-top:20px"><Plates ids={["golo-1826-priests"]} cols={1} /></div>
  </div>
  <div class="keyrow" style="margin-top:24px">
    <p class="prose" set:html={_md(g.framemap.honest)} />
  </div>
</section>

<Rule name="pomegranate" />

{/* 30 September 2026, at David's asking: the findings belong in the book with
    the register images beside them, not only in the search log. The plates are
    cut from the family's own copies of the film and carry the film and frame
    in their captions, so a reader can go back to the exact page this archive
    read — which is the whole point of publishing an image rather than a
    transcription. */}
