---
import Base from "../../layouts/Base.astro";
import { u } from "../../lib/url.js";
import Rule from "../../components/Rule.astro";
import { mdp } from "../../lib/md.js";
import m from "../../data/maternal.json";

export function getStaticPaths() {
  return Object.entries(m.lines).map(([line, d]) => ({ params: { line }, props: { d } }));
}
const { d } = Astro.props;
---
<Base title={d.name}
      eyebrow={`A maternal line — ${d.woman}`}
      dek={`${d.gen} ${d.born ? `Born ${d.born}${d.place && d.place !== "not established" ? `, at ${d.place}` : ""}.` : ""} What this archive can prove about her family, and what it would take to prove more.`}>

  <section class="prose">
    <p set:html={mdp(m.lead)} />
  </section>

  <Rule name="arrows" />

  {/* Two shapes, deliberately. A line whose research has landed is written in
      SECTIONS — the Kosina shape David asked for: a citation above the
      headline, the headline saying what happened, corrections shown where the
      claim was made, and the page closing on what is still unknown. A line
      still waiting on a register keeps the older flat ROWS, because giving a
      thin page the furniture of a full one is a way of looking finished. */}
  {d.sections ? d.sections.map((s) => (
    <section class={s.kind === "fix" ? "blk fix" : "blk"} style="margin-top:38px">
      {s.lab && <div class="lab">{s.lab}</div>}
      <h2 style="font-size:26px">{s.h2}</h2>
      {(s.paras || []).map((t) => <p class="prose" set:html={mdp(t)} style="margin-top:14px" />)}
      {s.asks && (
        <div class="rec rec-bio" style="margin-top:20px">
          {s.asks.map((a) => (<>
            <div class="k">Open</div>
            <div class="v">{a.q}</div>
            <div class="w" set:html={mdp(a.a)} />
          </>))}
        </div>
      )}
    </section>
  )) : (
  <section class="blk">
    <div class="stack" style="margin-top:8px">
      {d.rows.map((r) => (
        <div class={r.key ? "keyrow" : ""} style="margin-top:26px">
          <h3 style="font-size:21px;margin-bottom:8px">{r.lab}</h3>
          <p set:html={mdp(r.text)} />
        </div>
      ))}
    </div>
  </section>
  )}

  <section class="blk" style="margin-top:38px">
    <h2 style="font-size:26px">The other maternal lines</h2>
    <ul class="dek" style="margin-top:10px;line-height:2">
      {Object.entries(m.lines).filter(([k]) => k !== Astro.params.line).map(([k, o]) => (
        <li><a href={u(`/maternal/${k}/`)}>{o.name}</a> — {o.woman}</li>
      ))}
      <li><a href={u("/kalanj/")}>Kalanj</a> — Anna Kalanj, and the parish nobody has opened</li>
      <li><a href={u("/senj-line/")}>Blažević</a> — Hedviga; the family is kept in <a href="https://daviddef.github.io/TheBlazevic/">The Blažević Archive</a></li>
    </ul>
  </section>

  <p class="cap" style="margin-top:28px">{m.source_maternal}</p>

</Base>
