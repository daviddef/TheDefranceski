---
import Base from "../layouts/Base.astro";
import Rule from "../components/Rule.astro";
import Shotlist from "@daviddef/archive-kit/components/Shotlist.astro";
import { u } from "../lib/url.js";
import p from "../data/shots.json";
const md = (s) => String(s ?? "")
  .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
  .replace(/\*(.+?)\*/g, "<em>$1</em>")
  .replace(/«(.+?)»/g, "<em>«$1»</em>")
  .replace(/\n\n/g, "</p><p style='margin-top:12px'>");
const walks = [...new Set(p.rows.map(r => r.walk))];

/* 21 September 2026. The frame moved to the kit. The WALK did not: this page
   is an itinerary, ordered by the day you would be standing there, which is
   not a grade at all — Blazevic ranks by how much effort the trip is worth
   and Lerena by what the picture would settle. A walk stays a walk. */
const rowsFor = (wk) => p.rows.filter(r => r.walk === wk).map(r => ({
  tag: r.day === "\u2014" ? null : "Day " + r.day,
  where: r.sub,
  what: md(r.shot),
}));
---
<Base title={p.title} eyebrow={p.eyebrow} dek={p.dek}>
<section class="blk"><p class="prose" set:html={md(p.lead)}></p></section>
{walks.map(wk => (
<>
<Rule name="arrows" label={wk} />
<section class="blk">
  <h2>{wk}</h2>
  <Shotlist groups={[{ rows: rowsFor(wk) }]} u={u} />
  <p class="cap" style="margin-top:14px"><a href={u(p.rows.find(r => r.walk === wk).href)}>Where this belongs →</a></p>
</section>
</>
))}
<Rule name="pomegranate" />
<section class="blk"><p class="prose note" set:html={md(p.close)}></p>
  <p class="cap" style="margin-top:14px"><a href={u("/walk/")}>The itineraries →</a> · <a href={u("/corrections/")}>Corrections →</a></p>
</section>

</Base>
