---
import Base from "../layouts/Base.astro";
import Rule from "../components/Rule.astro";
import Sources from "../components/Sources.astro";
import EraTimeline from "@daviddef/archive-kit/components/EraTimeline.astro";
import Marriages from "@daviddef/archive-kit/components/Marriages.astro";
import { u } from "../lib/url.js";
import m from "../data/marriages.json";
import mi from "../data/marriedin.json";

/* Two pages until now — the essay on who this family married, and the index
   routing each of those families to the empire that held its town. They are one
   page because they are one argument: a surname is in this archive because a
   person married a person, and the essay could not point at the index while
   they were apart.

   This archive groups by ORIGIN, not by descent, and that is correct here for a
   reason that does not travel: its subject IS the name. It says outright that
   there is no single Defranceschi family and that the name was coined
   independently many times over, so a Bergamo who married one is not thereby
   related to a Bergamo who married another. Falco had to replace exactly this
   kind of rule with a descent test, because Falco is a family and this is a
   name. Both are right about themselves.

   The grouping is also, in this archive's own words, a reading and not a
   finding — it comes from surname morphology and the Carnian emigration
   literature. The caveat below is kept where a reader meets it. */
const md = (x) => String(x ?? "")
  .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
  .replace(/«(.+?)»/g, "<em>«$1»</em>")
  .replace(/(^|[^*])\*([^*\n]+?)\*/g, "$1<em>$2</em>");

const byRoute = {};
for (const r of mi.rows) (byRoute[r.route] = byRoute[r.route] || []).push(r);
const ORD = ["hungarian-littoral", "istria-austrian", "dalmatia", "carnia", "venice"];
const ORIGIN = {
  venetian: "--r-venice", slavic: "--accent", carnia: "--terra",
  austrian: "--r-habsburg", maritime: "--r-italy", uskok: "--r-yugo",
};

const GROUPED = ORD.filter((k) => mi.routes[k]).map((k) => {
  const R = mi.routes[k], fams = (byRoute[k] || []).sort((a, b) => b.c - a.c);
  return {
    key: k, label: R.label, places: R.places, badge: R.proved ? "already paid off" : "",
    count: fams.length,
    detail: [
      ["Who held it", md(R.held)],
      ["The registers", md(R.registers)],
      ["Beyond the registers", md(R.beyond)],
      ["Where this archive stands", md(R.gap)],
    ],
    chips: fams.map((f) => ({
      name: f.name,
      /* The colour is the family's ORIGIN while its place on the ring is the
         empire that held its town. Two readings of the same 74 names, which is
         why this archive used to carry a second chart drawing the other one. */
      accent: ORIGIN[f.origin] || "",
      count: f.notindexed ? "—" : f.c,
      aside: f.fb ? (f.fb.total === "0" ? "none alive" : f.fb.total + " alive") : "",
      asideTitle: f.fb ? f.fb.top : "",
      href: f.detail ? `/married-in/${f.slug}/` : "",
      mark: !!f.ours,
    })),
  };
});
const nFam = mi.rows.length, nMarr = mi.rows.reduce((a, b) => a + b.c, 0);
const band = (c) => (String(c.when).match(/\d{4}/) ? String(c.when).slice(0, 2) + "00s" : "Undated");

/* In the frontmatter, not inline in the attribute: a regex literal inside an
   Astro attribute expression ends the expression at the first slash, and the
   error it reports is "unterminated regular expression" pointing at a column
   several thousand characters along. */
const timelinePoints = m.couples
  .filter((c) => /^\d{4}$/.test(String(c.y)))
  .map((c) => ({ label: c.b, year: c.y }));
---
<Base title="The Marriages" eyebrow={`${nFam} families \u00b7 ${nMarr} indexed marriages \u00b7 three worlds`}
      dek="A surname is one thread. The family is the weave. Every generation this name entered a house that was not its own — and this page now carries both halves of that: who they married, and which empire still holds the records of the family they married into.">

<Rule name="arrows" label="Five jurisdictions, five sets of records" />

<section class="blk">
  <h2>{mi.heading}</h2>
  <div class="prose"><p set:html={md(mi.lead)} /><p set:html={md(mi.why)} /></div>

  <Marriages u={u} groups={GROUPED} subject="Defranceschi"
    metrics={[{ n: nFam, label: "families joined" }, { n: nMarr, label: "indexed marriages" },
              { n: m.couples.length + m.undated.length, label: "couples recovered" },
              { n: ORD.filter((k) => mi.routes[k]).length, label: "jurisdictions" },
              { n: mi.rows.filter((r) => r.ours).length, label: "in the direct line" }]} chartUnit="indexed marriages"
    couples={[...m.couples.map((c) => ({ a: { name: c.a }, b: { name: c.b }, when: c.y })),
              ...m.undated.map((c) => ({ a: { name: c.a }, b: { name: c.b }, when: "" }))]}
    couplesTitle="Everyone, as the registers name them"
    couplesNote={`Forty-nine couples recovered so far. Spelling is the clerk's, not ours. Source: ${m.source}.`}
    couplesGroupBy={band}>
    <div slot="missing">
      <Rule name="arrows" label={mi.fbnote.heading} />
      <div class="prose">{mi.fbnote.text.split("\n\n").map((p) => <p set:html={md(p)} />)}</div>
      <p class="prose note" style="margin-top:26px" set:html={md(mi.close)}></p>
      <p class="cap" style="margin-top:22px">Counts are of indexed marriages, from FamilySearch's
      Croatia Church Books. The grouping by origin is the archive's existing reading from surname
      morphology and the Carnian emigration literature — <strong>a reading, not a finding</strong> —
      and the routing here inherits that uncertainty. Families with a page of their own are linked;
      the rest carry their count and nothing more, because that is all this archive knows about them.
      Names in <span class="ink">this colour</span> married into our own direct line.</p>
    </div>
  </Marriages>
</section>


<section class="blk">
  <div class="prose">
    <p>Two thousand two hundred indexed records for this surname survive in the Croatian church books. Strip out the men who carried the name and what is left is a list of the families who let them in: seventy-one distinct in-law surnames, from a Venetian patrician house to a Carnian weaving family to the descendants of refugee raiders.</p>
    <p>Grouped by where those names come from, the pattern is not subtle. <strong>The family married the whole of Istria.</strong></p>
  </div>
  <p class="cap">{m.caveat} Counts are occurrences across the indexed records, so a large node means a name that recurs — a family married more than once, across generations, in the way village families do.</p>
</section>
<Rule name="arrows" />

<section class="blk">
  <h2>Three worlds at one altar</h2>
  <div class="prose">
    <h3>The Venetian and Istrian Romance names</h3>
    <p>The largest group, and the least surprising: <em>Bergamo, Malusà, Moscarda, Padovan, Belloni, Faravallo, Martechini, Frezza, Perusino, Beluzzi</em>. These are the names of the coastal and small-town Romance-speaking Istria the family lived in — the world of the parish register itself, kept in Latin and Italian by priests who wrote <em>de Franceschis</em> for a man everyone called Zuane.</p>
    <p>Two of them are not village names at all. A Pietro De Franceschi married an <strong>Anna <a href="https://en.wikipedia.org/wiki/Bembo_family">Bembo</a></strong> — the surname of a Venetian patrician house that gave the Republic a doge's chancery, a cardinal, and the type Aldus Manutius cut for him. A Bortolo De Franceschi married a <strong>Zanetta <a href="https://en.wikipedia.org/wiki/Gravisi">Gravisi</a></strong>, the marquesses of Pietrapelosa, one of the oldest titled families in Istria. Neither marriage proves anything about status — patrician surnames spread far beyond patrician households — but they are worth knowing about, and they sit oddly beside <em>modesti possidenti</em>.</p>

    <h3>The Slavic names</h3>
    <p><em>Schifich, Skoko, Vojnić, Michelcich, Mihecich, Bellinich, Buich, Kalanj, Ivancić, Marinovich, Zvitanovich.</em> Twenty-one surnames in <em>-ić</em>, written the Austrian way with <em>-ich</em>, or Slavic outright. In the Ližnjan records especially, the Defranceschi marry Skifich and Skoko and Vojnić generation after generation.</p>
    <p>This matters for the identity argument that has been fought over these villages for a century. A family with an Italian patronymic, in a parish whose registers are kept in Latin and Italian, marrying Croatian families for two hundred years, is not a puzzle. It is what Istria was. Acta Croatica records today's Defranceschi of the Pazin area as <strong>Croats</strong>, rarely Italians — and the marriage record is why.</p>

    <h3>The Carnian names — and this is the finding</h3>
    <p><em>Cleva, Corva, Crosilla, Carlutto, Dorliguzzo, Stefanutti, Clagnan.</em> Friulian and Carnian surnames, in Istrian parish registers, marrying into this family.</p>
    <p>Two of them are not merely Friulian in shape. <strong>Corva</strong> and <strong>Crosilla</strong> are named in the scholarship on the Canale di Gorto emigration as families of Ovaro's own commune — Giovanni Corva of Muina held tenants at Agrons; the Micoli <strong>Crosilla</strong> Toscano were the leading house of <strong>Mione</strong> itself, the family who built the <em>casa delle cento finestre</em> and who ran a cloth shop at Pinguente trading from Montona to Rozzo.</p>
    <p>In 1882 a <strong>Jacobina Defranceschi</strong>, born 1804, was buried as the wife of a <strong>Joan-Baptae Crosilla</strong>. Somewhere between the 1679 list that puts a De Franceschi of Mione on the road into the County of Pazin, and a Defranceschi woman dying as a Crosilla wife in the 1880s, the two Carnian families were still finding each other in Istria two hundred years after they left the same valley. That is not proof of descent. It is a very loud coincidence.</p>
  </div>
</section>
<Rule name="pomegranate" />

<section class="blk">
  <h2>The marriages, against the century they happened in</h2>
  <p class="dek">Thirty-one dated marriages between 1776 and 1891, laid over who was in charge and what the weather did.</p>
  <div style="margin-top:26px"><EraTimeline
    points={timelinePoints}
    from={1770} to={1900}
    eras={[[1770,1790,"Josephine reforms","--r-habsburg"],[1797,1805,"Venice falls","--r-venice"],
           [1805,1813,"Napoleonic Illyria","--r-napo"],[1813,1848,"Austrian restoration","--r-habsburg"],
           [1848,1866,"Revolution & reaction","--r-italy"],[1866,1900,"Austria–Hungary","--r-habsburg"]]}
    marks={[[1797,"Treaty of Campo Formio"],[1809,"Illyrian Provinces"],
            [1816,"The year without a summer"],[1817,"Europe's last famine"],
            [1848,"Carlo elected for Pisino"],[1854,"Carlo expelled from the bench"],
            [1866,"Austria loses Venetia"],[1880,"Phylloxera reaches Istria"]]}
    what="Each dot is a woman — or, where the record runs the other way, a husband — marrying into the family, placed at the year of the record. Names as the register spells them." /></div>
  <div class="prose" style="margin-top:30px">
    <p>Read it left to right and the politics change under the same families. <strong>Domenica Filipich</strong> marries a Francesco De Franceschi in 1776, under Maria Theresa, in a county the Habsburgs had held for four hundred years. <strong>Elisabetta Dalino</strong> marries in 1793, with Venice four years from extinction. <strong>Natalia Ivancić</strong> marries in 1806, when the Habsburgs had just lost the province to Napoleon; by 1809 these parishes were in the <a href="https://en.wikipedia.org/wiki/Illyrian_Provinces">Illyrian Provinces</a> and the priest's register was, briefly, a French administrative document.</p>
    <p>Then the sky closed. Tambora erupted in April 1815, and 1816 became <a href="https://en.wikipedia.org/wiki/Year_Without_a_Summer">the year without a summer</a> — cold, sunless, endlessly wet across Europe, followed by the harvest failure of 1817 and the last great famine the continent has had. Grain convoys were attacked; hundreds of thousands were left destitute. The Fasana records show a De Franceschi child in 1816 and another in 1819. Whatever else those families were doing, they were doing it hungry.</p>
    <p><strong>Maria Michelcich</strong> appears against a Carlo De Franceschi in an 1812 record, alongside a <em>Giuseppe da Gologorizza</em> — Joseph of Gologorica, which is how a village clerk writes a man who is known by where he is from. Carlo the historian was three years old that year, in that village, with a father called Giuseppe.</p>
    <p>By <strong>1845</strong> a Victorius Defranceschi is marrying <strong>Maria-Francisca Ottochian</strong>. <em>Ottochian</em> means <em>of Otočac</em> — and Otočac is one of the three surnames historians trace to the <a href="https://en.wikipedia.org/wiki/Uskoks">Uskoks</a> resettled inland near Učka after Venice forced them out of Senj in 1617. Two hundred and twenty-eight years after the expulsion, a descendant of the raiders marries into a family of weavers' descendants. Senj and Gologorica, the two halves of this archive that never shared a ruler, meet in one parish register.</p>
    <p>And in <strong>1879</strong>, a Defranceschi marries an <strong>Emerico <a href="https://en.wikipedia.org/wiki/Cosulich">Cosulich</a></strong> — the Lussino family who built one of the great Adriatic shipping houses out of a small island. The century that began with a hungry village ends with the family attached, however distantly, to the steamships that carried the next generation to New York, Sydney and Cape Town.</p>
  </div>
</section>
<Rule name="helm" />

<section class="blk">
  <h2>Lambertina Peschle of Volosca</h2>
  <p class="dek">Carlo De Franceschi's mother — and the one in-law whose family can be traced back three generations from the records alone.</p>
  <div class="prose">
    <p>Every account of Carlo gives the same half-sentence: born at Moncalvo di Pisino on 16 October 1809, to Giuseppe De Franceschi and <strong>Lambertina Peschle of Volosca</strong>. Then she disappears from the story, as the mothers do.</p>
    <p>She does not disappear from the registers. <em>Peschle</em> is not an Istrian name — it is German, and it belongs to <strong>Fiume</strong>, the Habsburg free port an hour up the coast from Volosca. Two hundred and twenty Peschle records survive in the Croatian church books, and they resolve into a family:</p>
  </div>
  <div class="scroll" style="margin-top:22px">
    <table>
      <thead><tr><th>Name</th><th class="m">Dates</th><th>Recorded as</th></tr></thead>
      <tbody>{m.peschle.map(([n,d,w])=>(<tr><td>{n}</td><td class="m">{d}</td><td>{w}</td></tr>))}</tbody>
    </table>
  </div>
  <div class="prose" style="margin-top:26px">
    <p>A Mathias Peschle born in 1756, married to a <strong>Justina Jacich</strong> — a German surname and a Croatian one, in the same marriage, in the 1780s. Their son Alexander, born 1803, married a Franca Descovich. A second Alexander, born 1797, married an <strong>Anna Promagnoli</strong>, and their children were baptised at Fiume: Pasqualina, Ercolano, Paschalis Maria in April 1832 — and Carmina, born 1832, buried 6 June 1833.</p>
    <p>Volosca, where Lambertina came from, sat on the boundary: Habsburg territory, Italian-speaking on the shore, Croatian in the hills behind, looking across the bay at a Hungarian free port full of German clerks and Italian merchants. A Peschle daughter marrying an inland Istrian landowner named De Franceschi is a small piece of exactly that world.</p>
    <p>And then the name comes back. Among the burials at <strong>Poreč</strong> is a <strong>Lamberta Defranceschi</strong>, born July 1866, died July 1867, daughter of <em>Caroli</em>. Carlo named a daughter after his mother. The child lived twelve months. Two years later, in 1868, his last child was born at Poreč and lived to be eighty-five: Camillo, who would write the history of the county his grandmother married into.</p>
    <p>There is one more, and it is the saddest line in the whole dataset. The Poreč and Rovinj registers give Carlo four children who did not survive: <strong>Julius</strong>, born 1853, died February 1854 at Rovinj. <strong>Aurelia Augusta</strong>, born 1867, died July 1867. <strong>Lamberta</strong>, 1866–1867. <strong>Virginia</strong>, born 1858, died 20 August 1876 at eighteen. The man who spent his life arguing about the future of a province buried at least four of his children while he did it.</p>
  </div>
  <div class="note" style="margin-top:26px">A caution on Virginia and Lamberta: the index gives the parent as <em>Caroli</em> or <em>Carlo De Franceschi</em> at Poreč and Rovinj in exactly the years Carlo lived and worked there, which is why they are set out here. It is <span class="chip inf" style="padding:2px 7px;font-size:10px">Inferred</span> until the register pages themselves are read. Carlo is a common name.</div>
</section>
<Rule name="tablet" />



<Rule name="tablet" />

  <Sources ids={["familysearch", "dapa"]} />
</Base>

<style>
.ink{color:var(--accent)}
</style>
