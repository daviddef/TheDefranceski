---
import Base from "../layouts/Base.astro";
import { md as _md, mdp as _mdp } from "../lib/md.js";
import Rule from "../components/Rule.astro";
import Sources from "../components/Sources.astro";
import { u } from "../lib/url.js";
import d from "../data/oldsite.json";
---
<Base title="defranceski.com"
      eyebrow="Before the old site is switched off"
      dek={d.note}>

<section class="blk">
  <div class="one" style="border-left-color:var(--terra)">
    <div class="lab">{d.backto.heading}</div>
    <p style="margin-top:8px" set:html={_md(d.backto.lead)}></p>
    <p style="margin-top:12px">
      <a href={d.backto.live[1]} rel="noopener" target="_blank">{d.backto.live[0]} &#8599;</a>
    </p>
  </div>
  <div style="margin-top:18px;display:flex;flex-direction:column;gap:16px">
    {d.backto.rows.map(r => (
      <div class="one" style={r.key ? "border-left-color:var(--accent)" : ""}>
        <div class="lab">{r.lab}</div>
        <p style="margin-top:8px" set:html={_mdp(r.text)}></p>
        {r.links && (
          <ul class="prose" style="display:block;margin-top:10px">
            {r.links.map(([t, href]) => (
              <li style="margin:.35em 0"><a href={href} rel="noopener" target="_blank">{t} &#8599;</a></li>
            ))}
          </ul>
        )}
        {r.after && <p style="margin-top:12px" set:html={_mdp(r.after)}></p>}
      </div>
    ))}
  </div>
</section>
<Rule name="arrows" label="What was captured" />

<section class="blk">
  <h2>{d.captured.heading}</h2>
  <div style="margin-top:20px;display:flex;flex-direction:column;gap:16px">
    {d.captured.rows.map(r => (
      <div class="one" style={r.key ? "border-left-color:var(--terra)" : ""}>
        <div class="lab">{r.lab}</div>
        <p style="margin-top:8px" set:html={_md(r.text)}></p>
      </div>
    ))}
  </div>
  <div class="one" style="border-left-color:var(--accent);margin-top:20px">
    <div class="lab">{d.maps.heading}</div>
    <p style="margin-top:8px" set:html={_md(d.maps.text)}></p>
    <ul class="prose" style="display:block;margin-top:10px">
      {d.maps.links.map(([t, href]) => <li style="margin:.4em 0"><a href={href} rel="noopener">{t}</a></li>)}
    </ul>
  </div>
</section>
<Rule name="arrows" label="Page by page" />

<section class="blk">
  <h2>{d.covered.heading}</h2>
  <div class="scroll" style="margin-top:20px">
    <table>
      <thead><tr><th>On the old site</th><th>What it said</th><th>Where it is now</th></tr></thead>
      <tbody>{d.covered.rows.map(([a,b,c]) => <tr><td><strong>{a}</strong></td><td>{b}</td><td>{c}</td></tr>)}</tbody>
    </table>
  </div>
</section>
<Rule name="pomegranate" label="And four things we did not have" />

<Rule name="arrows" label="Re-checked" />

<section class="blk">
  <h2>{d.recheck.heading}</h2>
  <p class="dek" style="margin-top:8px" set:html={d.recheck.lead.replace(/\*\*(.+?)\*\*/g,"<strong>$1</strong>")}></p>
  <div style="margin-top:22px;display:flex;flex-direction:column;gap:16px">
    {d.recheck.rows.map(r => (
      <div class="one" style={r.key ? "border-left-color:var(--accent)" : ""}>
        <div class="lab">{r.lab}</div>
        <p style="margin-top:8px" set:html={r.text.replace(/\*\*(.+?)\*\*/g,"<strong>$1</strong>")}></p>
      </div>
    ))}
  </div>
</section>

<section class="blk">
  <h2>{d.newfound.heading}</h2>
  <p class="dek" style="margin-top:8px" set:html={_md(d.newfound.lead)}></p>
  <div style="margin-top:20px;display:flex;flex-direction:column;gap:16px">
    {d.newfound.rows.map(r => (
      <div class="one" style={r.key ? "border-left-color:var(--accent)" : ""}>
        <div class="lab">{r.lab}</div>
        <p style="margin-top:8px" set:html={_md(r.text)}></p>
      </div>
    ))}
  </div>
</section>
<Rule name="loom" label="The link list" />

<section class="blk">
  <h2>{d.resources.heading}</h2>
  <p class="dek" style="margin-top:8px" set:html={_md(d.resources.lead)}></p>
  {d.resources.groups.map(([g, items]) => (
    <div style="margin-top:24px">
      <div class="lab">{g}</div>
      <ul class="prose" style="display:block;margin-top:8px">
        {items.map(([t, href, why]) => (
          <li style="margin:.5em 0"><a href={href} rel="noopener">{t}</a>{why ? <> — {why}</> : null}</li>
        ))}
      </ul>
    </div>
  ))}
</section>

<section class="blk">
  <div class="one" style="border-left-color:var(--accent)">
    <div class="lab">The verdict</div>
    <p style="margin-top:8px"><strong>{d.verdict}</strong></p>
  </div>
</section>

<Sources ids={["dfcom", "familysearch", "dapa", "blasonario", "istrianet"]} />
</Base>
