<style>
  /* the numbers, before any of the prose */
  .sfigs { list-style:none; margin:0; padding:0; display:grid; gap:12px;
           grid-template-columns:repeat(auto-fit,minmax(165px,1fr)); }
  .sfigs li { border-top:3px solid var(--accent,#8a7a52); padding:10px 0 0;
              display:flex; flex-direction:column; gap:3px; }
  .sfn { font-family:var(--mono); font-size:24px; font-weight:600; color:var(--ink); line-height:1.05; }
  .sfw { font-size:13.5px; font-weight:600; color:var(--ink); }
  .sfs { font-size:12px; color:var(--dim); line-height:1.5; }

  /* twenty-two sections is too many to scroll blind */
  .stoc { display:grid; gap:16px; grid-template-columns:repeat(auto-fit,minmax(215px,1fr));
          margin-top:12px; }
  .sact { border-left:3px solid var(--accent-wash,#e8e2d4); padding-left:12px; }
  .sath { margin:0 0 6px; font-size:12px; letter-spacing:.06em; text-transform:uppercase;
          color:var(--dim); display:flex; align-items:baseline; gap:7px; }
  .satn { font-family:var(--mono); color:var(--accent,#8a7a52); font-size:13px; }
  .sact ul { list-style:none; margin:0; padding:0; display:grid; gap:4px; }
  .sact li a { font-size:13.5px; line-height:1.45; text-decoration:none;
               border-bottom:1px solid transparent; }
  .sact li a:hover { border-bottom-color:var(--accent,#8a7a52); }

  /* the arc */
  .arc { margin:22px 0 0; }
  .arc svg { width:100%; height:auto; display:block; overflow:visible; }
  .aax { stroke:var(--ink,#222); stroke-width:1.5; }
  .atick { stroke:var(--accent-wash,#c9c2b2); stroke-width:1.5; }
  .ayr { font-family:var(--mono); font-size:11px; fill:var(--dim); }
  .aband { fill:var(--accent-wash,#f0ebdd); stroke:var(--accent,#8a7a52);
           stroke-width:1; stroke-dasharray:4 3; rx:3; }
  .abl { font-family:var(--mono); font-size:12px; font-weight:600; fill:var(--accent,#8a7a52); }
  .alead { stroke:var(--accent-wash,#d8d2c4); stroke-width:1; }
  .adot { fill:var(--panel,#fff); stroke:var(--ink,#222); stroke-width:2; }
  .akey { fill:var(--terra,#a6412f); stroke:var(--terra,#a6412f); }
  .aml { font-family:var(--mono); font-size:12px; font-weight:600; fill:var(--ink); }
  .amt { font-size:11px; fill:var(--dim); }
  .arc figcaption { margin-top:14px; border-top:2px solid var(--accent-wash,#e8e2d4); padding-top:12px; }
  .abh { margin:0 0 8px; font-weight:700; font-size:14.5px; color:var(--ink); }
  /* Four items of very different lengths in an auto-fit grid produced four
     ragged columns with a hole under the shortest. Two columns, and a fixed
     year gutter so the dates line up down the page. */
  .aburst { list-style:none; margin:0; padding:0; display:grid; gap:10px 28px;
            grid-template-columns:repeat(auto-fit,minmax(340px,1fr)); }
  .aburst li { display:grid; grid-template-columns:52px 1fr; gap:12px;
               align-items:baseline; font-size:13.5px; line-height:1.55; }
  .aburst b { font-family:var(--mono); color:var(--accent,#8a7a52); font-weight:600; }
  .aburst span { color:var(--dim); }

  section[id] { scroll-margin-top:18px; }

  /* WIDE TABLES. David: "cant we give tables like this more real estate so they
     are wide, not long?" The wrap is 1080px and a three-column table with a
     long prose column in it wraps to five lines a row inside that. This breaks
     the table out of the measure and centres it on the viewport instead, which
     turns height into width. Capped so it never runs edge to edge, and it
     collapses back to the column on anything narrow. */
  .scroll.wide {
    width: min(calc(100vw - 40px), 1340px);
    margin-left: 50%;
    transform: translateX(-50%);
  }
  .scroll.wide table { font-size: 14.5px; }
  .scroll.wide td { padding: 12px 20px 12px 0; line-height: 1.6; }
  @media (max-width: 1120px) {
    .scroll.wide { width: auto; margin-left: 0; transform: none; }
  }

  @media (max-width:760px) {
    .amt { font-size:13px; }
    .ayr { font-size:13px; }
    .aml { font-size:14px; }
  }
</style>
