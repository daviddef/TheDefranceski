---
import Base from "../layouts/Base.astro";
import Rule from "../components/Rule.astro";
import { u } from "../lib/url.js";
import j from "../data/julius.json";
const md = (x) => String(x ?? "")
  .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
  .replace(/«(.+?)»/g, "<em>«$1»</em>")
  .replace(/(^|[^*])\*([^*\n]+?)\*/g, "$1<em>$2</em>");
---
<Base title={j.title} eyebrow={j.eyebrow} dek={j.dek}>

  <section class="prose">{j.lede.map(p => <p set:html={md(p)} />)}</section>

  <div class="jf">
    {j.facts.map(f => (
      <div class="jf-i">
        <div class="jf-k">{f.k}</div>
        <div class="jf-v">{f.v}</div>
        <div class="jf-s">{f.s}</div>
      </div>
    ))}
  </div>

  <Rule name="arrows" label="Twenty-four years, list by list" />

  <ol class="jc">
    {j.career.map(r => (
      <li class={"jc-r" + (r.key ? " key" : "")}>
        <div class="jc-w">{r.when}</div>
        <div class="jc-b">
          <p class="jc-t" set:html={md(r.what)}></p>
          <p class="jc-c">{r.cite}</p>
        </div>
      </li>
    ))}
  </ol>

  <Rule name="arrows" label={j.trapp.heading} />
  <div class="one" style="border-left-color:var(--ochre)">
    {j.trapp.text.split("\n\n").map(p => <p set:html={md(p)} />)}
  </div>

  <Rule name="arrows" label="What these lists cannot say" />
  <ul class="ju">
    {j.unknown.map(x => <li set:html={md(x)}></li>)}
  </ul>

  <Rule name="arrows" label="The apparatus" />
  <p class="cap" set:html={md(j.citenote)}></p>
  <div class="jcite">
    {j.cites.map(c => (
      <div class="jci">
        <span class={"jci-t " + c.t.toLowerCase()}>{c.t}</span>
        <span class="jci-d">{c.d}</span>
        <span class="jci-p">pp. {c.pg.join(", ")}</span>
      </div>
    ))}
  </div>

  <div class="doors" style="margin-top:30px">
    <a class="door" href={u("/rijeka/")}>
      <div class="dn">The Kvarner households</div>
      <div class="dd">The nine households at Rijeka and Bakar, and the harbour master, salt-office draughtsman and naval officers the Hungarian records name beside them.</div>
      <div class="go">Where he probably belongs →</div>
    </a>
    <a class="door" href={u("/sources/")}>
      <div class="dn">Hungaricana</div>
      <div class="dd">Free, unblocked, full-text — and the reason Fiume and Bakar have to be searched in Hungarian paperwork rather than Austrian or Croatian.</div>
      <div class="go">The source →</div>
    </a>
  </div>

</Base>

<style>
.jf{display:grid;grid-template-columns:repeat(auto-fill,minmax(212px,1fr));gap:10px;margin-top:26px}
.jf-i{border:1px solid var(--rule);border-top:2px solid var(--accent);border-radius:2px;
  padding:13px 15px 14px}
.jf-k{font-family:var(--sans);font-size:10px;font-weight:600;letter-spacing:.14em;
  text-transform:uppercase;color:var(--ink-3)}
.jf-v{font-family:var(--serif);font-size:22px;line-height:1.2;margin-top:5px;color:var(--ink);
  font-variant-numeric:tabular-nums}
.jf-s{font-family:var(--sans);font-size:11.5px;line-height:1.5;color:var(--ink-3);margin-top:7px}

.jc{list-style:none;margin:22px 0 0;padding:0}
.jc-r{display:flex;gap:0;align-items:flex-start}
.jc-w{flex:none;width:150px;padding:13px 14px 0 0;text-align:right;
  font-family:var(--mono);font-size:11.5px;color:var(--ink-3);line-height:1.4;
  font-variant-numeric:tabular-nums}
.jc-b{flex:1;min-width:0;border-left:2px solid var(--rule-strong);padding:11px 0 20px 20px;position:relative}
.jc-r.key .jc-b{border-left-color:var(--accent)}
.jc-b::before{content:"";position:absolute;left:-7px;top:16px;width:12px;height:12px;border-radius:50%;
  background:var(--ground);border:2px solid var(--rule-strong)}
.jc-r.key .jc-b::before{border-color:var(--accent);background:var(--accent)}
.jc-t{font-family:var(--sans);font-size:14px;line-height:1.65;color:var(--ink-2);margin:0;max-width:80ch}
.jc-c{font-family:var(--mono);font-size:10.5px;line-height:1.5;color:var(--ink-3);margin:9px 0 0}

.ju{margin:18px 0 0;padding-left:20px;max-width:84ch}
.ju li{font-family:var(--sans);font-size:14px;line-height:1.68;color:var(--ink-2);margin-bottom:11px}

.jcite{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:5px 18px;margin-top:16px}
.jci{display:flex;align-items:baseline;gap:9px;font-family:var(--mono);font-size:11px;
  color:var(--ink-3);font-variant-numeric:tabular-nums}
.jci-t{flex:none;font-size:9px;font-weight:700;letter-spacing:.08em;border:1px solid var(--rule-strong);
  border-radius:2px;padding:1px 5px}
.jci-t.rl{color:var(--accent);border-color:var(--accent)}
.jci-t.sch{color:var(--ochre);border-color:var(--ochre)}
.jci-d{flex:none;width:76px}
.jci-p{min-width:0}

@media (max-width:640px){ .jc-w{width:96px;font-size:10.5px} }
</style>
