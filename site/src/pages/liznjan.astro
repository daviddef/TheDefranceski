---
import Base from "../layouts/Base.astro";
import Locator from "../components/Locator.astro";
import Cluster from "../components/Cluster.astro";
import cl from "../data/clusters.json";
import Rule from "../components/Rule.astro";
import Sources from "../components/Sources.astro";
import { u } from "../lib/url.js";
import d from "../data/liznjan.json";
import { mdHtml } from "../lib/md.js";
import Plates from "../components/Plates.astro";
---
<Base title="Ližnjan" eyebrow="Third of eighteen towns, and no page until now" dek={d.note}>


  <section class="blk">
    <div class="lab">The family drawn as what it is</div>
    <h2 style="font-size:30px;margin:6px 0 4px">Nine households, two hundred and twenty-four years, and no join at all</h2>
    <Cluster c={cl.clusters.southistria} />
  </section>

  <Locator place="Ližnjan" radius={16}
            note="Southern Istria. Svetvinčenat, where the 1628 baptism was read, is thirty kilometres north." />


<section class="blk">
  <h2>{d.grga.heading}</h2>
  <p class="dek" style="margin-top:8px">{d.lead}</p>
  <div style="margin-top:20px;display:flex;flex-direction:column;gap:16px">
    {d.grga.rows.map(r => (
      <div class="one" style={r.key ? "border-left-color:var(--accent)" : ""}>
        <div class="lab">{r.lab}</div>
        <p style="margin-top:8px" set:html={mdHtml(r.text)}></p>
      </div>
    ))}
  </div>
  <p class="cap" style="margin-top:14px" set:html={mdHtml(d.grga.source_g)}></p>
</section>
<Rule name="tablet" label="And what cannot be shown" />

<section class="blk">
  <h2>{d.monheim.heading}</h2>
  <div style="margin-top:20px;display:flex;flex-direction:column;gap:16px">
    {d.monheim.rows.map(r => (
      <div class="one" style={r.key ? "border-left-color:var(--ochre)" : ""}>
        <div class="lab">{r.lab}</div>
        <p style="margin-top:8px" set:html={mdHtml(r.text)}></p>
      </div>
    ))}
  </div>
  <p class="prose note" style="margin-top:22px">{d.why}</p>
  <p class="cap" style="margin-top:14px">
    The pin came off <a href={u("/old-site/")}>defranceski.com</a>, archived before it is switched off.
    Ante Defrančeski, the teacher, was born in this village on 1 February 1894 —
    <a href={u("/people/ante-defranceski/")}>his life is here</a>.
  </p>
</section>
<Rule name="helm" label="Zagreb" />
<section class="blk">
  <h2>{d.zagreb.heading}</h2>
  <p class="dek" style="margin-top:8px">{d.zagreb.lead}</p>
  <div style="margin-top:20px;display:flex;flex-direction:column;gap:16px">
    {d.zagreb.rows.map(r => (
      <div class="one" style={r.key ? "border-left-color:var(--accent)" : ""}>
        <div class="lab">{r.lab}</div>
        <p style="margin-top:8px" set:html={mdHtml(r.text)}></p>
      </div>
    ))}
  </div>
  <p class="cap" style="margin-top:14px" set:html={mdHtml(d.zagreb.source_z)}></p>
</section>

<Rule name="helm" label="A document from the family" />

<section class="blk">
  <h2 id="smrtnilist">{d.smrtnilist.heading}</h2>
  <p class="dek" style="margin-top:8px" set:html={mdHtml(d.smrtnilist.lead)}></p>
  <div style="margin-top:20px;display:flex;flex-direction:column;gap:16px">
    {d.smrtnilist.rows.map(r => (
      <div class="one" style={r.key ? "border-left-color:var(--accent)" : ""}>
        <div class="lab">{r.lab}</div>
        <p style="margin-top:8px" set:html={mdHtml(r.text)}></p>
      </div>
    ))}
  </div>
  <div style="margin-top:24px"><Plates ids={d.smrtnilist.plates} cols={1} /></div>
  <p class="cap" style="margin-top:14px" set:html={mdHtml(d.smrtnilist.source_s)}></p>
</section>


<Rule name="arrows" label="Southern Istria" />

<section class="blk">
  <h2>{d.southistria.heading}</h2>
  <p class="dek" style="margin-top:8px" set:html={mdHtml(d.southistria.lead)}></p>
  <div style="margin-top:22px;display:flex;flex-direction:column;gap:16px">
    {d.southistria.rows.map(r => (
      <div class="one" style={r.key ? "border-left-color:var(--accent)" : ""}>
        <div class="lab">{r.lab}</div>
        <p style="margin-top:8px" set:html={mdHtml(r.text)}></p>
      </div>
    ))}
  </div>
  <p class="cap" style="margin-top:16px" set:html={mdHtml(d.southistria.source_si)}></p>
</section>

<Rule name="arrows" label="What the evidence is" />

<section class="blk">
  <h2>{d.registers.heading}</h2>
  <p class="dek" style="margin-top:8px" set:html={mdHtml(d.registers.lead)}></p>
  <div style="margin-top:22px;display:flex;flex-direction:column;gap:16px">
    {d.registers.rows.map(r => (
      <div class="one" style={r.key ? "border-left-color:var(--accent)" : ""}>
        <div class="lab">{r.lab}</div>
        <p style="margin-top:8px" set:html={mdHtml(r.text)}></p>
      </div>
    ))}
  </div>
  <div style="margin-top:24px"><Plates ids={d.registers.plates} cols={1} /></div>
  <p class="cap" style="margin-top:16px" set:html={mdHtml(d.registers.source_si)}></p>
</section>

<Rule name="arrows" label="Medulin · her eight children" />

<section class="blk">
  <h2 id="medulin">{d.medulin.heading}</h2>
  <p class="dek" style="margin-top:8px" set:html={mdHtml(d.medulin.lead)}></p>
  <div style="margin-top:22px;display:flex;flex-direction:column;gap:16px">
    {d.medulin.rows.map(r => (
      <div class="one" style={r.key ? "border-left-color:var(--accent)" : ""}>
        <div class="lab">{r.lab}</div>
        <p style="margin-top:8px" set:html={mdHtml(r.text)}></p>
      </div>
    ))}
  </div>
  <p class="cap" style="margin-top:16px" set:html={mdHtml(d.medulin.source_m)}></p>
</section>

<Rule name="arrows" label="Pomer · where she came from" />

<section class="blk">
  <h2 id="pomer">{d.pomer.heading}</h2>
  <p class="dek" style="margin-top:8px" set:html={mdHtml(d.pomer.lead)}></p>
  <div style="margin-top:22px;display:flex;flex-direction:column;gap:16px">
    {d.pomer.rows.map(r => (
      <div class="one" style={r.key ? "border-left-color:var(--accent)" : ""}>
        <div class="lab">{r.lab}</div>
        <p style="margin-top:8px" set:html={mdHtml(r.text)}></p>
      </div>
    ))}
  </div>
  {d.pomer.plates && (
    <div style="margin-top:24px">
      <h3 style="margin:0 0 6px">The pages themselves</h3>
      <p class="cap" style="margin:0 0 12px">Thirty-six pages — whole pages, and strips of four Ližnjan pages — of the Pomer books, of the Pula book that followed one of their families, and of the Ližnjan registers behind it, so the column headings and the neighbouring lines stand with each entry. Each one links to the same image on FamilySearch (a free account is needed).</p>
      <Plates ids={d.pomer.plates} cols={1} />
    </div>
  )}
  <p class="cap" style="margin-top:16px" set:html={mdHtml(d.pomer.source_p)}></p>
</section>

<Rule name="arrows" label="Who did the spelling" />

<section class="blk">
  <h2 id="decrees">{d.decrees.heading}</h2>
  <p class="dek" style="margin-top:8px" set:html={mdHtml(d.decrees.lead)}></p>
  <div style="margin-top:22px;display:flex;flex-direction:column;gap:16px">
    {d.decrees.rows.map(r => (
      <div class="one" style={r.key ? "border-left-color:var(--accent)" : ""}>
        <div class="lab">{r.lab}</div>
        <p style="margin-top:8px" set:html={mdHtml(r.text)}></p>
      </div>
    ))}
  </div>
  <p class="cap" style="margin-top:16px" set:html={mdHtml(d.decrees.source_d)}></p>
</section>

<Sources ids={["familysearch", "dapa", "dfcom"]} />
</Base>
