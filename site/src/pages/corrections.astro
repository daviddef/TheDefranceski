---
import Base from "../layouts/Base.astro";
import Corrections from "@daviddef/archive-kit/components/Corrections.astro";
import Rule from "../components/Rule.astro";
import { u, based } from "../lib/url.js";
import { linkParts } from "../lib/exists.js";
import c from "../data/corrections.json";
import { mdHtml, mdpHtml } from "../lib/md.js";
const sev = { serious: "Serious", minor: "Minor", process: "Process", note: "Not ours" };
const order = ["serious", "process", "minor", "note"];
const rows = [...c.rows].sort((a, b) => order.indexOf(a.sev) - order.indexOf(b.sev));
const counts = Object.fromEntries(order.map(k => [k, c.rows.filter(r => r.sev === k).length]));
---
<Base title="Corrections"
      eyebrow={`${c.rows.length} entries · ${counts.serious} serious`}
      dek="Every claim this archive has published and then had to take back.">

<section class="blk">
  <p class="prose note" set:html={based(mdHtml(c.note))}></p>
</section>

<Rule name="arrows" label="The list" />

<section class="blk">
  <Corrections u={u} rows={rows.map(r => ({
    when: r.when,
    kind: r.what,
    sev: sev[r.sev] || r.sev,
    was: based(mdHtml(r.said)),
    now: based(mdHtml(r.true)),
    how: based(mdHtml(r.how)),
    /* 231 rows, and the shape drifted: 205 are written said/true/how, but 26 —
       every one added since late September — carry a single narrative `note`
       instead, and this page rendered none of it. They published as a title
       with an empty body. `why` is the component's only unlabelled prose slot,
       which is what a narrative note is. Found 9 October 2026 by grepping the
       BUILT page for a correction's own text and getting nothing back. */
    why: r.note ? based(mdpHtml(r.note)) : "",
    extra: r.where
      /* A «where» part is sometimes a bare path, sometimes a markdown link,
         and sometimes a sentence with links and code spans inside it —
         «[Households](/households/) — `households.json`, entries [h107]…».
         linkParts resolves the first two; the rest has to go through the
         renderer or it prints as punctuation, which is how 77 literal links
         came to be sitting in this footer. */
      ? " · Corrected in place: " + linkParts(r.where).map(x =>
          x.href ? `<a href="${u(x.href)}">${x.text}</a>` : mdHtml(x.text)).join(" · ")
      : "",
  }))} />
</section>

<Rule name="pomegranate" />
<section class="blk">
  <p class="prose note">Corrections are made on the page where the claim was made, under the original wording, rather than by deleting it. This page is the index to them, not a substitute. The running log of every search, including the ones that found nothing, is in <a href={u("/research-log/")}>the Search Register</a>.</p>
</section>

<style>
  .corr { border: 1px solid var(--rule, #dcd6cc); border-left-width: 4px; border-radius: 3px; padding: 20px 22px; }
  .sev-serious { border-left-color: var(--terra, #a5442c); }
  .sev-process { border-left-color: #8a7f5c; }
  .sev-minor   { border-left-color: var(--rule, #dcd6cc); }
  .sev-note    { border-left-color: transparent; opacity: .88; }
  .chead { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .tag { font-size: 10.5px; letter-spacing: .1em; text-transform: uppercase; padding: 3px 8px;
         border: 1px solid currentColor; border-radius: 2px; opacity: .75; }
  .sev-serious .tag { color: var(--terra, #a5442c); opacity: 1; }
  .when { font-size: 12px; opacity: .6; }
  .chead h3 { flex: 1 1 100%; margin: 6px 0 0; font-size: 21px; line-height: 1.25; }
  dl { margin: 16px 0 0; display: grid; grid-template-columns: minmax(0,150px) 1fr; gap: 10px 22px; }
  dt { font-size: 11px; letter-spacing: .09em; text-transform: uppercase; opacity: .6; padding-top: 3px; }
  dd { margin: 0; font-size: 15.5px; line-height: 1.68; }
  .corr .cap { margin-top: 16px; }
  @media (max-width: 640px) { dl { grid-template-columns: 1fr; gap: 4px; } dt { margin-top: 10px; } }
</style>
</Base>
