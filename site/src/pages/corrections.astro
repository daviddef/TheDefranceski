---
import Base from "../layouts/Base.astro";
import Corrections from "@daviddef/archive-kit/components/Corrections.astro";
import Rule from "../components/Rule.astro";
import { u, based } from "../lib/url.js";
import { linkParts } from "../lib/exists.js";
import c from "../data/corrections.json";
import plateTable from "../data/plates.json";
import { claim } from "@daviddef/archive-kit/lib/rec.js";
import { corrIdMap } from "@daviddef/archive-kit/lib/corrections.js";
import { bookIndex } from "@daviddef/archive-kit/lib/booklinks.js";
import { placeIndex } from "@daviddef/archive-kit/lib/placelinks.js";
import pb from "../data/parishbooks.json";
import placeRows from "../data/places.json";
import placeFlags from "../data/place-flags.json";
import { mdHtml, mdpHtml, plain } from "../lib/md.js";
/* 12 November 2026: corrections.json used twelve severity words and this page knew four, so 101 rows printed a raw word and sorted
   above the rest. scripts/vocab.py rewrote them to these five (three degrees, and two kinds that are not a degree); the original
   word stays in each row's sevWas. The gate refuses a sixth. */
/* the kit marks the most serious degree with a "material" chip; it compared the row's label with its own default word "major", which
   only the 36 rows still written «major» ever matched. `major` is now this page's word for the top degree, so all of them carry it. */
const sev = { serious: "Serious", moderate: "Moderate", minor: "Minor", process: "Process", note: "Not ours" };
/* What became of the problem, apart from how bad it was (corrections.json `status`, set by scripts/vocab.py from the rows once written
   «fixed» and «struck» in the severity column). The kit's Corrections has no slot for it, so it rides in `who`, the header's
   HTML slot, which this page does not otherwise use. */
const status = { fixed: "Fixed", struck: "Struck" };
const statusChip = (r) => status[r.status] ? `<span class="chip cx-status cx-status-${r.status}">${status[r.status]}</span>` : "";
const order = ["serious", "moderate", "process", "minor", "note"];
/* 18 November 2026 (kit pin eb8ce42, kit/docs/corrections.md): this page no longer sorts the rows. It used to put the serious ones first, which scattered
   the dates; the kit's Corrections now sorts newest first itself (sort="date"), and rows on one day keep the order of the file. */
const rows = c.rows;
/* the anchor of each entry (c-<day>-<hash of the headline>), from the SAME rows in FILE order that src/lib/pulse.js hands buildPulse as `corrections`, so a
   card on /whats-new/ lands on its entry. */
const ids = corrIdMap(c.rows);
/* the kit puts every internal address through `u`, and the Sources chip of a plate link is the in-page anchor "#plate-<id>": based, it became "/#plate-<id>"
   (the kit's anchors gate found 28 of them pointing at the home page). An anchor stays an anchor. */
const uh = (p) => String(p).startsWith("#") ? p : u(p);
/* the archive's catalogue of register books (parishbooks.json), so "the Svetvinčenat baptism book 1764-1791" in a correction links to that volume's
   FamilySearch image; a volume with no ark is left out. */
const arkOf = (parish, label) => { const a = pb.links?.[parish]?.[label]?.ark; return a ? `https://www.familysearch.org/ark:/61903/${a}` : ""; };
const books = bookIndex(pb.list.flatMap((p) => (p.books || []).map((b) => ({ parish: p.parish, label: b, href: arkOf(p.parish, b) }))));
/* a place named in a correction links to its page, with the flag of the state that held it in the year the sentence names (the kit's placeIndex; the
   table, src/data/place-flags.json, is made in the build by scripts/build-place-flags.py from the era snapshot and the kit's regime table). The
   flag art is the kit's own, resolved by the build. No name index is read here: the names on this page are linked after the build (autolink). */
const FLAG_ART = import.meta.glob("../../node_modules/@daviddef/archive-kit/kit/data/flags/*.svg", { eager: true, query: "?url", import: "default" });
const flagUrl = (svg) => { const k = Object.keys(FLAG_ART).find((p) => p.endsWith("/" + svg)); return k ? FLAG_ART[k] : ""; };
const places = placeIndex(placeRows.map((p) => ({ name: p.name, aliases: Object.values(p.alt || {}), href: u(`/places/${p.slug}/`) })), placeFlags, flagUrl);
/* A scan beside the passage that cites it (the linking standard, L4). A correction that rests on a page of the family's own copy
   of a parish register carries that plate, a small picture inside the entry, linked to the full file; the plate is already
   published (components/Plates.astro, /gallery/), and the words that cite it link here (md.js, [words](rec:plate-<id>)).
   Inline markup only: the kit draws the body fields inside <p>, where a <figure> is not allowed. One anchor id per plate
   per page (the kit's claim()). */
const esc = (x) => String(x ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
const thumbs = (ids) => (ids || []).map((id) => {
  const p = plateTable.find((x) => x.id === id);
  if (!p || !p.thumb) throw new Error(`corrections.json: plate ${id} is not a plate with a picture`);
  const anchor = claim(Astro.request, "plate-" + id) ? ` id="plate-${esc(id)}"` : "";
  return `<span class="cx-plate"><a class="cx-plate-img"${anchor} href="${esc(u(p.src))}"><img src="${esc(u(p.thumb))}" alt="${esc(p.title)}"` +
    `${p.w ? ` width="${p.w}"` : ""}${p.h ? ` height="${p.h}"` : ""} loading="lazy" decoding="async"></a>` +
    `<span class="cx-plate-cap">The register page itself, from the family's copy of the film</span></span>`;
}).join("");
const counts = Object.fromEntries(order.map(k => [k, c.rows.filter(r => r.sev === k).length]));
---
<Base title="Corrections"
      eyebrow={`${c.rows.length} entries · ${counts.serious} serious`}
      dek="Every claim this archive has published and then had to take back.">

<section class="blk">
  <p class="prose note" set:html={based(mdHtml(c.note))}></p>
</section>

<Rule name="arrows" label="The list" />

<section class="blk">
  <Corrections u={uh} major="Serious" books={books} places={places} rows={rows.map(r => ({
    id: ids.get(r),
    about: r.for,
    when: r.when,
    kind: plain(r.what),
    who: statusChip(r),
    sev: sev[r.sev] || r.sev,
    /* The sentence being withdrawn, kept verbatim: its names are the old claim, quoted, not this archive's claim now. The mark is the
       linking standard's own (data-name-exempt, with its reason); the links stay, only L2 and L5 do not count the names inside it. */
    was: r.said ? `<span data-name-exempt="the sentence being withdrawn, kept verbatim: its names are the old claim, quoted">${based(mdHtml(r.said))}</span>` : "",
    now: based(mdHtml(r.true)),
    how: based(mdHtml(r.how)) + (r.how ? thumbs(r.plates) : ""),
    /* 231 rows, and the shape drifted: 205 are written said/true/how, but 26 —
       every one added since late September — carry a single narrative `note`
       instead, and this page rendered none of it. They published as a title
       with an empty body. `why` is the component's only unlabelled prose slot,
       which is what a narrative note is. Found 9 October 2026 by grepping the
       BUILT page for a correction's own text and getting nothing back. */
    why: r.note ? based(mdpHtml(r.note)) + (!r.how ? thumbs(r.plates) : "") : (!r.how && r.plates ? thumbs(r.plates) : ""),
    extra: r.where
      /* A «where» part is sometimes a bare path, sometimes a markdown link,
         and sometimes a sentence with links and code spans inside it —
         «[Households](/households/) — `households.json`, entries [h107]…».
         linkParts resolves the first two; the rest has to go through the
         renderer or it prints as punctuation, which is how 77 literal links
         came to be sitting in this footer. */
      ? " · Corrected in place: " + linkParts(r.where).map(x =>
          x.href ? `<a href="${u(x.href)}">${x.text}</a>` : mdHtml(x.text)).join(" · ")
      : "",
  }))} />
</section>

<Rule name="pomegranate" />
<section class="blk">
  <p class="prose note">Corrections are made on the page where the claim was made, under the original wording, rather than by deleting it. This page is the index to them, not a substitute. The running log of every search, including the ones that found nothing, is in <a href={u("/searched/")}>the Search Register</a>.</p>
</section>

<style is:global>
  .cx-status { font-size: .72rem; letter-spacing: .04em; text-transform: uppercase; background: transparent; border: 1px solid currentColor; }
  .cx-status-fixed { color: #4f7a4f; }
  .cx-status-struck { color: #7a7a7a; text-decoration: line-through; }
  .cx-plate { display: block; margin: 12px 0 4px; max-width: 14rem; }
  .cx-plate-img { display: block; }
  .cx-plate img { display: block; width: 100%; height: auto; }
  .cx-plate-cap { display: block; font-size: 12px; line-height: 1.4; opacity: .7; margin-top: 4px; }
</style>
<style>

  .corr { border: 1px solid var(--rule, #dcd6cc); border-left-width: 4px; border-radius: 3px; padding: 20px 22px; }
  .sev-serious { border-left-color: var(--terra, #a5442c); }
  .sev-moderate { border-left-color: #b8895a; }
  .sev-process { border-left-color: #8a7f5c; }
  .sev-minor   { border-left-color: var(--rule, #dcd6cc); }
  .sev-note    { border-left-color: transparent; opacity: .88; }
  .chead { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .tag { font-size: 10.5px; letter-spacing: .1em; text-transform: uppercase; padding: 3px 8px;
         border: 1px solid currentColor; border-radius: 2px; opacity: .75; }
  .sev-serious .tag { color: var(--terra, #a5442c); opacity: 1; }
  .when { font-size: 12px; opacity: .6; }
  .chead h3 { flex: 1 1 100%; margin: 6px 0 0; font-size: 21px; line-height: 1.25; }
  dl { margin: 16px 0 0; display: grid; grid-template-columns: minmax(0,150px) 1fr; gap: 10px 22px; }
  dt { font-size: 11px; letter-spacing: .09em; text-transform: uppercase; opacity: .6; padding-top: 3px; }
  dd { margin: 0; font-size: 15.5px; line-height: 1.68; }
  .corr .cap { margin-top: 16px; }
  @media (max-width: 640px) { dl { grid-template-columns: 1fr; gap: 4px; } dt { margin-top: 10px; } }
</style>
</Base>
