---
import Base from "../../layouts/Base.astro";
import Rule from "../../components/Rule.astro";
import { u } from "../../lib/url.js";
import d from "../../data/dossiers.json";
import artsrc from "../../data/art-src.json";
import port from "../../data/portraits.json";
import Lightbox from "../../components/Lightbox.astro";
export function getStaticPaths() {
  return Object.values(d.people).map(p => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const byPage = {};
for (const h of p.hits) { (byPage[h.title] ||= { page: h.page, hits: [] }).hits.push(h); }
const groups = Object.entries(byPage);
const art = Object.fromEntries(artsrc.map(a => [a.id, a]));
const md = (x) => String(x ?? "").replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>").replace(/\*(.+?)\*/g, "<em>$1</em>").replace(/«(.+?)»/g, "<em>«$1»</em>");
const pt = port.map[p.slug];
const VIAW = { line: "the archive\u2019s own line", read: "a register read here", index: "a FamilySearch index entry", tree: "the family tree, unverified" };
const pics = pt ? pt.ids.map(i => art[i]).filter(Boolean) : [];
const pdata = pics.map(a => ({ id: a.id, title: a.desc || a.file.replace(/^File:/, ""),
  caption: [a.artist, a.date && a.date.slice(0,10), a.licence].filter(Boolean).join(" · "),
  holder: a.licence, w: a.w, h: a.h, src: u(a.src), thumb: u(a.thumb) }));
---
<Base title={p.name} eyebrow={`${p.n} mention${p.n === 1 ? "" : "s"} · ${p.pages.length} page${p.pages.length === 1 ? "" : "s"}`}
      dek={`Everything this archive holds under this name, gathered from every page of the site.`}>

{pics.length > 0 && (
<section class="blk">
  <div class="pgal" data-plates={JSON.stringify(pdata)}>
    {pdata.map((a, i) => (
      <button class="plate" type="button" data-i={i}>
        <img class="shot" src={a.thumb} alt={a.title} width={a.w} height={a.h} loading="lazy" decoding="async" />
      </button>
    ))}
  </div>
  <p class="pcap">
    <span class="lab">Whose face this is</span>
    {pt.whose}{pt.note && <> <strong>{pt.note}</strong></>}
    {" "}Licences and holders on <a href={u("/namesakes/")}>Namesakes</a>.
  </p>
</section>
)}

{(p.facts && p.facts.length > 0) && (
<section class="blk">
  <div class="facts">
    {p.facts.map(([k, v, href]) => (<div class="fact"><span class="fk">{k}</span><span class="fv">{href ? <a href={u(href)}>{v}</a> : v}</span></div>))}
  </div>
  {p.known && (
    <div class="known">
      <div class="lab">What the archive knows</div>
      <p set:html={md(p.known)}></p>
      {p.more && p.more.map(x => (<p style="margin-top:10px" set:html={md(x)}></p>))}
    </div>
  )}
</section>
)}

{(!p.ptree && p.rec) && (
<Rule name="arrows" label="The record itself" />
<section class="blk">
  <figure class="recstrip">
    <div class="rs-lab">This archive has not placed this name in a household. What it does have is one indexed entry.</div>
    <div class="rs-row">
      <span class="pnode me"><span class="nm">{p.name}</span>
        {p.rec.says && <span class="dt">{p.rec.says}</span>}
        {p.rec.place && <span class="via gen">{p.rec.place}</span>}</span>
      {p.rec.others.length > 0 && <span class="rs-and">named on the same record</span>}
      {p.rec.others.map(o => (
        o.slug
          ? <a class="pnode via-index" href={u(`/who/${o.slug}/`)}><span class="nm">{o.n}</span><span class="via">also in this archive</span></a>
          : <span class="pnode via-index"><span class="nm">{o.n}</span><span class="via">named here only</span></span>
      ))}
    </div>
    <figcaption>
      <p class="warn"><strong>This is a record, not a family.</strong> The index names these people on one page and does not
      say how they are related — a parent, a spouse and a godparent look identical here. Nothing above has been joined to anything.</p>
      <p class="cap" style="margin-top:10px">
        <a href={p.rec.url} rel="noopener">FamilySearch <span class="mono">{p.rec.id}</span> →</a> ·
        <a href={u(`/register/?q=${encodeURIComponent(p.name)}`)}>Every record naming {p.name} →</a>
      </p>
    </figcaption>
  </figure>
</section>
)}

{(!p.ptree && !p.rec) && (
<section class="blk">
  <div class="mt-warn drops"><strong>No family is drawn for this name, and no record stands behind it.</strong> This archive
  has not placed it in a household and holds no indexed entry for it — the name reached this project through a chart, a
  narrative source or the family tree, and everything it does hold is below.
  <a href={u(`/register/?q=${encodeURIComponent(p.name)}`)}>The Register</a> is where a record would appear if one turned up.</div>
</section>
)}

{(p.tree || p.chain) && (
<Rule name="arrows" label="Where this name sits" />
<section class="blk">
  {(p.chain && p.chain.length > 1) && (
    <div class="mt-note">
      <strong>These are not one man.</strong> This page gathers everyone recorded under the name, which is the archive's rule — so the {p.chain.length} positions below are {p.chain.length} different people who happen to share it{pt ? ", and none of them is necessarily the man in the pictures above" : ""}.
    </div>
  )}

  {(p.ptree && !p.ptree.none) && (
  <figure class="ptree">
    {p.ptree.parents && p.ptree.parents.length > 0 && (
      <div class="tier">
        <div class="tlab">Parents{p.ptree.parentsPlace ? <span class="tpl">{p.ptree.parentsPlace}</span> : null}</div>
        <div class="prow">{p.ptree.parents.map(x => (
          x.slug
            ? <a class={`pnode via-${x.via || "none"}`} href={u(`/who/${x.slug}/`)} title={`Known from: ${VIAW[x.via] || "no source recorded"}`}>
                <span class="nm">{x.n}</span>{x.dt && <span class="dt">{x.dt}</span>}<span class="via">{VIAW[x.via] || "no source recorded"}</span></a>
            : <span class={`pnode via-${x.via || "none"}`} title={`Known from: ${VIAW[x.via] || "no source recorded"}`}>
                <span class="nm">{x.n}</span>{x.dt && <span class="dt">{x.dt}</span>}<span class="via">{VIAW[x.via] || "no source recorded"}</span></span>
        ))}</div>
        <div class="drop" aria-hidden="true"></div>
      </div>
    )}
    <div class="tier self">
      <div class="prow">
        <span class="pnode me">
          <span class="nm">{p.ptree.self.n}</span>
          {p.ptree.self.dt && <span class="dt">{p.ptree.self.dt}</span>}
          {p.ptree.self.me
            ? <span class="via gen">this is David</span>
            : (p.ptree.self.rel && <span class="via gen">{p.ptree.self.rel}</span>)}
        </span>
        {p.ptree.spouse && (
          p.ptree.spouse.slug
            ? <a class={`pnode spouse via-${p.ptree.spouse.via || "none"}`} href={u(`/who/${p.ptree.spouse.slug}/`)}>
                <span class="mar">married</span><span class="nm">{p.ptree.spouse.n}</span>
                {p.ptree.spouse.dt && <span class="dt">{p.ptree.spouse.dt}</span>}</a>
            : <span class={`pnode spouse via-${p.ptree.spouse.via || "none"}`}>
                <span class="mar">married</span><span class="nm">{p.ptree.spouse.n}</span>
                {p.ptree.spouse.dt && <span class="dt">{p.ptree.spouse.dt}</span>}</span>
        )}
      </div>
    </div>
    {p.ptree.children && p.ptree.children.length > 0 && (
      <div class="tier">
        <div class="drop up" aria-hidden="true"></div>
        <div class="tlab">{p.ptree.children.length} {p.ptree.children.length === 1 ? "child" : "children"}
          {p.ptree.span ? <span class="tpl">recorded {p.ptree.span}</span> : null}</div>
        <div class="prow">{p.ptree.children.map(x => (
          x.slug
            ? <a class={`pnode via-${x.via || "none"}`} href={u(`/who/${x.slug}/`)} title={`Known from: ${VIAW[x.via] || "no source recorded"}`}>
                <span class="nm">{x.n}</span>{x.dt && <span class="dt">{x.dt}</span>}<span class="via">{VIAW[x.via] || "no source recorded"}</span></a>
            : <span class={`pnode via-${x.via || "none"}`}><span class="nm">{x.n}</span>{x.dt && <span class="dt">{x.dt}</span>}<span class="via">{VIAW[x.via] || "no source recorded"}</span></span>
        ))}</div>
      </div>
    )}
    {p.ptree.siblings && p.ptree.siblings.length > 0 && (
      <div class="tier sibs">
        <div class="tlab">{p.ptree.siblings.length} {p.ptree.siblings.length === 1 ? "brother or sister" : "brothers and sisters"}</div>
        <div class="prow">{p.ptree.siblings.map(x => (
          x.slug
            ? <a class={`pnode small via-${x.via || "none"}`} href={u(`/who/${x.slug}/`)} title={`Known from: ${VIAW[x.via] || "no source recorded"}`}>
                <span class="nm">{x.n}</span>{x.dt && <span class="dt">{x.dt}</span>}</a>
            : <span class={`pnode small via-${x.via || "none"}`}><span class="nm">{x.n}</span>{x.dt && <span class="dt">{x.dt}</span>}</span>
        ))}</div>
      </div>
    )}
    <figcaption>
      <span class="keys">
        <span class="key"><i class="sw line"></i> the archive's own line</span>
        <span class="key"><i class="sw read"></i> a register read here</span>
        <span class="key"><i class="sw index"></i> a FamilySearch index entry</span>
        <span class="key"><i class="sw tree"></i> the family tree, unverified</span>
      </span>
      {p.ptree.dupNames && p.ptree.dupNames.length > 0 && (
        <p class="warn"><strong>Two children here carry one name</strong> — {p.ptree.dupNames.join(", ")}.
        In these parishes that is usually not an error: <strong>a child who died was very often replaced by a later child given the same name</strong>.
        It is also exactly how an index invents one person out of two, so both are drawn.</p>
      )}
      {(p.ptree.upN > 1 || p.ptree.downN > 1) && (
        <p class="warn"><strong>This name sits in more than one household.</strong> {p.ptree.upN > 1 ? `${p.ptree.upN} sets of parents ` : ""}
        {p.ptree.upN > 1 && p.ptree.downN > 1 ? "and " : ""}{p.ptree.downN > 1 ? `${p.ptree.downN} households of his or her own ` : ""}
        survive the date check. <strong>The first is drawn.</strong> Joining them on a name alone is the mistake this site keeps having to correct.</p>
      )}
    </figcaption>
  </figure>
  )}

  {(p.ptree && p.ptree.none) && (
    <div class="mt-warn drops"><strong>No family is drawn for this name.</strong> The archive holds
    {" "}{p.ptree.dropped.length} household{p.ptree.dropped.length === 1 ? "" : "s"} under it, and
    {p.ptree.dropped.length === 1 ? " its dates do" : " none of their dates do"} not fit this person:
    {" "}{p.ptree.dropped.map((g, i) => (<>{i > 0 ? " · " : ""}<em>{g[1]}{g[2] ? ` × ${g[2]}` : ""}</em>{g[3] ? ` (${g[3]})` : ""}</>))}.
    A shared forename is not a family.</div>
  )}

  {p.chain && (
  <div class="mt chain">
    <div class="mt-head">{p.chain[0].label} — <a href={u(p.chain[0].href)}>see the whole line →</a></div>
    <div class="scroll">
      <table class="chaintab">
        <thead><tr><th>Gen</th><th>Father before</th><th>This name</th><th>Child after</th></tr></thead>
        <tbody>{p.chain.map(ch => (
          <tr>
            <td class="m">{ch.pos}/{ch.of}</td>
            <td>{ch.above ? ch.above.n : "—"}</td>
            <td><strong>{ch.self.n}</strong><span class="mt-p">{ch.self.d}</span></td>
            <td>{ch.below ? ch.below.n : "—"}</td>
          </tr>
        ))}</tbody>
      </table>
    </div>
    {p.chain[0].caveat && <p class="mt-warn">{p.chain[0].caveat}</p>}
  </div>
  )}
</section>
)}

{(p.ptree && !p.ptree.none) && (
<section class="blk">
  <div class="prov">
    <div class="lab">Where this comes from</div>
    <p><strong>{p.ptree.nread}</strong> of the {p.ptree.nrel} relationship{p.ptree.nrel === 1 ? "" : "s"} drawn above
      {p.ptree.nread === 1 ? " is" : " are"} written in a register this archive has read with its own eyes.
      {p.ptree.tally.filter(([k]) => k === "index").map(([, n]) => (
        <> <strong>{n}</strong> come from a <strong>FamilySearch index entry</strong> — a transcription, not the page.</>
      ))}
      {p.ptree.tally.filter(([k]) => k === "tree").map(([, n]) => (
        <> <strong>{n}</strong> come from the family tree and {n === 1 ? "is" : "are"} <strong>unverified here</strong>.</>
      ))}
      {p.ptree.tally.filter(([k]) => k === "").map(([, n]) => (
        <> <strong>{n}</strong> carry <strong>no source at all</strong> in this archive yet.</>
      ))}
    </p>
    {p.ptree.dropped && p.ptree.dropped.length > 0 && (
      <p><strong>{p.ptree.dropped.length} household{p.ptree.dropped.length === 1 ? " was" : "s were"} rejected</strong> before
        this chart was drawn, because the dates do not fit a person of this name:
        {" "}{p.ptree.dropped.map((g, i) => (<>{i > 0 ? " · " : ""}<em>{g[1]}{g[2] ? ` × ${g[2]}` : ""}</em>{g[3] ? ` (${g[3]})` : ""}</>))}.
      </p>
    )}
    {p.ptree.est && (
      <p><strong>This person has no recorded year.</strong> The archive estimates a birth <strong>about {p.ptree.est[0]}</strong>
        {p.ptree.est[1] && <> — somewhere between {p.ptree.est[1][0]} and {p.ptree.est[1][1]}</>}, {p.ptree.est[2]}.
        The households above were tested against that estimate rather than a date, on a deliberately loose window.
        <strong>That is a sanity check, not a verification</strong> — it can throw out an absurdity, and it cannot confirm a link.</p>
    )}
    {p.ptree.estRej && p.ptree.estRej.length > 0 && (
      <p><strong>{p.ptree.estRej.length} household{p.ptree.estRej.length === 1 ? " was" : "s were"} rejected even on that loose estimate</strong>:
        {" "}{p.ptree.estRej.map((g, i) => (<>{i > 0 ? " · " : ""}<em>{g[1]}{g[2] ? ` × ${g[2]}` : ""}</em>{g[3] ? ` (${g[3]})` : ""}</>))}.</p>
    )}
    {p.ptree.unchecked && p.ptree.unchecked.length > 0 && (
      <p><strong>Joined on a name alone.</strong> {p.ptree.unchecked.length === 1 ? "One household" : `${p.ptree.unchecked.length} households`} above
        could not be date-checked, because this archive holds no year for the person or for the household. Treat that link as a lead.</p>
    )}
    <p class="lk">
      <a href={u("/households/")}>The households →</a> ·
      <a href={u(`/register/?q=${encodeURIComponent(p.name)}`)}>Every record naming {p.name} →</a> ·
      <a href={u("/direct-line/")}>The Spine →</a> ·
      <a href={u("/method/")}>How this is decided →</a>
    </p>
  </div>
</section>
)}

<section class="blk">
  <div class="note">
    Identity here is by <strong>name</strong>, not by resolved individual. Where two people of one name appear
    in this archive they share this page, and it is for the reader to keep them apart — the surrounding text
    usually makes it obvious. Nothing here is new evidence; it is the same evidence, brought together.
  </div>
  {p.pages.length > 0 && (
    <p class="prose" style="margin-top:20px">
      Appears on: {p.pages.map((x, i) => (<>{i > 0 ? " · " : ""}<a href={u(x.h)}>{x.t}</a></>))}
    </p>
  )}
</section>

{(p.records && p.records.length > 0) && (
<Rule name="arrows" label="The records themselves" />
<section class="blk">
  <div class="recs">
    {p.records.map(r => (
      <div class="rec">
        <div class="rk">{r.kind}</div>
        <div class="rt">{r.text}</div>
        <p class="cap" style="margin-top:8px">
          <a href={u(r.href)}>Where this set is written up →</a>
          {r.url && <> · <a href={r.url} rel="noopener">the headstone →</a></>}
        </p>
      </div>
    ))}
  </div>
</section>
)}

{groups.length === 0 && (
<section class="blk">
  <div class="one">
    <div class="lab">No prose mention yet</div>
    <p style="margin-top:8px">This person has not been written up in an essay yet — most often read straight off a register page that no index anywhere contains. What is known is at the top, and the pages linked above are where the finding sits.</p>
  </div>
</section>
)}

{groups.map(([title, g]) => (
<Rule name="arrows" />
  <section class="blk">
    <h2>{g.page ? <a href={u(g.page)}>{title}</a> : title}</h2>
    <div style="margin-top:16px;display:flex;flex-direction:column;gap:14px">
      {g.hits.map(h => (<div class="one"><p style="font-size:14px;line-height:1.65">…{h.text}…</p></div>))}
    </div>
  </section>
))}
<Rule name="pomegranate" />

<section class="blk">
  <p class="prose note">{d.note}</p>
  <p class="cap" style="margin-top:14px"><a href={u("/who/")}>All {Object.keys(d.people).length} people →</a> · <a href={u("/search/")}>Search the whole archive →</a></p>
</section>
<Lightbox />
</Base>

<style>
  .mt { border: 1px solid var(--rule, #dcd6cc); border-radius: 3px; padding: 4px 0; margin-top: 14px; }
  .mt.chain { border-left: 3px solid var(--ochre, #8a7f5c); }
  .mt-head { padding: 10px 16px 4px; font-size: 12px; letter-spacing: .04em; opacity: .72; }
  .mt-row { display: grid; grid-template-columns: minmax(0,150px) 1fr; gap: 8px 18px;
            padding: 9px 16px; border-top: 1px solid var(--rule, #dcd6cc); }
  .mt-row:first-child { border-top: 0; }
  .mt-row.is-self { background: color-mix(in srgb, var(--accent, #8a5a3b) 7%, transparent); }
  .mt-l { font-size: 10.5px; letter-spacing: .09em; text-transform: uppercase; opacity: .6; padding-top: 3px; }
  .mt-v { font-size: 15.5px; line-height: 1.5; }
  .mt-p { display: block; font-size: 12.5px; opacity: .66; margin-top: 2px; }
  .mt-y { opacity: .6; font-size: 13px; }
  .amp { opacity: .5; padding: 0 4px; }
  .mt-note { border-left: 3px solid var(--terra, #a5442c); padding: 12px 16px; margin-bottom: 14px;
             background: color-mix(in srgb, var(--terra, #a5442c) 6%, transparent);
             border-radius: 0 3px 3px 0; font-size: 15px; line-height: 1.6; }
  .chaintab { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .chaintab th { text-align: left; font-size: 10.5px; letter-spacing: .09em; text-transform: uppercase;
                 opacity: .55; font-weight: 400; padding: 8px 16px; }
  .chaintab td { padding: 9px 16px; border-top: 1px solid var(--rule, #dcd6cc); vertical-align: top; }
  .chaintab td .mt-p { margin-top: 1px; }
  .mt-warn { margin: 0; padding: 10px 16px 12px; font-size: 13.5px; line-height: 1.6; opacity: .82; }
  @media (max-width: 620px) { .mt-row { grid-template-columns: 1fr; gap: 2px; } }
  .recs { display: flex; flex-direction: column; gap: 14px; }
  .rec { padding: 14px 16px; border: 1px solid var(--rule, #dcd6cc); border-left-width: 3px;
         border-left-color: var(--accent, #8a5a3b); border-radius: 3px; }
  .rk { font-size: 10.5px; letter-spacing: .09em; text-transform: uppercase; opacity: .6; }
  .rt { margin-top: 5px; font-size: 15.5px; line-height: 1.6; }
  .pgal{display:flex;gap:12px;flex-wrap:wrap;align-items:flex-end}
  .pgal .plate{padding:0;border:1px solid var(--rule);background:var(--panel);
    border-radius:3px;cursor:zoom-in;line-height:0;overflow:hidden}
  .pgal .plate img{height:230px;width:auto;display:block}
  .pcap{font-family:var(--sans);font-size:13px;line-height:1.6;color:var(--ink-2);
    margin-top:14px;max-width:74ch;border-left:2px solid var(--ochre);padding-left:12px}
  .pcap .lab{display:block;color:var(--ochre);margin-bottom:3px}
</style>

<style>
  .facts { display: flex; flex-wrap: wrap; gap: 0; border: 1px solid var(--rule, #dcd6cc); border-radius: 3px; overflow: hidden; }
  .fact { flex: 1 1 170px; padding: 12px 16px; border-right: 1px solid var(--rule, #dcd6cc); min-width: 0; }
  .fact:last-child { border-right: 0; }
  .fk { display: block; font-size: 11px; letter-spacing: .09em; text-transform: uppercase; opacity: .62; }
  .fv { display: block; margin-top: 4px; font-size: 15px; line-height: 1.4; overflow-wrap: anywhere; }
  .known { margin-top: 18px; padding: 16px 18px; border-left: 3px solid var(--accent, #8a5a3b); background: color-mix(in srgb, var(--accent, #8a5a3b) 5%, transparent); border-radius: 0 3px 3px 0; }
  .known p { margin: 0; font-size: 15.5px; line-height: 1.68; }
  @media (max-width: 620px) { .fact { flex: 1 1 100%; border-right: 0; border-bottom: 1px solid var(--rule, #dcd6cc); } .fact:last-child { border-bottom: 0; } }

  figure.ptree { margin: 0; padding: 0; }
  .ptree .tier { position: relative; }
  .ptree .tlab { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; opacity: .55;
    font-weight: 600; margin: 0 0 8px; display: flex; gap: 10px; align-items: baseline; flex-wrap: wrap; }
  .ptree .tpl { text-transform: none; letter-spacing: 0; font-weight: 400; opacity: .8; }
  .ptree .prow { display: flex; flex-wrap: wrap; gap: 8px; }
  .ptree .drop { height: 20px; width: 1px; margin: 6px 0 6px 28px; background: var(--rule, #dcd6cc); }
  .ptree .tier.self { margin: 4px 0; }
  .ptree .tier.sibs { margin-top: 22px; padding-top: 16px; border-top: 1px dashed var(--rule, #dcd6cc); }
  .pnode { display: flex; flex-direction: column; gap: 1px; text-decoration: none; color: inherit;
    border: 1px solid var(--rule, #dcd6cc); border-left-width: 3px; border-radius: 3px;
    padding: 8px 12px; min-width: 148px; max-width: 260px; }
  a.pnode:hover { background: rgba(138,127,92,.09); }
