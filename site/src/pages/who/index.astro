---
import Base from "../../layouts/Base.astro";
import NameLists from "@daviddef/archive-kit/components/NameLists.astro";
import { md as _md } from "../../lib/md.js";
import Rule from "../../components/Rule.astro";
import { u } from "../../lib/url.js";
import EveryName from "@daviddef/archive-kit/components/EveryName.astro";
import d from "../../data/dossiers.json";
const people = Object.values(d.people).sort((a, b) => a.name.localeCompare(b.name));
/* ONE ENTRY PER NAME, keyed by a name-slug: 1,118 entries for 1,118 distinct
   names. This page used to open "one page per person", which is the merge this
   archive does not do - two men called Giovanni Defranceschi have one entry
   here and it is an entry for the NAME. n counts mentions across the site, so
   the shared table is told that and does not read it as a count of people.

   The letter headings go. A search box beats scrolling to G, and it searches
   all 1,118 at once instead of one letter at a time. */
const rows = people.map(p => ({ slug: p.slug, name: p.name, n: p.n }));
const total = people.reduce((s, p) => s + p.n, 0);
---
<Base title="Every Name" eyebrow={`${people.length} names · ${total} mentions`}
      dek="One page per name — every single one the archive can put in writing, including those read straight off a register page that no index anywhere contains. Each opens with what is known, then gathers every mention of that name from every page of the site. A name is not a person: where two people share one, this archive keeps them under the one name until a record says to part them.">

<NameLists here="who" u={u} />


<section class="blk">
  <p class="prose note" set:html={_md(d.note)}></p>
</section>
<section class="blk">
  <EveryName names={rows} u={u} counts="mentions" noun="names" />
</section>

</Base>
