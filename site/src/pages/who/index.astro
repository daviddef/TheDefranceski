---
import Base from "../../layouts/Base.astro";
import Rule from "../../components/Rule.astro";
import { u } from "../../lib/url.js";
import d from "../../data/dossiers.json";
const people = Object.values(d.people).sort((a, b) => a.name.localeCompare(b.name));
const letters = [...new Set(people.map(p => p.name[0].toUpperCase()))].sort();
const total = people.reduce((s, p) => s + p.n, 0);
---
<Base title="Every Person" eyebrow={`${people.length} named people · ${total} mentions`}
      dek="One page per person — every single one the archive can name, including those read straight off a register page that no index anywhere contains. Each opens with what is known, then gathers every mention of the name from every page of the site.">
<section class="blk">
  <p class="prose note">{d.note}</p>
</section>
{letters.map(L => (
<Rule name="arrows" />
  <section class="blk">
    <h2>{L}</h2>
    <div class="grid g3" style="margin-top:16px">
      {people.filter(p => p.name[0].toUpperCase() === L).map(p => (
        <div class="one">
          <a href={u(`/who/${p.slug}/`)}><strong>{p.name}</strong></a>
          <div class="cap" style="margin-top:4px">{p.n} mention{p.n === 1 ? "" : "s"} · {p.pages.length} page{p.pages.length === 1 ? "" : "s"}</div>
        </div>
      ))}
    </div>
  </section>
))}
</Base>
