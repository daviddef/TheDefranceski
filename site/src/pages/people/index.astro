---
import { u } from "../../lib/url.js";
import Rule from "../../components/Rule.astro";
import Base from "../../layouts/Base.astro";
import Chip from "../../components/Chip.astro";
import people from "../../data/people.json";
import notables from "../../data/notables.json";
import roster from "../../data/roster.json";
const S = roster.stats;
const LINEN = { carnia: "Carnia", venice: "Venice", crete: "Crete", south: "S. Istria",
                unplaced: "Not placed", trentino: "Trentino", corsica: "Corsica",
                abroad: "Abroad", unknown: "No place", other: "Other" };
const ORDER = ["carnia", "venice", "crete", "south", "unplaced", "trentino", "corsica",
               "abroad", "unknown", "other"];
const R = roster.rows;
const N = {
  mine: R.filter(r => r.mine).length,
  direct: R.filter(r => r.direct).length,
  star: R.filter(r => r.notable).length,
  rec: R.filter(r => r.ark).length,
  par: R.filter(r => r.parish).length,
};
const PLACES = Object.entries(
  R.reduce((a, r) => { const k = (r.place || "").split(",")[0].trim(); if (k) a[k] = (a[k] || 0) + 1; return a; }, {})
).filter(([, n]) => n >= 3).sort((a, b) => b[1] - a[1]);
---
<Base title="Everyone" eyebrow={`${S.total} people of the name, from every record set in this archive`}
      dek="The whole roster, in one list. Start with ★ My line if you only want the people this archive can attach to David\u2019s own descent — the rest are of the name, not of the family.">

<section class="blk">
  <p class="dek" set:html={roster.note.replace(/\*\*(.+?)\*\*/g,"<strong>$1</strong>")}></p>
  <div class="note" style="margin-top:16px" set:html={roster.warn.replace(/\*\*(.+?)\*\*/g,"<strong>$1</strong>")}></div>
  <p class="dek" style="margin-top:14px" set:html={roster.links.replace(/\*\*(.+?)\*\*/g,"<strong>$1</strong>")}></p>

  <div class="rcount">
    {ORDER.filter(k => S.lines[k]).map(k => (
      <div class={"rc rc-" + k}><b>{S.lines[k]}</b><span>{LINEN[k]}</span></div>
    ))}
  </div>

  <div class="rtools">
    <input id="rq" type="search" placeholder="Search a name, a place, a year…" autocomplete="off" />
    <div class="rfilters">
      <button class="rf on" data-l="all">All <span class="rfn">{S.total}</span></button>
      <button class="rf is-mine" data-l="mine">★ My line <span class="rfn">{N.mine}</span></button>
      <button class="rf is-mine" data-l="direct">★ Direct line <span class="rfn">{N.direct}</span></button>
      <button class="rf is-mine" data-l="rel">★ Related to David <span class="rfn">{R.filter(r => r.rel).length}</span></button>
      {ORDER.filter(k => S.lines[k] && k !== "carnia").map(k => <button class="rf" data-l={k}>{LINEN[k]} <span class="rfn">{S.lines[k]}</span></button>)}
      <button class="rf" data-l="star">Notable <span class="rfn">{N.star}</span></button>
      <button class="rf" data-l="rec">Has a record <span class="rfn">{N.rec}</span></button>
      <button class="rf" data-l="par">Parish known <span class="rfn">{N.par}</span></button>
    </div>
    <div class="rplacewrap">
      <label for="rp">Narrow by place</label>
      <select id="rp">
        <option value="">Everywhere</option>
        {PLACES.map(([k, n]) => <option value={k.toLowerCase()}>{k} — {n}</option>)}
      </select>
      <span class="rphint">★ My line is the Carnia lane — everyone this archive places on the family's own road. ★ Direct line is the documented spine, generation by generation.</span>
    </div>
    <div id="rn" class="rn"></div>
  </div>

  <div class="tablewrap" style="margin-top:14px">
    <table class="roster" id="rtab">
      <thead><tr><th>Name</th><th class="m">Born</th><th class="m">Died</th><th>Place</th><th>Family</th><th>Where it is written up</th><th>Records</th></tr></thead>
      <tbody>
        {roster.rows.map(r => (
          <tr data-l={r.line} data-star={r.notable ? "1" : "0"} data-mine={r.mine ? "1" : "0"} data-rel={r.rel ? "1" : "0"} data-direct={r.direct ? "1" : "0"}
              data-k={(r.name + " " + r.place + " " + (r.b||"") + " " + (r.d||"") + " " + (r.note||"")).toLowerCase()}
              data-place={(r.place || "").split(",")[0].trim().toLowerCase()}>
            <td class="rname">
              {r.notable && <span class="star" title="Notable — has a life written up">★</span>}
              {r.who ? <a href={u(r.who)}>{r.name}</a> : r.name}
              {r.me && <span class="mechip" title="This is David, the compiler — every relationship on this site is measured from here">ME</span>}
              {r.living && <span class="livechip" title="Living — named only; no dates, no places, no photograph">living</span>}
              {r.rel && <span class="relchip">{r.rel}</span>}
            </td>
            <td class="m">{r.b || "—"}</td>
            <td class="m">{r.d || "—"}</td>
            <td class="rplace">{r.parish
                ? <span class="parish" title="The parish register this record was filmed from">{r.parish}</span>
                : (r.place || "—")}{r.parish && r.place && r.place !== r.parish && <span class="rnote"> · {r.place}</span>}</td>
            <td><span class={"lchip l-" + r.line}>{LINEN[r.line]}</span></td>
            <td class="rsrc"><a href={u(r.href)}>{roster.srclabel[r.src]}</a>{r.note && <span class="rnote"> · {r.note}</span>}</td>
            <td class="rlinks">
              {r.ark && <a class="reclink" href={`https://www.familysearch.org/ark:/61903/${r.ark}`} rel="noopener" title="The indexed record on FamilySearch">record</a>}
              {r.mh && <a class="reclink tree" href={`https://www.myheritage.com/site-family-tree-OYYV7AGVV4FMSGNWXC6TO74JQDUMOYA?familyTreeID=4&individualId=${r.mh}`} rel="noopener" title="This person in the family tree">tree</a>}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="cap" style="margin-top:14px">Built by <code>tools/roster.py</code> from ten record sets, September 2026. A name may appear once here and be several people, or appear twice and be one; where the archive knows, it has merged them, and where it does not, it has left them apart rather than guess.</p>
</section>

<Rule name="arrows" label="What the colours mean" />
<section class="blk">
  <div class="regkey">
    {roster.legend.filter(([k]) => S.lines[k]).map(([k, v]) => (
      <div class="regkey-row"><span class={"lchip l-" + k}>{LINEN[k]}</span><span class="regkey-v">{v}</span></div>
    ))}
  </div>
</section>

<Rule name="pomegranate" label="Written up in full" />
<section class="blk">
  <h2>The lives</h2>
  <p class="dek" style="margin-top:8px">Nine people this archive has followed all the way through — the record first, cold and cited, then the life, then what was happening around them.</p>
  <div class="grid g2" style="margin-top:22px">
    {people.map(p=>(
      <a class="cardlink" href={u(`/people/${p.slug}/`)}>
        <div class="nm">{p.name}</div>
        <div class="alt">{p.born||"?"}–{p.died||"?"} · {p.roles.join(", ")}</div>
        <div style="margin-top:10px"><Chip c={p.confidence} /></div>
        <div class="txt">{p.lead}</div>
      </a>
    ))}
  </div>
</section>

<Rule name="arrows" />
<section class="blk">
  <h2>Others who carried the name</h2>
  <p class="dek">Listed because people search for them and arrive here. Almost none of them is demonstrably related — a shared patronymic is not a shared ancestor, and saying otherwise is how family myths start.</p>
  <div class="scroll" style="margin-top:22px">
    <table>
      <thead><tr><th>Name</th><th class="m">Dates</th><th>What</th><th>Where</th><th>Link to this family</th></tr></thead>
      <tbody>{notables.map(n=>(
        <tr><td>{n.name}</td><td class="m">{n.dates}</td><td>{n.what}</td><td>{n.where}</td>
        <td><Chip c={n.conn} />{n.link && <div style="margin-top:6px;font-size:12px">{n.link}</div>}</td></tr>
      ))}</tbody>
    </table>
  </div>
</section>

<script is:inline>
  (function () {
    var q = document.getElementById("rq"), tab = document.getElementById("rtab"),
        out = document.getElementById("rn");
    if (!q || !tab) return;
    var rows = Array.prototype.slice.call(tab.tBodies[0].rows), mode = "all";
    function apply() {
      var t = q.value.trim().toLowerCase(), n = 0;
      var pl = (document.getElementById("rp") || {}).value || "";
      for (var i = 0; i < rows.length; i++) {
        var r = rows[i];
        var okL = mode === "all"
          || (mode === "rel" ? r.getAttribute("data-rel") === "1"
          : mode === "mine" ? r.getAttribute("data-mine") === "1"
          : mode === "direct" ? r.getAttribute("data-direct") === "1"
          : mode === "star" ? r.getAttribute("data-star") === "1"
          : mode === "rec" ? r.getAttribute("data-rec") === "1"
          : mode === "par" ? r.getAttribute("data-par") === "1"
          : r.getAttribute("data-l") === mode);
        var okQ = !t || r.getAttribute("data-k").indexOf(t) !== -1;
        var okP = !pl || r.getAttribute("data-place") === pl;
        var show = okL && okQ && okP;
        r.hidden = !show;
        if (show) n++;
      }
      out.textContent = n + (n === 1 ? " person" : " people") + " shown";
    }
    q.addEventListener("input", apply);
    var sel = document.getElementById("rp"); if (sel) sel.addEventListener("change", apply);
    document.querySelectorAll(".rf").forEach(function (b) {
      b.addEventListener("click", function () {
        document.querySelectorAll(".rf").forEach(function (x) { x.classList.remove("on"); });
        b.classList.add("on"); mode = b.getAttribute("data-l"); apply();
      });
    });
    apply();
  })();
</script>

<style>
  .rcount{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px}
  .rc{flex:1 1 110px;padding:12px 14px;border-radius:10px;background:var(--panel-2);
    border-left:3px solid var(--ink-3)}
  .rc b{display:block;font-size:24px;font-family:var(--serif);line-height:1}
  .rc span{display:block;margin-top:3px;font-family:var(--mono);font-size:9.5px;
    letter-spacing:.1em;text-transform:uppercase;color:var(--ink-3)}
  .rc-carnia{border-left-color:var(--accent)}
  .rc-venice{border-left-color:var(--ochre)}
  .rc-crete{border-left-color:var(--terra)}
  .rc-south{border-left-color:var(--r-napo)}
  .rc-corsica{border-left-color:var(--r-italy)}
  .rtools{margin-top:24px}
  .rtools input{width:100%;padding:12px 14px;font-family:var(--sans);font-size:15px;
    border:1px solid var(--rule);border-radius:10px;background:var(--panel);color:var(--ink)}
  .rfilters{display:flex;flex-wrap:wrap;gap:7px;margin-top:12px}
  .relchip{display:inline-block;margin-left:7px;font-family:var(--sans);font-size:11px;line-height:1.3;
    padding:2px 7px;border-radius:9px;background:color-mix(in srgb,var(--accent) 12%,transparent);color:var(--accent)}
  .mechip{display:inline-block;margin-left:7px;font-family:var(--mono);font-size:9px;letter-spacing:.1em;
    padding:2px 6px;border-radius:3px;background:var(--accent);color:var(--ground)}
  .livechip{display:inline-block;margin-left:7px;font-family:var(--mono);font-size:9px;letter-spacing:.08em;
    text-transform:uppercase;padding:2px 6px;border-radius:3px;border:1px solid var(--rule-strong);color:var(--ink-3)}
  .rfn{opacity:.55;font-variant-numeric:tabular-nums;margin-left:4px}
  .rf.is-mine{border-color:var(--accent);color:var(--accent)}
  .rf.is-mine.on{background:var(--accent);color:var(--ground);border-color:var(--accent)}
  .rf.is-mine.on .rfn{opacity:.8}
  .rplacewrap{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:12px}
  .rplacewrap label{font-family:var(--mono);font-size:9.5px;letter-spacing:.09em;text-transform:uppercase;color:var(--ink-3)}
  .rplacewrap select{font-family:var(--sans);font-size:13.5px;padding:6px 10px;border:1px solid var(--rule);
    border-radius:3px;background:var(--panel);color:var(--ink);max-width:min(100%,320px)}
  .rphint{flex:1 1 100%;font-family:var(--sans);font-size:12.5px;line-height:1.55;color:var(--ink-3)}
  .rf{font-family:var(--mono);font-size:10px;letter-spacing:.09em;text-transform:uppercase;
    padding:6px 11px;border-radius:20px;border:1px solid var(--rule);background:transparent;
    color:var(--ink-3);cursor:pointer}
  .rf:hover{color:var(--ink)}
  .rf.on{background:var(--ink);color:var(--panel);border-color:var(--ink)}
  .rn{margin-top:10px;font-family:var(--mono);font-size:10.5px;letter-spacing:.08em;
    text-transform:uppercase;color:var(--ink-3)}
  table.roster{width:100%;border-collapse:collapse;font-size:14px}
  table.roster th{text-align:left;font-family:var(--mono);font-size:9.5px;letter-spacing:.12em;
    text-transform:uppercase;color:var(--ink-3);padding:0 12px 7px 0;border-bottom:1px solid var(--rule)}
  table.roster td{padding:9px 12px 9px 0;border-bottom:1px solid var(--rule);vertical-align:top}
  table.roster td.m{font-family:var(--mono);font-size:12.5px;color:var(--ink-2);
    font-variant-numeric:tabular-nums;white-space:nowrap}
  .rname{font-weight:600;min-width:190px}
  .rplace{color:var(--ink-2);font-size:13px;max-width:26ch}
  .parish{color:var(--ink);border-bottom:1px dotted var(--rule-strong)}
  .rsrc{font-size:12.5px;color:var(--ink-3)}
  .rlinks{white-space:nowrap}
  .reclink{display:inline-block;font-family:var(--mono);font-size:9px;letter-spacing:.08em;
    text-transform:uppercase;padding:3px 7px;border-radius:4px;margin-right:5px;
    text-decoration:none;background:color-mix(in srgb,var(--accent) 12%,transparent);color:var(--accent)}
  .reclink:hover{background:var(--accent);color:var(--panel)}
  .reclink.tree{background:color-mix(in srgb,var(--ochre) 16%,transparent);color:var(--ochre)}
  .reclink.tree:hover{background:var(--ochre);color:var(--panel)}
  .rnote{color:var(--ink-3)}
  .star{color:var(--ochre);margin-right:5px}
  .lchip{font-family:var(--mono);font-size:9px;letter-spacing:.08em;text-transform:uppercase;
    padding:3px 7px;border-radius:4px;white-space:nowrap;background:var(--panel-2);color:var(--ink-3)}
  .l-carnia{background:color-mix(in srgb,var(--accent) 16%,transparent);color:var(--accent)}
  .l-venice{background:color-mix(in srgb,var(--ochre) 20%,transparent);color:var(--ochre)}
  .l-crete{background:color-mix(in srgb,var(--terra) 18%,transparent);color:var(--terra)}
  .l-south{background:color-mix(in srgb,var(--r-napo) 18%,transparent);color:var(--r-napo)}
  .l-corsica{background:color-mix(in srgb,var(--r-italy) 18%,transparent);color:var(--r-italy)}
  .regkey{margin-top:6px;display:grid;gap:8px;padding:14px 16px;background:var(--panel-2);border-radius:10px}
  .regkey-row{display:flex;gap:12px;align-items:baseline;font-size:13.5px}
  .regkey-v{color:var(--ink-2)}
  .tablewrap{overflow-x:auto}
</style>
</Base>
