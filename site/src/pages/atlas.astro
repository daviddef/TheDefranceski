---
import Base from "../layouts/Base.astro";
import Sources from "../components/Sources.astro";
import { u } from "../lib/url.js";
import a from "../data/atlas.json";
const cats = [
  ["spine",    "The documented line",        "#A8442B"],
  ["carnia",   "Carnia — where it may start","#9A6B18"],
  ["sweep",    "Istria, where the name is",  "#1F5C6B"],
  ["other",    "Other families of the name", "#6E6A86"],
  ["senj",     "The Senj and Karlobag side", "#4E7A55"],
  ["diaspora", "Where they went",            "#2E7C8C"],
];
const s = a.stats;
---
<Base
  title="The Atlas"
  eyebrow={`${s.places} places · ${s.people} people placed · ${s.films} register volumes`}
  dek="Every place this archive can put a person in. Click a marker and it gives you what happened there, the people the archive has standing in it, and — where the parish is on film — the register volumes themselves, open at page one.">

  <div class="at-wrap">
    <div class="at-map" id="atlas"></div>
    <aside class="at-panel" id="at-panel">
      <div class="at-empty" id="at-empty">
        <div class="lab">Pick a place</div>
        <p>Click any marker. Bigger markers hold more people.</p>
        <p class="at-hint">{s.withPeople} of the {s.places} places carry at least one person; {s.withFilms} of them can hand you the register itself.</p>
      </div>
      <div class="at-body" id="at-body" hidden></div>
    </aside>
  </div>

  <div class="at-tools">
    <label class="at-find">
      <span class="lab">Find a place</span>
      <input id="at-q" type="search" placeholder="Vodnjan · Torrington · Omiš · Broken Hill" autocomplete="off" />
    </label>
    <div class="atlas-key">
      {cats.map(([k, label, c]) => (
        <button class="at-cat on" data-cat={k}><i style={`background:${c}`}></i>{label}</button>
      ))}
    </div>
  </div>
  <p class="cap" id="at-count"></p>

  <section class="blk" style="margin-top:34px">
    <h2>Reading the map</h2>
    <div class="grid g3" style="margin-top:20px">
      <div class="panel">
        <div class="lab">The line is short</div>
        <p class="dek" style="margin-top:8px">Nine places carry the whole documented descent, and seven of them sit inside a hundred kilometres of each other. The family did not move much until 1939, and then it moved to three continents in a decade.</p>
      </div>
      <div class="panel">
        <div class="lab">The cluster is not the line</div>
        <p class="dek" style="margin-top:8px">Rijeka, Pula and Ližnjan carry far more of the surname than Gračišće ever did — and none of them is connected to this family by any document. <strong>Weight on the map is not kinship.</strong></p>
      </div>
      <div class="panel">
        <div class="lab">The gap is the argument</div>
        <p class="dek" style="margin-top:8px">Between Mione in 1679 and Gologorica in 1711 there is nothing but a house with a date on it. That two-hundred-kilometre jump is the one thing this archive cannot yet prove.</p>
      </div>
    </div>
    <div class="note" style="margin-top:24px"><strong>What a marker means, and what it does not.</strong> A place is on this map because a person in the roster is attached to it — by a record, a headstone, a register or a family tree. It does not mean that person was born there, and where the archive only has a parish it has used the parish. <strong>Names in three languages have been folded together</strong>: Almissa is Omiš, Vitipolis is Rijeka, Promontore is Premantura, Spalato is Split. Seventy-three entries were left off because they name a country, a region, or a church's patron saint rather than a town — those are errors in the data and are being cleaned separately.</div>
  </section>

  <Sources ids={["familysearch", "dapa", "kobler", "arolsen", "findagrave"]} />
</Base>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js" defer></script>
<script is:inline define:vars={{ BASE: u("/"), DATA: u("/atlas-data.json") }}>
  window.addEventListener("load", async function () {
    var el = document.getElementById("atlas");
    if (!el || typeof L === "undefined") return;
    var base = BASE.replace(/\/$/, "");
    var d;
    try { d = await (await fetch(DATA)).json(); } catch (e) { return; }

    var COLORS = { spine:"#A8442B", carnia:"#9A6B18", sweep:"#1F5C6B",
                   other:"#6E6A86", senj:"#4E7A55", diaspora:"#2E7C8C" };
    var map = L.map(el, { scrollWheelZoom: true, worldCopyJump: true });
    L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
      attribution: "&copy; OpenStreetMap contributors", maxZoom: 18
    }).addTo(map);

    var esc = function (x) { return String(x == null ? "" : x)
      .replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;"); };
    var panel = document.getElementById("at-body");
    var empty = document.getElementById("at-empty");

    function show(p) {
      var h = [];
      h.push('<div class="at-h"><h3>' + esc(p.name) + "</h3>");
      if (p.n) h.push('<span class="at-n">' + p.n + (p.n === 1 ? " person" : " people") + "</span>");
      h.push("</div>");
      if (p.also && p.also.length)
        h.push('<p class="at-also">also written ' + p.also.map(function (x) {
          return "<em>" + esc(x) + "</em>"; }).join(" · ") + "</p>");
      if (p.when || p.what)
        h.push('<p class="at-what">' + (p.when ? "<b>" + esc(p.when) + "</b> — " : "") + esc(p.what) + "</p>");
      if (p.href)
        h.push('<p class="at-go"><a href="' + base + esc(p.href) + '">The page that proves it &rarr;</a></p>');

      if (p.nfilms) {
        h.push('<div class="at-sec"><div class="lab">The registers, open at page one</div>');
        h.push('<p class="at-sub">' + p.nfilms + " volume" + (p.nfilms === 1 ? "" : "s") +
               " photographed for this parish. None of it is name-indexed.</p><ul class=\"at-films\">");
        p.films.forEach(function (f) {
          h.push('<li><a href="https://www.familysearch.org/ark:/61903/' + esc(f.ark) +
                 "?cc=" + esc(f.cc) + "&wc=" + encodeURIComponent(f.wc) +
                 '" target="_blank" rel="noopener">' + esc(f.t) + " &#8599;</a></li>");
        });
        h.push("</ul></div>");
      }

      if (p.people && p.people.length) {
        h.push('<div class="at-sec"><div class="lab">Who the archive puts here</div><ul class="at-ppl">');
        p.people.forEach(function (q) {
          var yr = q.y ? (q.y + (q.d ? "–" + q.d : "")) : "";
          var nm = esc(q.n) + (yr ? ' <span class="at-y">' + esc(yr) + "</span>" : "");
          h.push("<li>" + (q.w ? '<a href="' + base + esc(q.w) + '">' + nm + "</a>" : nm) + "</li>");
        });
        h.push("</ul>");
        if (p.more) h.push('<p class="at-sub">and ' + p.more + " more — <a href=\"" + base + "/people/\">the full roster &rarr;</a></p>");
        h.push("</div>");
      }
      panel.innerHTML = h.join("");
      panel.hidden = false; empty.hidden = true;
      panel.scrollTop = 0;
    }

    var markers = [], pts = [];
    d.places.forEach(function (p) {
      var r = p.n > 40 ? 11 : p.n > 12 ? 8.5 : p.n > 3 ? 6.5 : p.order ? 7.5 : 5;
      var m = L.circleMarker([p.lat, p.lon], {
        radius: r, color: "#ffffff", weight: p.order ? 2.2 : 1.2,
        fillColor: COLORS[p.cat] || "#666", fillOpacity: 0.9
      }).addTo(map);
      m.bindTooltip(p.name + (p.n ? " · " + p.n : ""), { direction: "top", offset: [0, -6] });
      m.on("click", function () { show(p); });
      m._p = p; markers.push(m); pts.push([p.lat, p.lon]);
    });

    var spine = d.places.filter(function (p) { return p.order; })
      .sort(function (x, y) { return x.order - y.order; })
      .map(function (p) { return [p.lat, p.lon]; });
    L.polyline(spine, { color: "#A8442B", weight: 2.5, opacity: 0.75, dashArray: "1 7", lineCap: "round" }).addTo(map);

    map.fitBounds(L.latLngBounds([[35, 9], [49, 26]]), { padding: [24, 24] });

    // filters
    var off = {}, q = document.getElementById("at-q"), count = document.getElementById("at-count");
    function apply() {
      var t = (q.value || "").toLowerCase().trim();
      var shown = 0;
      markers.forEach(function (m) {
        var p = m._p;
        var ok = !off[p.cat] &&
          (!t || (p.name + " " + (p.also || []).join(" ")).toLowerCase().indexOf(t) > -1);
        if (ok) { if (!map.hasLayer(m)) m.addTo(map); shown++; }
        else if (map.hasLayer(m)) map.removeLayer(m);
      });
      count.textContent = shown + " of " + markers.length + " places shown";
      if (t && shown) {
        var vis = markers.filter(function (m) { return map.hasLayer(m); });
        map.fitBounds(L.latLngBounds(vis.map(function (m) { return m.getLatLng(); })), { padding: [40, 40], maxZoom: 11 });
        if (vis.length === 1) show(vis[0]._p);
      }
    }
    q.addEventListener("input", apply);
    document.querySelectorAll(".at-cat").forEach(function (b) {
      b.addEventListener("click", function () {
        var c = b.getAttribute("data-cat");
        off[c] = !off[c]; b.classList.toggle("on", !off[c]); apply();
      });
    });
    apply();

    var btn = L.control({ position: "topright" });
    btn.onAdd = function () {
      var b = L.DomUtil.create("div", "leaflet-bar");
      b.innerHTML = '<a href="#" title="Show the whole world" style="width:auto;padding:0 9px;font:500 11px/26px system-ui">Whole world</a>';
      var wide = false;
      L.DomEvent.on(b, "click", function (e) {
        L.DomEvent.stop(e); wide = !wide;
        if (wide) { map.fitBounds(L.latLngBounds(pts), { padding: [24, 24] }); b.querySelector("a").textContent = "Back to Istria"; }
        else { map.fitBounds(L.latLngBounds([[35, 9], [49, 26]]), { padding: [24, 24] }); b.querySelector("a").textContent = "Whole world"; }
      });
      return b;
    };
    btn.addTo(map);
  });
</script>

<style>
  .at-wrap { display: grid; grid-template-columns: 1fr 340px; gap: 18px; margin-top: 8px; }
  .at-map { height: 560px; border: 1px solid var(--rule); border-radius: 3px; }
  .at-panel {
    height: 560px; overflow-y: auto; border: 1px solid var(--rule);
    border-radius: 3px; background: var(--panel); padding: 18px 18px 24px;
  }
  .at-empty p { font-size: 13px; line-height: 1.6; color: var(--ink-2); margin: 8px 0 0; }
  .at-hint { color: var(--ink-3) !important; font-size: 12px !important; }
  .at-h { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .at-h h3 { font-family: var(--serif); font-size: 21px; margin: 0; line-height: 1.25; }
  .at-n { font: 400 11px/1 var(--mono); color: var(--accent); white-space: nowrap; }
  .at-also { font: 400 11.5px/1.5 var(--mono); color: var(--ink-3); margin: 8px 0 0; }
  .at-what { font-size: 13.5px; line-height: 1.65; margin: 12px 0 0; }
  .at-go { margin: 10px 0 0; font-size: 13px; }
  .at-sec { margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--rule); }
  .at-sub { font: 400 11.5px/1.5 var(--mono); color: var(--ink-3); margin: 6px 0 8px; }
  .at-films, .at-ppl { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 4px; }
  .at-films li a { font-size: 12.5px; line-height: 1.45; }
  .at-ppl li { font-size: 13px; line-height: 1.5; }
  .at-y { font: 400 11px/1 var(--mono); color: var(--ink-3); }
  .at-tools { display: flex; flex-wrap: wrap; gap: 16px 26px; align-items: flex-end; margin-top: 16px; }
  .at-find { flex: 1 1 260px; }
  #at-q {
    width: 100%; box-sizing: border-box; margin-top: 6px; padding: 9px 12px;
    font: 400 15px/1.3 var(--serif); color: var(--ink);
    background: var(--card); border: 1px solid var(--rule); border-radius: 3px;
  }
  #at-q:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  .at-cat {
    font: 400 12px/1 var(--sans); color: var(--ink-3); cursor: pointer;
    background: none; border: 1px solid var(--rule); border-radius: 999px;
    padding: 6px 11px; display: inline-flex; align-items: center; gap: 6px; opacity: .45;
  }
  .at-cat.on { opacity: 1; color: var(--ink-2); border-color: var(--ink-3); }
  .at-cat i { width: 9px; height: 9px; border-radius: 50%; display: inline-block; }
  @media (max-width: 860px) {
    .at-wrap { grid-template-columns: 1fr; }
    .at-map { height: 380px; } .at-panel { height: auto; max-height: 460px; }
  }
</style>
