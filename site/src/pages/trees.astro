---
/* Every line this archive follows. The rows are this archive's own; the
   component is the kit's — this page used to carry a near-verbatim copy of
   it, which is how the shared one came to be missing the markdown rendering
   this one had. */
import Base from "../layouts/Base.astro";
import Rule from "../components/Rule.astro";
import Trees from "@daviddef/archive-kit/components/Trees.astro";
import { u } from "../lib/url.js";
import t from "../data/trees.json";

const rows = t.rows.map(r => ({ ...r, href: r.href ? u(r.href) : null }));
---
<Base
  title="The trees"
  eyebrow={`${t.rows.length} families · all six drawn`}
  dek="This archive follows six families of the name, and every one of them is now drawn — not all as pedigrees, because only two of them are pedigrees. A line that moved is drawn as the ground it covered; a parish that never joined up is drawn as the web it is; a chart a family made about itself is drawn banded by how much of it can be tested. A tree with invented joins in it is worse than no tree, so none of these has any.">

  <Trees rows={rows} close={t.close} drawn={u("/tree/")} />

  <Rule name="arrows" label="Where to start" />
  <section class="blk">
    <div class="doors" style="margin-top:18px">
      <a class="door" href={u("/lines/")}>
        <div class="dn">All five, compared</div>
        <div class="dd">The families side by side — where each begins, what it rests on, and where it ended up.</div>
        <div class="go">Compare them →</div>
      </a>
      <a class="door" href={u("/households/")}>
        <div class="dn">Households</div>
        <div class="dd">The 112 reconstructed couples the trees would be built from, whichever family they belong to.</div>
        <div class="go">Browse households →</div>
      </a>
      <a class="door" href={u("/bloodline/")}>
        <div class="dn">Blood relatives</div>
        <div class="dd">The other way round: pick one person and the chart is built around them — parents
          above, brothers and sisters beside, children below, and every line drawn in the colour of
          the record behind it. The direct line runs through it to the living generation.</div>
        <div class="go">Start with a person →</div>
      </a>
    </div>
  </section>
</Base>
