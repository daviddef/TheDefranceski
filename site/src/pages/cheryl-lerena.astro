---
import Base from "../layouts/Base.astro";
import d from "../data/cheryl.json";
const LIVING = "A living person (80 or younger, with no death recorded) is named with their relationships and their town and country, and nothing more.";
---
<Base title={d.name} eyebrow="mother" dek={LIVING} noindex>

<section class="blk">
  <p class="prose note living">{LIVING}</p>
  <dl class="plain">
    <dt>Relationships</dt>
    <dd>{d.rel.join("; ")}</dd>
    <dt>Town and country</dt>
    <dd>{d.place}</dd>
  </dl>
</section>

<style>
  .plain { margin: 20px 0 0; display: grid; grid-template-columns: max-content 1fr; gap: 6px 18px; max-width: 62ch; }
  .plain dt { font-size: 12px; letter-spacing: .08em; text-transform: uppercase; opacity: .6; font-weight: 600; padding-top: 3px; }
  .plain dd { margin: 0; }
</style>
</Base>
