---
import Base from "../layouts/Base.astro";
import Rule from "../components/Rule.astro";
import { u } from "../lib/url.js";
import d from "../data/cheryl.json";
const md = (s) => String(s ?? "")
  .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
  .replace(/\*(.+?)\*/g, "<em>$1</em>")
  .replace(/«(.+?)»/g, "<em>«$1»</em>")
  .replace(/\n\n/g, "</p><p>");
const P = (s) => `<p>${md(s)}</p>`;
---
<Base title={d.title} eyebrow={d.eyebrow} dek={d.dek}>

<section class="blk">
  <p class="prose note living" set:html={md(d.living)}></p>
  <div class="prose" style="margin-top:20px" set:html={P(d.lead)}></div>
</section>

<Rule name="pomegranate" label={d.preface.heading} />
<section class="blk"><div class="prose hi" set:html={P(d.preface.text)}></div></section>

<Rule name="arrows" label={d.bio.heading} />
<section class="blk"><div class="prose hi" set:html={P(d.bio.text)}></div></section>

<Rule name="pomegranate" label={d.tree.heading} />
<section class="blk">
  <p class="cap">{d.tree.note}</p>
  <figure class="ctree">
    {d.tree.tiers.map((t, i) => (
      <div class={"ctier" + (t.self ? " self" : "")}>
        <div class="tlab">{t.lab}</div>
        <div class="crow">{t.nodes.map(n => (
          n.slug
            ? <a class={"cnode via-" + n.via} href={u(`/who/${n.slug}/`)}>
                <span class="nm">{n.n}</span><span class="dt">{n.d}</span></a>
            : <span class={"cnode via-" + n.via}><span class="nm">{n.n}</span><span class="dt">{n.d}</span></span>
        ))}</div>
        {i < d.tree.tiers.length - 1 && <div class="cdrop" aria-hidden="true"></div>}
      </div>
    ))}
    <figcaption><p class="warn" set:html={md(d.tree.close)}></p></figcaption>
  </figure>
</section>

<Rule name="arrows" label={d.intro.heading} />
<section class="blk"><div class="prose" set:html={P(d.intro.text)}></div></section>

<Rule name="pomegranate" label={d.how.heading} />
<section class="blk"><div class="prose hi" set:html={P(d.how.text)}></div></section>

<Rule name="arrows" label="The collection, entire" />
<section class="blk">
  <div class="tsc">
    {d.transcript.map(x => (
      x.k === "prose"
        ? <div>
            {x.title && <h3 class="ttl">{x.title}</h3>}
            {x.l.filter(l => l !== "").map((l, i) => (
              <p class={"tp" + (x.restored ? " restored" : "") + (x.gap ? " gap" : "")}>{l}{x.restored && i === x.l.length - 1 && <span class="rst">restored from the original — the scan destroyed this paragraph</span>}</p>
            ))}
          </div>
        : x.k === "date"
          ? <div class="td">{x.l[0]}</div>
          : <figure class="tv">
              {x.no && <span class="tno">{x.no}</span>}
              {x.img && <img class="pimg" src={u(`/poems/${x.img}.jpg`)} alt="" loading="lazy" decoding="async" width="1000" height="670" />}
              {x.title && <h3 class="ttl">{x.title}</h3>}
              <div class="verse">{x.l.map(l => (l === "" ? <br /> : <span class="ln">{l}</span>))}</div>
              {x.titlenote && <p class="ttlnote">{x.titlenote}</p>}
              {x.note && <figcaption class="tnote"><span class="lab">The archive</span><span set:html={md(x.note)}></span></figcaption>}
            </figure>
    ))}
  </div>
</section>

<Rule name="pomegranate" label="What the archive makes of it" />
<section class="blk">
  <p class="prose note">Everything above is hers. Everything below is the archive's, and is set here rather than among her work.</p>
</section>

<Rule name="arrows" label={d.corona.heading} />
<section class="blk">
  <img class="pimg wide" src={u("/poems/corona.jpg")} alt="" loading="lazy" decoding="async" width="1000" height="670" />
  <div class="prose hi" set:html={P(d.corona.intro)}></div>
  <div class="prose" style="margin-top:20px" set:html={P(d.corona.close)}></div>
</section>

<Rule name="pomegranate" label={d.elegy.heading} />
<section class="blk">
  <img class="pimg wide" src={u("/poems/elegy-2021.jpg")} alt="" loading="lazy" decoding="async" width="1000" height="670" />
  <div class="prose hi" set:html={P(d.elegy.intro)}></div>
</section>

<Rule name="arrows" label={d.dark.heading} />
<section class="blk">
  <div class="prose" set:html={P(d.dark.text)}></div>
  <p class="prose pnote" set:html={md(d.dark.note)}></p>
</section>

<Rule name="pomegranate" label={d.jar.heading} />
<section class="blk jarhead">
  <img class="pimg wide" src={u(`/poems/${d.jar.img}.jpg`)} alt="" loading="lazy" decoding="async" width="1000" height="670" />
</section>
<section class="blk">
  <div class="prose hi" set:html={P(d.jar.intro)}></div>
  <h3 class="sh">{d.jar.shape.heading}</h3>
  <div class="prose" set:html={P(d.jar.shape.text)}></div>
  <div class="bars">
    {d.jar.shape.bars.map(([m, n]) => (
      <div class={"bar" + (n === 0 ? " zero" : "") + (m === "June" ? " june" : "")}>
        <span class="bm">{m}</span>
        <span class="bt"><i style={`width:${(n / 31) * 100}%`}></i></span>
        <span class="bn">{n === 0 ? "\u2014" : n}</span>
      </div>
    ))}
  </div>
  <h3 class="sh">{d.jar.june.heading}</h3>
  <div class="prose" set:html={P(d.jar.june.text)}></div>
  <div class="jrows">
    {d.jar.june.rows.map(([dt, tx]) => (
      <div class="jr"><span class="jd">{dt}</span><span class="jt" set:html={md(tx)}></span></div>
    ))}
  </div>
  <div class="prose hi" style="margin-top:22px" set:html={P(d.jar.june.close)}></div>
  <p class="prose note" style="margin-top:24px" set:html={md(d.jar.quiet)}></p>
</section>

<Rule name="arrows" label={d.books.heading} />
<section class="blk">
  <div class="prose hi" set:html={P(d.books.intro)}></div>
  <div class="bks">
    {d.books.rows.map(b => (
      <article class="bk">
        <header>
          <h3>{b.t}</h3>
          <p class="bsub" set:html={md(b.sub)}></p>
          <p class="bmeta"><span>{b.w}</span>{b.y !== "\u2014" && <span class="by">{b.y}</span>}</p>
        </header>
        <div class="prose" set:html={P(b.d)}></div>
      </article>
    ))}
  </div>
  <p class="prose note" style="margin-top:24px" set:html={md(d.books.close)}></p>
</section>

<Rule name="arrows" label={d.excluded.heading} />
<section class="blk"><div class="prose" set:html={P(d.excluded.text)}></div></section>

<Rule name="pomegranate" label={d.rest.heading} />
<section class="blk"><div class="prose" set:html={P(d.rest.text)}></div></section>

<Rule name="arrows" label={d.pending.heading} />
<section class="blk"><div class="prose" set:html={P(d.pending.text)}></div></section>

<Rule name="pomegranate" />
<section class="blk">
  <p class="prose note" set:html={md(d.art.note)}></p>
  <p class="cap src" style="margin-top:14px"><span class="lab">Source</span> <span set:html={md(d.source)}></span></p>
</section>

<style>
  .living { border-left: 3px solid #8a7f5c; padding-left: 14px; }
  .poem { margin: 0; max-width: 62ch; }
  .poem h2 { margin: 0 0 18px; font-size: 23px; font-style: italic; font-weight: 500; line-height: 1.25; }
  .verse { display: flex; flex-direction: column; gap: 3px; padding-left: 4px; }
  .verse .ln { font-size: 19px; line-height: 1.55; letter-spacing: .005em; }
  .verse br { display: block; content: ""; height: 14px; }
  .poem figcaption { margin-top: 22px; border-top: 1px solid var(--rule, #dcd6cc); padding-top: 12px; }
  .poem .occ { margin: 0; font-size: 13.5px; line-height: 1.6; opacity: .85; }
  .poem .conf { margin: 8px 0 0; font-size: 12.5px; opacity: .7; }
  .lab { font-size: 10.5px; letter-spacing: .08em; text-transform: uppercase; opacity: .6;
         font-weight: 600; margin-right: 6px; }
  .pnote { margin-top: 22px; max-width: 74ch; }
  .src { max-width: 80ch; }

  .seq { display: grid; gap: 26px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); margin-top: 26px; }
  .seqp { border-left: 2px solid var(--rule, #dcd6cc); padding-left: 16px; max-width: none; }
  .seqp .verse .ln { font-size: 15.5px; line-height: 1.5; }
  .poem .dt { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; opacity: .55;
              font-weight: 600; margin-bottom: 10px; }

  .sh { font-size: 18px; margin: 30px 0 12px; }
  .bars { display: flex; flex-direction: column; gap: 5px; margin-top: 20px; max-width: 460px; }
  .bar { display: grid; grid-template-columns: 6.5rem 1fr 2rem; align-items: center; gap: 10px; font-size: 13px; }
  .bar .bt { height: 10px; background: rgba(0,0,0,.07); border-radius: 2px; overflow: hidden; }
  .bar .bt i { display: block; height: 100%; background: #8a7f5c; }
  .bar .bn { text-align: right; font-variant-numeric: tabular-nums; opacity: .7; }
  .bar.june .bt i { background: #a3402f; }
  .bar.june .bm, .bar.june .bn { font-weight: 700; }
  .bar.zero .bm, .bar.zero .bn { opacity: .45; }
  .jrows { display: flex; flex-direction: column; gap: 10px; margin-top: 18px; max-width: 76ch; }
  .jr { display: grid; grid-template-columns: 7.5rem 1fr; gap: 12px; align-items: baseline;
        border-left: 2px solid var(--rule, #dcd6cc); padding-left: 14px; }
  .jd { font-size: 11px; letter-spacing: .07em; text-transform: uppercase; opacity: .55; font-weight: 600; }
  .jt { font-size: 14.5px; line-height: 1.6; }
  @media (prefers-color-scheme: dark) { .bar .bt { background: rgba(255,255,255,.1); } }

  .bks { display: flex; flex-direction: column; gap: 26px; margin-top: 26px; }
  .bk { border-left: 3px solid #8a7f5c; padding-left: 18px; max-width: 78ch; }
  .bk h3 { margin: 0; font-size: 20px; line-height: 1.25; }
  .bsub { margin: 4px 0 0; font-size: 13.5px; opacity: .75; font-style: italic; }
  .bmeta { margin: 8px 0 12px; display: flex; gap: 14px; font-size: 11.5px; letter-spacing: .05em;
           text-transform: uppercase; opacity: .6; font-variant-numeric: tabular-nums; }
  .bk .prose p { font-size: 14.5px; }

  .ctree { margin: 18px 0 0; }
  .ctier { position: relative; }
  .ctier .tlab { font-size: 10.5px; letter-spacing: .09em; text-transform: uppercase; opacity: .5;
                 font-weight: 600; margin-bottom: 8px; }
  .crow { display: flex; flex-wrap: wrap; gap: 8px; }
  .cdrop { height: 18px; width: 1px; margin: 8px 0 8px 26px; background: var(--rule, #dcd6cc); }
  .cnode { display: flex; flex-direction: column; gap: 2px; text-decoration: none; color: inherit;
           border: 1px solid var(--rule, #dcd6cc); border-left-width: 3px; border-radius: 3px;
           padding: 8px 13px; min-width: 150px; max-width: 300px; }
  a.cnode:hover { background: rgba(138,127,92,.09); }
  .cnode .nm { font-size: 14.5px; line-height: 1.25; font-weight: 500; }
  .cnode .dt { font-size: 11.5px; opacity: .62; }
  .via-doc { border-left-color: #8a7f5c; }
  .via-lore { border-left-color: #b0a89a; border-left-style: dashed; }
  .via-living { border-left-color: #6d7f8a; }
  .via-me { border-left-color: #3f5c3f; border-width: 2px; border-left-width: 4px;
            background: rgba(92,122,92,.08); }
  .via-me .nm { font-weight: 700; font-size: 16px; }
  .ctier.self .crow { padding: 12px 0; }
  .ctree figcaption { margin-top: 18px; }
  .ctree .warn { font-size: 14px; line-height: 1.6; border-left: 3px solid #8a7f5c; padding-left: 12px; margin: 0; }
  .jarhead { display: flex; justify-content: center; padding-top: 4px; }
  .jarsvg { width: 92px; height: auto; color: #8a7f5c; opacity: .85; }

  .pimg { display: block; width: 100%; max-width: 560px; height: auto; border-radius: 3px;
          margin: 0 0 20px; border: 1px solid var(--rule, #dcd6cc); }
  .pimg.wide { max-width: 760px; margin-bottom: 24px; }
  .jarhead { display: block; }
  .jarhead .pimg { margin-left: auto; margin-right: auto; }

  .seqp .dt .sub { text-transform: none; letter-spacing: 0; font-weight: 400; opacity: .85; }

  .pno { display: inline-block; min-width: 2.1em; font-variant-numeric: tabular-nums; opacity: .38;
         font-weight: 400; font-style: normal; font-size: .62em; vertical-align: middle; }
  .pno.sm { min-width: 1.9em; font-size: 1em; opacity: .45; }

  .tsc { max-width: 74ch; }
  .tp { font-size: 15px; line-height: 1.75; margin: 26px 0 0; opacity: .92; }
  .td { font-size: 12px; letter-spacing: .1em; text-transform: uppercase; opacity: .55; font-weight: 600;
        margin: 34px 0 -6px; font-variant-numeric: tabular-nums; }
  .tv { margin: 22px 0 0; position: relative; padding-left: 0; }
  .tno { display: block; font-size: 11px; letter-spacing: .08em; opacity: .35; font-variant-numeric: tabular-nums;
         margin-bottom: 8px; }
  .tv .verse { display: flex; flex-direction: column; gap: 2px; }
  .tv .verse .ln { font-size: 17px; line-height: 1.55; }
  .tv .verse br { display: block; content: ""; height: 12px; }
  .tv .pimg { max-width: 460px; margin-bottom: 16px; }

  .tnote { margin-top: 14px; border-left: 2px solid #8a7f5c; padding-left: 12px; font-size: 13.5px;
           line-height: 1.65; opacity: .88; max-width: 66ch; }
  .tnote .lab { display: block; font-size: 10px; letter-spacing: .1em; text-transform: uppercase;
                opacity: .5; font-weight: 600; margin-bottom: 4px; }

  .ttl { margin: 64px 0 14px; font-size: 21px; font-style: italic; font-weight: 500; line-height: 1.25; }
  .ttlnote { margin: 10px 0 0; font-size: 12.5px; opacity: .6; line-height: 1.6; max-width: 62ch; }

  .vfy { display: inline-block; margin-left: 10px; font-size: 9.5px; letter-spacing: .09em;
         text-transform: uppercase; font-style: normal; font-weight: 600; opacity: .5;
         border: 1px solid var(--rule, #dcd6cc); border-radius: 999px; padding: 2px 8px; vertical-align: middle; }

  .tp.restored { border-left: 2px solid #8a7f5c; padding-left: 14px; }
  .rst { display: block; margin-top: 8px; font-size: 10.5px; letter-spacing: .07em; text-transform: uppercase; opacity: .5; }

  .tp.gap { opacity: .6; font-style: italic; border-left: 2px dashed var(--rule, #dcd6cc); padding-left: 14px; }

  .tsc > * + * { margin-top: 4px; }
  .tsc > div { margin-top: 0; }
  .tsc .ttl:first-child { margin-top: 64px; }
  .tv { margin-top: 40px; }
  .tv .ttl { margin-top: 0; }
  .tp { margin-top: 20px; }
  .tsc > div > .tp { margin-top: 0; }
  .td { margin-top: 40px; }
</style>
</Base>
