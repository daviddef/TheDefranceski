---
import Base from "../layouts/Base.astro";
import registers from "../data/registers.json";
import fs from "../data/familysearch.json";
import recs from "../data/fsrecords.json";
const kinds={MKR:"Baptisms",MKV:"Marriages",MKU:"Burials",SD:"Household census",MK:"Register"};
const places=[...new Set(registers.map(r=>r.place))].sort();
const dig=registers.filter(r=>r.digitised==="yes").length;
---
<Base title="The Archive" eyebrow={`${registers.length} registers catalogued`}
      dek="Read directly from the State Archives in Pazin inventory. This is not a plan — these are books that exist, with dates, custodians and digitisation status.">

<section class="blk">
  <div class="grid g4">
    <div class="stat"><div class="n">{registers.length}</div><div class="l">registers catalogued across nine parishes</div></div>
    <div class="stat"><div class="n">{dig}</div><div class="l">digitised — {Math.round(dig/registers.length*100)}% of the total</div></div>
    <div class="stat"><div class="n">1582</div><div class="l">earliest book — Pazin baptisms</div></div>
    <div class="stat"><div class="n">4</div><div class="l">separate custodians, each with its own door</div></div>
  </div>
  <div class="note" style="margin-top:28px">Custody codes: <b>ŽU</b> parish office, still in the village · <b>BA Poreč</b> diocesan archive of Poreč-Pula · <b>DAPA</b> State Archives in Pazin · <b>MU</b> civil registry office. The State Archives states publicly that its staff do not undertake genealogical research, will not act on a request lacking a name, an approximate period and a place, and will not review large quantities of material. Research is done by the user in the reading room, by appointment.</div>
</section>

<section class="blk">
  <h2>Search the holdings</h2>
  <div class="filters">
    <label>Parish <select id="f-place"><option value="">All</option>{places.map(p=><option>{p}</option>)}</select></label>
    <label>Type <select id="f-kind"><option value="">All</option>{Object.entries(kinds).map(([k,v])=><option value={k}>{v}</option>)}</select></label>
    <label>Digitised <select id="f-dig"><option value="">All</option><option value="yes">Yes</option><option value="no">No</option></select></label>
    <span class="count" id="f-count"></span>
  </div>
  <div class="scroll" style="margin-top:18px">
    <table id="regtable">
      <thead><tr><th>Parish</th><th>Type</th><th class="m">Period</th><th>Held at</th><th class="m">Digitised</th></tr></thead>
      <tbody>{registers.map(r=>(
        <tr data-place={r.place} data-kind={r.type} data-dig={r.digitised}>
          <td>{r.place}</td><td>{kinds[r.type]||r.type}</td><td class="m">{r.period}</td>
          <td>{r.held_at}</td>
          <td class="m" style={r.digitised==="yes"?"color:var(--accent)":"color:var(--terra)"}>{r.digitised}</td>
        </tr>
      ))}</tbody>
    </table>
  </div>
</section>

<script is:inline>
(function(){
  var rows=[].slice.call(document.querySelectorAll('#regtable tbody tr'));
  var f=['place','kind','dig'].map(function(k){return document.getElementById('f-'+k)});
  var out=document.getElementById('f-count');
  function apply(){
    var v=f.map(function(s){return s.value});
    var n=0;
    rows.forEach(function(r){
      var ok=(!v[0]||r.dataset.place===v[0])&&(!v[1]||r.dataset.kind===v[1])&&(!v[2]||r.dataset.dig===v[2]);
      r.hidden=!ok; if(ok)n++;
    });
    out.textContent=n+' of '+rows.length+' registers';
  }
  f.forEach(function(s){s.addEventListener('change',apply)});
  apply();
})();
</script>

<section class="blk">
  <h2>What FamilySearch holds — the microfilm</h2>
  <p class="dek">The Pazin inventory covers Istria. For Kvarner, Dalmatia and Carnia the films are the way in — made by the Genealogical Society of Utah from originals in Zagreb, Zadar and Udine, and viewable with a free account.</p>
  <div class="scroll" style="margin-top:22px">
    <table>
      <thead><tr><th>Place</th><th>Parish or office</th><th>Series</th><th class="m">Covers</th><th>Filmed from</th></tr></thead>
      <tbody>{fs.rows.map(r=>(
        <tr><td>{r[0]}</td><td>{r[1]}</td><td>{r[2]}</td><td class="m">{r[3]}</td><td>{r[4]}</td></tr>
      ))}</tbody>
    </table>
  </div>
  <p class="cap">{fs.source}</p>
  <div class="note" style="margin-top:24px">Two results matter most here. <b>Omiš opens in 1588</b> — two years before Gaspar de Franceschi is said to have owned a warship there — so the Dalmatian family's earliest claim is testable. And <b>Ovaro has no parish books on film at all</b>, only the Napoleonic civil registration, which confirms that the Carnian church registers before 1806 exist nowhere online and must be asked for at the parish.</div>
</section>

<section class="blk">
  <h2>The indexed records</h2>
  <p class="dek">Beyond the film, the name index. A search of the Croatian church books returns 3,652 hits for this surname; 2,388 of them are genuine variants rather than Franchini or Francetich, and 2,200 are distinct people.</p>
  <div class="grid g3" style="margin-top:24px">
    <div class="stat"><div class="n">2,200</div><div class="l">distinct indexed people in Croatia</div></div>
    <div class="stat"><div class="n">1619</div><div class="l">earliest — Pietro De Franceschi</div></div>
    <div class="stat"><div class="n">447</div><div class="l">at Rijeka, the largest single cluster</div></div>
  </div>
  <div class="scroll" style="margin-top:26px">
    <table>
      <thead><tr><th>Cluster</th><th class="m">Indexed records</th></tr></thead>
      <tbody>{fs.clusters.sort((a,b)=>b[1]-a[1]).map(c=>(
        <tr><td>{c[0]}</td><td class="m">{c[1]}</td></tr>))}</tbody>
    </table>
  </div>
  <h3 class="lab" style="margin-top:38px">And worldwide</h3>
  <div class="scroll" style="margin-top:16px">
    <table>
      <thead><tr><th>Country</th><th class="m">Index hits</th></tr></thead>
      <tbody>{Object.entries(fs.counts.worldwide).map(([k,v])=>(
        <tr><td>{k}</td><td class="m">{v.toLocaleString()}</td></tr>))}</tbody>
    </table>
  </div>
  <p class="cap">Country figures are raw index hits and are fuzzy — they include Franceschi, Franceschini and De Francesco. They show where to look, not how many people are ours. The search interface stops returning new results past about 1,100 per query, so exhaustive worldwide harvesting needs the query split by spelling and place; that work is not finished.</p>
</section>

<section class="blk">
  <h2>The named dead</h2>
  <p class="dek">388 individuals recovered from the index with a name, a date and, usually, their parents — the raw material every other page here is built from.</p>
  <div class="filters">
    <label>Place <select id="r-place"><option value="">All</option></select></label>
    <label>Century <select id="r-cent"><option value="">All</option><option>15</option><option>16</option><option>17</option><option>18</option><option>19</option></select></label>
    <span class="count" id="r-count"></span>
  </div>
  <div class="scroll" style="margin-top:18px">
    <table id="rectable">
      <thead><tr><th>Name</th><th class="m">Born</th><th class="m">Died / buried</th><th>Place</th><th>Parents, or spouse</th></tr></thead>
      <tbody>{recs.map(r=>(
        <tr data-place={(r.place||"").split(",")[0].trim()} data-y={((r.birth+" "+r.death+" "+r.burial).match(/1[5-9]\d\d/)||[""])[0]}>
          <td>{r.name}</td><td class="m">{r.birth}</td><td class="m">{r.death||r.burial}</td>
          <td>{(r.place||"").split(",")[0]}</td><td>{r.parents||r.spouses}</td></tr>
      ))}</tbody>
    </table>
  </div>
  <p class="cap">From FamilySearch's index of the Croatian church books. Spelling and Latin case endings are the clerk's. Where a place reads only “Croazia, Austria” the index did not localise it further; those are mostly Istrian and Kvarner parishes.</p>
</section>

<script is:inline>
(function(){
  var rows=[].slice.call(document.querySelectorAll('#rectable tbody tr'));
  var sel=document.getElementById('r-place'), cent=document.getElementById('r-cent'), out=document.getElementById('r-count');
  var places={};
  rows.forEach(function(r){var p=r.dataset.place; if(p) places[p]=(places[p]||0)+1;});
  Object.keys(places).sort(function(a,b){return places[b]-places[a]}).forEach(function(p){
    var o=document.createElement('option'); o.textContent=p+' ('+places[p]+')'; o.value=p; sel.appendChild(o);});
  function apply(){
    var n=0;
    rows.forEach(function(r){
      var okP=!sel.value||r.dataset.place===sel.value;
      var okC=!cent.value||(r.dataset.y&&r.dataset.y.slice(0,2)===cent.value);
      r.hidden=!(okP&&okC); if(okP&&okC)n++;});
    out.textContent=n+' of '+rows.length+' people';
  }
  sel.addEventListener('change',apply); cent.addEventListener('change',apply); apply();
})();
</script>
</Base>
