---
import Base from "../layouts/Base.astro";
import Household from "../components/Household.astro";
import hs from "../data/households.json";
import Lineage from "../components/Lineage.astro";
import lin from "../data/lineages.json";
const male = hs.filter(h => h.line !== 'female');
const female = hs.filter(h => h.line === 'female');
const big = male.filter(h => h.n >= 4);
const rest = male.filter(h => h.n === 3);
const byPlace = {};
for (const h of hs) { const p = h.place || "not localised"; byPlace[p] = (byPlace[p]||0) + 1; }
const infant = hs.reduce((s,h) => s + h.children.filter(c => {
  const b=+((c.birth||'').match(/1[5-9]\d\d/)?.[0]||0), d=+((c.death||'').match(/1[5-9]\d\d/)?.[0]||0);
  return b && d && (d-b) <= 5; }).length, 0);
const kids = hs.reduce((s,h)=>s+h.n,0);
---
<Base title="Households" eyebrow={`${hs.length} families reconstructed from the registers`}
      dek="Not a family tree handed down — a family tree rebuilt. Each of these is a set of siblings who name the same two parents in the index, grouped and de-duplicated across Latin case endings and spelling drift.">

<section class="blk">
  <div class="grid g4">
    <div class="stat"><div class="n">{hs.length}</div><div class="l">households with two or more recorded children</div></div>
    <div class="stat"><div class="n">{kids}</div><div class="l">children placed with their parents</div></div>
    <div class="stat"><div class="n">{infant}</div><div class="l">who did not reach five years old</div></div>
    <div class="stat"><div class="n">1645</div><div class="l">earliest reconstructed household</div></div>
  </div>
  <div class="note" style="margin-top:28px">How this is built, and where it can be wrong. Each indexed record names its parents. Grouping records by a normalised parent pair recovers the sibling set — but the index writes the same man as <em>Valentino</em>, <em>Valentini</em> and <em>Valentinus</em>, and the same woman as <em>Ursula</em>, <em>Ursulæ</em> and <em>Orsola</em>, so a normaliser collapses Latin case endings and known spelling variants before grouping. Two different men of the same name in the same parish will merge wrongly. Every household here is <span class="chip inf" style="padding:2px 7px;font-size:10px">Inferred</span> and needs the register page to confirm it.</div>
</section>

<section class="blk">
  <h2>The large households</h2>
  <p class="dek">Four or more children recorded. Dashed cards are children who died before their fifth birthday.</p>
  <div class="stack" style="margin-top:26px">
    {big.map(h => <Household h={h} />)}
  </div>
</section>

<section class="blk">
  <h2>The daughters' households</h2>
  <p class="dek">Found by searching the in-law families rather than our own: {female.length} households where a Defranceschi woman is the mother. This is the half of the family the surname loses.</p>
  <div class="stack" style="margin-top:26px">
    {female.map(h => <Household h={h} />)}
  </div>
  <div class="note" style="margin-top:26px">These come from sweeping 33 in-law surnames through the index and keeping only records that name our family — 209 of them. <strong>Francesca Defranceschi and Giovanni Bergamo</strong> had seven children between 1831 and 1846. <strong>Jacoba Defranceschi married a Johannes Baptista Crosilla</strong> — the Crosilla being one of the leading houses of Mione — and their children are recorded in 1831 and 1833; she was buried as his wife in 1882. Two more daughters married a Moscarda and a Tamborin at Fažana within a year of each other.</div>
</section>

<section class="blk">
  <h2>Smaller groups</h2>
  <p class="dek">Three recorded children — often a household whose register years are only partly indexed.</p>
  <div class="grid g2" style="margin-top:24px">
    {rest.map(h => <Household h={h} />)}
  </div>
</section>

<section class="blk">
  <h2>Where they sit</h2>
  <div class="scroll" style="margin-top:20px">
    <table><thead><tr><th>Place</th><th class="m">Households</th></tr></thead>
    <tbody>{Object.entries(byPlace).sort((a,b)=>b[1]-a[1]).map(([p,n])=>(
      <tr><td>{p}</td><td class="m">{n}</td></tr>))}</tbody></table>
  </div>
</section>

<section class="blk">
  <h2>Linked into lineages</h2>
  <p class="dek">A household is the child of another when a recorded child of the first grew up to be the father named in the second. {lin.links.length} such links survive the tests; {lin.ambiguous.length} candidates were too ambiguous to draw.</p>

  <div class="note" style="margin-top:24px">The tests: the normalised given name must match; the man must be male and not have died in childhood; the gap between his own baptism and his first recorded child must fall between 17 and 48 years; the parishes must be compatible; and descent is never drawn across regions on a bare name match. A link is <b>strong</b> only when there is exactly one candidate, the parish is the same, and the generation gap is ordinary. Everything else is <b>probable</b>. None of it is proven — two men of one name in one parish is the ordinary case, not the exception.</div>

  {lin.lineages.map(L => (
    <div style="margin-top:34px">
      <div class="lab">{L.generations} generations · {L.size} households</div>
      <div style="margin-top:14px"><Lineage node={L.tree} /></div>
    </div>
  ))}
</section>

{lin.ambiguous.length > 0 && (
<section class="blk">
  <h2>Too ambiguous to draw</h2>
  <p class="dek">Where two or more men of the same name could equally be the father. Published because the next person to read the register pages will resolve them in an afternoon.</p>
  <div class="grid g2" style="margin-top:24px">
    {lin.ambiguous.map(a => {
      const h = hs.find(x => x.id === a.household);
      return (
        <div class="ambig">
          <div class="q">{h.father} &amp; {h.mother}</div>
          <div class="mono" style="color:var(--ink-3);margin-top:4px">{h.place || "not localised"} · from {h.from}</div>
          <ul>{a.options.map(o => {
            const p = hs.find(x => x.id === o.parent);
            return <li>could be the son of <b>{p.father}</b> &amp; {p.mother} — through {o.via}, {o.gap}y</li>;
          })}</ul>
        </div>
      );
    })}
  </div>
</section>
)}
</Base>
