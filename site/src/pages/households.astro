---
import Base from "../layouts/Base.astro";
import { md as _md } from "../lib/md.js";
import { u } from "../lib/url.js";
import Rule from "../components/Rule.astro";
import Sources from "../components/Sources.astro";
import Households from "@daviddef/archive-kit/components/Households.astro";
import hs from "../data/households.json";
import Lineage from "../components/Lineage.astro";
import lin from "../data/lineages.json";
import dl from "../data/directline.json";
import roster from "../data/roster.json";
import { norm } from "../lib/people.js";

/* THE LIVING, ON THIS PAGE.
   The archive's rule is that a living person is named and nothing more. The
   build's check:living enforces it — but only for dates the DATA attaches to
   that person, and the roster deliberately carries `b: null` for everyone it
   flags living. A birth year sitting in households.json is therefore invisible
   to the checker: it never learns the year belongs to them. Two of these were
   already reaching the page through the exactly-three bucket.
   So the suppression is done here, on the same two tests the kit itself uses:
   the data's own living flag, and its PRESUME_DEAD_AFTER = 80. */
const NOW = new Date().getFullYear();
const PRESUME_DEAD_AFTER = 80;
const flaggedLiving = new Set(
  roster.rows.filter(r => r.living || r.presumedLiving || r.alive || r.isLiving
                     || String(r.conf || "").toLowerCase() === "living")
             .map(r => norm(r.name)));
/* `dead` is for someone known to have died whose year this archive does not
   have. Without it the age rule below would keep withholding their dates for
   another few decades on the strength of a death it has already been told
   about. A recorded death — with or without a year — ends the question. */
const maybeLiving = (c) =>
  !c.dy && !c.dead && (
    flaggedLiving.has(norm(c.name)) ||
    (c.by && (NOW - c.by) < PRESUME_DEAD_AFTER));
/* Which of these households is a generation of the direct line? The tree shows
   those eight as couples; this page should say which of them they are. */
const onTree = new Map();
for (const g of dl.generations) {
  if (!g.spouse) continue;
  const a = norm(g.name), bs = norm(g.spouse.name).split(" ").pop();
  const cand = hs.filter(x => norm(x.father) === a && norm(x.mother).split(" ").pop() === bs);
  const one = new Set(cand.map(x => norm(x.father) + "|" + norm(x.mother))).size === 1;
  if (cand.length && one) for (const c of cand) onTree.set(c.key, g.n);
}
const male = hs.filter(h => h.line !== 'female');
const female = hs.filter(h => h.line === 'female');
const big = male.filter(h => h.n >= 4);
const rest = male.filter(h => h.n === 3);
/* Households of one or two children. These were built, counted in every total
   on this page, and then rendered by nothing: `big` took four and up, `rest`
   took exactly three, and sixty-five fell through the gap between the two.
   They are the weakest form of this reconstruction and the most numerous, so
   they get their own section rather than being folded in with the threes. */
const pairs = male.filter(h => h.n <= 2);
const byPlace = {};
for (const h of hs) { const p = h.place || "not localised"; byPlace[p] = (byPlace[p]||0) + 1; }
const infant = hs.reduce((s,h) => s + h.children.filter(c => {
  const b=+((c.birth||'').match(/1[5-9]\d\d/)?.[0]||0), d=+((c.death||'').match(/1[5-9]\d\d/)?.[0]||0);
  return b && d && (d-b) <= 5; }).length, 0);
const kids = hs.reduce((s,h)=>s+h.n,0);

/* The card carries what the diagram carried: the couple, the children, and the
   ones who did not reach five. The short-life rule is this archive's own,
   promoted into the shared component, so it is computed here the same way and
   handed over rather than re-derived from a printed string. */
const shape = (h) => ({
  head: h.father, spouse: h.mother, where: h.place,
  /* The card's year range is the span of the children's births, so it leaks
     exactly the dates the rule above withholds. Derive it from the children
     whose dates are actually shown; a household of only living children
     carries no range at all. */
  born: (() => {
    const ys = (h.children || []).filter(c => !maybeLiving(c) && c.by).map(c => c.by);
    if (!ys.length) return "";
    const lo = Math.min(...ys), hi = Math.max(...ys);
    return lo === hi ? String(lo) : `${lo}\u2013${hi}`;
  })(),
  /* `confirmed` and `read` are both PROSE, present on every household - the
     first says what makes the couple a couple, the second what has been read
     under it. Treating either as a boolean puts "confirmed by a marriage
     register" on sixty households, forty-five of which say in their own words
     that no register has been read. The word comes from the reading note. */
  via: /index entries only/i.test(h.read || "") || !h.read
    ? "index only" : "a register read",
  note: [
    onTree.has(h.key) ? `<strong>Generation ${onTree.get(h.key)} of the direct line.</strong>` : "",
    h.confirmed ? _md(h.confirmed) : "",
    h.read ? `<span style="display:block;margin-top:6px">${_md(h.read)}</span>` : "",
  ].filter(Boolean).join(" "),
  children: (h.children || []).map((c) => {
    const hide = maybeLiving(c);
    return {
      name: c.name,
      /* Name and nothing more, for anyone who may still be alive. */
      dates: hide ? "" : (c.by && c.dy ? `${c.by}\u2013${c.dy}` : (c.by ? String(c.by) : "")),
      short: !hide && !!(c.by && c.dy && c.dy - c.by <= 5),
    };
  }),
});
---
<Base title="Households" eyebrow={`${hs.length} families reconstructed from the registers`}
      dek="Not a family tree handed down — a family tree rebuilt. Each of these is a set of siblings who name the same two parents in the index, grouped and de-duplicated across Latin case endings and spelling drift.">

<section class="blk">
  <div class="grid g4">
    <div class="stat"><div class="n">{hs.length}</div><div class="l">households reconstructed from the registers</div></div>
    <div class="stat"><div class="n">{kids}</div><div class="l">children placed with their parents</div></div>
    <div class="stat"><div class="n">{infant}</div><div class="l">who did not reach five years old</div></div>
    <div class="stat"><div class="n">1645</div><div class="l">earliest reconstructed household</div></div>
  </div>
  <div class="note" style="margin-top:28px">How this is built, and where it can be wrong. Each indexed record names its parents. Grouping records by a normalised parent pair recovers the sibling set — but the index writes the same man as <em>Valentino</em>, <em>Valentini</em> and <em>Valentinus</em>, and the same woman as <em>Ursula</em>, <em>Ursulæ</em> and <em>Orsola</em>, so a normaliser collapses Latin case endings and known spelling variants before grouping. Two different men of the same name in the same parish will merge wrongly. Every household here is <span class="chip inf" style="padding:2px 7px;font-size:10px">Inferred</span> and needs the register page to confirm it.</div>
  <div class="note" style="margin-top:16px"><strong>Seven of them no longer are.</strong> On 9 September 2026 the Vodnjan marriage register — which no index anywhere contains — was read opening by opening, and it confirmed four of these households <em>from the weddings that made them</em>, naming both sets of parents. It also produced <strong>three households the baptism index could never have seen</strong>, including one whose husband and wife appear in no register on any film this archive can reach: they exist only because their widowed daughter remarried at forty-nine and the clerk wrote her parents out in full. Those seven carry the reading beneath them. <a href={u("/fiume-1626/")}>How they were read →</a></div>
</section>
<Rule name="arrows" />

<section class="blk">
  {onTree.size > 0 && (
    <a class="hh-tree" href={u("/tree/")}>
      <span class="hh-k">{onTree.size === 1 ? `One of these ${hs.length} is on the tree` : `${onTree.size} of these ${hs.length} are on the tree`}</span>
      <span class="hh-t">{onTree.size === 1 ? "Generation" : "Generations"} {[...onTree.values()].sort((a,b)=>a-b).join(", ")} of the direct line {onTree.size === 1 ? "is" : "are"} among the households below.
        The tree shows each of them as the couple it was, with its children, its evidence and its open questions →</span>
    </a>
  )}

  <h2>The large households</h2>
  <p class="dek">Four or more children recorded. Dashed cards are children who died before their fifth birthday.</p>
  <div class="stack" style="margin-top:26px">
    <Households rows={big.map(shape)} u={u} caveat={false} />
  </div>
</section>
<Rule name="pomegranate" />

<section class="blk">
  <h2>The daughters' households</h2>
  <p class="dek">{female.length} households where a Defranceschi woman is the mother. This is the half of the family the surname loses.</p>
  <div class="note" style="margin-top:14px"><strong>This section showed eight of them until 22 September 2026.</strong> Eight were built on purpose, by sweeping 33 in-law surnames through the index and keeping only records that name our family. The other twenty-seven arrived through the ordinary baptism sweep and were never re-read: they sat among the households <em>of</em> the name, counted as though the surname had carried on through them. <strong>A household belongs here whenever the mother carries the name and the father does not</strong>, and that is now decided by the data rather than by which sweep found it. Three more were listing the wife in the father's slot. <a href={u("/corrections/")}>What was wrong →</a></div>
  <div class="stack" style="margin-top:26px">
    <Households rows={female.map(shape)} u={u} sort="given" caveat={false} />
  </div>
  <div class="note" style="margin-top:26px">These come from sweeping 33 in-law surnames through the index and keeping only records that name our family — 209 of them. <strong>Francesca Defranceschi and Giovanni Bergamo</strong> had seven children between 1831 and 1846. <strong>Jacoba Defranceschi married a Johannes Baptista Crosilla</strong> — the Crosilla being one of the leading houses of Mione — and their children are recorded in 1831 and 1833; she was buried as his wife in 1882. Two more daughters married a Moscarda and a Tamborin at Fažana within a year of each other.</div>
</section>
<Rule name="helm" />

<section class="blk">
  <h2>Smaller groups</h2>
  <p class="dek">Three recorded children — often a household whose register years are only partly indexed.</p>
  <div class="grid g2" style="margin-top:24px">
    <Households rows={rest.map(shape)} u={u} sort="given" caveat={false} />
  </div>
</section>
<Rule name="tablet" />

<section class="blk">
  <h2>One or two children</h2>
  <p class="dek">{pairs.length} households — the largest group on this page, and the weakest. A pair of siblings naming the same parents is the thinnest thing this method will call a household.</p>
  <div class="note" style="margin-top:20px"><strong>These were built and then shown nowhere.</strong> Until now the page rendered four-or-more, exactly-three, and the daughters' households — and everything with one or two children fell through the gap between those buckets. They were counted in every total at the top of this page while being impossible to read. That is fixed here rather than by quietly dropping them from the counts: they are real groupings from real records, and a reader is owed the chance to judge how thin they are.</div>
  <div class="grid g2" style="margin-top:24px">
    <Households rows={pairs.map(shape)} u={u} sort="given" caveat={false} />
  </div>
</section>
<Rule name="tablet" />

<section class="blk">
  <h2>Where they sit</h2>
  <div class="scroll" style="margin-top:20px">
    <table><thead><tr><th>Place</th><th class="m">Households</th></tr></thead>
    <tbody>{Object.entries(byPlace).sort((a,b)=>b[1]-a[1]).map(([p,n])=>(
      <tr><td>{p}</td><td class="m">{n}</td></tr>))}</tbody></table>
  </div>
</section>
<Rule name="arcade" />

<section class="blk">
  <h2>Linked into lineages</h2>
  <p class="dek">A household is the child of another when a recorded child of the first grew up to be the father named in the second. {lin.links.length} such links survive the tests; {lin.ambiguous.length} candidates were too ambiguous to draw.</p>

  <div class="note" style="margin-top:24px">The tests: the normalised given name must match; the man must be male and not have died in childhood; the gap between his own baptism and his first recorded child must fall between 17 and 48 years; the parishes must be compatible; and descent is never drawn across regions on a bare name match. A link is <b>strong</b> only when there is exactly one candidate, the parish is the same, and the generation gap is ordinary. Everything else is <b>probable</b>. None of it is proven — two men of one name in one parish is the ordinary case, not the exception.</div>

  {lin.lineages.map(L => (
    <div style="margin-top:34px">
      <div class="lab">{L.generations} generations · {L.size} households</div>
      <div style="margin-top:14px"><Lineage node={L.tree} /></div>
    </div>
  ))}
</section>

{lin.ambiguous.length > 0 && (
<Rule name="loom" />
<section class="blk">
  <h2>Too ambiguous to draw</h2>
  <p class="dek">Where two or more men of the same name could equally be the father. Published because the next person to read the register pages will resolve them in an afternoon.</p>
  <div class="grid g2" style="margin-top:24px">
    {lin.ambiguous.map(a => {
      const h = hs.find(x => x.id === a.household);
      return (
        <div class="ambig">
          <div class="q">{h.father} &amp; {h.mother}</div>
          <div class="mono" style="color:var(--ink-3);margin-top:4px">{h.place || "not localised"} · from {h.from}</div>
          <ul>{a.options.map(o => {
            const p = hs.find(x => x.id === o.parent);
            return <li>could be the son of <b>{p.father}</b> &amp; {p.mother} — through {o.via}, {o.gap}y</li>;
          })}</ul>
        </div>
      );
    })}
  </div>
</section>
)}
  <Sources ids={["familysearch"]} />
<style>
  .hh-tree { display:block; margin: 4px 0 22px; padding: 11px 14px; text-decoration: none;
             border-left: 3px solid var(--accent); background: var(--panel); }
  .hh-k { display:block; font-family: var(--sans); font-size: 10.5px; letter-spacing:.12em;
          text-transform: uppercase; color: var(--accent); }
  .hh-t { display:block; margin-top: 4px; font-size: 13.5px; color: var(--ink-2); line-height: 1.55; }
</style>
</Base>
