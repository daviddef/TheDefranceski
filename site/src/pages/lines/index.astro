---
import Base from "../../layouts/Base.astro";
import Rule from "../../components/Rule.astro";
import Sources from "../../components/Sources.astro";
import Chip from "../../components/Chip.astro";
import JourneyMap from "../../components/JourneyMap.astro";
import { u } from "../../lib/url.js";
import lines from "../../data/lines.json";
import fam from "../../data/families.json";
import BranchRivers from "../../components/BranchRivers.astro";
import arr from "../../data/arrivals.json";
import reg from "../../data/regions.json";
import Plates from "../../components/Plates.astro";
import Lightbox from "../../components/Lightbox.astro";
---
<Base title="The Lines" eyebrow="Five families · five unplaced clusters · one very common name"
      dek="Separating three things this site had been adding together: a family is an origin, a station is a stop on one family's road, and a namesake is somebody who happens to share the commonest patronymic in Italy.">
<section class="blk">
  <h2>{fam.heading}</h2>
  <p class="dek" style="margin-top:10px">{fam.lead}</p>
  <div style="margin-top:22px;display:flex;flex-direction:column;gap:16px">
    {fam.why.map(r => (
      <div class="one" style={r.key ? "border-left-color:var(--accent)" : ""}>
        <div class="lab">{r.lab}</div>
        <p style="margin-top:8px;white-space:pre-line" set:html={r.text.replace(/\*\*(.+?)\*\*/g,"<strong>$1</strong>").replace(/(^|[^*])\*([^*\n]+?)\*/g,"$1<em>$2</em>")}></p>
      </div>
    ))}
  </div>

  <h3 id="families" style="font-size:23px;margin-top:40px">The five families</h3>
  <div class="famgrid">
    {fam.families.map(f => (
      <a id={"fam-" + f.slug} class={f.not_ours ? "famcard away" : "famcard"} href={u(f.href)} style={`--c:${f.colour}`}>
        <div class="fc-conf">{f.conf === "doc" ? "Documented" : f.conf === "inf" ? "Inferred" : "Family lore"}{f.not_ours && <span style="color:var(--terra)"> · not this family</span>}</div>
        <h4>{f.name}</h4>
        <div class="fc-meta"><span><b>From</b> {f.from}</span><span><b>Here from</b> {f.when}</span></div>
        <p class="fc-rest" set:html={f.rests.replace(/\*\*(.+?)\*\*/g,"<strong>$1</strong>")}></p>
        <p class="fc-who">{f.who}</p>
      </a>
    ))}
  </div>

  <h3 id="clusters" style="font-size:23px;margin-top:44px">{fam.clusters_head}</h3>
  <p class="dek" style="margin-top:8px">{fam.clusters_lead}</p>
  <div class="scroll" style="margin-top:18px">
    <table>
      <thead><tr><th>Where</th><th>How much</th><th>What it is, and which family it probably belongs to</th></tr></thead>
      <tbody>{fam.clusters.map(c => (
        <tr>
          <td style="font-weight:600;white-space:nowrap">{c.where}</td>
          <td style="white-space:nowrap;color:var(--ink-3)">{c.n}</td>
          <td set:html={c.what.replace(/\*\*(.+?)\*\*/g,"<strong>$1</strong>")}></td>
        </tr>
      ))}</tbody>
    </table>
  </div>

  <h3 style="font-size:23px;margin-top:44px">{fam.dest_head}</h3>
  <p class="dek" style="margin-top:8px">{fam.dest_lead}</p>
  <div class="scroll" style="margin-top:18px">
    <table>
      <thead><tr><th>Destination</th><th>Whose</th><th>How well</th><th>What is behind it</th></tr></thead>
      <tbody>{fam.dests.map(d => (
        <tr>
          <td style="font-weight:600">{d.place}</td>
          <td style="white-space:nowrap">{d.fam === "none"
            ? <span style="color:var(--ink-3)">not this family</span>
            : <span style="color:var(--accent);font-weight:600">{d.fam}</span>}</td>
          <td><Chip c={d.conf === "doc" ? "documented" : d.conf === "inf" ? "inferred" : "lore"} /></td>
          <td set:html={d.what.replace(/\*\*(.+?)\*\*/g,"<strong>$1</strong>")}></td>
        </tr>
      ))}</tbody>
    </table>
  </div>

  <p class="prose note" style="margin-top:26px" set:html={fam.close.replace(/\*\*(.+?)\*\*/g,"<strong>$1</strong>")}></p>
  <p class="cap" style="margin-top:14px">{fam.source_fam}</p>
</section>
<Rule name="pomegranate" label="The pages themselves" />

<section class="blk">
  <div class="stack">
    {lines.map(l=>(
      <div class="linerow">
        <div>
          <h2 style="font-size:26px">{l.name}</h2>
          <div style="margin-top:10px"><Chip c={l.status} /></div>
        </div>
        <div>
          <div class="meta"><span><b>Route</b> {l.route}</span><span><b>Earliest</b> {l.earliest}</span></div>
          <p style="font-family:var(--sans);font-size:14px;line-height:1.6;color:var(--ink-2);margin-top:12px;max-width:62ch">{l.note}</p>
        </div>
      </div>
    ))}
  </div>
</section>
<Rule name="arrows" label="Five rivers" />
<section class="blk">
  <h2>The five roads, drawn</h2>
  <p class="dek" style="margin-top:8px">One surname, five families, and five entirely different reasons for being where they are. Click any stop for the document behind it; click a destination on the right and it tells you its own story, with the way through to the page.</p>
  <div style="margin-top:24px"><BranchRivers /></div>
</section>

<Rule name="tablet" label="A parish named" />

<section class="blk" id="svetjoin">
  <h2>{fam.svetjoin.heading}</h2>
  <p class="dek" style="margin-top:8px" set:html={fam.svetjoin.lead.replace(/\*\*(.+?)\*\*/g,"<strong>$1</strong>")}></p>
  <div style="margin-top:22px;display:flex;flex-direction:column;gap:16px">
    {fam.svetjoin.rows.map(r => (
      <div class="one" style={r.key ? "border-left-color:var(--accent)" : ""}>
        <div class="lab">{r.lab}</div>
        <p style="margin-top:8px;white-space:pre-line" set:html={r.text.replace(/\*\*(.+?)\*\*/g,"<strong>$1</strong>").replace(/(^|[^*])\*([^*\n]+?)\*/g,"$1<em>$2</em>")}></p>
      </div>
    ))}
  </div>
  <p class="cap" style="margin-top:16px">{fam.svetjoin.source_svet}</p>
</section>

<Rule name="arrows" label="The whole inventory" />

<section class="blk" id="regions">
  <h2>{reg.heading}</h2>
  <p class="dek" style="margin-top:8px" set:html={reg.lead.replace(/\*\*(.+?)\*\*/g,"<strong>$1</strong>")}></p>

  <div class="regkey">
    {reg.key.map(([k, v]) => (
      <div class="regkey-row"><span class="regkey-k">{k}</span><span class="regkey-v">{v}</span></div>
    ))}
  </div>

  {reg.groups.map(g => (
    <div style="margin-top:30px">
      <h3 style="margin:0 0 10px">{g.name}</h3>
      <div class="tablewrap">
        <table class="reg">
          <thead><tr><th>Place</th><th>Line</th><th>Verdict</th><th>Why</th></tr></thead>
          <tbody>
            {g.rows.map(([place, line, conf, why]) => (
              <tr class={conf === "unplaced" ? "is-open" : ""}>
                <td><strong>{place}</strong></td>
                <td class="regline">{line}</td>
                <td><span class={"vd vd-" + conf}>{conf === "doc" ? "on a line" : conf === "inf" ? "on a line · inferred" : conf === "lore" ? "lore only" : conf === "unplaced" ? "not placed" : conf === "none" ? "a different family" : conf === "allied" ? "allied, not ours" : "a place, not a family"}</span></td>
                <td set:html={why.replace(/\*\*(.+?)\*\*/g,"<strong>$1</strong>").replace(/(^|[^*])\*([^*\n]+?)\*/g,"$1<em>$2</em>")}></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  ))}

  <div class="one" style="margin-top:28px;border-left-color:var(--accent)">
    <p set:html={reg.close.replace(/\*\*(.+?)\*\*/g,"<strong>$1</strong>")}></p>
  </div>
  <p class="cap" style="margin-top:16px">{reg.source_reg}</p>
</section>

<Rule name="helm" label="Three arrivals" />

<section class="blk">
  <h2>{arr.heading}</h2>
  <p class="dek" style="margin-top:10px">{arr.lead}</p>

  <div class="arrgrid">
    {arr.cards.map(c => (
      <div class="arrcard">
        <div class="arrwhen">{c.when}</div>
        <h3>{c.who}</h3>
        <div class="arrline">{c.line}</div>
        <div class="arrmeta"><span><b>Reason</b> {c.why}</span><span><b>Arms</b> {c.arms}</span></div>
        <p set:html={c.text.replace(/\*\*(.+?)\*\*/g,"<strong>$1</strong>")}></p>
      </div>
    ))}
  </div>

  <div style="margin-top:30px"><Plates ids={["field-seget-arms","field-golo-shield"]} /></div>

  <div style="margin-top:28px;display:flex;flex-direction:column;gap:16px">
    {arr.rows.map(r => (
      <div class="one" style={r.key ? "border-left-color:var(--accent)" : ""}>
        <div class="lab">{r.lab}</div>
        <p style="margin-top:8px;white-space:pre-line" set:html={r.text.replace(/\*\*(.+?)\*\*/g,"<strong>$1</strong>").replace(/(^|[^*])\*([^*\n]+?)\*/g,"$1<em>$2</em>")}></p>
      </div>
    ))}
  </div>
  <p class="cap" style="margin-top:16px">{arr.source_arr}</p>
</section>
<Lightbox />

<Rule name="arrows" />
<section class="blk">
  <h2>How they move</h2>
  <p class="dek">The Carnian road south, the two arrivals at Fiume eighteen months apart, and the branch that reached Crikvenica by way of Poreč.</p>
  <div style="margin-top:24px"><JourneyMap /></div>
</section>
  <Sources ids={["kobler", "dfcom", "familysearch"]} />
<style>
  .arrgrid{margin-top:26px;display:grid;gap:18px;grid-template-columns:repeat(auto-fit,minmax(280px,1fr))}
  .arrcard{border:1px solid var(--rule);border-top:3px solid var(--accent);padding:20px 20px 22px;background:var(--panel);display:flex;flex-direction:column}
  .arrwhen{font-family:var(--sans);font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3)}
  .arrcard h3{font-size:23px;margin:6px 0 0}
  .arrline{font-family:var(--sans);font-size:13px;color:var(--ink-2);margin-top:6px}
  .arrmeta{display:flex;flex-wrap:wrap;gap:6px 18px;margin:14px 0 4px;font-family:var(--sans);font-size:12px;color:var(--ink-3)}
  .arrmeta b{color:var(--ink-2);font-weight:600}
  .arrcard p{font-family:var(--sans);font-size:14px;line-height:1.65;color:var(--ink-2);margin-top:10px}
</style>
<style>
  .famgrid{margin-top:22px;display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(270px,1fr))}
  .famcard{display:block;text-decoration:none;border:1px solid var(--rule);border-top:4px solid var(--c);
    border-radius:12px;padding:18px 18px 20px;background:var(--panel)}
  .famcard:hover{border-color:var(--c);box-shadow:0 10px 28px rgba(10,20,26,.09)}
  .famcard.away{border-style:dashed;background:transparent}
  .fc-conf{font-family:var(--mono);font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3)}
  .famcard h4{font-size:20px;margin:7px 0 0;color:var(--ink)}
  .fc-meta{display:flex;flex-direction:column;gap:3px;margin:12px 0 0;font-family:var(--sans);font-size:11.5px;color:var(--ink-3)}
  .fc-meta b{color:var(--ink-2);font-weight:600}
  .fc-rest{font-family:var(--sans);font-size:13.5px;line-height:1.6;color:var(--ink-2);margin-top:12px}
  .fc-who{font-family:var(--serif);font-style:italic;font-size:15px;color:var(--ink);margin-top:10px}
</style>
</Base>

<style>
  .regkey{margin-top:20px;display:grid;gap:6px;padding:14px 16px;
    background:var(--panel-2);border-radius:10px}
  .regkey-row{display:flex;gap:12px;align-items:baseline;font-size:13.5px}
  .regkey-k{font-family:var(--mono);font-size:10px;letter-spacing:.1em;
    text-transform:uppercase;color:var(--ink-3);min-width:150px;flex:none}
  .regkey-v{color:var(--ink-2)}
  .tablewrap{overflow-x:auto}
  table.reg{width:100%;border-collapse:collapse;font-size:14px}
  table.reg th{text-align:left;font-family:var(--mono);font-size:9.5px;
    letter-spacing:.12em;text-transform:uppercase;color:var(--ink-3);
    padding:0 12px 7px 0;border-bottom:1px solid var(--rule)}
  table.reg td{padding:11px 12px 11px 0;border-bottom:1px solid var(--rule);
    vertical-align:top;line-height:1.55}
  table.reg td:first-child{min-width:150px}
  table.reg tr.is-open td{background:color-mix(in srgb, var(--ochre) 7%, transparent)}
  .regline{font-size:13px;color:var(--ink-2);white-space:nowrap}
  .vd{font-family:var(--mono);font-size:9.5px;letter-spacing:.08em;
    text-transform:uppercase;white-space:nowrap;padding:3px 7px;border-radius:4px;
    background:var(--panel-2);color:var(--ink-3)}
  .vd-doc{background:color-mix(in srgb, var(--accent) 14%, transparent);color:var(--accent)}
  .vd-inf{background:color-mix(in srgb, var(--accent) 9%, transparent);color:var(--ink-2)}
  .vd-lore{background:color-mix(in srgb, var(--ochre) 18%, transparent);color:var(--ochre)}
  .vd-unplaced{background:color-mix(in srgb, var(--terra) 16%, transparent);color:var(--terra)}
  .vd-none,.vd-allied,.vd-context{background:var(--panel-2);color:var(--ink-3)}
</style>
