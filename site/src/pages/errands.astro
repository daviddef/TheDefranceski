---
import Base from "../layouts/Base.astro";
import Errands from "@daviddef/archive-kit/components/Errands.astro";
import Rule from "../components/Rule.astro";
import { u } from "../lib/url.js";
import e from "../data/errands.json";
const md = (s) => String(s ?? "")
  .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
  .replace(/\*(.+?)\*/g, "<em>$1</em>")
  .replace(/«(.+?)»/g, "<em>«$1»</em>")
  .replace(/\n\n/g, "</p><p style='margin-top:12px'>");

/* 21 September 2026. The card moved to the kit. The PRIORITY did not: `pri`
   ranks these by what the answer would buy, which is this archive's question
   and not D'Arcy's (where has it got to) or Lerena's (has anyone replied).
   The component takes the grade and its colour as given. */
const PRI = { high:   ["Send first",     "var(--terra)"],
              medium: ["Worth sending",  "#8a7f5c"],
              low:    ["When convenient", "var(--rule-strong)"] };
const unlabelled = [...new Set(e.rows.map((r) => r.pri).filter((k) => k && !PRI[k]))];

const groups = [{
  rows: e.rows.map((r) => ({
    n: r.n, who: r.who, what: md(r.what), ref: md(r.ref), why: md(r.why),
    ask: md(r.ask), draft: md(r.draft), sent: r.sent,
    stateLabel: (PRI[r.pri] || [r.pri])[0],
    colour: (PRI[r.pri] || [])[1],
  })),
}];
---
<Base title={e.title} eyebrow={e.eyebrow} dek={e.dek}>
<section class="blk"><p class="prose" set:html={md(e.lead)}></p>
  {unlabelled.length > 0 && (
    <p class="small">Filed under a priority this page has no label for: {unlabelled.join(", ")}.</p>
  )}
</section>
<Rule name="arrows" label="The requests" />
<section class="blk">
  <Errands groups={groups} u={u} />
</section>
<Rule name="pomegranate" />
<section class="blk"><p class="prose note" set:html={md(e.close)}></p>
  <p class="cap" style="margin-top:14px"><a href={u("/research-log/")}>The Search Register →</a> · <a href={u("/parish-books/")}>Parish Books →</a> · <a href={u("/worklist/")}>The Work List →</a></p>
</section>
</Base>
