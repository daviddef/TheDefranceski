---
import Base from "../layouts/Base.astro";
import Errands from "@daviddef/archive-kit/components/Errands.astro";
import Rule from "../components/Rule.astro";
import { u } from "../lib/url.js";
import e from "../data/errands.json";
import Shotlist from "@daviddef/archive-kit/components/Shotlist.astro";
import p from "../data/shots.json";
import { md, mdps, mdpsUnbased } from "../lib/md.js";

/* 21 September 2026. The card moved to the kit. The PRIORITY did not: `pri`
   ranks these by what the answer would buy, which is this archive's question
   and not D'Arcy's (where has it got to) or Lerena's (has anyone replied).
   The component takes the grade and its colour as given. */
const PRI = { high:   ["Send first",     "var(--terra)"],
              medium: ["Worth sending",  "#8a7f5c"],
              low:    ["When convenient", "var(--rule-strong)"] };
const unlabelled = [...new Set(e.rows.map((r) => r.pri).filter((k) => k && !PRI[k]))];

/* 9 October 2026. «Photograph these» folded in here. It is an errand in every field the
   kit's Errands row has (a place, why the picture is worth the trip, what it would settle)
   and nobody asked yet; the one real difference is that it is an ITINERARY, ordered by the
   day you would be standing there, which is not a grade. A walk stays a walk, so it keeps
   its own list under its own heading. /photograph-these/ redirects to #photographs. */
const walks = [...new Set(p.rows.map(r => r.walk))];
const rowsFor = (wk) => p.rows.filter(r => r.walk === wk).map(r => ({
  tag: r.day === "\u2014" ? null : "Day " + r.day,
  where: r.sub,
  what: mdps(r.shot),
}));

const groups = [{
  rows: e.rows.map((r) => ({
    n: r.n, who: r.who, what: mdpsUnbased(r.what), ref: mdpsUnbased(r.ref), why: mdpsUnbased(r.why),
    ask: mdpsUnbased(r.ask), draft: mdpsUnbased(r.draft), sent: r.sent,
    stateLabel: (PRI[r.pri] || [r.pri])[0],
    colour: (PRI[r.pri] || [])[1],
  })),
}];
---
<Base title={e.title} eyebrow={`${e.eyebrow} · ${p.rows.length} shots on ${walks.length} walks`} dek={e.dek}>
<section class="blk"><p class="prose" set:html={mdps(e.lead)}></p>
  {unlabelled.length > 0 && (
    <p class="small">Filed under a priority this page has no label for: {unlabelled.join(", ")}.</p>
  )}
</section>
{/* What has come back. The kit's Errands component draws the REQUEST — who,
    why, the ask, the draft, and a "Sent" tag — and it has no field for an
    answer, so a reply recorded in the data would sit in a file no reader ever
    opens. That is the one thing this archive's rules will not have: a finding
    is done when it is told. The kit is another session's ground and is not
    touched; the replies are rendered here instead, above the requests,
    because an answer that has arrived outranks a letter still being drafted. */}
{e.rows.some((r) => r.reply) && (
  <>
    <Rule name="arrows" label="What has come back" />
    <section class="blk">
      {e.rows.filter((r) => r.reply).map((r) => (
        <div class="blk fix" style="margin-top:26px">
          <div class="lab">Errand {r.n} · {r.who}</div>
          <h2 style="font-size:24px">{r.what}</h2>
          <p class="prose" set:html={mdps(r.reply)} style="margin-top:14px"></p>
          {r.next && (
            <p class="prose" style="margin-top:14px">
              <span class="lab">Where it goes next</span>
              <span set:html={mdps(r.next)}></span>
            </p>
          )}
        </div>
      ))}
    </section>
  </>
)}

<Rule name="arrows" label="The requests" />
<section class="blk">
  <Errands groups={groups} u={u} />
</section>
<Rule name="arrows" label="Photographs only someone there can take" />
<section class="blk" id="photographs">
  <h2>Photographs only someone there can take</h2>
  <p class="prose" set:html={mdps(p.lead)}></p>
</section>
{walks.map(wk => (
<>
<section class="blk">
  <h3>{wk}</h3>
  <Shotlist groups={[{ rows: rowsFor(wk) }]} u={u} />
  <p class="cap" style="margin-top:14px"><a href={u(p.rows.find(r => r.walk === wk).href)}>Where this belongs →</a></p>
</section>
</>
))}
<section class="blk"><p class="prose note" set:html={mdps(p.close)}></p>
  <p class="cap" style="margin-top:14px"><a href={u("/walk/")}>The itineraries →</a></p>
</section>
<Rule name="pomegranate" />
<section class="blk"><p class="prose note" set:html={mdps(e.close)}></p>
  <p class="cap" style="margin-top:14px"><a href={u("/searched/")}>The Search Register →</a> · <a href={u("/parish-books/")}>Parish Books →</a> · <a href={u("/worklist/")}>The Work List →</a></p>
</section>
</Base>
