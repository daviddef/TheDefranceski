---
import Base from "../layouts/Base.astro";
import Evidence from "@daviddef/archive-kit/components/Evidence.astro";
import Rule from "../components/Rule.astro";
import { u } from "../lib/url.js";
import m from "../data/method.json";
const md = (s) => String(s ?? "")
  .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
  .replace(/\*(.+?)\*/g, "<em>$1</em>")
  .replace(/«(.+?)»/g, "<em>«$1»</em>")
  .replace(/`(.+?)`/g, "<code>$1</code>")
  .replace(/\n\n/g, "</p><p style='margin-top:12px'>");
---
<Base title={m.title} eyebrow={m.eyebrow} dek={m.dek}>

  <section class="blk" id="ladder">
    <h2>The five words</h2>
    <p class="prose">All seven of these family archives grade a claim with the same five words, so a
    level means the same thing wherever you meet it. The word is always printed next to the colour,
    because a reader should never have to know the palette to know the confidence.</p>
    <dl class="ladder">
      <dt><Evidence level="documented" /></dt>
      <dd>A record was read, and it says this. The source is named.</dd>
      <dt><Evidence level="probable" /></dt>
      <dd>The evidence points one way and nothing found so far points the other. Not proven.</dd>
      <dt><Evidence level="inferred" /></dt>
      <dd>Reasoned from what is known — a gap of the right size, a name in the right place — rather
      than witnessed in a record.</dd>
      <dt><Evidence level="family" /></dt>
      <dd>Told, remembered, or written on a family chart. Kept, because discarding it would lose the
      lead; labelled, because it is not evidence.</dd>
      <dt><Evidence level="disputed" /></dt>
      <dd>Two sources disagree and neither has been ruled out. Both are shown.</dd>
    </dl>
    <div class="notclaimed">
      <span class="lab">Not claimed</span>
      <p class="prose">Some pages carry this instead. It states the thing a reader is likely to
      assume — the connection that would be tidy, the identification that almost works — and says
      plainly that this archive does not assert it. An archive is judged as much by what it refuses
      to say as by what it says.</p>
    </div>
  </section>
<section class="blk"><p class="prose" set:html={md(m.lead)}></p></section>
<Rule name="arrows" label="Eleven things" />
<section class="blk">
  <ol class="rules">
    {m.rows.map((r, i) => (
      <li class={r.key ? "is-key" : ""}>
        <span class="num">{String(i + 1).padStart(2, "0")}</span>
        <div>
          <h3>{r.lab}</h3>
          <p set:html={md(r.text)}></p>
        </div>
      </li>
    ))}
  </ol>
</section>
<Rule name="pomegranate" />
<section class="blk">
  <p class="prose note" set:html={md(m.close)}></p>
  <p class="cap" style="margin-top:14px">{m.source}</p>
  <p class="cap" style="margin-top:10px">
    <a href={u("/corrections/")}>Corrections →</a> · <a href={u("/research-log/")}>The Search Register →</a> ·
    <a href={u("/istria-sweep/")}>The sweep, and the test of it →</a> · <a href={u("/vodnjan/")}>What the unindexed book gave →</a>
  </p>
</section>
<style>
  .rules { list-style: none; margin: 24px 0 0; padding: 0; display: flex; flex-direction: column; gap: 20px; }
  .rules li { display: grid; grid-template-columns: 44px 1fr; gap: 18px; padding: 16px 18px;
              border: 1px solid var(--rule, #dcd6cc); border-left-width: 3px; border-radius: 3px; }
  .rules li.is-key { border-left-color: var(--terra, #a5442c); }
  .num { font-size: 13px; opacity: .4; font-variant-numeric: tabular-nums; padding-top: 5px; }
  .rules h3 { margin: 0; font-size: 20px; line-height: 1.25; }
  .rules p { margin: 10px 0 0; font-size: 15.5px; line-height: 1.7; white-space: pre-line; }
  @media (max-width: 620px) { .rules li { grid-template-columns: 1fr; gap: 6px; } }
</style>
</Base>
