---
import Base from "../layouts/Base.astro";
import Sources from "../components/Sources.astro";
import Plates from "../components/Plates.astro";
import { u } from "../lib/url.js";
import Gallery from "@daviddef/archive-kit/components/Gallery.astro";
import all from "../data/plates.json";
const groups = [
  ["photographs", "Photographs"],
  ["graves", "Graves"],
  ["dp", "Camp cards"],
  ["gracisce", "Gračišće registers"],
  ["documents", "Documents"],
  ["places", "Places"],
];
const counts = Object.fromEntries(groups.map(([k]) => [k, all.filter(p => p.group === k).length]));

/* The local Plates component stays: the direct line draws its register pages
   with it, one household at a time. This page's own filter row and lightbox
   are the shared component's now, and the six groups become its filter. */
const LABEL = Object.fromEntries(groups);
const sheet = all.map((p) => ({
  /* Based here. This archive stores plate paths unbased and its own Plates
     component added the prefix; the shared gallery passes a path through
     untouched, because the four archives store them four ways and a component
     that guessed would base one of them twice. */
  src: u(p.src), thumb: u(p.thumb), w: p.w, h: p.h,
  title: p.title, what: p.caption, holder: p.holder,
  kind: LABEL[p.group] || p.group,
}));
---
<Base
  title="The Plate Room"
  eyebrow={`${all.length} images from the family's own holdings`}
  dek="Every image here comes from the family's own papers or from an archive that sent them on request. Click any plate to read what it shows; arrow keys move through the set.">

  <Gallery rows={sheet} u={u} unit="images" />

  <section class="prose" style="margin-top:48px">
    <h3>What is here and what is not</h3>
    <p>Seventeen photographs, three camp portraits, five pages of the Gračišće parish books with the archive's letters that released them, and the working papers of a family in Württemberg between 1941 and 1950. Nothing on this page was found on the open web; all of it was either kept by the family or bought, page by page, from an archive.</p>
    <p>Faces of people who may be living are not published, and the children entered on the camp cards as <em>enfant</em> are named nowhere on this site.</p>
    <h3>If you hold more</h3>
    <p>A photograph with a name and a decade attached is worth more than a chart. Studio marks on the back of a print name the town; a uniform names the army; a dress names the decade to within about five years. Send what you have.</p>
  </section>

  <Sources ids={["mftpkg", "arolsen", "dapa", "omisphotos"]} />
</Base>

<script>
  const bar = document.querySelector(".filters");
  const grid = document.querySelector(".plates");
  const count = document.getElementById("pcount");
  if (bar && grid) {
    const data = JSON.parse(grid.getAttribute("data-plates"));
    const cards = [...grid.querySelectorAll(".plate")];
    const apply = (g) => {
      let n = 0;
      cards.forEach((c, i) => {
        const on = g === "all" || data[i].group === g;
        c.hidden = !on;
        if (on) n++;
      });
      count.textContent = `${n} showing`;
    };
    bar.addEventListener("click", (e) => {
      const b = e.target.closest("button[data-g]");
      if (!b) return;
      bar.querySelectorAll("button").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      apply(b.dataset.g);
    });
    apply("all");
  }
</script>
