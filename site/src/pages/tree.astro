---
import Base from "../layouts/Base.astro";
import Rule from "../components/Rule.astro";
import Sources from "../components/Sources.astro";
import { u } from "../lib/url.js";
import dl from "../data/directline.json";
import anc from "../data/ancestors.json";
import AncChart from "../components/AncChart.astro";
import Spine from "../components/Spine.astro";
import Kin from "../components/Kin.astro";
import spines from "../data/spines.json";
import arch from "@daviddef/archive-kit/data/archives.json";
import doss from "../data/dossiers.json";
import hhs from "../data/households.json";
import { makeResolver, norm } from "../lib/people.js";

const gens = dl.generations;

/* Every mother came from a family that may have an archive of its own.
   Map a surname to the sibling archive that holds it. */
const archOf = (name) => {
  if (!name) return null;
  for (const a of arch.archives) {
    if (a.key === "defranceski") continue;
    for (const s of a.surnames || []) {
      const re = new RegExp("(^|\\s|né[e]?\\s|born\\s)" + s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"), "i");
      if (re.test(name)) return a;
    }
  }
  return null;
};

/* Link a name to its dossier page — via the shared resolver, which will not
   return a match it cannot confirm against dates. */
const resolve = makeResolver(Object.values(doss.people));
/* /who/[slug] is generated from the dossier slugs and nothing else, so a
   resolved name that is not one of them is a link to a page that will not be
   built. The resolver returned exactly one — cheryl-lerena, whose page is
   cheryl-lerena-defranceski — and it shipped as a dead link on the tree.
   Ask before linking, the same way the changelog and namesakes pages do. */
const whoPages = new Set(Object.values(doss.people).map(p => p.slug));
const whoOf = (name, dates) => {
  const slug = resolve(name, dates);
  return slug && whoPages.has(slug) ? slug : null;
};

/* And link a generation to the household this archive reconstructed for it. */
const hhOf = (g) => {
  if (!g.spouse) return null;
  const a = norm(g.name), b = norm(g.spouse.name);
  const bs = b.split(" ").pop();
  /* Father's full name must match; for the mother only the surname, because the
     register writes "Ana Kalanj" where the family chart writes "Anna Kalanj".
     And the match must be unique — one candidate or none. */
  const cand = hhs.filter(h => norm(h.father) === a && norm(h.mother).split(" ").pop() === bs);
  /* Accept several candidates only when they are plainly the same couple — this
     archive holds Josip and Ana Kalanj twice, at Ledenice and at Crikvenica. */
  const one = new Set(cand.map(h => norm(h.father) + "|" + norm(h.mother))).size === 1;
  return cand.length && one ? cand[0] : null;
};

const CONF = {
  documented: ["doc", "Documented", "var(--accent)"],
  family:     ["lore", "Family chart", "var(--ochre)"],
  living:     ["", "Living — name only", "var(--ink-3)"],
};
const md = (x) => String(x ?? "")
  .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
  .replace(/«(.+?)»/g, "<em>«$1»</em>")
  .replace(/(^|[^*])\*([^*\n]+?)\*/g, "$1<em>$2</em>");
---
<Base
  title="Our line — the tree"
  eyebrow={`${gens.length} generations down · 17 named ancestors and 11 walls back`}
  dek="This is one family of the five — ours. Eight generations of a single descent, each as the couple it actually was. Every mother is named, with her own birthplace and — where her family keeps one — a link to her own archive. Every child is listed, not only the one who carried the line.">


  <section class="blk">
    <div class="lab">The line as ground covered</div>
    <h2 style="font-size:30px;margin:6px 0 4px">Eight generations, and the seven places that hold them</h2>
    <Spine s={spines.spines.find(x => x.key === "carnia")} />
  </section>

  <section class="t-anc-sec">
    <h2 class="t-h2">Backwards — the ancestry</h2>
    <p class="t-lead">Every line that runs into this family, worked backwards from the keeper of the archive. Each box is a person a document names.
      A <strong>wall</strong> is a place where this archive knows a person existed and cannot name their parents — and the reasons differ, so each wall says which it is.
      Seventeen ancestors are named; there are eleven walls.</p>
    <div class="t-wkey">
      <span style="--k:var(--ochre)">A candidate, not a proof</span>
      <span style="--k:var(--terra)">Not named in any source</span>
      <span style="--k:var(--ink-3)">Unworked — the registers exist</span>
      <span style="--k:var(--accent)">Continues in another archive</span>
    </div>
    <AncChart root={anc.root} />
    <p class="cap" style="margin-top:12px">{anc.note}</p>
  </section>

  <Rule name="loom" label="Forwards — the descent" />

  <div class="legend" style="margin-bottom:22px">
    <span><i style="background:var(--accent);border-radius:0;width:3px;height:14px"></i>Documented — a register page or certified extract</span>
    <span><i style="background:var(--ochre);border-radius:0;width:3px;height:14px"></i>The family's own chart, not yet a register</span>
    <span><i style="background:var(--ink-3);border-radius:0;width:3px;height:14px"></i>Living — name only, by the archive's rule</span>
  </div>

  <div class="t-spine">
  {gens.map((g, i) => {
    const [chip, confLabel, colour] = CONF[g.confidence] || CONF.documented;
    const sp = g.spouse;
    const spArch = sp ? archOf(sp.name) : null;
    const who = whoOf(g.name, `${g.born || ""} ${g.died || ""}`);
    const hh = hhOf(g);
    const spWho = sp ? whoOf(sp.name, sp.born) : null;
    const kids = g.children || [];
    const isLast = i === gens.length - 1;
    return (
      <section class="t-gen" id={`g${g.n}`} style={`--c:${colour}`}>
        <div class="t-rail">
          <div class="t-gno">{g.n}</div>
          {!isLast && <div class="t-drop"></div>}
        </div>

        <div class="t-body">
          <div class="t-couple">
            <div class="t-person t-him">
              <div class="t-nm">{who ? <a href={u(`/who/${who}/`)}>{g.name}</a> : g.name}</div>
              {g.latin && <div class="t-alt">as the register writes him — {g.latin}</div>}
              <div class="t-meta">
                {(g.bornExact || g.born) && <span>b. {g.bornExact || g.born}</span>}
                {(g.diedExact || g.died) && <span>d. {g.diedExact || g.died}</span>}
              </div>
              {g.occupation && <div class="t-occ">{g.occupation}</div>}
            </div>

            {sp ? (
              <>
                <div class="t-amp" aria-hidden="true">×</div>
                <div class="t-person t-her">
                  <div class="t-nm">{spWho ? <a href={u(`/who/${spWho}/`)}>{sp.name}</a> : sp.name}</div>
                  {sp.born && <div class="t-meta"><span>b. {sp.born}</span></div>}
                  {spArch
                    ? <a class="t-xarch" href={spArch.url}>Her family has its own archive — {spArch.name} →</a>
                    : <div class="t-alt">No archive of her own line yet</div>}
                </div>
              </>
            ) : (
              <>
                <div class="t-amp" aria-hidden="true">×</div>
                <div class="t-person t-her empty">
                  <div class="t-nm">{g.confidence === "living" ? "Withheld" : "Not named"}</div>
                  <div class="t-alt">{g.confidence === "living"
                    ? "Living people are named here and no more, by the archive's own rule."
                    : "This generation's wife is in no source the archive holds."}</div>
                </div>
              </>
            )}
          </div>

          <div class="t-strip">
            <span class="t-where">{g.place}</span>
            {g.married && <span class="m">married {g.married}</span>}
            {hh && <a class="t-hh" href={u("/households/")}>the household this archive reconstructed{hh.n ? ` — ${hh.n} children` : ""} →</a>}
            <span class="t-cf" style="--c:var(--c)">{confLabel}</span>
          </div>

          {kids.length > 0 && (
            <div class="t-kids">
              <div class="t-klab">{kids.length} {kids.length === 1 ? "child" : "children"} recorded</div>
              <div class="t-krow">
                {kids.map(c => (
                  <div class={"t-kid" + (c.line ? " carries" : "")}>
                    <span class="t-kn">{c.name}</span>
                    {c.born && c.born !== "—" && <span class="t-kd">{c.born}</span>}
                    {c.note && <span class="t-knote">{c.note}</span>}
                    {c.line && <span class="t-carry">carries the line</span>}
                  </div>
                ))}
              </div>
            </div>
          )}

          {g.evidence && <p class="t-ev" set:html={md(g.evidence)}></p>}

          {g.flag && (
            <div class="t-flag">
              <div class="t-flab">Open question</div>
              <p set:html={md(g.flag)}></p>
            </div>
          )}

          {(g.sources || []).length > 0 && (
            <div class="t-src">
              {g.sources.map(s => <div><span class="t-sl">{s.label}</span>{s.note && <span class="t-sn"> — {s.note}</span>}</div>)}
            </div>
          )}
        </div>
      </section>
    );
  })}
  </div>

  <p class="cap" style="margin-top:22px">Built from <a href={u("/direct-line/")}>the direct line</a>, which carries the working and the objections. Where a generation's evidence is an inference it says so here, in the same words.</p>

  <Rule name="arrows" label="Other ways in" />
  <section class="blk">
    <div class="doors" style="margin-top:20px">
      <a class="door" href={u("/direct-line/")}>
        <div class="dn">The spine, in full</div>
        <div class="dd">The same eight generations with every objection, every plate and every certificate reference set out at length.</div>
        <div class="go">Open the direct line →</div>
      </a>
      <a class="door" href={u("/households/")}>
        <div class="dn">Households</div>
        <div class="dd">Every reconstructed household the archive holds — not only this line — by house number where the register gives one.</div>
        <div class="go">Browse households →</div>
      </a>
      <a class="door" href={u("/search/")}>
        <div class="dn">Search everything</div>
        <div class="dd">People, places, households, records and plates in one index — diacritics folded, so «Gracisce» finds Gračišće.</div>
        <div class="go">Open search →</div>
      </a>
    </div>
  </section>

  <Sources ids={["dapa", "maticne", "mftpkg", "arolsen", "myheritage"]} />
  <Rule name="arrows" label="The line, widened" />
  <section class="blk">
    <h2 style="font-size:30px;margin:6px 0 4px">The brothers and sisters, and where their branches go</h2>
    <Kin />
  </section>


</Base>

<style>
  .t-h2 { font-family: var(--serif); font-size: 27px; margin: 0 0 8px; }
  .t-lead { font-size: 15px; line-height: 1.65; color: var(--ink-2); max-width: 68ch; }
  .t-wkey { display: flex; flex-wrap: wrap; gap: 8px 16px; margin: 14px 0 18px; }
  .t-wkey span {
    font-family: var(--sans); font-size: 10.5px; letter-spacing: .08em; text-transform: uppercase;
    color: var(--ink-3); border-left: 3px solid var(--k); padding-left: 8px;
  }
  .t-ancwrap { overflow-x: auto; padding: 6px 2px 14px; }
  .t-anc-sec { margin-bottom: 10px; }

  .t-spine { margin-top: 8px; }

  .t-gen { display: grid; grid-template-columns: 44px 1fr; gap: 0 16px; }
  .t-rail { display: flex; flex-direction: column; align-items: center; }
  .t-gno {
    width: 30px; height: 30px; flex: 0 0 30px; border-radius: 50%;
    display: grid; place-items: center; background: var(--c); color: var(--ground);
    font-family: var(--sans); font-size: 13px; font-weight: 700; line-height: 1;
  }
  .t-drop { flex: 1; width: 2px; background: var(--rule); margin: 8px 0 0; min-height: 24px; }

  .t-body {
    border-left: 3px solid var(--c); background: var(--panel);
    padding: 16px 18px 15px; margin-bottom: 26px; border-radius: 2px;
  }

  .t-couple { display: flex; align-items: flex-start; gap: 14px; flex-wrap: wrap; }
  .t-person { flex: 1 1 240px; min-width: 0; }
  .t-person.her { border-left: 1px solid var(--rule); padding-left: 14px; }
  .t-person.her.empty .t-nm { color: var(--ink-3); font-style: italic; }
  .t-amp { font-family: var(--serif); font-size: 22px; color: var(--ink-3); padding-top: 4px; }
  .t-nm { font-family: var(--serif); font-size: 20px; line-height: 1.25; }
  .t-nm a { color: inherit; text-decoration: none; border-bottom: 1px solid var(--rule-strong); }
  .t-nm a:hover { border-bottom-color: var(--accent); }
  .t-alt { font-size: 12.5px; color: var(--ink-3); margin-top: 3px; font-style: italic; }
  .t-meta { margin-top: 5px; display: flex; gap: 12px; flex-wrap: wrap;
          font-family: var(--mono); font-size: 12px; color: var(--ink-2); }
  .t-occ { margin-top: 5px; font-size: 13px; color: var(--ink-2); }
  .t-xarch {
    display: inline-block; margin-top: 6px; font-size: 12.5px;
    color: var(--accent); text-decoration: none; border-bottom: 1px solid transparent;
  }
  .t-xarch:hover { border-bottom-color: var(--accent); }

  .t-strip {
    margin-top: 12px; padding-top: 11px; border-top: 1px solid var(--rule);
    display: flex; gap: 10px 16px; flex-wrap: wrap; align-items: baseline;
  }
  .t-strip .t-where { font-size: 14px; color: var(--ink); }
  .t-strip .m { font-family: var(--mono); font-size: 12px; color: var(--ink-2); }
  .t-strip .t-hh { font-size: 12.5px; color: var(--accent); text-decoration: none; }
  .t-strip .t-cf {
    margin-left: auto; font-family: var(--sans); font-size: 10.5px;
    letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3);
    border: 1px solid var(--rule-strong); padding: 2px 7px; border-radius: 2px;
  }

  .t-kids { margin-top: 13px; }
  .t-klab {
    font-family: var(--sans); font-size: 10.5px; letter-spacing: .12em;
    text-transform: uppercase; color: var(--ink-3); margin-bottom: 7px;
  }
  .t-krow { display: flex; flex-wrap: wrap; gap: 8px; }
  .t-kid {
    border: 1px solid var(--rule); border-radius: 2px; padding: 7px 10px;
    background: var(--panel-2); min-width: 0; flex: 0 1 auto;
  }
  .t-kid.carries { border-color: var(--c); background: var(--accent-wash); }
  .t-kn { display: block; font-size: 14px; }
  .t-kd { display: block; font-family: var(--mono); font-size: 11.5px; color: var(--ink-2); margin-top: 2px; }
  .t-knote { display: block; font-size: 11.5px; color: var(--ink-3); margin-top: 3px; max-width: 34ch; }
  .t-carry {
    display: inline-block; margin-top: 5px; font-family: var(--sans);
    font-size: 9.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--accent);
  }

  .t-ev { margin-top: 13px; font-size: 14.5px; line-height: 1.62; color: var(--ink-2); }

  .t-flag { margin-top: 12px; padding: 10px 12px; border-left: 2px solid var(--terra); background: var(--panel-2); }
  .t-flab {
    font-family: var(--sans); font-size: 10.5px; letter-spacing: .12em;
    text-transform: uppercase; color: var(--terra); margin-bottom: 4px;
  }
  .t-flag p { margin: 0; font-size: 13.5px; line-height: 1.58; }

  .t-src { margin-top: 12px; font-family: var(--mono); font-size: 11.5px; color: var(--ink-3); line-height: 1.7; }
  .t-src .t-sl { color: var(--ink-2); }

  @media (max-width: 620px) {
    .t-gen { grid-template-columns: 30px 1fr; gap: 0 10px; }
    .t-person.her { border-left: 0; padding-left: 0; border-top: 1px solid var(--rule); padding-top: 10px; }
    .t-amp { display: none; }
    .t-strip .t-cf { margin-left: 0; }
  }
</style>
