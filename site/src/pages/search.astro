---
/* The box is one component in @daviddef/archive-kit, shared by all seven
   archives. What stays here is what belongs to this archive: how it describes
   itself, and the things worth trying. */
import Base from "../layouts/Base.astro";
import Search from "@daviddef/archive-kit/components/Search.astro";
import { u } from "../lib/url.js";
import idx from "../data/searchindex.json";
const hints = [["lapicida", "the stonecutter, in the priest's Latin"], ["house 5", "the farmer's household at Gračišće"], ["Status Animarum", "the book of souls"], ["Gologorica", "the 1711 house on the square"], ["Klenovica", "house 22, where the coast branch married in"], ["Pfullingen", "the German factory, 1941"], ["zavičaj", "the inherited commune the register names"], ["Carnia", "the valley the weavers came out of"]];
---
<Base title="Search the Archive" eyebrow={`${idx.length.toLocaleString()} things, one box`} dek="People, places, households, register entries, document plates, namesakes and the direct line — one box. Type without the accents if it is easier: Gracisce finds Gračišće.">
  <section class="blk">
    <Search base={u("/")} hints={hints} placeholder="Gračišće · lapicida · house 5 · Gologorica · 1711 · Pfullingen" />
    <p class="dek" style="margin-top:1.4rem">This searches <strong>what the archive says</strong>,
    not the registers themselves. A name that returns nothing here has not been read yet — which is
    itself worth knowing. <a href={u("/searched/")}>What has already been looked for &rarr;</a></p>
  </section>
</Base>
