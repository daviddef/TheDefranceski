---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url.js";
import Rule from "../components/Rule.astro";
import Sources from "../components/Sources.astro";
import questions from "../data/questions.json";
const open = questions.open.map(o => ({ q:o.q, s:o.status, w:o.known, n:o.needed }));
const closed = questions.closed.map(c => [c.q, c.answer]);

---
<Base title="Research Log" eyebrow={`${questions.open.filter(o=>o.status==="open").length} open, ${questions.open.filter(o=>o.status==="blocked").length} blocked, ${questions.closed.length} closed`}
      dek="Publishing the dead ends is what separates an archive from a scrapbook. It is also the page most likely to recruit somebody who can answer one of these.">
<section class="blk">
  <h2>Open and blocked</h2>
  <p class="dek">The same questions are set out one at a time, with what each would take, on <a href={u("/open-questions/")}>Open questions</a>.</p>
  <p class="dek">‘Blocked’ means the next step is known and cannot be taken from a desk.</p>
  <div class="stack" style="margin-top:26px">
    {open.map(o=>(
      <div class="qrow">
        <div><h3 class="qq">{o.q}</h3><span class={`chip ${o.s==="blocked"?"lore":o.s==="answered"?"doc":"inf"}`}>{o.s==="blocked"?"Blocked":o.s==="answered"?"Answered":"Open"}</span></div>
        <div><p class="qw">{o.w}</p><p class="qn"><b>Next:</b> {o.n}</p></div>
      </div>
    ))}
  </div>
</section>
<Rule name="arrows" />
<section class="blk">
  <h2>Closed in this round</h2>
  <div class="scroll" style="margin-top:22px">
    <table><tbody>{closed.map(([q,a])=>(
      <tr><td style="width:34%">{q}</td><td>{a}</td></tr>
    ))}</tbody></table>
  </div>
</section>
  <Sources ids={["dapa", "familysearch", "arolsen", "tna", "kobler"]} />
</Base>
