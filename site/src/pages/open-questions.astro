---
/* The last hole in the spine: six of the seven archives publish a list of what
   they do not know, and the richest of them did not.
   Nothing here is new. These are the questions the research log has been
   carrying all along, in site/src/data/questions.json, set out one at a time
   with what each would actually take to answer — because a question with a
   next step is a job somebody can pick up, and a question without one is just
   a sigh. */
import Base from "../layouts/Base.astro";
import Questions from "@daviddef/archive-kit/components/Questions.astro";
import Rule from "../components/Rule.astro";
import Evidence from "@daviddef/archive-kit/components/Evidence.astro";
import { u } from "../lib/url.js";
import questions from "../data/questions.json";
import { md, mdpsHtml } from "../lib/md.js";
import Sources from "../components/Sources.astro";
import gaps from "../data/gaps.json";
import dossiers from "../data/dossiers.json";

const open = questions.open.filter(o => o.status === "open");
const blocked = questions.open.filter(o => o.status === "blocked");
const answered = questions.open.filter(o => o.status === "answered");
const closed = questions.closed;
/* 9 October 2026. Two pages folded in. «Research Log» was never a log: this page said
   itself that the two were «two views of one file», and the 37 closed answers lived only
   there. They are section #closed now. «What we cannot close» (the deaths that ought to
   exist and cannot be found) is section #gaps. /research-log/ and /gaps/ redirect here. */
const slugOf = (n) => Object.values(dossiers.people).find(p => p.name === n)?.slug;

/* What a question needs decides who can take it. Read off the "next step" the
   archive has already written for each one — every question in this file has
   one, so there is no unscoped bucket. Order matters: a question that wants a
   photograph wants a photograph even if it also mentions a register. */
const RULES = [
  [/\b(photograph|photo\b|raking light|square on|in person|visiting|go and stand)\b/i,
   "feet", "Somebody standing there",
   "The cheapest questions in the archive, and the ones it can do nothing about from here. Each needs one person, in one place, with a camera."],
  [/\bY-?DNA\b/i,
   "dna", "A DNA test",
   "Both say the same thing: a Y-DNA test on one living man would settle in weeks what the registers have not settled at all."],
  [/\b(letter|write to|enquir|appointment|his working papers|boxes|inventor)\b/i,
   "letter", "A letter to an archive",
   "The next step is known and somebody has to be asked. One of them — the Udine charters — already has its letters drafted."],
  [/\b(book|printed edition|edition|library|published|zbornik|AMSI|volume)\b/i,
   "book", "A book to find",
   "Printed and citable. No archive appointment needed — only a copy."],
  [/\b(register|records|series|film|fond|index|parish book|baptism|marriage|death entr)\b/i,
   "reg", "A register to read",
   "The largest group, and the slowest. Each names the exact series that would answer it."],
];
function kindOf(o) {
  const n = o.needed || "";
  for (const [re, c, label] of RULES) if (re.test(n)) return { c, label };
  return { c: "reg", label: "A register to read" };
}
const byKind = RULES.map(([, c, label, note]) => ({
  c, label, note,
  rows: [...open, ...blocked].filter(o => kindOf(o).c === c),
})).filter(g => g.rows.length);

const total = open.length + blocked.length;
---
<Base title="Open Questions"
      eyebrow={`${total} unanswered — ${open.length} open, ${blocked.length} blocked`}
      dek="What this archive does not know, written down so that a gap is never mistaken for a fact, and so that anybody who can close one can see exactly what it would take.">

  <section class="blk">
    <p class="prose">Every one of these has been worked on and none of them has been closed. They
    are kept in the open because an archive that publishes only its answers is not showing its
    work — and because more than one of them could be closed in an afternoon by somebody who
    happens to live in the right town.</p>
    <p class="prose" style="margin-top:1rem"><strong>Blocked</strong> means the next step is known
    and cannot be taken from a desk. <strong>{closed.length}</strong> other questions have been
    answered and are kept, with their answers, <a href="#closed">below</a>. The deaths that ought to
    exist and cannot be found are <a href="#gaps">below that</a>.</p>

  </section>

          <section class="blk">
    <h2>Every open question, and what would answer it</h2>
    <p class="dek">The kinds above are the filter. Each one carries what is already known and the
    record that would settle it — a question without that is a regret, not a queue.</p>
    <Questions u={u} rows={questions.open.map((o, i) => ({
      n: i + 1,
      q: md(o.q),
      state: o.status === "blocked" ? "Blocked" : "Open",
      known: md(o.known),
      settles: md(o.needed),
    }))} />
  </section>

  {answered.length > 0 && (
    <>
      <Rule name="arrows" />
      <section class="blk">
        <h2>Answered, and still on the list <span class="dim mono">{answered.length}</span></h2>
        <p class="dek">Answered but not yet folded back into the pages they affect. They stay here
        until they are.</p>
        <div class="stack" style="margin-top:22px">
          {answered.map(o => (
            <article class="qrow">
              <div><h3 class="qq" set:html={md(o.q)}></h3><Evidence level="documented">Answered</Evidence></div>
              <div><p class="qw" set:html={md(o.known)}></p><p class="qn"><b>Next:</b> <span set:html={md(o.needed)}></span></p></div>
            </article>
          ))}
        </div>
      </section>
    </>
  )}

  <Rule name="arrows" />
  <section class="blk" id="closed">
    <h2>Closed in this round <span class="dim mono">{closed.length}</span></h2>
    <p class="dek">Answered questions are kept, with their answers, so a question cannot be closed in
    one place and left open in another.</p>
    <div class="scroll" style="margin-top:22px">
      <table><tbody>{closed.map((c) => (
        <tr><td style="width:34%">{c.q}</td><td>{c.answer}</td></tr>
      ))}</tbody></table>
    </div>
  </section>

  <Rule name="arrows" label="Unfinished" />
  <section class="blk" id="gaps">
    <h2>The deaths that ought to exist and cannot be found</h2>
    <p class="prose" set:html={mdpsHtml(gaps.lead)}></p>
    <div class="gaps" style="margin-top:1.2rem">
      {gaps.rows.map(r => (
        <article class="gap">
          <div class="gh">
            <h3>{slugOf(r.name) ? <a href={u(`/who/${slugOf(r.name)}/`)}>{r.name}</a> : r.name}</h3>
            {r.place && <span class="pl">{r.place}</span>}
          </div>
          <p set:html={mdpsHtml(r.known)}></p>
          <p class="cap" style="margin-top:8px"><span class="lab">Where the death should be</span> {r.where}</p>
        </article>
      ))}
    </div>
    <p class="prose note" style="margin-top:1.4rem" set:html={mdpsHtml(gaps.close)}></p>
    <p class="cap" style="margin-top:12px"><a href={u("/vodnjan/")}>The Vodnjan lines →</a> · <a href={u("/method/")}>Method →</a> · <a href={u("/changes/")}>What changed →</a></p>
  </section>

  <section class="blk">
    <p class="prose dim">The list of places already searched without result is on
    <a href={u("/searched/")}>Searched</a>.</p>
  </section>

  <Sources ids={["dapa", "familysearch", "arolsen", "tna", "kobler"]} />

  <style>
    .gaps { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(min(100%,340px), 1fr)); }
    .gap { border: 1px solid var(--rule, #dcd6cc); border-left-width: 3px; border-left-color: #8a7f5c;
           border-radius: 3px; padding: 15px 17px; }
    .gh { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
    .gh h3 { margin: 0; font-size: 18.5px; line-height: 1.25; }
    .pl { font-size: 12px; opacity: .6; }
    .gap p { margin: 9px 0 0; font-size: 14.5px; line-height: 1.6; }
  </style>
</Base>
