---
/* What is being done here, as opposed to what is known.
   The list lives in worklist.json; the rendering is the kit's, shared across
   the estate so eight archives keep one register in one shape. */
import Base from "../layouts/Base.astro";
import WorkList from "@daviddef/archive-kit/components/WorkList.astro";
import { u } from "../lib/url.js";
import { mdp } from "../lib/md.js";
import work from "../data/worklist.json";

const link = (h) => h.replace(/\[([^\]]+)\]\((\/[^)]*)\)/g,
  (_, t, href) => `<a href="${u(href)}">${t}</a>`);
const open = work.rows.filter(r => !["done", "struck"].includes(r.state)).length;
const waiting = work.rows.filter(r => r.state === "blocked").length;
---
<Base
  title={work.title}
  eyebrow={`${work.rows.length} items · ${open} open · ${waiting} waiting on somebody else`}
  dek={work.dek}>

  <div class="prose" style="margin-top:8px" set:html={link(mdp(work.lead))}></div>

  <WorkList work={work} u={u} />

  <div class="one" style="margin-top:34px;border-left-color:var(--accent)">
    <div class="lab">What is left</div>
    <div class="prose" style="margin-top:8px" set:html={link(mdp(work.close))}></div>
  </div>

  <p class="cap" style="margin-top:36px">
    The registers that answer <em>what do we know</em>:
    <a href={u("/searched/")}>what has been searched</a> ·
    <a href={u("/open-questions/")}>what is unanswered</a> ·
    <a href={u("/gaps/")}>who is missing</a> ·
    <a href={u("/errands/")}>what has to be asked for</a> ·
    <a href={u("/corrections/")}>what this archive got wrong</a>.
  </p>
</Base>
