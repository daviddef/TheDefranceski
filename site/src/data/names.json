{
  "variants": [
    {
      "form": "de' Franceschi",
      "era": "15c–16c",
      "where": "Venice, Tuscany",
      "lang": "it",
      "why": "The original: a genitive plural, ‘of the Franceschi’ — the household of a Francesco. The apostrophe is the elided dei."
    },
    {
      "form": "de Franceschis",
      "era": "16c–19c",
      "where": "Parish registers",
      "lang": "la",
      "why": "Not a variant at all: the Latin ablative the priest wrote. Franciscus de Franceschis. Mistaking case endings for spellings is the classic beginner's error."
    },
    {
      "form": "De Franceschi",
      "era": "17c–19c",
      "where": "Venetian coast, western Istria",
      "lang": "it",
      "why": "The settled Italian civil form. What Carlo and Camillo put on their books — and, in 1945, the form still found at Seghetto and Svetvinčenat, both on the Venetian side."
    },
    {
      "form": "Defranceschi",
      "era": "18c–",
      "where": "Habsburg lands, Pazin county, Fiume",
      "lang": "it/de",
      "why": "Prefix fused into one word — the Austrian administrative habit. In 1945 every Defranceschi household in the Pazin district wrote it this way. It is also the form that dominates in Trentino, Austrian until 1918."
    },
    {
      "form": "Franceschi",
      "era": "any",
      "where": "Split and Imotski · Italy · Corsica · the Americas",
      "lang": "it",
      "why": "Usually the prefix simply dropped — but in Dalmatia it was taken. The nobiliary *de* was removed from the Omiš–Imotski family by decree of the Napoleonic administration, which is why the descendants of a count are called Franceschi today. Not drift, and not a clerk: law."
    },
    {
      "form": "Franzeschi",
      "era": "18c–19c",
      "where": "German-language clerks",
      "lang": "de",
      "why": "German orthography reaching for the Italian c sound."
    },
    {
      "form": "Franceschich",
      "era": "19c–1918",
      "where": "Austrian Littoral",
      "lang": "de/hr",
      "why": "Slavic patronymic -ić written the Austrian way, -ich. Watch for this in reverse: an -ich name Italianised back to -i after 1920."
    },
    {
      "form": "Defranceski",
      "era": "20c–",
      "where": "South Africa, Australia, Argentina",
      "lang": "en",
      "why": "Italian schi is pronounced ‘ski’. An English-speaking clerk wrote what he heard. Thirteen of the seventeen people who carry this spelling worldwide are in South Africa."
    },
    {
      "form": "de Franceski",
      "era": "20c–",
      "where": "Diaspora",
      "lang": "en",
      "why": "The prefix restored onto a phonetic stem — a deliberate reclaiming rather than a clerk's error."
    }
  ],
