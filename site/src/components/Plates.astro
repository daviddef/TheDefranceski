---
import { u } from "../lib/url.js";
import { md } from "../lib/md.js";
import all from "../data/plates.json";
import { claim } from "@daviddef/archive-kit/lib/rec.js";
const { group, ids, cols } = Astro.props;
let list = all;
if (ids) list = ids.map(i => all.find(p => p.id === i)).filter(Boolean);
else if (group) list = all.filter(p => (Array.isArray(group) ? group : [group]).includes(p.group));
/* A plate is only an image when the manifest holds a thumbnail for it. Sixty-two
   entries are cited pages whose picture is not kept on this site: their `src`
   is the citation, not a path, and u() turned the missing path into "/", so each
   rendered <img src="/"> (165 times across four pages). Those are listed as
   cited-but-not-held below the grid instead of as broken pictures. */
const held = list.filter(p => p.thumb);
const cited = list.filter(p => !p.thumb);
const data = held.map(p => ({ ...p, src: u(p.src), thumb: u(p.thumb) }));
/* The anchor a passage's record link points to (the linking standard, L3; md.js `[words](rec:plate-<id>)`). One id per plate
   per page: a plate shown twice on a page keeps both buttons and gives the id to the first (the kit's claim()). */
const anchors = data.map(p => (claim(Astro.request, "plate-" + p.id) ? "plate-" + p.id : undefined));
---
{data.length > 0 && (
<div class="plates" style={cols ? `grid-template-columns:repeat(${cols},minmax(0,1fr))` : undefined} data-plates={JSON.stringify(data)}>
  {data.map((p, i) => (
    <button class={`plate${p.h > p.w ? " tall" : ""}`} data-i={i} type="button" id={anchors[i]}>
      <img class="shot" src={p.thumb} alt={p.title} width={p.w} height={p.h} loading="lazy" decoding="async" />
      <span class="meta">
        <span class="t">{p.title}</span>
        <span class="h">{p.holder}</span>
        <span class="zoomhint">Open plate</span>
      </span>
    </button>
  ))}
</div>
)}
{cited.length > 0 && (
<div class="plates-cited">
  {cited.map((p) => (
    <details class="pcited">
      <summary><span class="t">{p.title}</span> <span class="h">cited here, picture not shown on this site</span></summary>
      <p class="pc-src" set:html={md(p.src)} />
      <p class="pc-cap" set:html={md(p.caption)} />
    </details>
  ))}
</div>
)}
