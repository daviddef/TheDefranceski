---
/* One dialog serves every plate grid on the page. */
---
<dialog class="lb" id="lb" aria-label="Document plate">
  <div class="lb-in" style="position:relative">
    <div class="lb-img"><img id="lb-img" alt="" decoding="async" /><span class="lb-wait" id="lb-wait" role="status" hidden>Loading the full-size image…</span></div>
    <div class="lb-txt">
      <div class="lab" id="lb-holder"></div>
      <h3 id="lb-title"></h3>
      <p id="lb-cap"></p>
      <a class="lb-full" id="lb-full" href="#" target="_blank" rel="noopener">Open the image full size ↗</a>
      <div class="lb-nav">
        <button type="button" id="lb-prev">← Previous</button>
        <button type="button" id="lb-next">Next →</button>
      </div>
    </div>
    <button class="lb-close" type="button" id="lb-x">Close ✕</button>
  </div>
</dialog>
<script>
  const dlg = document.getElementById("lb");
  if (dlg) {
    const img = document.getElementById("lb-img");
    const ttl = document.getElementById("lb-title");
    const cap = document.getElementById("lb-cap");
    const hol = document.getElementById("lb-holder");
    const wait = document.getElementById("lb-wait");
    const full = document.getElementById("lb-full");
    let set = [], at = 0, tok = 0;

    const show = (n) => {
      if (!set.length) return;
      at = (n + set.length) % set.length;
      const p = set[at];
      /* The full-size plate can be a megabyte. The old code set img.src to it and showed an empty
         grey panel (the image is 0 x 0 until it arrives), and on Previous/Next kept the last picture
         beside the new caption. Now the thumbnail, already fetched for the grid, shows at once and
         is swapped for the full image when that has loaded; a late answer for a plate the reader has
         already left is dropped. */
      const me = ++tok;
      img.alt = p.title;
      if (p.w && p.h) { img.width = p.w; img.height = p.h; }
      img.src = p.thumb || p.src;
      full.href = p.src;
      if (p.thumb) {
        wait.textContent = "Loading the full-size image…"; wait.hidden = false; img.classList.add("lb-soft");
        const big = new Image();
        big.onload = () => { if (me !== tok) return; img.src = p.src; img.classList.remove("lb-soft"); wait.hidden = true; };
        big.onerror = () => { if (me !== tok) return; img.classList.remove("lb-soft"); wait.textContent = "The full-size image did not load; the preview is shown."; };
        big.src = p.src;
      } else { wait.hidden = true; img.classList.remove("lb-soft"); }
      // Plate captions are written in the archive's light markdown; render it
      // rather than printing the asterisks at the reader.
      const fmt = (x) => String(x ?? "")
        .replace(/[&<>]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" }[c]))
        .replace(/\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>')
        .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
        .replace(/«(.+?)»/g, "<em>«$1»</em>")
        .replace(/(^|[^*])\*([^*\n]+?)\*/g, "$1<em>$2</em>");
      ttl.textContent = p.title; cap.innerHTML = fmt(p.caption); hol.textContent = p.holder;
    };

    document.querySelectorAll("[data-plates]").forEach((grid) => {
      const data = JSON.parse(grid.getAttribute("data-plates"));
      grid.querySelectorAll(".plate").forEach((btn) => {
        btn.addEventListener("click", () => {
          set = data; show(+btn.dataset.i);
          dlg.showModal();
        });
      });
    });

    document.getElementById("lb-x").addEventListener("click", () => dlg.close());
    document.getElementById("lb-prev").addEventListener("click", () => show(at - 1));
    document.getElementById("lb-next").addEventListener("click", () => show(at + 1));
    dlg.addEventListener("click", (e) => { if (e.target === dlg) dlg.close(); });
    document.addEventListener("keydown", (e) => {
      if (!dlg.open) return;
      if (e.key === "ArrowLeft") show(at - 1);
      if (e.key === "ArrowRight") show(at + 1);
    });
  }
</script>
