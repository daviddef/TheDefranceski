---
import d from "../data/onename.json";
const STATE = {
  present: ["Carried", "s-on"],
  echo:    ["Only as a patronymic", "s-echo"],
  absent:  ["Not carried", "s-off"],
  return:  ["Carried again", "s-on"],
};
---
<div class="oname">
  <div class="on-forms">
    {d.forms.map(f => <span class="on-f">{f}</span>)}
  </div>
  <p class="cap" style="margin-top:12px">{d.formsnote}</p>

  <ol class="on-list">
    {d.rows.map(r => (
      <li class={"on-row " + STATE[r.state][1]}>
        <div class="on-rail" aria-hidden="true"><span class="on-dot"></span></div>
        <div class="on-body">
          <div class="on-top">
            <span class="on-form">{r.form}</span>
            <span class="on-lang">{r.lang}</span>
            <span class="on-state">{STATE[r.state][0]}</span>
          </div>
          <div class="on-who">{r.who}<span class="on-years">{r.years}</span></div>
          <div class="on-rule">{r.rule}</div>
          <p class="on-note" set:html={r.note.replace(/\*\*(.+?)\*\*/g,"<strong>$1</strong>").replace(/(^|[^*])\*([^*\n]+?)\*/g,"$1<em>$2</em>")}></p>
        </div>
      </li>
    ))}
  </ol>
</div>

<style>
  .oname{margin-top:22px}
  .on-forms{display:flex;flex-wrap:wrap;gap:6px}
  .on-f{font-family:var(--serif);font-size:15px;color:var(--ink-2);
    border:1px solid var(--rule);border-radius:20px;padding:4px 12px;background:var(--panel)}
  .on-list{list-style:none;margin:30px 0 0;padding:0}
  .on-row{display:grid;grid-template-columns:34px 1fr;gap:0 18px;padding-bottom:26px}
  .on-rail{position:relative;display:flex;justify-content:center}
  .on-rail::before{content:"";position:absolute;top:6px;bottom:-26px;width:2px;
    background:var(--rule-strong)}
  .on-row:last-child .on-rail::before{display:none}
  .on-dot{position:relative;z-index:1;width:14px;height:14px;border-radius:50%;
    margin-top:5px;background:var(--panel);border:2.5px solid var(--rule-strong)}
  .s-on .on-dot{border-color:var(--accent);background:var(--accent)}
  .s-echo .on-dot{border-color:var(--accent);background:var(--panel)}
  .s-off .on-dot{border-color:var(--ink-3);background:var(--panel)}
  .s-off .on-rail::before{background:repeating-linear-gradient(var(--rule-strong) 0 4px,transparent 4px 9px)}
  .on-top{display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 14px}
  .on-form{font-family:var(--serif);font-size:30px;line-height:1.05;color:var(--ink)}
  .s-on .on-form{color:var(--accent)}
  .s-off .on-form{color:var(--ink-3)}
  .on-lang{font-family:var(--sans);font-size:12.5px;color:var(--ink-2)}
  .on-state{font-family:var(--mono);font-size:9px;letter-spacing:.12em;text-transform:uppercase;
    padding:3px 8px;border-radius:4px;background:var(--panel-2);color:var(--ink-3)}
  .s-on .on-state{background:color-mix(in srgb,var(--accent) 14%,transparent);color:var(--accent)}
  .s-echo .on-state{background:color-mix(in srgb,var(--ochre) 18%,transparent);color:var(--ochre)}
  .on-who{margin-top:7px;font-family:var(--sans);font-size:14px;color:var(--ink)}
  .on-years{font-family:var(--mono);font-size:12px;color:var(--ink-3);margin-left:10px;
    font-variant-numeric:tabular-nums}
  .on-rule{margin-top:3px;font-family:var(--mono);font-size:10px;letter-spacing:.1em;
    text-transform:uppercase;color:var(--ink-3)}
  .on-note{margin-top:9px;font-family:var(--sans);font-size:14px;line-height:1.65;
    color:var(--ink-2);max-width:76ch}
  @media (max-width:560px){.on-form{font-size:24px}.on-row{grid-template-columns:26px 1fr;gap:0 12px}}
</style>
