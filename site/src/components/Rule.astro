---
/* A section break. The rule itself is the kit's, shared with two sibling
   archives; what stays here is this archive's own ornament — the mark goes in
   as a slot precisely so the kit never has to know about it. */
import Motif from "./Motif.astro";
import Rule from "@daviddef/archive-kit/components/Rule.astro";
const { name = "arrows", label } = Astro.props;
---
<Rule label={label}><Motif name={name} size={26} /></Rule>
