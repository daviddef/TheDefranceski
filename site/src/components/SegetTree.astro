---
/* THE HOUSEHOLD, DRAWN AS WHAT IT IS.
 *
 * David, looking at the table this replaces: «is this a tree?» It was — a
 * four-generation descent flattened into seven rows of a table, which hid the
 * one thing a reader needs: that Nicolò, Angelo and Alvise are the sons of
 * MARC'ANTONIO, not of Giorgio. The table listed them straight after Giorgio
 * and Nicolò with the single word «son», and nothing said whose.
 *
 * The parentage is not inferred here. seget.json already carried
 * `children_marcantonio` — eleven names, Nicolò and Alvise and Angelo among
 * them — and `children_alvise`, six. The tree simply draws what those two
 * lists already said.
 *
 * The eleven and the six are drawn as chips rather than boxes because that is
 * all this archive has of most of them: a name in a genealogy. Only the four
 * the sources actually describe get a box, and the three generations that
 * carry the estate get the spine.
 */
const { t } = Astro.props;
import { u } from "../lib/url.js";
/* A name links to its own page when the data gives it one. The pid is in
   seget.json beside the name; nothing is looked up here, so a name that has no
   page stays plain text instead of linking somewhere that 404s. */
const link = (pid) => (pid ? u(`/person/${pid}/`) : null);
---
<div class="stree">
  <ol class="st-channel">
    {t.gens.map((g, gi) => (
      <li class={`st-gen ${gi === 0 ? "first" : ""}`}>
        <span class="st-dot" aria-hidden="true"></span>
        <div class="st-head">
          <span class="st-place">Generation {g.n}</span>
          <span class="st-kind">{g.label}</span>
        </div>

        <ul class="st-people">
          {g.people.map(p => (
            <li>
              <span class="st-gn">{g.n}</span>
              <span class="st-pname">{link(p.pid) ? <a href={link(p.pid)}>{p.name}</a> : p.name}</span>
              {p.d && p.d !== "\u2014" && <span class="st-dates">{p.d}</span>}
              {p.w && <span class="st-what">{p.w}</span>}
            </li>
          ))}
        </ul>

        {g.people.filter(p => p.spouse).map(p => (
          <ul class="st-joins">
            <li>
              <span class="st-trib" aria-hidden="true">&#8627;</span>
              <span class="st-fam">{link(p.spousePid) ? <a href={link(p.spousePid)}>{p.spouse}</a> : p.spouse}</span>
              <span class="st-person">married {p.name}</span>
            </li>
          </ul>
        ))}

        {g.sibs && (
          <div class="st-sibs">
            <p class="st-sl">{g.sibs.label}</p>
            <ul>
              {g.sibs.names.map(n => (
                <li class={g.sibs.carried && g.sibs.carried.includes(n) ? "carried" : ""}>{link(g.sibs.pids && g.sibs.pids[n]) ? <a href={link(g.sibs.pids[n])}>{n}</a> : n}</li>
              ))}
            </ul>
            {g.sibs.note && <p class="st-sn">{g.sibs.note}</p>}
          </div>
        )}
      </li>
    ))}
  </ol>
</div>

<style>
  /* ALIGNED TO River.astro ON PURPOSE. David: "and this is a family tree? can
     we align them to be consistent". The two drawings on this page cover the
     SAME four generations — the river by route, Candia to Brtonigla; this one
     by descent — and in two different visual languages they read as unrelated
     widgets that happen to both count to four. Every measurement below is
     River's: the 26px channel, the 2px spine at left 7, the 11px dot at
     left -24, the same type scale, the same row rules and the same ↳ for a
     family marrying in. If River's geometry changes, change this with it. */
  .stree { margin: 20px 0 0; }
  .st-channel { list-style: none; margin: 22px 0 0; padding: 0 0 0 26px; position: relative; }
  .st-channel::before {
    content: ""; position: absolute; left: 7px; top: 6px; bottom: 6px;
    width: 2px; background: var(--accent-wash, #d8d2c4);
  }
  .st-gen { position: relative; padding: 0 0 22px 10px; }
  .st-gen:last-child { padding-bottom: 0; }
  .st-dot {
    position: absolute; left: -24px; top: 5px; width: 11px; height: 11px;
    border-radius: 50%; background: var(--panel, #fff);
    border: 2px solid var(--accent, #8a7a52);
  }
  .st-gen.first .st-dot { background: var(--accent, #8a7a52); }

  .st-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px; }
  .st-place { font-weight: 700; font-size: 17px; color: var(--ink); }
  .st-kind { font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--dim); }

  .st-people { list-style: none; margin: 10px 0 0; padding: 0; }
  .st-people li {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px;
    padding: 5px 0; border-top: 1px solid var(--accent-wash, #e8e2d4);
  }
  .st-gn { font-family: var(--mono); font-size: 12.5px; min-width: 1.6em;
           text-align: right; color: var(--dim); }
  .st-pname { font-weight: 600; font-size: 16px; color: var(--ink); }
  .st-dates { font-family: var(--mono); font-size: 13.5px; color: var(--dim); }
  .st-what { flex-basis: 100%; font-size: 14.5px; color: var(--dim);
             line-height: 1.55; max-width: 62ch; }

  .st-joins { list-style: none; margin: 8px 0 0; padding: 0 0 0 14px; }
  .st-joins li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 7px;
                 padding: 6px 0; font-size: 15px; }
  .st-pname a, .st-fam a, .st-sibs li a { color: inherit; text-decoration: none;
                                       border-bottom: 1px solid var(--accent-wash, #d8d2c4); }
  .st-pname a:hover, .st-fam a:hover, .st-sibs li a:hover { border-bottom-color: var(--accent, #8a7a52); }
  .st-trib { color: var(--accent, #8a7a52); }
  .st-fam { font-weight: 600; color: var(--ink); }
  .st-person { color: var(--dim); font-size: 14px; }

  .st-sibs { margin-top: 14px; border-top: 1px solid var(--accent-wash, #e8e2d4); padding-top: 10px; }
  .st-sl { margin: 0 0 8px; font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--dim); }
  .st-sibs ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .st-sibs li { font-size: 13.5px; padding: 3px 11px; border-radius: 999px;
                border: 1px solid var(--accent-wash, #d8d2c4); color: var(--dim); }
  .st-sibs li.carried { border-color: var(--accent, #8a7a52); color: var(--ink);
                        font-weight: 600; background: var(--accent-wash, #f0ebdd); }
  .st-sn { margin: 9px 0 0; font-size: 13px; color: var(--dim); line-height: 1.55; max-width: 62ch; }
</style>
