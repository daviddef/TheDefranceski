---
/* Sift — every issue of a newspaper run that carries the name, on a date rule,
   with the handful that carry a PERSON drawn out of the crowd.

   The point of the drawing is the ratio. A hundred and sixty of these ticks
   are an address in a rental advertisement; four of them are somebody's life.
   Nothing here is an estimate: one tick per issue actually read. */
const { g } = Astro.props;
const t = g.ticks;
const peep = new Set(g.people.map(p => p.datum));
const unk = new Set((g.unnamed || []).map(p => p.datum));

/* the strip is cut where the paper's digitised run is cut: a dense band of
   1914 into March 1915, then a single issue four years later. Drawing that
   gap to scale would waste four fifths of the width on nothing. */
const main = t.filter(d => d < "19160000");
const tail = t.filter(d => d >= "19160000");
const day = (d) => Date.UTC(+d.slice(0,4), +d.slice(4,6) - 1, +d.slice(6,8)) / 864e5;
const lo = day(main[0]), hi = day(main[main.length - 1]);
const W = 1000, H = 96, PAD = 26, TRACK = W - 2 * PAD - (tail.length ? 110 : 0);
const x = (d) => PAD + ((day(d) - lo) / (hi - lo)) * TRACK;

/* one mark per month the run touches, the first pinned to the left edge so
   the strip always opens with a year on it */
const months = [];
for (let y = +main[0].slice(0, 4); y <= +main[main.length - 1].slice(0, 4); y++)
  for (let m = 0; m < 12; m++) {
    const s = `${y}${String(m + 1).padStart(2, "0")}01`;
    if (s >= main[0].slice(0, 6) + "01" && s <= main[main.length - 1]) months.push({ s, y, m });
  }
const MN = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
---
<figure class="sf">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${t.length} issues carry the name; ${g.people.length} carry a person`}>
    <line x1={PAD} y1="58" x2={PAD + TRACK} y2="58" class="sf-rule" />

    {months.map((m, i) => (
      <g>
        <line x1={Math.max(x(m.s), PAD)} y1="54" x2={Math.max(x(m.s), PAD)} y2="62" class="sf-mk" />
        <text x={Math.max(x(m.s), PAD)} y="76" class="sf-ml">{MN[m.m]}{m.m === 0 || i === 0 ? ` ${m.y}` : ""}</text>
      </g>
    ))}

    {main.map(d => (
      <line x1={x(d)} y1={peep.has(d) ? 18 : unk.has(d) ? 38 : 46}
            x2={x(d)} y2="58"
            class={peep.has(d) ? "sf-t sf-p" : unk.has(d) ? "sf-t sf-u" : "sf-t"} />
    ))}
    {main.filter(d => peep.has(d)).map(d => <circle cx={x(d)} cy="18" r="3.6" class="sf-dot" />)}

    {tail.length > 0 && (
      <g>
        <line x1={PAD + TRACK + 16} y1="58" x2={PAD + TRACK + 34} y2="58" class="sf-gap" />
        {tail.map((d, i) => <line x1={PAD + TRACK + 52 + i * 6} y1="46" x2={PAD + TRACK + 52 + i * 6} y2="58" class="sf-t" />)}
        <text x={PAD + TRACK + 52} y="76" class="sf-ml sf-tl">{tail[0].slice(6,8).replace(/^0/,"")} May 1919</text>
      </g>
    )}
  </svg>

  <figcaption class="sf-cap">
    <span class="sf-k"><i class="sf-sw sf-p"></i>{g.people.length} issues name a person</span>
    <span class="sf-k"><i class="sf-sw sf-u"></i>{(g.unnamed || []).length} name the family without a forename</span>
    <span class="sf-k"><i class="sf-sw"></i>{t.length - g.people.length - (g.unnamed || []).length} carry only the street</span>
  </figcaption>
</figure>

<style>
  .sf { margin: 26px 0 8px; }
  .sf svg { width: 100%; height: auto; display: block; }
  .sf-rule { stroke: var(--rule-strong); stroke-width: 1; }
  .sf-mk { stroke: var(--rule); stroke-width: 1; }
  .sf-ml { fill: var(--ink-3); font: 400 10px/1 var(--mono); letter-spacing: .04em; text-anchor: middle; }
  .sf-tl { text-anchor: start; }
  .sf-t { stroke: var(--ink-3); stroke-width: 2.2; opacity: .42; }
  .sf-u { stroke: var(--ochre); stroke-width: 2.6; opacity: .95; }
  .sf-p { stroke: var(--accent); stroke-width: 3; opacity: 1; }
  .sf-dot { fill: var(--accent); }
  .sf-gap { stroke: var(--rule); stroke-width: 1; stroke-dasharray: 2 3; }
  .sf-cap {
    display: flex; flex-wrap: wrap; gap: 6px 22px;
    font: 400 12px/1.5 var(--mono); color: var(--ink-3);
    letter-spacing: .02em; margin-top: 10px;
  }
  .sf-k { display: inline-flex; align-items: center; gap: 7px; }
  .sf-sw { width: 12px; height: 3px; background: var(--ink-3); opacity: .42; display: inline-block; }
  .sf-sw.sf-p { background: var(--accent); opacity: 1; }
  .sf-sw.sf-u { background: var(--ochre); opacity: .95; }
</style>
