---
/* Worldwide incidence of one spelling of the name.

   The chart is the kit's and takes rows. The lookup is this archive's: it holds
   several spellings in one file and a page asks for them by name, which is why
   the shared component could never have read the file itself. */
import names from "../data/names.json";
import Distribution from "@daviddef/archive-kit/components/Distribution.astro";
const { spelling } = Astro.props;
const set = names.distribution.sets.find((s) => s.spelling === spelling);
---
<Distribution rows={set.rows} rest="--r-habsburg"
              label={`Worldwide incidence of the spelling ${spelling}`} />
