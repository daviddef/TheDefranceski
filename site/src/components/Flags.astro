---
// Schematic renderings. Field divisions and principal charges only.
const flags=[
 {id:"venice",n:"Republic of Venice",y:"1420–1797",w:"Over Mione and Carnia for 377 years — and over the Istrian coast, though never over Pazin county."},
 {id:"habsburg",n:"Habsburg / Austria",y:"1374–1918",w:"Over Gologorica and Gračišće from 1374, and over Senj from 1522. The longest single authority in this archive."},
 {id:"napo",n:"Napoleonic Italy",y:"1805–1815",w:"Kingdom of Italy, then the Illyrian Provinces. Ten years that broke every older register series."},
 {id:"italy",n:"Kingdom of Italy",y:"1920–1943",w:"Over Istria after Rapallo — never over Senj or Crikvenica. The years of surname Italianisation."},
 {id:"yugo",n:"Yugoslavia",y:"1945–1991",w:"Over both halves of the family at once, for the first time since the Middle Ages."},
 {id:"croatia",n:"Croatia",y:"1991–",w:"Present day. Some ten Defranceschi remain in the country."},
];
---
<div class="flags">
{flags.map(f=>(
  <div class="flag">
    <svg viewBox="0 0 90 60" width="100%" role="img" aria-label={`Schematic flag: ${f.n}`}>
      {f.id==="venice" && <g>
        <rect width="90" height="60" fill="#8E1F2B"/>
        <g fill="#C79A2B" transform="translate(24,18) scale(0.9)">
          <ellipse cx="22" cy="16" rx="14" ry="7"/><circle cx="8" cy="11" r="6"/>
          <path d="M20,12 L40,2 L38,14 Z"/><rect x="4" y="20" width="30" height="3" rx="1.5"/>
        </g>
      </g>}
      {f.id==="habsburg" && <g><rect width="90" height="30" fill="#20242A"/><rect y="30" width="90" height="30" fill="#C79A2B"/></g>}
      {f.id==="napo" && <g>
        <rect width="30" height="60" fill="#3E7A46"/><rect x="30" width="30" height="60" fill="#E8E6DF"/>
        <rect x="60" width="30" height="60" fill="#9E2B2B"/>
        <rect x="36" y="21" width="18" height="18" transform="rotate(45 45 30)" fill="#3E7A46" stroke="#C79A2B" stroke-width="1.5"/>
      </g>}
      {f.id==="italy" && <g>
        <rect width="30" height="60" fill="#3E7A46"/><rect x="30" width="30" height="60" fill="#E8E6DF"/>
        <rect x="60" width="30" height="60" fill="#9E2B2B"/>
        <rect x="37" y="22" width="16" height="16" fill="#9E2B2B" stroke="#C79A2B" stroke-width="1.4"/>
        <path d="M45,24 V36 M39,30 H51" stroke="#E8E6DF" stroke-width="3"/>
      </g>}
      {f.id==="yugo" && <g>
        <rect width="90" height="20" fill="#2C4C86"/><rect y="20" width="90" height="20" fill="#E8E6DF"/>
        <rect y="40" width="90" height="20" fill="#9E2B2B"/>
        <path d="M45,17 L49.7,30.5 L63,30.5 L52.2,38.6 L56.4,52 L45,43.6 L33.6,52 L37.8,38.6 L27,30.5 L40.3,30.5 Z"
              fill="#C8202E" stroke="#7A1420" stroke-width="1"/>
      </g>}
      {f.id==="croatia" && <g>
        <rect width="90" height="20" fill="#9E2B2B"/><rect y="20" width="90" height="20" fill="#E8E6DF"/>
        <rect y="40" width="90" height="20" fill="#2C4C86"/>
        <g transform="translate(34,17)">
          {[0,1,2,3].map(r=>[0,1,2,3].map(c=>
            <rect x={c*5.5} y={r*5.5} width="5.5" height="5.5" fill={(r+c)%2 ? "#9E2B2B":"#E8E6DF"}/>))}
          <rect width="22" height="22" fill="none" stroke="#20242A" stroke-width="1"/>
        </g>
      </g>}
    </svg>
    <div class="n">{f.n}</div>
    <div class="y">{f.y}</div>
    <div class="w">{f.w}</div>
  </div>
))}
</div>
