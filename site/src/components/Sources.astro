---
/* "What this page rests on" — and, since September 2026, a way to actually get
   there. The block used to link only inward, to this site's own bibliography,
   which answered «what is this» and never «take me to it». Each source now
   carries its outward link as well, and says where the thing physically is when
   there is nothing on the web to point at. */
import { u } from "../lib/url.js";
import all from "../data/sources.json";
const { ids, note } = Astro.props;
const list = ids.map(i => all.find(s => s.id === i)).filter(Boolean);
const host = (url) => (url || "").replace(/^https?:\/\/(www\.)?/, "").replace(/\/.*$/, "");
---
<section class="srcblock">
  <div class="lab">What this page rests on</div>
  <div class="srclist">
    {list.map(s => (
      <div class="srcitem">
        <a href={u(`/sources/#${s.id}`)}>{s.title}</a>
        <span>{s.kind}{s.where ? ` · ${s.where}` : ""}</span>
        {s.url
          ? <a class="srcout" href={s.url} rel="noopener" target="_blank">{host(s.url)} &#8599;</a>
          : <span class="srcheld">{s.held ? s.held : "not online — see the bibliography for where it is held"}</span>}
      </div>
    ))}
  </div>
  {note && <p class="cap" style="margin-top:14px">{note}</p>}
  <p class="cap" style="margin-top:10px"><a href={u("/sources/")}>The full bibliography, with what each source gave and where it is weak →</a></p>
</section>
<style>
  .srcout {
    display: block; margin-top: 3px;
    font: 400 11px/1.3 var(--mono); letter-spacing: .02em;
    overflow-wrap: anywhere;
  }
  .srcheld {
    display: block; margin-top: 3px;
    font: 400 11px/1.3 var(--mono); color: var(--ink-3); letter-spacing: .02em;
  }
</style>
