---
/* A retired /who/ address that lands on the page that now holds its subject.
   These six were Astro `redirects` until 17 October 2026. A redirect page has no layout, so it could carry neither the
   book's running head nor its Previous / Next, and checkbook.py (the build's gate on the book) fails any built page under
   /who/ that lacks them. So the six are ordinary pages now, at the same six addresses, with the same meta refresh, the
   same canonical and the same noindex the redirect had. Each one's reason is kept in its own file. */
import Base from "../layouts/Base.astro";
import { u } from "../lib/url.js";
const { to, from } = Astro.props;
const target = u(to);
const canonical = Astro.site ? new URL(target, Astro.site).href : target;
---
<Base title={`Moved to ${to}`} eyebrow="This address has moved" dek="The page that was here is now at the address below." noindex canonical={canonical}>
  <meta slot="head" http-equiv="refresh" content={`0;url=${target}`} />
  <p><a href={target}>Moving from <code>{from}</code> to <code>{to}</code></a></p>
</Base>
