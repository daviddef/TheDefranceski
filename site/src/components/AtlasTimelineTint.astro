---
/* Colour the gap rows in the Atlas panel's coverage timeline.

   The panel is the shared kit component and this session does not own it, so
   nothing here reaches into the kit: the rows are tagged from outside, after
   the panel renders, by reading the text the builder already puts in them.
   «GAP — no births register filmed, 15 years» is the row that matters and it
   was reading as one grey line among twenty.

   The panel is rebuilt with innerHTML on every marker click, so a one-shot
   pass would only ever paint the first place a reader opened. A
   MutationObserver re-tags on each rebuild. */
---
<style is:global>
  /* A hole in the record, which is the thing somebody came to this map to find. */
  .at-ev li.at-gap {
    background: rgba(176, 74, 22, 0.13);
    border-left: 2.5px solid #B04A16;
    padding: 4px 8px 4px 9px;
    margin-left: -9px;
    border-radius: 0 2px 2px 0;
  }
  .at-ev li.at-gap .at-ed { color: #8E3A11; font-weight: 600; }
  :root:not([data-theme="light"]) .at-ev li.at-gap { background: rgba(214, 106, 48, 0.17); }
  :root:not([data-theme="light"]) .at-ev li.at-gap .at-ed { color: #E2894F; }
  :root[data-theme="dark"] .at-ev li.at-gap { background: rgba(214, 106, 48, 0.17); }
  :root[data-theme="dark"] .at-ev li.at-gap .at-ed { color: #E2894F; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .at-ev li.at-gap { background: rgba(214, 106, 48, 0.17); }
    :root:not([data-theme="light"]) .at-ev li.at-gap .at-ed { color: #E2894F; }
  }

  /* A year uncovered by any title but almost certainly not a missing book.
     Marked, because it is still a hole on paper — but not cried over. */
  .at-ev li.at-soft {
    background: rgba(140, 140, 140, 0.10);
    border-left: 2.5px dotted var(--rule, #dcd6cc);
    padding: 4px 8px 4px 9px;
    margin-left: -9px;
    border-radius: 0 2px 2px 0;
  }

  /* Every volume of a kind, one by one, folded away until asked for.
     The timeline above answers «is there a hole»; this answers «what is
     actually on the shelf», and for a parish with a hundred volumes it must
     not be the first thing a reader meets. */
  .at-ev li.at-vols { margin: 4px 0 2px; }
  .at-ev li.at-vols > details > summary {
    cursor: pointer; font-family: var(--mono); font-size: 11px;
    color: var(--ink-3); list-style: none; padding: 2px 0;
  }
  .at-ev li.at-vols > details > summary::-webkit-details-marker { display: none; }
  .at-ev li.at-vols > details > summary::before { content: "▸ "; }
  .at-ev li.at-vols > details[open] > summary::before { content: "▾ "; }
  .at-ev li.at-vols > details > summary:hover { color: var(--ink-2); }
  .at-ev li.at-vols ul {
    list-style: none; margin: 6px 0 2px; padding: 0 0 0 12px;
    border-left: 1px solid var(--rule, #dcd6cc); display: grid; gap: 3px;
  }
  .at-ev li.at-vols ul li { font-size: 12px; line-height: 1.45; color: var(--ink-2); }
  .at-ev li.at-vols ul li .at-ed {
    display: inline; margin-right: 8px; font-size: 10.5px;
  }
  /* A volume somebody has actually opened and read, page by page. This is the
     rarest state in the archive — 16 of 7,159 — and the one the whole map
     exists to grow, so it gets the strongest mark on the panel. */
  .at-ev li.at-open a { font-size: 12.5px; }
  .at-ev li.at-vols ul li.at-read,
  .at-ev li.at-read,
  .at-films li.at-read {
    background: rgba(18, 112, 63, 0.14);
    border-left: 2.5px solid #12703F;
    padding: 3px 8px 3px 8px;
    margin-left: -10px;
    border-radius: 0 2px 2px 0;
    color: #0E5730;
  }
  .at-films li.at-read a { color: #0E5730; }
  .at-ev li.at-vols ul li.at-paper { color: #8E3A11; }

  /* The record-type heading, coloured by how far that type has got:
     green when every volume of it has been read, amber when some have. */
  .at-ev li.at-kind.at-all {
    background: rgba(18, 112, 63, 0.13);
    border-left: 2.5px solid #12703F;
    padding: 4px 8px; margin-left: -10px; border-radius: 0 2px 2px 0;
  }
  .at-ev li.at-kind.at-part {
    background: rgba(233, 160, 32, 0.16);
    border-left: 2.5px solid #C9820F;
    padding: 4px 8px; margin-left: -10px; border-radius: 0 2px 2px 0;
  }
  .at-ev li.at-kind.at-all .at-ed { color: #0E5730; }
  .at-ev li.at-kind.at-part .at-ed { color: #8A5A08; }

  :root:not([data-theme="light"]) .at-ev li.at-vols ul li.at-read,
  :root:not([data-theme="light"]) .at-films li.at-read,
  :root[data-theme="dark"] .at-ev li.at-vols ul li.at-read,
  :root[data-theme="dark"] .at-films li.at-read {
    background: rgba(46, 168, 104, 0.18); color: #6FD3A0;
  }
  :root:not([data-theme="light"]) .at-films li.at-read a,
  :root[data-theme="dark"] .at-films li.at-read a { color: #6FD3A0; }

  /* Births / Marriages / Deaths — the block each timeline hangs under. */
  .at-ev li.at-kind { margin-top: 12px; }
  .at-ev li.at-kind .at-ed {
    font-family: inherit; font-size: 11px; letter-spacing: .09em;
    text-transform: uppercase; font-weight: 700; color: var(--ink-2);
  }
  .at-ev li.at-kind:first-child { margin-top: 2px; }
</style>

<script is:inline>
  (function () {
    var body = document.getElementById("at-body");
    if (!body) return;
    /* The builder indents every row that belongs under a record-type heading
       with two spaces, so the heading rows are the ones whose date cell does
       not start with whitespace. */
    function tag() {
      var rows = body.querySelectorAll(".at-ev li");
      for (var i = 0; i < rows.length; i++) {
        var li = rows[i];
        var ed = li.querySelector(".at-ed");
        var when = ed ? (ed.textContent || "") : "";
        var text = (li.textContent || "").slice(when.length);
        li.classList.toggle("at-gap", /^\s*GAP\b/.test(text));
        li.classList.toggle("at-soft", /^\s*not covered by any title/.test(text));
        /* A record-type heading is one of exactly three words in the date
           cell, with no indent. The old test looked for «volumes, covering»,
           which a parish holding ONE book of a kind never says — so every
           single-volume heading on the map went untagged and unmarked. */
        var kind = /^(Births|Marriages|Deaths)$/.test(when);
        li.classList.toggle("at-kind", kind);
        li.classList.toggle("at-all", kind && /ALL READ/.test(text));
        li.classList.toggle("at-part", kind && /\d+ of \d+ read/.test(text));
      }
      films();
      fold();
      marks();
    }

    /* A mark on every volume row and every record-type heading, saying how far
       through it anybody has got. Four states, and the fourth is the one this
       map mostly needs: «nobody has written it down». Drawing an empty circle
       on an untracked volume would claim we had checked and found it unopened,
       which is a different and untrue thing.

       Runs last, after films() has rewritten the rows it moves links into and
       after fold() has put them inside their details element. */
    var MARK = {
      read: ["\u25CF", "at-mk-read", "Read right through."],
      part: ["\u25D0", "at-mk-part", "Opened, and part of it read."],
      shut: ["\u25CB", "at-mk-shut", "Never opened. This parish does track its volumes one by one, so this is a checked negative."],
      nil:  ["\u00B7",  "at-mk-nil",  "Not tracked. Nobody has recorded whether this volume has been opened — it is not the same as knowing it has not been."]
    };
    function mark(li, st) {
      var ed = li.querySelector(".at-ed");
      if (!ed || li.querySelector(".at-mk")) return;
      var m = MARK[st]; if (!m) return;
      var i = document.createElement("i");
      i.className = "at-mk " + m[1];
      i.textContent = m[0];
      i.setAttribute("title", m[2]);
      i.setAttribute("aria-hidden", "true");
      ed.parentNode.insertBefore(i, ed.nextSibling);
    }
    function marks() {
      var rows = body.querySelectorAll(".at-ev li");
      /* Whether this PLACE tracks its volumes at all decides between «never
         opened» and «not written down», so it is read once off the headings
         rather than guessed row by row. */
      var tracks = false;
      for (var t = 0; t < rows.length; t++) {
        if (rows[t].classList.contains("at-kind") &&
            !/not tracked per volume/.test(rows[t].textContent || "")) { tracks = true; break; }
      }
      for (var i = 0; i < rows.length; i++) {
        var li = rows[i], txt = li.textContent || "";
        /* The folded «N volumes, one by one» row is a lid, not a book: its
           textContent is every volume underneath it, so testing it for READ
           marks the lid green the moment any one book below is. */
        if (li.classList.contains("at-vols")) continue;
        if (li.classList.contains("at-kind")) {
          mark(li, /ALL READ/.test(txt) ? "read"
                 : /\bread,\s*\d+ part read/.test(txt) ? "part"
                 : /not tracked per volume/.test(txt) ? "nil" : "shut");
          continue;
        }
        var ed = li.querySelector(".at-ed");
        if (!ed || !/^ {4}/.test(ed.textContent || "")) continue;   /* volume rows only */
        mark(li, /\u2014\s*READ/.test(txt) ? "read"
               : /\u2014\s*PART READ/.test(txt) ? "part"
               : tracks ? "shut" : "nil");
      }
      /* One line of legend, under the section's own heading, because four
         marks with no key is a puzzle rather than a finding. */
      var sec = body.querySelector(".at-ev");
      sec = sec && sec.closest(".at-sec");
      if (sec && !sec.querySelector(".at-legend")) {
        var p = document.createElement("p");
        p.className = "at-legend";
        p.innerHTML =
          '<span><i class="at-mk at-mk-read">\u25CF</i><b>read</b></span>' +
          '<span><i class="at-mk at-mk-part">\u25D0</i><b>part read</b></span>' +
          '<span><i class="at-mk at-mk-shut">\u25CB</i><b>never opened</b></span>' +
          '<span><i class="at-mk at-mk-nil">\u00B7</i><b>not written down</b></span>';
        var lab = sec.querySelector(".lab");
        if (lab && lab.nextSibling) sec.insertBefore(p, lab.nextSibling);
        else sec.appendChild(p);
      }
    }

    /* ONE list, not two.
       The kit renders the volumes twice over: once as the coverage timeline
       this archive feeds it, and once as its own «open at page one» list of
       links. On a parish with a single book that meant seeing the same volume
       four times — heading, span, row, link — which is three times too many.
       So the links are MOVED into the timeline rows they belong to, matched on
       the label the builder deliberately makes identical on both sides, and
       the leftover list is removed. Nothing in the shared component changes. */
    function films() {
      var links = body.querySelectorAll(".at-films li");
      var rows = body.querySelectorAll(".at-ev li");
      var pool = [];
      for (var i = 0; i < links.length; i++) {
        var a = links[i].querySelector("a");
        if (a) pool.push({ li: links[i], a: a, key: key(a.textContent) });
      }
      for (var r = 0; r < rows.length; r++) {
        var li = rows[r];
        if (li.querySelector("a")) continue;
        var ed = li.querySelector(".at-ed");
        if (!ed || !/^ {4}/.test(ed.textContent || "")) continue;
        var text = (li.textContent || "").slice((ed.textContent || "").length);
        var k = key(text);
        for (var j = 0; j < pool.length; j++) {
          if (pool[j].used || pool[j].key !== k) continue;
          pool[j].used = true;
          var a = pool[j].a;
          a.setAttribute("target", "_blank");
          a.setAttribute("rel", "noopener");
          a.textContent = text.trim() + " \u2197";
          while (ed.nextSibling) li.removeChild(ed.nextSibling);
          li.appendChild(a);
          li.classList.add("at-open");
          /* The link has moved; its old row must go with it or the section it
             came from stays alive on a list of empty bullets. */
          if (pool[j].li.parentNode) pool[j].li.parentNode.removeChild(pool[j].li);
          break;
        }
      }
      /* Whatever could not be matched keeps its own section rather than being
         thrown away; if everything matched, the section goes. */
      var secs = body.querySelectorAll(".at-films");
      for (var q = 0; q < secs.length; q++) {
        if (!secs[q].querySelector("li")) {
          var sec = secs[q].closest(".at-sec");
          if (sec) sec.hidden = true;
        }
      }
      for (var m = 0; m < rows.length; m++) {
        rows[m].classList.toggle("at-read", /\u2014\s*READ/.test(rows[m].textContent || ""));
      }
    }

    /* Years and letters only, order-insensitive — so «Deaths (Umrli) 1875-1895»
       from the kit's link and «1875–1895 · Deaths (Umrli)» from the timeline
       are recognised as one book. */
    function key(s) {
      s = String(s || "").replace(/\u2014\s*(READ|not digitised anywhere)/g, "");
      var years = (s.match(/1[5-9]\d\d/g) || []).sort().join("");
      var word = s.toLowerCase().replace(/[^a-z\u00c0-\u024f]+/g, "");
      return years + "|" + word;
    }

    /* The builder marks a per-volume row by indenting its date by four
       spaces. Consecutive runs of those are lifted out of the flat list and
       put inside a collapsed <details>, so the shelf is one line until
       somebody wants it. Done here rather than in the shared Atlas, which
       this session does not own. */
    function fold() {
      var uls = body.querySelectorAll(".at-ev");
      for (var u = 0; u < uls.length; u++) {
        var kids = Array.prototype.slice.call(uls[u].children), run = [];
        for (var i = 0; i <= kids.length; i++) {
          var li = kids[i];
          var ed = li && li.querySelector ? li.querySelector(".at-ed") : null;
          var deep = !!ed && /^ {4}/.test(ed.textContent || "");
          if (deep && !li.classList.contains("at-vols")) { run.push(li); continue; }
          if (run.length) { if (run.length > 4) wrap(run); run = []; }
        }
      }
    }

    function wrap(run) {
      var first = run[0];
      var host = document.createElement("li");
      host.className = "at-vols";
      var det = document.createElement("details");
      var sum = document.createElement("summary");
      sum.textContent = run.length + (run.length === 1 ? " volume" : " volumes")
                      + ", one by one";
      var ul = document.createElement("ul");
      first.parentNode.insertBefore(host, first);
      run.forEach(function (li) {
        var t = li.textContent || "";
        if (/\u2014 READ\b/.test(t)) li.classList.add("at-read");
        else if (/not digitised/.test(t)) li.classList.add("at-paper");
        ul.appendChild(li);
      });
      det.appendChild(sum);
      det.appendChild(ul);
      host.appendChild(det);
    }

    /* The panel is rebuilt with innerHTML on every marker click, so a one-shot
       pass would only ever paint the first place a reader opened. */
    /* fold() moves nodes, which the observer sees. It is idempotent — once a
       run is inside a <details> those rows are no longer direct children of
       .at-ev, so the second pass finds nothing to move — but the guard makes
       that a property of the code rather than of the DOM. */
    var busy = false;
    new MutationObserver(function () {
      if (busy) return;
      busy = true;
      try { tag(); } finally { busy = false; }
    }).observe(body, { childList: true, subtree: true });
    tag();
  })();
</script>

<style is:global>
  /* The find box filters the map but only opens a place when the query happens
     to match exactly one. Typing «Senj» leaves Senj, Senja and Senjska Draga on
     the map and the panel still saying «pick a place», which is not what a
     search box promises. These are the matches, listed, so one can be chosen. */
  /* The find box and the filters ship below the map. They are controls for
     the map, so they belong above it — moved by node rather than by CSS
     order, because their parent is the page's own content column and turning
     that into a flex container to reorder two children would be a large
     change for a small reason. */
  .at-tools.at-top { margin: 4px 0 14px; }
  .at-count-top { margin: -6px 0 14px; }

  .at-find { position: relative; }
  .at-hits {
    position: absolute; z-index: 1200; left: 0; right: 0; top: 100%;
    margin: 4px 0 0; padding: 4px; list-style: none;
    background: var(--panel, #fff); border: 1px solid var(--rule, #dcd6cc);
    border-radius: 3px; box-shadow: 0 6px 18px rgba(0,0,0,.10);
    max-height: 280px; overflow-y: auto;
  }
  .at-hits[hidden] { display: none !important; }
  .at-hits li {
    display: flex; align-items: baseline; gap: 8px;
    padding: 6px 8px; cursor: pointer; border-radius: 2px; font-size: 13.5px;
  }
  .at-hits li:hover, .at-hits li.on { background: var(--card, #f3efe7); }
  .at-hits i { width: 8px; height: 8px; border-radius: 50%; flex: 0 0 auto; }
  .at-hits .n { font-weight: 600; }
  .at-hits .a { font-size: 11.5px; opacity: .62; font-style: italic; }
  .at-hits .v { margin-left: auto; font-size: 11px; opacity: .6; white-space: nowrap; }
  .at-hits .none { cursor: default; opacity: .6; font-style: italic; }
  /* A place that cannot answer the question being asked is still findable —
     it just says so. Clicking it still works; the marker is simply not lit. */
  .at-hits li.dim .n { opacity: .55; }
  .at-hits li.dim i { opacity: .25; }

  /* ---- the read marks ----------------------------------------------------
     A parish could say «something here has been read» while every volume
     under it said «none read», and both were true: a reading was recorded
     against the PLACE and never against the BOOK. The marks say which, one
     volume at a time, and there is a mark for «nobody has written it down»
     because that is the state most of this map is actually in. */
  .at-mk {
    display: inline-block; width: 1.05em; margin-right: 4px;
    font: 600 11px/1 var(--mono); text-align: center; vertical-align: 1px;
  }
  .at-mk-read { color: #0E5730; }
  .at-mk-part { color: #8A5A08; }
  .at-mk-shut { color: var(--ink-3); opacity: .55; }
  .at-mk-nil  { color: var(--ink-3); opacity: .3; }
  :root:not([data-theme="light"]) .at-mk-read { color: #6FD3A0; }
  :root:not([data-theme="light"]) .at-mk-part { color: #E0B457; }
  :root[data-theme="dark"] .at-mk-read { color: #6FD3A0; }
  :root[data-theme="dark"] .at-mk-part { color: #E0B457; }

  .at-legend {
    font: 400 10.5px/1.7 var(--mono); color: var(--ink-3);
    margin: 6px 0 0; display: flex; flex-wrap: wrap; gap: 2px 14px;
  }
  .at-legend b { font-weight: 600; }

  /* ---- the pulse ---------------------------------------------------------
     The people layer is off when the map opens, so the one thing that could
     not be seen was that it exists. The pill breathes until it is switched
     on, and the markers breathe while it is. */
  @keyframes at-breathe {
    0%, 100% { fill-opacity: .92; stroke-width: 1.2; }
    50%      { fill-opacity: .38; stroke-width: 3.4; }
  }
  @keyframes at-pill {
    0%, 100% { box-shadow: 0 0 0 0 rgba(122, 92, 168, .55); }
    50%      { box-shadow: 0 0 0 5px rgba(122, 92, 168, 0); }
  }
  #atlas path.at-pulse { animation: at-breathe 2.6s ease-in-out infinite; }
  .at-cat.at-pulse-pill { animation: at-pill 2.2s ease-in-out infinite; }
  @media (prefers-reduced-motion: reduce) {
    #atlas path.at-pulse, .at-cat.at-pulse-pill { animation: none; }
  }

  /* ---- the basemap picker ------------------------------------------------ */
  .at-base { background: none !important; border: none !important; }
  .at-base .at-base-in {
    display: flex; gap: 0; background: var(--card, #fff);
    border: 1px solid rgba(0, 0, 0, .28); border-radius: 3px; overflow: hidden;
  }
  .at-base button {
    font: 500 11px/1 system-ui, sans-serif; padding: 6px 8px;
    background: var(--card, #fff); color: var(--ink-2, #333);
    border: 0; border-left: 1px solid var(--rule, #ddd); cursor: pointer;
  }
  .at-base button:first-child { border-left: 0; }
  .at-base button.on { background: #7A5CA8; color: #fff; }

  /* ---- three questions, one map -----------------------------------------
     The archive grew three maps off the same ground. They are one map now,
     and this is the switch between the questions it can be asked. */
  .at-scheme { margin: 18px 0 2px; }
  .at-scheme .at-sc-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 7px; }
  .at-scheme button {
    font: 500 13px/1.25 var(--sans, system-ui); text-align: left;
    padding: 9px 13px; border-radius: 3px; cursor: pointer;
    background: var(--card); color: var(--ink-2);
    border: 1px solid var(--rule);
  }
  .at-scheme button b { display: block; font-weight: 600; color: var(--ink); }
  .at-scheme button i {
    display: block; font-style: normal; font-size: 11px;
    color: var(--ink-3); margin-top: 2px;
  }
  .at-scheme button.on { border-color: var(--accent, #7A5CA8); background: var(--panel); }
  .at-scheme button.on b { color: var(--accent, #7A5CA8); }

  /* Three layers, each on or off, so the control has to look like a switch and
     not like a choice. A radio row and a checkbox row are different promises. */
  .at-scheme button { display: flex; gap: 9px; align-items: flex-start; }
  .at-sc-box {
    flex: 0 0 auto; width: 14px; height: 14px; margin-top: 2px; border-radius: 3px;
    border: 1.5px solid var(--rule); background: var(--ground);
    position: relative;
  }
  .at-scheme button.on .at-sc-box {
    background: var(--accent, #7A5CA8); border-color: var(--accent, #7A5CA8);
  }
  .at-scheme button.on .at-sc-box::after {
    content: ""; position: absolute; left: 4px; top: 0.5px;
    width: 4px; height: 8px; border: solid var(--ground);
    border-width: 0 2px 2px 0; transform: rotate(42deg);
  }
  .at-sc-t { min-width: 0; }

  /* Which family a colour belongs to, said once, because three legends on one
     map is three legends. */
  .at-sc-key {
    display: flex; flex-wrap: wrap; gap: 4px 20px; margin: 9px 0 0;
    font: 400 11.5px/1.6 var(--mono); color: var(--ink-3);
  }
  .at-sc-key span { display: inline-flex; align-items: center; gap: 6px; }
  .at-sc-key i { width: 10px; height: 10px; border-radius: 50%; flex: 0 0 auto; }
  .at-sc-key b { font-weight: 600; color: var(--ink-2); }

  /* ---- the panel follows the map ----------------------------------------
     The kit sizes both at a flat 560px. This archive's own stylesheet then
     gives the map `#atlas { height: min(70vh, 620px) }` — responsive, and
     right — and the panel never got the message, so on a normal screen the
     map ran sixty pixels past the bottom of the column beside it.
     Nothing here restates a number: the map sets the row, the panel takes it. */
  .at-wrap > .at-panel { height: auto; align-self: stretch; }

  /* ---- full screen ------------------------------------------------------
     1,367 markers in a 475-pixel column is a thumbnail of a map. The switch
     row, the find box, the filters, the map and the panel all move into one
     fixed layer, the native fullscreen API is asked for on top of that where
     the browser allows it, and Escape or the button brings them home. */
  .at-stage {
    position: fixed; inset: 0; z-index: 2000; background: var(--ground);
    padding: 12px 16px 14px; display: flex; flex-direction: column; gap: 8px;
    overflow: hidden;
  }
  .at-stage .at-wrap { flex: 1 1 auto; min-height: 0; margin-top: 0; }
  .at-stage #atlas, .at-stage .at-panel { height: 100% !important; }
  .at-stage .at-scheme { margin-top: 0; }
  .at-stage .at-tools { margin-top: 2px; }

  /* In full screen the controls are a header, not a section. Left as they are
     they took 485 pixels of a 1,029-pixel window and left the map 468 — which
     is smaller than the map the reader pressed the button to escape. The
     switches keep their names and lose their sentences; the find box loses its
     label; the pills tighten. Nothing is removed that is not said elsewhere on
     the page the reader just came from. */
  .at-stage .at-scheme .lab { display: none; }
  .at-stage .at-scheme button i { display: none; }
  .at-stage .at-scheme button { padding: 7px 11px; }
  .at-stage .at-sc-row { gap: 8px; }
  .at-stage .at-sc-key { margin-top: 6px; font-size: 11px; gap: 3px 16px; }
  .at-stage .at-tools { align-items: center; gap: 8px 16px; }
  .at-stage .at-find { flex: 0 1 280px; }
  .at-stage .at-find .lab { display: none; }
  .at-stage #at-q { margin-top: 0; padding: 7px 11px; font-size: 14px; }
  .at-stage .atlas-key { gap: 5px; }
  .at-stage .at-cat { padding: 4px 9px; font-size: 11px; }
  .at-stage #at-count { margin: 0; }
  .at-fs-btn {
    font: 500 12px/1 var(--sans, system-ui); padding: 8px 12px; cursor: pointer;
    background: var(--card); color: var(--ink-2);
    border: 1px solid var(--rule); border-radius: 3px; white-space: nowrap;
  }
  .at-fs-btn:hover { border-color: var(--accent); color: var(--accent); }
  .at-stage .at-fs-btn { border-color: var(--accent); color: var(--accent); margin-left: auto; }
  @media (max-width: 640px) {
    .at-stage { padding: 8px 10px 10px; }
    .at-stage .at-wrap { grid-template-columns: 1fr; grid-template-rows: 1fr auto; }
    .at-stage .at-panel { height: 34vh !important; }
    .at-stage #atlas { height: 100% !important; }
  }
  .at-cat[data-cat="_none"] { display: none !important; }
  .at-cat[data-scheme-off] { display: none !important; }
  /* On a phone the three questions sit one above the other, and buttons that
     size to their own text make a ragged left edge out of what is meant to
     read as one control. */
  @media (max-width: 640px) {
    .at-scheme .at-sc-row { display: grid; grid-template-columns: 1fr; gap: 6px; }
    .at-scheme button { width: 100%; }
  }
</style>

<script is:inline define:vars={{ hitsUrl: Astro.props.dataUrl || "",
                                 startOff: Astro.props.startOff || [],
                                 SCHEMES: Astro.props.schemes || null,
                                 CATOF: Astro.props.catOf || null }}>
  (function () {
    var q = document.getElementById("at-q");
    var box = q && q.closest(".at-find");
    var count = document.getElementById("at-count");

    /* A category the page wants switched off when the map opens. The kit
       renders every button on and keeps its own `off` map in a closure, so
       the only honest way in from outside is the button itself: click it
       once, after the kit has bound its listener and run its first apply().
       #at-count gets its text at the end of that apply(), which is the
       cheapest signal that the map is live. */
    if (startOff.length) {
      var tries = 0;
      var arm = setInterval(function () {
        if (++tries > 80) return clearInterval(arm);
        if (!count || !count.textContent) return;
        clearInterval(arm);
        startOff.forEach(function (k) {
          var b = document.querySelector('.at-cat[data-cat="' + k + '"]');
          if (b && b.classList.contains("on")) b.click();
        });
      }, 120);
    }

    if (!q || !box || !hitsUrl) return;

    /* Controls above the thing they control. */
    (function () {
      var wrap = document.querySelector(".at-wrap");
      var tools = document.querySelector(".at-tools");
      if (!wrap || !tools || !wrap.parentNode) return;
      wrap.parentNode.insertBefore(tools, wrap);
      tools.classList.add("at-top");
      if (count && count.parentNode) {
        wrap.parentNode.insertBefore(count, wrap);
        count.classList.add("at-count-top");
      }
    })();

    var COLOURS = {};
    document.querySelectorAll(".at-cat[data-cat] i").forEach(function (i) {
      COLOURS[i.parentNode.getAttribute("data-cat")] = i.style.background;
    });

    /* ---- the basemap, and the map object the kit keeps to itself ----------
       Leaflet's own init hook hands every map to whoever registered before it
       was built. The kit builds its map on window «load»; deferred scripts —
       Leaflet included — have run by DOMContentLoaded, which is strictly
       earlier. So this is the one hook into the shared component that does not
       touch the shared component. */
    var BASES = [
      ["Street", "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
       "&copy; OpenStreetMap contributors", 18],
      ["Terrain", "https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png",
       "&copy; OpenStreetMap contributors · SRTM | &copy; OpenTopoMap (CC-BY-SA)", 16],
      ["Satellite",
       "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
       "Imagery &copy; Esri, Maxar, Earthstar Geographics", 18],
      ["Plain", "https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png",
       "&copy; OpenStreetMap contributors &copy; CARTO", 19]
    ];
    var KEY = "at-base";

    function baseControl(map) {
      var want = 0;
      try { want = Math.max(0, BASES.findIndex(function (b) {
        return b[0] === localStorage.getItem(KEY); })); } catch (e) { want = 0; }

      var layers = BASES.map(function (b) {
        return L.tileLayer(b[1], { attribution: b[2], maxZoom: b[3] });
      });
      /* The kit put its own street layer on at construction. Take it off
         rather than stack a second one under it. */
      var old = [];
      map.eachLayer(function (l) { if (l instanceof L.TileLayer) old.push(l); });
      old.forEach(function (l) { try { map.removeLayer(l); } catch (e) {} });
      layers[want].addTo(map);
      var cur = want;

      var ctl = L.control({ position: "topright" });
      ctl.onAdd = function () {
        var box = L.DomUtil.create("div", "at-base");
        var inner = L.DomUtil.create("div", "at-base-in", box);
        BASES.forEach(function (b, i) {
          var btn = L.DomUtil.create("button", i === cur ? "on" : "", inner);
          btn.type = "button";
          btn.textContent = b[0];
          /* Terrain and satellite are somebody else's tiles on somebody else's
             bandwidth; the title says so where a reader can see it. */
          btn.title = b[0] === "Terrain" ? "OpenTopoMap — contours and relief"
                    : b[0] === "Satellite" ? "Esri world imagery"
                    : b[0] === "Plain" ? "CARTO Positron — quiet, so the markers carry the page"
                    : "OpenStreetMap";
          L.DomEvent.on(btn, "click", function (e) {
            L.DomEvent.stop(e);
            if (i === cur) return;
            map.removeLayer(layers[cur]);
            layers[i].addTo(map);
            layers[i].bringToBack();
            cur = i;
            inner.querySelectorAll("button").forEach(function (x, j) {
              x.classList.toggle("on", j === i);
            });
            try { localStorage.setItem(KEY, BASES[i][0]); } catch (e2) {}
          });
        });
        L.DomEvent.disableClickPropagation(box);
        L.DomEvent.disableScrollPropagation(box);
        return box;
      };
      ctl.addTo(map);
    }

    /* ---- the pulse --------------------------------------------------------
       The kit draws its markers with no class on them, so they are found the
       only way they can be from outside: by the fill colour the page itself
       declared for that category. Markers come and go as the filters change,
       so the tagging is redone whenever the map's SVG does. */
    function pulse(map) {
      var col = COLOURS.people;
      if (!col) return;
      var hex = (function (c) {
        var m = String(c).match(/rgb\((\d+),\s*(\d+),\s*(\d+)\)/);
        if (!m) return String(c).toLowerCase();
        return "#" + [1, 2, 3].map(function (i) {
          return ("0" + Number(m[i]).toString(16)).slice(-2); }).join("");
      })(col);
      var host = document.getElementById("atlas");
      var btn = document.querySelector('.at-cat[data-cat="people"]');
      function paint() {
        host.querySelectorAll("path").forEach(function (pa) {
          var f = (pa.getAttribute("fill") || "").toLowerCase();
          pa.classList.toggle("at-pulse", f === hex);
        });
        /* The pill breathes only while the layer is off — an invitation, and
           it stops the moment it has been taken. */
        if (btn) btn.classList.toggle("at-pulse-pill", !btn.classList.contains("on"));
      }
      paint();
      new MutationObserver(function () { clearTimeout(host._pt);
        host._pt = setTimeout(paint, 60); })
        .observe(host, { childList: true, subtree: true });
      if (btn) btn.addEventListener("click", function () { setTimeout(paint, 30); });
    }

    /* ---- one map, three questions ----------------------------------------
       Every marker carries up to three categories — the shelf, our people,
       the ground — and this switches which one is being coloured and filtered.
       The PANEL never switches: a place that is a parish, a home and a grave
       says all three at once, which is the whole reason the three maps were
       merged into this one.

       The kit keeps its filter state in a closure, so the only way in is the
       one the kit itself provides: each marker's own `cat`, which its apply()
       reads on every pass. Markers outside the active question are given the
       category «_none», whose pill is hidden and switched off once at the
       start, so the kit filters them out by its own rules. */
    function schemes(map, all) {
      var row = document.querySelector(".at-scheme .at-sc-row");
      var tools = document.querySelector(".at-tools");
      if (!row || !tools) return;
      var marks = all.filter(function (m) { return m._p && m._p.cats; });
      if (!marks.length) return;

      document.querySelectorAll(".at-cat[data-cat]").forEach(function (b) {
        var k = b.getAttribute("data-cat");
        if (CATOF && CATOF[k]) b.setAttribute("data-of", CATOF[k]);
      });

      /* «_none» has to be switched off through the kit's own button, once,
         before anything is hidden by it. */
      var nil = document.querySelector('.at-cat[data-cat="_none"]');
      if (nil && nil.classList.contains("on")) nil.click();

      function radius(p, n) {
        return n > 40 ? 11 : n > 12 ? 8.5 : n > 3 ? 6.5 : p.order ? 7.5 : 5;
      }

      /* ---- three layers, not three views ----------------------------------
         This was a switch: one question at a time, and asking a second put the
         first away. David: «can our map rather layer the shelf, our people and
         the ground? so i can toggle on and off rather than only show one at a
         time».

         So they layer. The kit gives a marker ONE category, and a place that
         answers two questions still has to be one dot — drawing it twice is
         what merging the three maps was for. It takes the colour of the
         RAREST question it answers among the layers that are on: the ground
         before our people, our people before the shelf. There are 1,235 shelf
         places, 167 with people and 61 with graves, so the rare thing is the
         thing worth seeing, and the common thing is the ground it sits on.
         The panel does not change either way — it says all three whatever the
         dot is coloured for. */
      var ORDER = ["graves", "people", "shelf"];
      var RING = { shelf: "#ffffff", people: "#2E1147", graves: "#062B42" };
      var on = {};

      function paint() {
        var live = ORDER.filter(function (k) { return on[k]; });
        marks.forEach(function (m) {
          var p = m._p, k = null;
          for (var i = 0; i < live.length; i++) {
            if (p.cats[live[i]]) { k = live[i]; break; }
          }
          p.cat = k ? p.cats[k] : "_none";
          p.n = (k && p.ns && p.ns[k]) || 0;
          /* Hue says which category. The RING says which layer — a second
             channel, because three legends on one map is three legends, and a
             reader looking at one dot should not have to work out which of
             them it is being coloured from. The shelf keeps the kit's thin
             white outline; our people take a deep violet ring and the ground
             a navy one, each matching its own family. */
          if (k) m.setStyle({
            fillColor: COLOURS[p.cats[k]] || "#666",
            color: RING[k] || "#ffffff",
            weight: k === "shelf" ? (p.order ? 2.2 : 1.2) : 2.2
          });
          m.setRadius(radius(p, p.n));
        });
        document.querySelectorAll(".at-cat[data-of]").forEach(function (b) {
          if (on[b.getAttribute("data-of")]) b.removeAttribute("data-scheme-off");
          else b.setAttribute("data-scheme-off", "1");
        });
        row.querySelectorAll("button").forEach(function (b) {
          var k = b.getAttribute("data-sc");
          b.classList.toggle("on", !!on[k]);
          b.setAttribute("aria-pressed", on[k] ? "true" : "false");
        });
        try { localStorage.setItem("at-layers", JSON.stringify(on)); } catch (e) {}
        /* The kit re-filters on every keystroke in its own search box, so
           saying nothing in it is how this asks for a fresh pass. */
        if (q) q.dispatchEvent(new Event("input", { bubbles: true }));
      }

      function toggle(k) {
        /* One layer must stay on, or the map is a blank rectangle and the
           reader has to guess why. */
        if (on[k] && ORDER.filter(function (x) { return on[x]; }).length === 1) return;
        on[k] = !on[k];
        paint();
      }

      SCHEMES.forEach(function (sc) {
        var b = document.createElement("button");
        b.type = "button";
        b.setAttribute("data-sc", sc[0]);
        b.setAttribute("aria-pressed", "false");
        b.innerHTML = "<span class=\"at-sc-box\"></span><span class=\"at-sc-t\"><b></b><i></i></span>";
        b.querySelector("b").textContent = sc[1];
        b.querySelector("i").textContent = sc[2] || "";
        b.addEventListener("click", function () { toggle(sc[0]); });
        row.appendChild(b);
      });

      var saved = null;
      try { saved = JSON.parse(localStorage.getItem("at-layers") || "null"); } catch (e) {}
      if (saved && ORDER.some(function (k) { return saved[k]; })) {
        ORDER.forEach(function (k) { on[k] = !!saved[k]; });
      } else {
        /* All three on the first time, because the whole point of layering is
           that the reader can see at once which places answer more than one. */
        ORDER.forEach(function (k) { on[k] = true; });
      }
      paint();
    }

    /* ---- full screen ------------------------------------------------------
       A map of 1,367 places in a 475-pixel column is a thumbnail. This lifts
       the whole instrument — the three layer switches, the find box, the
       filters, the map and the panel — into one fixed layer over the page,
       and asks the browser for real fullscreen on top of that where it is
       allowed. Nothing is re-rendered and nothing is cloned: the same nodes
       move, and move back, so every listener the kit attached still holds.
       Escape leaves, because a reader who cannot find the way out of a
       fullscreen map will use the back button and lose the page. */
    function fullscreen(map) {
      var wrap = document.querySelector(".at-wrap");
      var tools = document.querySelector(".at-tools");
      var scheme = document.querySelector(".at-scheme");
      var count = document.getElementById("at-count");
      if (!wrap || !tools || !wrap.parentNode) return;

      var btn = document.createElement("button");
      btn.type = "button";
      btn.className = "at-fs-btn";
      btn.setAttribute("aria-pressed", "false");
      btn.textContent = "Full screen";
      tools.appendChild(btn);

      var stage = null, mark = null, open = false;

      function enter() {
        if (open) return;
        mark = document.createComment("at-stage");
        wrap.parentNode.insertBefore(mark, scheme || tools);
        stage = document.createElement("div");
        stage.className = "at-stage";
        document.body.appendChild(stage);
        [scheme, tools, count, wrap].forEach(function (n) { if (n) stage.appendChild(n); });
        btn.textContent = "Leave full screen";
        btn.setAttribute("aria-pressed", "true");
        open = true;
        if (stage.requestFullscreen) { try { stage.requestFullscreen(); } catch (e) {} }
        setTimeout(function () { map.invalidateSize(); }, 60);
      }

      function leave() {
        if (!open) return;
        if (document.fullscreenElement && document.exitFullscreen) {
          try { document.exitFullscreen(); } catch (e) {}
        }
        [scheme, tools, count, wrap].forEach(function (n) {
          if (n && mark && mark.parentNode) mark.parentNode.insertBefore(n, mark);
        });
        if (mark && mark.parentNode) mark.parentNode.removeChild(mark);
        if (stage && stage.parentNode) stage.parentNode.removeChild(stage);
        stage = null; mark = null; open = false;
        btn.textContent = "Full screen";
        btn.setAttribute("aria-pressed", "false");
        setTimeout(function () { map.invalidateSize(); }, 60);
      }

      btn.addEventListener("click", function () { open ? leave() : enter(); });
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && open) leave();
      });
      /* Leaving through the browser's own fullscreen exit must bring the page
         back too, or the reader is left with a fixed layer and no way out. */
      document.addEventListener("fullscreenchange", function () {
        if (!document.fullscreenElement && open) leave();
      });
    }

    document.addEventListener("DOMContentLoaded", function () {
      if (typeof L === "undefined" || !L.Map || !L.Map.addInitHook) return;
      /* Every circle marker the kit makes, kept as it is made — the kit's own
         array is in a closure and a marker the filter has hidden is not on the
         map to be found. */
      var all = [];
      if (SCHEMES && L.CircleMarker && L.CircleMarker.addInitHook) {
        L.CircleMarker.addInitHook(function () { all.push(this); });
      }
      L.Map.addInitHook(function () {
        var self = this;
        if (self.getContainer && self.getContainer().id !== "atlas") return;
        /* One tick after the map says it is ready. «Ready» fires inside the
           first setView, at which point the kit's tile layer is registered
           but has no DOM container yet — removing it there throws inside
           Leaflet's own reset. A tick later it is a layer like any other. */
        self.whenReady(function () {
          setTimeout(function () {
            baseControl(self); pulse(self);
            if (SCHEMES) schemes(self, all);
            fullscreen(self);
          }, 0);
        });
      });
    });

    var list = document.createElement("ul");
    list.className = "at-hits";
    list.hidden = true;
    box.appendChild(list);

    var places = [], cur = -1;
    fetch(hitsUrl).then(function (r) { return r.json(); }).then(function (d) {
      places = (d.places || []).map(function (p) {
        return { name: p.name, also: p.also || [], cat: p.cat, n: p.n || 0,
                 cats: p.cats || null, ns: p.ns || null,
                 vols: (String(p.what).match(/(\d+)\s+volumes?\s+catalogued/) || [])[1] || null };
      });
    });

    /* Which of the three questions the map is showing, read off the switch
       rather than held in a second variable that could drift from it. */
    function active() {
      var on = document.querySelector(".at-scheme button.on");
      return on ? on.getAttribute("data-sc") : "shelf";
    }

    function matches(t) {
      t = t.toLowerCase().trim();
      if (!t) return [];
      var out = [];
      for (var i = 0; i < places.length && out.length < 40; i++) {
        var p = places[i];
        var hay = (p.name + " " + p.also.join(" ")).toLowerCase();
        if (hay.indexOf(t) > -1) out.push(p);
      }
      /* A place whose own name starts with what was typed is what the typist
         meant; «Senj» should not rank below «Senjska Draga». */
      out.sort(function (a, b) {
        var an = a.name.toLowerCase(), bn = b.name.toLowerCase();
        return (bn.indexOf(t) === 0) - (an.indexOf(t) === 0) || an.length - bn.length;
      });
      return out.slice(0, 8);
    }

    function draw() {
      var hits = matches(q.value);
      cur = -1;
      if (!q.value.trim()) { list.hidden = true; list.innerHTML = ""; return; }
      if (!hits.length) {
        list.innerHTML = '<li class="none">Nothing on this map is called that.</li>';
        list.hidden = false;
        return;
      }
      list.innerHTML = "";
      hits.forEach(function (p) {
        var li = document.createElement("li");
        if (p.cats && !p.cats[active()]) li.classList.add("dim");
        var dot = document.createElement("i");
        dot.style.background = COLOURS[p.cat] || "#999";
        var n = document.createElement("span"); n.className = "n"; n.textContent = p.name;
        li.appendChild(dot); li.appendChild(n);
        if (p.also.length) {
          var a = document.createElement("span"); a.className = "a";
          a.textContent = p.also.slice(0, 2).join(" · ");
          li.appendChild(a);
        }
        var v = document.createElement("span"); v.className = "v";
        /* What a place is worth depends on what the map is being asked. Under
           «our people» a volume count is a true sentence about the wrong
           thing, and «no catalogue» is worse. */
        var sc = active();
        var cnt = p.ns && p.ns[sc];
        v.textContent =
            sc === "people" ? (cnt ? cnt + (cnt === 1 ? " person" : " people") : "—")
          : sc === "graves" ? (cnt ? cnt + (cnt === 1 ? " burial" : " burials") : "—")
          : p.vols ? p.vols + (p.vols === "1" ? " volume" : " volumes")
          : "no catalogue";
        li.appendChild(v);
        li.addEventListener("mousedown", function (e) { e.preventDefault(); pick(p); });
        list.appendChild(li);
      });
      list.hidden = false;
    }

    /* Choosing a place means making the kit's own filter resolve to exactly
       one marker, because that is the moment the kit pans the map and opens
       the panel. The place's own name is tried first; if it is a prefix of a
       neighbour's — Senj inside Senjska Draga — an older name usually is not. */
    function pick(p) {
      var tries = [p.name].concat(p.also);
      for (var i = 0; i < tries.length; i++) {
        q.value = tries[i];
        q.dispatchEvent(new Event("input", { bubbles: true }));
        if (count && /^1 of\b/.test(count.textContent || "")) break;
      }
      q.value = p.name;
      list.hidden = true;
      q.blur();
    }

    q.addEventListener("input", draw);
    q.addEventListener("focus", draw);
    q.addEventListener("blur", function () { setTimeout(function () { list.hidden = true; }, 120); });
    q.addEventListener("keydown", function (e) {
      var items = list.querySelectorAll("li:not(.none)");
      if (!items.length || list.hidden) return;
      if (e.key === "ArrowDown" || e.key === "ArrowUp") {
        e.preventDefault();
        cur = (cur + (e.key === "ArrowDown" ? 1 : items.length - 1)) % items.length;
        items.forEach(function (x, i) { x.classList.toggle("on", i === cur); });
      } else if (e.key === "Enter") {
        e.preventDefault();
        items[cur > -1 ? cur : 0].dispatchEvent(new MouseEvent("mousedown"));
      } else if (e.key === "Escape") {
        list.hidden = true;
      }
    });
  })();
</script>
