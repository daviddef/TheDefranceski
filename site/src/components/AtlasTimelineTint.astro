---
/* Colour the gap rows in the Atlas panel's coverage timeline.

   The panel is the shared kit component and this session does not own it, so
   nothing here reaches into the kit: the rows are tagged from outside, after
   the panel renders, by reading the text the builder already puts in them.
   «GAP — no births register filmed, 15 years» is the row that matters and it
   was reading as one grey line among twenty.

   The panel is rebuilt with innerHTML on every marker click, so a one-shot
   pass would only ever paint the first place a reader opened. A
   MutationObserver re-tags on each rebuild. */
---
<style is:global>
  /* A hole in the record, which is the thing somebody came to this map to find. */
  .at-ev li.at-gap {
    background: rgba(176, 74, 22, 0.13);
    border-left: 2.5px solid #B04A16;
    padding: 4px 8px 4px 9px;
    margin-left: -9px;
    border-radius: 0 2px 2px 0;
  }
  .at-ev li.at-gap .at-ed { color: #8E3A11; font-weight: 600; }
  :root:not([data-theme="light"]) .at-ev li.at-gap { background: rgba(214, 106, 48, 0.17); }
  :root:not([data-theme="light"]) .at-ev li.at-gap .at-ed { color: #E2894F; }
  :root[data-theme="dark"] .at-ev li.at-gap { background: rgba(214, 106, 48, 0.17); }
  :root[data-theme="dark"] .at-ev li.at-gap .at-ed { color: #E2894F; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .at-ev li.at-gap { background: rgba(214, 106, 48, 0.17); }
    :root:not([data-theme="light"]) .at-ev li.at-gap .at-ed { color: #E2894F; }
  }

  /* A year uncovered by any title but almost certainly not a missing book.
     Marked, because it is still a hole on paper — but not cried over. */
  .at-ev li.at-soft {
    background: rgba(140, 140, 140, 0.10);
    border-left: 2.5px dotted var(--rule, #dcd6cc);
    padding: 4px 8px 4px 9px;
    margin-left: -9px;
    border-radius: 0 2px 2px 0;
  }

  /* Every volume of a kind, one by one, folded away until asked for.
     The timeline above answers «is there a hole»; this answers «what is
     actually on the shelf», and for a parish with a hundred volumes it must
     not be the first thing a reader meets. */
  .at-ev li.at-vols { margin: 4px 0 2px; }
  .at-ev li.at-vols > details > summary {
    cursor: pointer; font-family: var(--mono); font-size: 11px;
    color: var(--ink-3); list-style: none; padding: 2px 0;
  }
  .at-ev li.at-vols > details > summary::-webkit-details-marker { display: none; }
  .at-ev li.at-vols > details > summary::before { content: "▸ "; }
  .at-ev li.at-vols > details[open] > summary::before { content: "▾ "; }
  .at-ev li.at-vols > details > summary:hover { color: var(--ink-2); }
  .at-ev li.at-vols ul {
    list-style: none; margin: 6px 0 2px; padding: 0 0 0 12px;
    border-left: 1px solid var(--rule, #dcd6cc); display: grid; gap: 3px;
  }
  .at-ev li.at-vols ul li { font-size: 12px; line-height: 1.45; color: var(--ink-2); }
  .at-ev li.at-vols ul li .at-ed {
    display: inline; margin-right: 8px; font-size: 10.5px;
  }
  /* A volume somebody has actually opened and read, page by page. This is the
     rarest state in the archive — 16 of 7,159 — and the one the whole map
     exists to grow, so it gets the strongest mark on the panel. */
  .at-ev li.at-open a { font-size: 12.5px; }
  .at-ev li.at-vols ul li.at-read,
  .at-ev li.at-read,
  .at-films li.at-read {
    background: rgba(18, 112, 63, 0.14);
    border-left: 2.5px solid #12703F;
    padding: 3px 8px 3px 8px;
    margin-left: -10px;
    border-radius: 0 2px 2px 0;
    color: #0E5730;
  }
  .at-films li.at-read a { color: #0E5730; }
  .at-ev li.at-vols ul li.at-paper { color: #8E3A11; }

  /* The record-type heading, coloured by how far that type has got:
     green when every volume of it has been read, amber when some have. */
  .at-ev li.at-kind.at-all {
    background: rgba(18, 112, 63, 0.13);
    border-left: 2.5px solid #12703F;
    padding: 4px 8px; margin-left: -10px; border-radius: 0 2px 2px 0;
  }
  .at-ev li.at-kind.at-part {
    background: rgba(233, 160, 32, 0.16);
    border-left: 2.5px solid #C9820F;
    padding: 4px 8px; margin-left: -10px; border-radius: 0 2px 2px 0;
  }
  .at-ev li.at-kind.at-all .at-ed { color: #0E5730; }
  .at-ev li.at-kind.at-part .at-ed { color: #8A5A08; }

  :root:not([data-theme="light"]) .at-ev li.at-vols ul li.at-read,
  :root:not([data-theme="light"]) .at-films li.at-read,
  :root[data-theme="dark"] .at-ev li.at-vols ul li.at-read,
  :root[data-theme="dark"] .at-films li.at-read {
    background: rgba(46, 168, 104, 0.18); color: #6FD3A0;
  }
  :root:not([data-theme="light"]) .at-films li.at-read a,
  :root[data-theme="dark"] .at-films li.at-read a { color: #6FD3A0; }

  /* Births / Marriages / Deaths — the block each timeline hangs under. */
  .at-ev li.at-kind { margin-top: 12px; }
  .at-ev li.at-kind .at-ed {
    font-family: inherit; font-size: 11px; letter-spacing: .09em;
    text-transform: uppercase; font-weight: 700; color: var(--ink-2);
  }
  .at-ev li.at-kind:first-child { margin-top: 2px; }
</style>

<script is:inline>
  (function () {
    var body = document.getElementById("at-body");
    if (!body) return;
    /* The builder indents every row that belongs under a record-type heading
       with two spaces, so the heading rows are the ones whose date cell does
       not start with whitespace. */
    function tag() {
      var rows = body.querySelectorAll(".at-ev li");
      for (var i = 0; i < rows.length; i++) {
        var li = rows[i];
        var ed = li.querySelector(".at-ed");
        var when = ed ? (ed.textContent || "") : "";
        var text = (li.textContent || "").slice(when.length);
        li.classList.toggle("at-gap", /^\s*GAP\b/.test(text));
        li.classList.toggle("at-soft", /^\s*not covered by any title/.test(text));
        var kind = !/^\s/.test(when) && /volumes?,\s*covering/.test(text);
        li.classList.toggle("at-kind", kind);
        li.classList.toggle("at-all", kind && /ALL READ/.test(text));
        li.classList.toggle("at-part", kind && /\d+ of \d+ read/.test(text));
      }
      films();
      fold();
    }

    /* ONE list, not two.
       The kit renders the volumes twice over: once as the coverage timeline
       this archive feeds it, and once as its own «open at page one» list of
       links. On a parish with a single book that meant seeing the same volume
       four times — heading, span, row, link — which is three times too many.
       So the links are MOVED into the timeline rows they belong to, matched on
       the label the builder deliberately makes identical on both sides, and
       the leftover list is removed. Nothing in the shared component changes. */
    function films() {
      var links = body.querySelectorAll(".at-films li");
      var rows = body.querySelectorAll(".at-ev li");
      var pool = [];
      for (var i = 0; i < links.length; i++) {
        var a = links[i].querySelector("a");
        if (a) pool.push({ li: links[i], a: a, key: key(a.textContent) });
      }
      for (var r = 0; r < rows.length; r++) {
        var li = rows[r];
        if (li.querySelector("a")) continue;
        var ed = li.querySelector(".at-ed");
        if (!ed || !/^ {4}/.test(ed.textContent || "")) continue;
        var text = (li.textContent || "").slice((ed.textContent || "").length);
        var k = key(text);
        for (var j = 0; j < pool.length; j++) {
          if (pool[j].used || pool[j].key !== k) continue;
          pool[j].used = true;
          var a = pool[j].a;
          a.setAttribute("target", "_blank");
          a.setAttribute("rel", "noopener");
          a.textContent = text.trim() + " \u2197";
          while (ed.nextSibling) li.removeChild(ed.nextSibling);
          li.appendChild(a);
          li.classList.add("at-open");
          /* The link has moved; its old row must go with it or the section it
             came from stays alive on a list of empty bullets. */
          if (pool[j].li.parentNode) pool[j].li.parentNode.removeChild(pool[j].li);
          break;
        }
      }
      /* Whatever could not be matched keeps its own section rather than being
         thrown away; if everything matched, the section goes. */
      var secs = body.querySelectorAll(".at-films");
      for (var q = 0; q < secs.length; q++) {
        if (!secs[q].querySelector("li")) {
          var sec = secs[q].closest(".at-sec");
          if (sec) sec.hidden = true;
        }
      }
      for (var m = 0; m < rows.length; m++) {
        rows[m].classList.toggle("at-read", /\u2014\s*READ/.test(rows[m].textContent || ""));
      }
    }

    /* Years and letters only, order-insensitive — so «Deaths (Umrli) 1875-1895»
       from the kit's link and «1875–1895 · Deaths (Umrli)» from the timeline
       are recognised as one book. */
    function key(s) {
      s = String(s || "").replace(/\u2014\s*(READ|not digitised anywhere)/g, "");
      var years = (s.match(/1[5-9]\d\d/g) || []).sort().join("");
      var word = s.toLowerCase().replace(/[^a-z\u00c0-\u024f]+/g, "");
      return years + "|" + word;
    }

    /* The builder marks a per-volume row by indenting its date by four
       spaces. Consecutive runs of those are lifted out of the flat list and
       put inside a collapsed <details>, so the shelf is one line until
       somebody wants it. Done here rather than in the shared Atlas, which
       this session does not own. */
    function fold() {
      var uls = body.querySelectorAll(".at-ev");
      for (var u = 0; u < uls.length; u++) {
        var kids = Array.prototype.slice.call(uls[u].children), run = [];
        for (var i = 0; i <= kids.length; i++) {
          var li = kids[i];
          var ed = li && li.querySelector ? li.querySelector(".at-ed") : null;
          var deep = !!ed && /^ {4}/.test(ed.textContent || "");
          if (deep && !li.classList.contains("at-vols")) { run.push(li); continue; }
          if (run.length) { if (run.length > 4) wrap(run); run = []; }
        }
      }
    }

    function wrap(run) {
      var first = run[0];
      var host = document.createElement("li");
      host.className = "at-vols";
      var det = document.createElement("details");
      var sum = document.createElement("summary");
      sum.textContent = run.length + (run.length === 1 ? " volume" : " volumes")
                      + ", one by one";
      var ul = document.createElement("ul");
      first.parentNode.insertBefore(host, first);
      run.forEach(function (li) {
        var t = li.textContent || "";
        if (/\u2014 READ\b/.test(t)) li.classList.add("at-read");
        else if (/not digitised/.test(t)) li.classList.add("at-paper");
        ul.appendChild(li);
      });
      det.appendChild(sum);
      det.appendChild(ul);
      host.appendChild(det);
    }

    /* The panel is rebuilt with innerHTML on every marker click, so a one-shot
       pass would only ever paint the first place a reader opened. */
    /* fold() moves nodes, which the observer sees. It is idempotent — once a
       run is inside a <details> those rows are no longer direct children of
       .at-ev, so the second pass finds nothing to move — but the guard makes
       that a property of the code rather than of the DOM. */
    var busy = false;
    new MutationObserver(function () {
      if (busy) return;
      busy = true;
      try { tag(); } finally { busy = false; }
    }).observe(body, { childList: true, subtree: true });
    tag();
  })();
</script>

<style is:global>
  /* The find box filters the map but only opens a place when the query happens
     to match exactly one. Typing «Senj» leaves Senj, Senja and Senjska Draga on
     the map and the panel still saying «pick a place», which is not what a
     search box promises. These are the matches, listed, so one can be chosen. */
  /* The find box and the filters ship below the map. They are controls for
     the map, so they belong above it — moved by node rather than by CSS
     order, because their parent is the page's own content column and turning
     that into a flex container to reorder two children would be a large
     change for a small reason. */
  .at-tools.at-top { margin: 4px 0 14px; }
  .at-count-top { margin: -6px 0 14px; }

  .at-find { position: relative; }
  .at-hits {
    position: absolute; z-index: 1200; left: 0; right: 0; top: 100%;
    margin: 4px 0 0; padding: 4px; list-style: none;
    background: var(--panel, #fff); border: 1px solid var(--rule, #dcd6cc);
    border-radius: 3px; box-shadow: 0 6px 18px rgba(0,0,0,.10);
    max-height: 280px; overflow-y: auto;
  }
  .at-hits[hidden] { display: none !important; }
  .at-hits li {
    display: flex; align-items: baseline; gap: 8px;
    padding: 6px 8px; cursor: pointer; border-radius: 2px; font-size: 13.5px;
  }
  .at-hits li:hover, .at-hits li.on { background: var(--card, #f3efe7); }
  .at-hits i { width: 8px; height: 8px; border-radius: 50%; flex: 0 0 auto; }
  .at-hits .n { font-weight: 600; }
  .at-hits .a { font-size: 11.5px; opacity: .62; font-style: italic; }
  .at-hits .v { margin-left: auto; font-size: 11px; opacity: .6; white-space: nowrap; }
  .at-hits .none { cursor: default; opacity: .6; font-style: italic; }
</style>

<script is:inline define:vars={{ hitsUrl: Astro.props.dataUrl || "",
                                 startOff: Astro.props.startOff || [] }}>
  (function () {
    var q = document.getElementById("at-q");
    var box = q && q.closest(".at-find");
    var count = document.getElementById("at-count");

    /* A category the page wants switched off when the map opens. The kit
       renders every button on and keeps its own `off` map in a closure, so
       the only honest way in from outside is the button itself: click it
       once, after the kit has bound its listener and run its first apply().
       #at-count gets its text at the end of that apply(), which is the
       cheapest signal that the map is live. */
    if (startOff.length) {
      var tries = 0;
      var arm = setInterval(function () {
        if (++tries > 80) return clearInterval(arm);
        if (!count || !count.textContent) return;
        clearInterval(arm);
        startOff.forEach(function (k) {
          var b = document.querySelector('.at-cat[data-cat="' + k + '"]');
          if (b && b.classList.contains("on")) b.click();
        });
      }, 120);
    }

    if (!q || !box || !hitsUrl) return;

    /* Controls above the thing they control. */
    (function () {
      var wrap = document.querySelector(".at-wrap");
      var tools = document.querySelector(".at-tools");
      if (!wrap || !tools || !wrap.parentNode) return;
      wrap.parentNode.insertBefore(tools, wrap);
      tools.classList.add("at-top");
      if (count && count.parentNode) {
        wrap.parentNode.insertBefore(count, wrap);
        count.classList.add("at-count-top");
      }
    })();

    var COLOURS = {};
    document.querySelectorAll(".at-cat[data-cat] i").forEach(function (i) {
      COLOURS[i.parentNode.getAttribute("data-cat")] = i.style.background;
    });

    var list = document.createElement("ul");
    list.className = "at-hits";
    list.hidden = true;
    box.appendChild(list);

    var places = [], cur = -1;
    fetch(hitsUrl).then(function (r) { return r.json(); }).then(function (d) {
      places = (d.places || []).map(function (p) {
        return { name: p.name, also: p.also || [], cat: p.cat, n: p.n || 0,
                 vols: (String(p.what).match(/(\d+)\s+volumes?\s+catalogued/) || [])[1] || null };
      });
    });

    function matches(t) {
      t = t.toLowerCase().trim();
      if (!t) return [];
      var out = [];
      for (var i = 0; i < places.length && out.length < 40; i++) {
        var p = places[i];
        var hay = (p.name + " " + p.also.join(" ")).toLowerCase();
        if (hay.indexOf(t) > -1) out.push(p);
      }
      /* A place whose own name starts with what was typed is what the typist
         meant; «Senj» should not rank below «Senjska Draga». */
      out.sort(function (a, b) {
        var an = a.name.toLowerCase(), bn = b.name.toLowerCase();
        return (bn.indexOf(t) === 0) - (an.indexOf(t) === 0) || an.length - bn.length;
      });
      return out.slice(0, 8);
    }

    function draw() {
      var hits = matches(q.value);
      cur = -1;
      if (!q.value.trim()) { list.hidden = true; list.innerHTML = ""; return; }
      if (!hits.length) {
        list.innerHTML = '<li class="none">Nothing on this map is called that.</li>';
        list.hidden = false;
        return;
      }
      list.innerHTML = "";
      hits.forEach(function (p) {
        var li = document.createElement("li");
        var dot = document.createElement("i");
        dot.style.background = COLOURS[p.cat] || "#999";
        var n = document.createElement("span"); n.className = "n"; n.textContent = p.name;
        li.appendChild(dot); li.appendChild(n);
        if (p.also.length) {
          var a = document.createElement("span"); a.className = "a";
          a.textContent = p.also.slice(0, 2).join(" · ");
          li.appendChild(a);
        }
        var v = document.createElement("span"); v.className = "v";
        /* A people marker holds no shelf, and «no catalogue» would be a
           true sentence about the wrong thing. */
        v.textContent = p.cat === "people"
          ? (p.n ? p.n + (p.n === 1 ? " person" : " people") : "our people")
          : p.vols ? p.vols + (p.vols === "1" ? " volume" : " volumes") : "no catalogue";
        li.appendChild(v);
        li.addEventListener("mousedown", function (e) { e.preventDefault(); pick(p); });
        list.appendChild(li);
      });
      list.hidden = false;
    }

    /* Choosing a place means making the kit's own filter resolve to exactly
       one marker, because that is the moment the kit pans the map and opens
       the panel. The place's own name is tried first; if it is a prefix of a
       neighbour's — Senj inside Senjska Draga — an older name usually is not. */
    function pick(p) {
      var tries = [p.name].concat(p.also);
      for (var i = 0; i < tries.length; i++) {
        q.value = tries[i];
        q.dispatchEvent(new Event("input", { bubbles: true }));
        if (count && /^1 of\b/.test(count.textContent || "")) break;
      }
      q.value = p.name;
      list.hidden = true;
      q.blur();
    }

    q.addEventListener("input", draw);
    q.addEventListener("focus", draw);
    q.addEventListener("blur", function () { setTimeout(function () { list.hidden = true; }, 120); });
    q.addEventListener("keydown", function (e) {
      var items = list.querySelectorAll("li:not(.none)");
      if (!items.length || list.hidden) return;
      if (e.key === "ArrowDown" || e.key === "ArrowUp") {
        e.preventDefault();
        cur = (cur + (e.key === "ArrowDown" ? 1 : items.length - 1)) % items.length;
        items.forEach(function (x, i) { x.classList.toggle("on", i === cur); });
      } else if (e.key === "Enter") {
        e.preventDefault();
        items[cur > -1 ? cur : 0].dispatchEvent(new MouseEvent("mousedown"));
      } else if (e.key === "Escape") {
        list.hidden = true;
      }
    });
  })();
</script>
