---
/* THE RIBBON (prototype, 11 November 2026): two round icon buttons beside Search, the way Record Atlas has them. The sparkle goes to
   /whats-new/; the chart opens a panel with the four newest entries and the archive in numbers. Everything is computed at build time
   from the archive's own logs (src/lib/pulse.js), so there is nothing to keep up to date. The styles are scoped to this component on
   purpose: the shared stylesheet is not touched. Below 1181px the header hides the nav, and with it this ribbon: a phone reaches
   /whats-new/ from the drawer (the Evidence group). */
import { u } from "../lib/url.js";
import { pulse, KIND, fmtDay, nf, tiles } from "../lib/pulse.js";
const top = pulse.entries.slice(0, 4);
const c = pulse.counts;
const tip = `${nf(c.people)} people, ${nf(c.logged)} searches logged: what's new and the archive in numbers`;
---
<div class="pulse">
  <a class="pbtn" href={u("/whats-new/")} aria-label="What's new" title="What's new: the latest finds, corrections and nils">
    <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3zM18.5 15l.9 2.1 2.1.9-2.1.9-.9 2.1-.9-2.1-2.1-.9 2.1-.9.9-2.1z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
  </a>
  <details class="pdet">
    <summary class="pbtn" aria-label="The archive in numbers" title={tip}>
      <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path d="M5 20V11M12 20V4M19 20v-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    </summary>
    <div class="ppanel">
      <p class="ph"><b>What's new</b> <span>to {fmtDay(pulse.latest)}</span></p>
      <ul class="pl">
        {top.map((e) => (
          <li>
            <span class={`pk k-${e.kind}`} title={KIND[e.kind].note}><i aria-hidden="true">{KIND[e.kind].glyph}</i> {KIND[e.kind].label}</span>
            <a href={u(e.href)}>{e.head}</a>
            <time datetime={e.iso}>{fmtDay(e.iso, e.exact)}</time>
          </li>
        ))}
      </ul>
      <p class="pall"><a href={u("/whats-new/")}>All updates &rarr;</a></p>
      <p class="ph"><b>In numbers</b> <span>this week: {pulse.week.found} found · {pulse.week.nil} nothing · {pulse.week.corrected} corrected</span></p>
      <div class="pt">
        {tiles().map(([n, l, d]) => <div><b>{n}</b><span>{l}</span><em>{d}</em></div>)}
      </div>
    </div>
  </details>
</div>
<style is:global>
  .pulse{display:flex;align-items:center;gap:6px;margin-right:6px}
  header.site nav.topnav .pulse a.pbtn,.pulse .pdet>summary.pbtn{display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;padding:0;border-radius:50%;
    border:1px solid var(--rule);background:var(--panel);color:var(--ink-2);cursor:pointer;list-style:none;text-decoration:none;line-height:1}
  .pulse .pdet>summary::after{display:none}
  .pulse .pdet>summary::-webkit-details-marker{display:none}
  header.site nav.topnav .pulse a.pbtn:hover,.pulse .pdet>summary.pbtn:hover,.pulse .pdet[open]>summary.pbtn{color:var(--accent);background:var(--accent-wash);border-color:var(--accent)}
  .pulse .pdet{position:relative}
  .pulse .ppanel{position:absolute;top:calc(100% + 10px);right:0;z-index:80;width:min(440px,92vw);padding:16px 18px;background:var(--panel);border:1px solid var(--rule);
    border-radius:6px;box-shadow:0 10px 30px rgba(0,0,0,.16);font-family:var(--sans);font-size:13px;color:var(--ink-2);text-align:left}
  .ppanel .ph{margin:0 0 8px;display:flex;justify-content:space-between;gap:12px;align-items:baseline;font-size:11.5px;letter-spacing:.04em;text-transform:uppercase;color:var(--ink-3,#777)}
  .ppanel .ph b{color:var(--ink);font-weight:600}
  .ppanel .ph span{text-transform:none;letter-spacing:0;font-size:12px}
  .ppanel .pl{list-style:none;margin:0 0 6px;padding:0}
  .ppanel .pl li{display:grid;grid-template-columns:auto 1fr;gap:2px 10px;padding:8px 0;border-top:1px solid var(--rule);align-items:baseline}
  .ppanel .pl li a{color:var(--ink);text-decoration:none;font-size:13.5px;line-height:1.35}
  .ppanel .pl li a:hover{color:var(--accent);text-decoration:underline}
  .ppanel .pl time{grid-column:2;font-size:11.5px;color:var(--ink-3,#777)}
  .ppanel .pk{font-size:10.5px;letter-spacing:.05em;text-transform:uppercase;padding:2px 7px;border-radius:99px;background:var(--panel-2);color:var(--ink-2);white-space:nowrap}
  .ppanel .pk.k-found{background:var(--accent-wash);color:var(--accent)}
  .ppanel .pk.k-corrected{background:#f6ead9;color:#8a5a12}
  .ppanel .pall{margin:2px 0 14px;text-align:right}
  .ppanel .pall a{color:var(--accent);text-decoration:none;font-weight:600}
  .ppanel .pt{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
  .ppanel .pt div{border:1px solid var(--rule);border-radius:4px;padding:8px 10px;background:var(--panel-2)}
  .ppanel .pt b{display:block;font-family:var(--serif,Georgia,serif);font-size:21px;color:var(--ink);font-weight:600;line-height:1.1}
  .ppanel .pt span{display:block;font-size:12px;color:var(--ink);margin-top:2px}
  .ppanel .pt em{display:block;font-style:normal;font-size:11px;color:var(--ink-3,#777);line-height:1.3;margin-top:1px}
  @media (prefers-color-scheme:dark){.ppanel .pk.k-corrected{background:#3a2c14;color:#e6bd7c}}
</style>
<script is:inline>
  (function(){
    function shut(except){document.querySelectorAll(".pulse .pdet[open]").forEach(function(d){if(d!==except)d.open=false})}
    document.addEventListener("click",function(e){shut(e.target.closest(".pulse .pdet"))});
    document.addEventListener("keydown",function(e){if(e.key==="Escape")shut(null)});
  })();
</script>
