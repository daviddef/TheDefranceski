---
// Tinctures and ordinaries are rendered faithfully from the blazon.
// Figurative charges beyond the tree are named, not drawn — see the note below.
const AZ="#2C4C86", OR="#C79A2B", ARG="#E8E6DF", VERT="#3E6B3A", PROP="#8A6A45";
const shield="M12,10 H108 V62 C108,96 84,118 60,130 C36,118 12,96 12,62 Z";
const arms=[
 {id:"pine",
  blazon:"Azure, on a mount vert a pine tree proper fructed or, supported by two lions or.",
  attested:"Recorded for the De Franceschi of Corsica, of Florentine origin — the line descending from a Taddeo who moved to Corsica early in the fourteenth century.",
  drawn:"Field, mount and tree drawn. Supporters named only.",
  charges:["two lions or, as supporters"]},
 {id:"perfess",
  blazon:"Per fess azure and or, a lion rampant proper over all.",
  attested:"A second recorded variation for families of the name.",
  drawn:"Division of the field drawn. Charge named only.",
  charges:["a lion rampant proper"]},
 {id:"bend",
  blazon:"Azure, a bend argent charged with three lions gules.",
  attested:"A third recorded variation for families of the name.",
  drawn:"Field and bend drawn. Charges named only.",
  charges:["three lions gules, on the bend"]},
];
---
<div class="grid g3">
{arms.map(a=>(
  <figure class="armfig">
    <svg viewBox="0 0 120 140" width="176" role="img" aria-label={a.blazon}>
      <defs><clipPath id={`c-${a.id}`}><path d={shield}/></clipPath></defs>

      {a.id==="pine" && <g clip-path={`url(#c-${a.id})`}>
        <rect x="0" y="0" width="120" height="140" fill={AZ}/>
        <path d="M0,108 Q60,94 120,108 L120,140 L0,140 Z" fill={VERT}/>
        <rect x="57.5" y="84" width="5" height="24" fill={PROP}/>
        <path d="M60,26 L76,58 L44,58 Z" fill="#2F5B33"/>
        <path d="M60,42 L81,80 L39,80 Z" fill="#37693C"/>
        <path d="M60,60 L86,100 L34,100 Z" fill="#2F5B33"/>
        <circle cx="51" cy="72" r="2.4" fill={OR}/><circle cx="70" cy="78" r="2.4" fill={OR}/>
        <circle cx="60" cy="92" r="2.4" fill={OR}/>
      </g>}

      {a.id==="perfess" && <g clip-path={`url(#c-${a.id})`}>
        <rect x="0" y="0" width="120" height="70" fill={AZ}/>
        <rect x="0" y="70" width="120" height="70" fill={OR}/>
      </g>}

      {a.id==="bend" && <g clip-path={`url(#c-${a.id})`}>
        <rect x="0" y="0" width="120" height="140" fill={AZ}/>
        <path d="M2,28 L90,134 L120,110 L32,4 Z" fill={ARG}/>
      </g>}

      <path d={shield} fill="none" style="stroke:var(--ink)" stroke-width="2.5"/>
    </svg>
    <figcaption>
      <p class="bl">{a.blazon}</p>
      <ul class="chg">{a.charges.map(c=><li>{c}</li>)}</ul>
      <p class="at">{a.attested}</p>
      <p class="dr">{a.drawn}</p>
      <p class="vd"><span class="chip lore">Not demonstrated for our line</span></p>
    </figcaption>
  </figure>
))}
</div>
