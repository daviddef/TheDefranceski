---
import { u } from "../lib/url.js";
/* Four surnames' worth of movement, drawn as four rivers.
   Each lane is one of the families this archive follows; the dots are
   places it can put a document in, and the fan at the right is where
   that family ended up. */
const LANES = [
  {
    key: "carnia", colour: "var(--accent)", label: "Out of Carnia, for work", href: "/story/", read: "Nine chapters →",
    conf: "documented",
    nodes: [
      ["Mione", "1679", "A De Franceschi of Mione on the headmen's list, working in the County of Pazin"],
      ["Moncalvo", "1661", "The surname enters the Moncalvo di Pisino baptism book"],
      ["Gologorica", "1711", "ANNO · DOMNI · 1711 cut over the door of the house"],
      ["Gračišće", "1787", "Joannes Baptista, farmer of house 5 — the line's earliest dated ancestor"],
      ["Crikvenica", "1892", "The stonecutter's son comes down to the coast between 1892 and 1894"],
    ],
    ends: [
      ["Senj", "/senj-line/", "Antonio's brother's line, up the coast. Nine graves in the town cemetery and a shipping family — the same Carnian stock as Crikvenica, one headland further north."],
      ["Germany", "/pfullingen/", "Ivan, born Crikvenica 1925, taken to work in the Reich and issued papers at Pfullingen in Württemberg. The line's hinge: everything after 1945 leaves from here."],
      ["Australia", "/diaspora/", "The post-war emigration out of Yugoslavia, and the one destination where the surname is still spelt three different ways inside one family."],
      ["South Africa", "/diaspora/", "Johannesburg. Thirteen of the seventeen people on earth who spell it «Defranceski» are here — an English clerk's spelling that became the family's own."],
      ["United States", "/diaspora/", "Two separate arrivals: the Eleven of Gračišće sending Basilio to Jackson Heights, and the older Istrian emigration to the mines."],
      ["Argentina?", "/diaspora/", "Rotilio, eighth of the Eleven, is said to have gone to Buenos Aires with two daughters. The only authority is a reunion album of 2012. Dotted until a document says otherwise."],
    ],
  },
  {
    key: "venice", colour: "var(--ochre)", label: "Out of Venice, as soldiers", href: "/imotski/", read: "The Imotski page →",
    conf: "documented",
    nodes: [
      ["Venice", "—", "Cittadini originari of the Republic"],
      ["Zadar", "1359", "Louis I grants «nobiles regni Croacie»; the family is at Zadar from the 14th century"],
      ["Omiš", "1584", "Francesco the Venetian lays the foundations of his house on 18 June 1584"],
      ["Imotski", "1717", "Zuane takes the town and is paid in ruined land on the Vrljika"],
      ["Perinuša", "1722", "The mills: six wheels, then eleven, then fourteen"],
    ],
    ends: [
      ["Opačac", "/imotski/", "The spring at the head of the Vrljika, and the mills the Republic paid Zuane with in 1717. Franceschi property into living memory."],
      ["Split", "/omis-line/", "Where the Dalmatian family is today, the particle stripped off by Napoleonic decree — which is why the descendants of a count are called Franceschi."],
    ],
  },
  {
    key: "crete", colour: "var(--terra)", label: "Out of Crete, as refugees", href: "/seget/", read: "The Seget page →",
    conf: "documented",
    nodes: [
      ["Candia", "1500", "Nicolò castellan of Castel Milopotamo; the family noble in Crete"],
      ["Wrecked", "1669", "Candia falls; Morosini's galleys take them off and the fleet is wrecked in a storm"],
      ["Zante", "1670s", "Zorzi de Franceschi goes from Candia to Zante"],
      ["Šibenik", "1674", "and from Zante to Sebenico, drawing a Venetian war pension"],
      ["Seget", "1720", "Marc'Antonio buys the estate; 1724 on the portal, 1732 on the cistern"],
    ],
    ends: [
      ["Umag", "/seget/", "The town the Seget estate belongs to, the parish church with the arms on a canvas of 1650, and the family tomb with its ironwork dated 1890."],
      ["Brtonigla", "/seget/", "Verteneglio. The second of the western-Istrian holdings, and part of the same estate world as Seget."],
      ["Koper", "/seget/", "Capodistria — where a Venetian war pension out of Crete was ordered to be drawn in 1730, «probably because the family was already living at Seghetto»."],
    ],
  },
  {
    key: "liznjan", colour: "var(--r-napo)", label: "Out of southern Istria — origin unknown", href: "/liznjan/", read: "The Ližnjan page →",
    conf: "documented from 1667 · origin not found",
    nodes: [
      ["Pula", "1667", "Anto De Franceschi, with children entered in October 1667 and November 1669 — the earliest of the cluster"],
      ["Fažana", "1810s", "Baptisms and deaths at Fasana through the 1810s, 1840s and after"],
      ["Premantura", "1809", "A Maria Defranceski at Premantura, and again in 1859"],
      ["Barban", "1924", "Two born here who died in France"],
      ["Ližnjan", "1931", "Gregorius «Grgo», born at Ližnjan and dead at Zagreb — the last address, not the origin"],
    ],
    ends: [
      ["Zagreb", "/liznjan/", "Grga died here, and thirteen graves of the name are in the city's cemeteries — the largest single concentration in Croatia."],
      ["Monheim?", "/liznjan/", "A line drawn on a map years ago from Ližnjan to Monheim in Bavaria, with no note, no date and no name. Searched for and not found. Dotted, and staying dotted."],
      ["United States", "/diaspora/", "Southern-Istrian emigration, separate from the Gračišće one and never yet joined to it."],
      ["France", "/liznjan/", "Two born at Barban in 1924 who died in France — the clearest documented exit from this cluster."],
    ],
  },
  {
    key: "corsica", colour: "var(--r-italy)", label: "Out of Corsica — never in Istria",
    conf: "documented · not this family", href: "/namesakes/", read: "The namesakes →",
    parallel: true,
    nodes: [
      ["Ersa", "1694", "Pietro Franceschi, 29 June 1694 – 12 February 1771, the first generation on Cap Corse"],
      ["Gasparo", "1721", "Gasparo Franceschi, 1721–1799, the second generation"],
      ["Francesco M.", "1750", "Francesco Maria Franceschi, 1750–1828"],
      ["Simone", "1826", "Simone Franceschi, born and dead at Ersa, 1826–1907; married Caroline Mattei"],
    ],
    ends: [
      ["Puerto Rico", "/namesakes/", "Where Napoleón Franceschi's own history takes the Cap Corse family. Not ours, and the page says so."],
      ["St Thomas", "/namesakes/", "The Danish West Indies leg of the Corsican trading diaspora."],
      ["Trinidad", "/namesakes/", "The same movement again — Cap Corse to the Caribbean, by sea and by trade."],
      ["Venezuela", "/namesakes/", "Where the Corsican line ends up, and where its own historian wrote it down. No contact with Istria at any point."],
    ],
  },
];

const W = 1040;
/* Households of the name that are real, documented and NOT yet on any lane —
   drawn so that the diagram does not quietly imply everything has been placed. */
const UNPLACED = [
  ["Fiume", "/carlos-letter/", "Kobler found three separate stocks in the Rijeka civic registers and refused to join them to one another. One of them — Valentino, «venuto dalla Carnia», a citizen in 1739 — is almost certainly the Carnian family. The other two are not placed."],
  ["Svetvinčenat", "/istria-sweep/", "142 records from 1666, the second-largest concentration in the sweep. Kandler's list of the Carnian families settled at Sanvincenti names Defranceschi among Lupieri, Fiorencis, Fabris and Crosilla — so the origin is Carnian, but whether it is our Carnian household or another one out of the same valleys is not shown."],
  ["Bakar", "/crikvenica-house/", "Twelve people, one household across three generations, from before 1772 to a death in 1819 — Dominus Giovanni Battista son of Dominus Francesco, styled Dominus, a citizen-class family. Nothing on the page ties them to Gologorica, to Gračišće, or to Kobler's Fiume stocks, and this archive will not join a fourth household to them on the strength of two common Christian names."],
  ["Vodnjan", "/istria-sweep/", "78 records. Carlo's own book names Franceschi among the nobles of Pola «venuti da Capodistria» before the plague of 1631 — which would make them the extinct Koper family and none of the four."],
];
const LOOSE = [
  ["Brazil", "/diaspora/", "The largest cluster of the surname anywhere — Rio Grande do Sul, Santa Catarina, São Paulo. Veneto and Trentino, not Istrian: the in-law names are Marcato, Busatto, Poletta, Raminelli, Barbiero, Negri, Catteri, Facco."],
  ["Ticino", "/diaspora/", "Italian-speaking Switzerland, over the border from Lombardy. A different stock of the same ordinary patronymic."],
  ["Michigan", "/diaspora/", "Domme De Franceski, born in Italy 1880, at the Penn Iron Mining Company at Norway, Michigan, with a wife born in Switzerland. Nothing joins him to Istria."],
];
const BANDS = [ {y0:34,sp:112,h:150}, {y0:192,sp:268,h:140}, {y0:340,sp:414,h:140}, {y0:488,sp:566,h:128}, {y0:630,sp:712,h:150} ];
const X0 = 150, X1 = 700, XE = 902;
---
<figure class="rivers">
  <svg viewBox="0 0 1040 930" role="img" aria-labelledby="riversttl">
    <title id="riversttl">Four families of one surname, and the road each of them took</title>
    {LANES.map((lane, li) => {
      const b = BANDS[li];
      const n = lane.nodes.length;
      const step = n > 2 ? (X1 - X0) / (n - 1) : (X1 - X0) / 2;
      const lineEnd = X0 + step * (n - 1);
      const ends = lane.ends;
      const spread = Math.min(b.h / 2 - 18, 16 + ends.length * 13);
      return (
        <g>
          <rect x="0" y={b.y0} width={W} height={b.h} rx="10"
                fill={lane.colour} opacity={lane.parallel ? 0.04 : 0.055}
                stroke={lane.parallel ? lane.colour : "none"}
                stroke-dasharray={lane.parallel ? "5 5" : ""} stroke-opacity="0.4" />
          <text x="12" y={b.y0 + 21} class="lane-label" fill={lane.colour}>{lane.label}</text>
          <text x="12" y={b.y0 + 37} class="lane-conf">{lane.conf}</text>
          <a href={u(lane.href)} class="lane-link"><text x="12" y={b.y0 + b.h - 9} class="lane-read" fill={lane.colour}>{lane.read}</text></a>

          <line x1={X0} y1={b.sp} x2={Math.max(lineEnd, X1)} y2={b.sp} stroke={lane.colour}
                stroke-width="5" stroke-linecap="round" opacity="0.34"
                stroke-dasharray={lane.parallel ? "12 7" : ""} />

          {ends.map(([e, ehref, ewhy], ei) => {
            const y = ends.length === 1 ? b.sp
              : b.sp - spread + (ei * (spread * 2) / (ends.length - 1));
            const soft = e.endsWith("?");
            return (
              <g class="node end" tabindex="0" role="button"
                 data-place={e.replace("?","")} data-year={soft ? "unverified" : ""}
                 data-why={ewhy} data-lane={lane.label}
                 data-href={u(ehref)} data-read={`Read the ${e.replace("?","")} story`}>
                <title>{e.replace("?","")} — {ewhy}</title>
                <path d={`M ${Math.max(lineEnd, X1)} ${b.sp} C ${X1 + 90} ${b.sp}, ${XE - 90} ${y}, ${XE} ${y}`}
                      fill="none" stroke={lane.colour} stroke-width="1.6" opacity="0.5"
                      stroke-dasharray={soft ? "3 4" : ""} />
                <circle cx={XE} cy={y} r="6.5" fill="transparent" />
                <circle cx={XE} cy={y} r="3.4" fill={lane.colour}
                        fill-opacity={soft ? 0.35 : 1} />
                <text x={XE + 9} y={y + 4} class={soft ? "endlab soft" : "endlab"}>{e.replace("?","")}</text>
              </g>
            );
          })}

          {lane.nodes.map(([place, year, why], i) => {
            const x = X0 + i * step;
            return (
              <g class="node" tabindex="0" role="button"
                 data-place={place} data-year={year} data-why={why} data-lane={lane.label}
                 data-href={u(lane.href)} data-read={lane.read.replace(" →","")}>
                <title>{place}{year !== "—" ? ` · ${year}` : ""} — {why}</title>
                <circle cx={x} cy={b.sp} r="8.5" fill="var(--panel)" stroke={lane.colour} stroke-width="2.6" />
                <circle cx={x} cy={b.sp} r="3" fill={lane.colour} />
                <text x={x} y={b.sp - 19} class="place">{place}</text>
                <text x={x} y={b.sp + 27} class="year" fill={lane.colour}>{year}</text>
              </g>
            );
          })}
        </g>
      );
    })}
    <g>
      <line x1="12" y1="806" x2={W - 12} y2="806" stroke="var(--rule-strong)" stroke-width="1" stroke-dasharray="2 4" />
      <text x="12" y="826" class="loose-head">Real households of the name — not yet placed on any of these lines</text>
      {UNPLACED.map((l, i) => (
        <g class="node" tabindex="0" role="button"
           data-place={l[0]} data-year="unplaced" data-why={l[2]}
           data-lane="Not yet placed on a line" data-href={u(l[1])} data-read={`Where ${l[0]} is written up`}>
          <title>{l[0]} — {l[2]}</title>
          <circle cx={150 + i * 200} cy={846} r="7" fill="transparent" />
          <circle cx={150 + i * 200} cy={846} r="4.5" fill="none" stroke="var(--ink-2)" stroke-width="1.8" />
          <text x={162 + i * 200} y={850} class="loose">{l[0]}</text>
        </g>
      ))}

      <text x="12" y="886" class="loose-head">Attached to no line here — a different stock of a very common name</text>
      {LOOSE.map((l, i) => (
        <g class="node" tabindex="0" role="button"
           data-place={l[0]} data-year="—" data-why={l[2]}
           data-lane="Attached to no line here" data-href={u(l[1])} data-read={`Where ${l[0]} is written up`}>
          <title>{l[0]} — {l[2]}</title>
          <circle cx={150 + i * 200} cy={906} r="7" fill="transparent" />
          <circle cx={150 + i * 200} cy={906} r="4.5" fill="none" stroke="var(--ink-3)" stroke-width="1.6" stroke-dasharray="2 2" />
          <text x={162 + i * 200} y={910} class="loose">{l[0]}</text>
        </g>
      ))}
      <text x={760} y={910} class="loose-note">— the commonest patronymic in Italy</text>
    </g>
  </svg>
  <div class="riverread" id="riverread" aria-live="polite">
    <b>Click or tab any dot</b> — the stops tell you what the document behind them says, and the destinations on the right tell their own story and link to it. Click a second time to go there.
  </div>
  <figcaption>The teal river is the one this archive descends from, and the only one that arrived on foot looking for work. <strong>The green river at the bottom is drawn dashed because it never came to Istria at all</strong> — a fully documented family of the same name that goes from Cap Corse to the Caribbean, put here so that a Franceschi found in Puerto Rico or Caracas can be seen for what they are. <strong>A dotted end-point means the attachment is family lore, not a document</strong> — Argentina hangs off Carnia only on the word of a reunion album, and Monheim is a pin on a map. Below the rule are the households this archive will not pretend to have placed: <strong>Fiume, Svetvinčenat, Bakar and Vodnjan are real, documented families of the name that belong to nobody yet</strong>, and Brazil, Ticino and Michigan are somebody else's entirely. The table under this diagram gives every one of them a verdict.</figcaption>
</figure>

<script is:inline>
  (function () {
    var host = document.getElementById("riverread");
    if (!host) return;
    var rest = host.innerHTML;
    function show(g) {
      var place = g.getAttribute("data-place"), year = g.getAttribute("data-year"),
          why = g.getAttribute("data-why"), lane = g.getAttribute("data-lane");
      var href = g.getAttribute("data-href"), read = g.getAttribute("data-read");
      host.innerHTML = '<span class="rr-lane"></span><b class="rr-place"></b>'
        + '<span class="rr-year"></span><span class="rr-why"></span>'
        + (href ? '<a class="rr-go" href="' + href + '"></a>' : '');
      host.querySelector(".rr-lane").textContent = lane;
      host.querySelector(".rr-place").textContent = place;
      host.querySelector(".rr-year").textContent = year && year !== "\u2014" ? year : "";
      host.querySelector(".rr-why").textContent = why;
      if (href) host.querySelector(".rr-go").textContent = (read || "Read on") + " \u2192";
      document.querySelectorAll(".rivers .node").forEach(function (n) { n.classList.remove("sel"); });
      g.classList.add("sel");
    }
    document.querySelectorAll(".rivers .node").forEach(function (g) {
      g.addEventListener("click", function () {
        var was = g.classList.contains("sel"), href = g.getAttribute("data-href");
        show(g);
        if (was && href) window.location.href = href;
      });
      g.addEventListener("mouseenter", function () { show(g); });
      g.addEventListener("focus", function () { show(g); });
      g.addEventListener("keydown", function (e) {
        if (e.key === "Enter" || e.key === " ") { e.preventDefault(); show(g); }
      });
    });
  })();
</script>

<style>
  .rivers{margin:0}
  .rivers svg{width:100%;height:auto;display:block;overflow:visible}
  .lane-label{font-family:var(--sans);font-size:13px;font-weight:600}
  .lane-conf{font-family:var(--mono);font-size:9.5px;letter-spacing:.12em;
    text-transform:uppercase;fill:var(--ink-3)}
  .lane-read{font-family:var(--sans);font-size:11.5px;font-weight:600;text-anchor:start}
  .lane-link{text-decoration:none}
  .lane-link:hover .lane-read{text-decoration:underline}
  .place{font-family:var(--sans);font-size:12.5px;font-weight:600;fill:var(--ink);
    text-anchor:middle;paint-order:stroke;stroke:var(--panel);stroke-width:3.4px}
  .year{font-family:var(--mono);font-size:10.5px;text-anchor:middle;
    paint-order:stroke;stroke:var(--panel);stroke-width:3px}
  .endlab{font-family:var(--sans);font-size:11.5px;fill:var(--ink-2)}
  .endlab.soft{fill:var(--ink-3);font-style:italic}
  .loose-head{font-family:var(--mono);font-size:10px;letter-spacing:.14em;
    text-transform:uppercase;fill:var(--ink-3)}
  .loose{font-family:var(--sans);font-size:12.5px;fill:var(--ink-2)}
  .loose-note{font-family:var(--sans);font-size:11.5px;font-style:italic;fill:var(--ink-3)}
  .rivers .node{cursor:help}
  .rivers .node:hover circle:first-of-type,
  .rivers .node:focus circle:first-of-type{r:11}
  .rivers .node:focus{outline:none}
  .rivers .node:focus .place{fill:var(--accent)}
  .rivers .node.sel circle:first-of-type{r:11;stroke-width:3.4}
  .riverread{margin-top:18px;padding:14px 18px;border-left:3px solid var(--accent);
    background:var(--panel-2);border-radius:0 10px 10px 0;font-family:var(--sans);
    font-size:14px;line-height:1.55;color:var(--ink-2);min-height:52px}
  .riverread .rr-lane{display:block;font-family:var(--mono);font-size:9.5px;
    letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3);margin-bottom:4px}
  .riverread .rr-place{color:var(--ink);font-size:16px}
  .riverread .rr-year{font-family:var(--mono);font-size:12px;color:var(--accent);margin-left:9px}
  .riverread .rr-why{display:block;margin-top:5px}
  .riverread .rr-go{display:inline-block;margin-top:8px;font-weight:600;
    font-size:13px;color:var(--accent);text-decoration:none}
  .riverread .rr-go:hover{text-decoration:underline}
  .rivers .node.end{cursor:pointer}
  .rivers .node.end:hover .endlab,
  .rivers .node.end:focus .endlab{fill:var(--ink);text-decoration:underline}
  .rivers .node.end.sel .endlab{fill:var(--ink);font-weight:600}
  .rivers figcaption{font-family:var(--sans);font-size:13px;color:var(--ink-2);
    margin-top:14px;max-width:78ch;line-height:1.6}
  @media (max-width:700px){
    .rivers svg{min-width:660px}
    .rivers{overflow-x:auto}
  }
</style>
