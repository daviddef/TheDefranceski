---
/* Ornaments drawn from things this family actually owned or cut in stone.

   arrows      the cross pierced by two arrows in bend sinister — the chief of
               the arms as Carlo described them from memory to Kobler in 1876:
               "una croce greca attraversata da due freccie".
   pomegranate the charge in base of the same arms: "un melagrano".
   helm        "sovra lo scudo elmo piumato" — the plumed helm above the shield.
   tablet      the lintel of the house at Gologorica: ANNO · DOMNI · 1711.
   arcade      the arcaded portico Matejčić describes on the palazzetto.
   loom        the weaver's shuttle — the trade the 1679 headmen's list records.

   Everything here is ornament, not evidence. Nothing is drawn that is not
   named in a source the site already cites. */
const { name = "arrows", size = 26, tone = "var(--rule-strong)" } = Astro.props;
---
<svg viewBox="0 0 40 40" width={size} height={size} aria-hidden="true"
     style={`display:block;color:${tone}`} fill="none"
     stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
  {name === "arrows" && (
    <g>
      <path d="M20,7 V31 M11,15 H29"/>
      <path d="M9,29 L27,11 M15,31 L33,13"/>
      <path d="M27,11 l-4.6,.5 M27,11 l-.5,4.6"/>
      <path d="M33,13 l-4.6,.5 M33,13 l-.5,4.6"/>
    </g>
  )}
  {name === "pomegranate" && (
    <g>
      <path d="M20,12 C27,12 31,17 31,23 C31,29 26,33 20,33 C14,33 9,29 9,23 C9,17 13,12 20,12 Z"/>
      <path d="M16,8 l.6,4 L20,9.5 L23.4,12 L24,8"/>
      <path d="M13,21 C16,29 24,29 27,21"/>
      <circle cx="17" cy="23" r="1.3" fill="currentColor" stroke="none"/>
      <circle cx="22" cy="21.5" r="1.3" fill="currentColor" stroke="none"/>
      <circle cx="20" cy="27" r="1.3" fill="currentColor" stroke="none"/>
    </g>
  )}
  {name === "helm" && (
    <g>
      <path d="M12,20 C12,13 16,9 20,9 C24,9 28,13 28,20 L28,25 H12 Z"/>
      <path d="M12,25 H28 L26,31 H14 Z"/>
      <path d="M14,17 H26"/>
      <path d="M20,9 C15,4 8,6 7,12 C11,9 16,8 19,10"/>
      <path d="M20,9 C25,4 32,6 33,12 C29,9 24,8 21,10"/>
    </g>
  )}
  {name === "tablet" && (
    <g>
      <rect x="6" y="12" width="28" height="17" rx="1.4"/>
      <path d="M10,18 H30 M10,23 H26"/>
      <circle cx="8.6" cy="20.5" r=".9" fill="currentColor" stroke="none"/>
    </g>
  )}
  {name === "arcade" && (
    <g>
      <path d="M7,31 V22 A5,5 0 0 1 17,22 V31"/>
      <path d="M23,31 V22 A5,5 0 0 1 33,22 V31"/>
      <path d="M4,31 H36 M5,17 H35"/>
      <path d="M20,31 V17"/>
    </g>
  )}
  {name === "loom" && (
    <g>
      <path d="M5,20 C11,14 29,14 35,20 C29,26 11,26 5,20 Z"/>
      <path d="M14,18.6 H26"/>
      <circle cx="20" cy="20" r="1.5" fill="currentColor" stroke="none"/>
    </g>
  )}
</svg>
