---
import sov from "../data/sovereignty.json";
const X0=90, X1=980, MID=490;
const x = (y) => y<=1800 ? X0+(y-1200)*((MID-X0)/600) : MID+(y-1800)*((X1-MID)/226);
const LANE_H=30, TOP=68, GAP=34;
const laneY = (i)=> TOP + i*(LANE_H+GAP);
const AX = laneY(sov.lanes.length-1)+LANE_H+24;
const H = AX+52;
const ticks=[1200,1400,1600,1800,1850,1900,1950,2000];
const evYears=[...new Set(sov.events.map(e=>e.year))].sort((a,b)=>a-b);
const { events = true } = Astro.props;
---
<div class="scroll">
<svg viewBox={`0 0 1000 ${H}`} width="1000" style="min-width:940px;display:block" role="img"
     aria-label="Sovereignty over Central Istria, Senj and Vinodol, and Carnia, 1200 to 2026">
  {events && <>
    <line x1={X0} y1="44" x2={X1} y2="44" style="stroke:var(--rule-strong)" stroke-width="1"/>
    <text x="6" y="47" font-size="9.5" style="fill:var(--terra);font-family:var(--sans)">Family events</text>
    {evYears.map(y => <circle cx={x(y)} cy="44" r="3.2" style="fill:var(--terra)"/>)}
  </>}

  {sov.lanes.map((lane,i) => (
    <g>
      <text x="6" y={laneY(i)+12} font-size="9.5" style="fill:var(--ink-2);font-family:var(--sans)">{lane.label}</text>
      <text x="6" y={laneY(i)+24} font-size="9.5" style="fill:var(--ink-3);font-family:var(--sans)">{lane.sub}</text>
      {lane.bands.map(([a,b,kind,label]) => {
        const w = x(b)-x(a);
        return <>
          <rect x={x(a)} y={laneY(i)} width={w} height={LANE_H}
                style={`fill:var(${sov.regimes[kind].color})`}/>
          {label && w>46 &&
            <text x={x(a)+8} y={laneY(i)+19} font-size="9.5"
                  style="fill:var(--band-label);font-family:var(--sans)">{label}</text>}
        </>;
      })}
    </g>
  ))}

  <line x1={MID} y1="36" x2={MID} y2={AX-10} style="stroke:var(--ink-3)" stroke-width="1" stroke-dasharray="2 3"/>
  <text x={MID+5} y={AX-8} font-size="8.5" style="fill:var(--ink-3);font-family:var(--mono)">scale expands →</text>

  <line x1={X0} y1={AX} x2={X1} y2={AX} style="stroke:var(--rule-strong)" stroke-width="1"/>
  {ticks.map(t => <line x1={x(t)} y1={AX} x2={x(t)} y2={AX+6} style="stroke:var(--rule-strong)" stroke-width="1"/>)}
  {ticks.map(t => <text x={x(t)} y={AX+20} font-size="10" text-anchor="middle"
                        style="fill:var(--ink-3);font-family:var(--mono)">{t}</text>)}
</svg>
</div>

<div class="legend">
  {Object.values(sov.regimes).map(r => (
    <span><i style={`background:var(${r.color})`}></i>{r.label}</span>
  ))}
</div>
