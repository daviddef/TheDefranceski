---
import { u } from "../lib/url.js";
const { title, dek, eyebrow } = Astro.props;
const SITE = "The Defranceschi Archive";
const nav = [
  ["Start", [["/", "Home"], ["/search/", "Search"], ["/about/", "About"]]],
  ["The line", [["/direct-line/", "The Spine"], ["/carnia/", "Carnia"], ["/gologorica-line/", "Gologorica"], ["/the-eleven/", "The Eleven"], ["/crikvenica-house/", "Crikvenica"], ["/pfullingen/", "Pfullingen"],
                ["/seget/", "Seget"], ["/omis-line/", "Omiš"], ["/lines/", "All lines"]]],
  ["People", [["/people/", "People"], ["/namesakes/", "Namesakes"], ["/households/", "Households"],
              ["/explorer/", "Explorer"], ["/marriages/", "Marriages"], ["/carlos-letter/", "Carlo's Letter"]]],
  ["Places", [["/places/", "Places"], ["/journeys/", "Journeys"], ["/emigration/", "Leaving"], ["/diaspora/", "Diaspora"],
              ["/timeline/", "Timeline"]]],
  ["The dead", [["/burials/", "Burials"], ["/graves/", "Graves"]]],
  ["Names & signs", [["/name/", "The Name"], ["/your-name/", "Say Your Name"], ["/arms/", "Arms & Flags"]]],
  ["Sources", [["/gallery/", "Gallery"], ["/archive/", "Archive"], ["/parish-books/", "Parish Books"],
               ["/sources/", "Sources"], ["/research-log/", "Research Log"]]],
];
const here = Astro.url.pathname;
---
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title === SITE ? SITE : `${title} — ${SITE}`}</title>
<meta name="description" content={dek} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Libre+Franklin:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" />
<link rel="stylesheet" href={u("/styles.css")} />
</head>
<body>
<header class="site">
  <div class="wrap sitein">
    <a class="brand" href={u("/")}>The Defranceschi Archive</a>
    <nav class="grouped">{nav.map(([label, links]) => (
      <span class="grp">
        <span class="gl">{label}</span>
        {links.map(([h, l]) => <a href={u(h)} class={here === u(h) ? "on" : ""}>{l}</a>)}
      </span>
    ))}</nav>
  </div>
</header>

<main>
  <div class="wrap">
    <div class="pagehead">
      {eyebrow && <div class="lab">{eyebrow}</div>}
      <h1>{title}</h1>
      {dek && <p class="dek lead">{dek}</p>}
    </div>
    <slot />
  </div>
</main>

<footer class="site">
  <div class="wrap">
    <p class="foot">An evidence-first family archive for the Defranceschi, De Franceschi, Defranceski and de Franceski families of Istria, Kvarner, Carnia and the diaspora. Every claim carries its confidence. Living people are excluded from this build.</p>
    <p class="foot dim">Built {new Date().getFullYear()} · Sources listed on <a href={u("/about/")}>About</a> · Corrections welcome</p>
  </div>
</footer>

<script define:vars={{ searchUrl: u("/search/") }}>
  /* "/" opens search from anywhere, the way an archive catalogue should.
     Ignored while the caret is in a field, so it never eats a typed slash. */
  document.addEventListener("keydown", (e) => {
    if (e.key !== "/" || e.metaKey || e.ctrlKey || e.altKey) return;
    const t = e.target;
    if (t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.isContentEditable)) return;
    e.preventDefault();
    location.href = searchUrl;
  });
</script>
</body>
</html>
