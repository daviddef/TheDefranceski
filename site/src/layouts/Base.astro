---
import "@daviddef/archive-kit/styles/print.css";
import { versioner } from "@daviddef/archive-kit/lib/assetv.js";
/* every public asset gets a fingerprint, so a fix is never served stale */
const v = versioner();
import { u } from "../lib/url.js";
import SiblingArchives from "@daviddef/archive-kit/components/SiblingArchives.astro";
import SkipLink from "@daviddef/archive-kit/components/SkipLink.astro";
import SocialHead from "@daviddef/archive-kit/components/SocialHead.astro";
import JsonLd from "@daviddef/archive-kit/components/JsonLd.astro";
import VisitCount from "@daviddef/archive-kit/components/VisitCount.astro";
import ring from "@daviddef/archive-kit/data/archives.json";
const { title, description = "", dek, eyebrow, bare, noindex } = Astro.props;
const SITE = "The Defranceschi Archive";
const nav = [
  ["Start", [["/", "Home"], ["/story/", "The Story"], ["/trees/", "The trees"], ["/tree/", "Our line, drawn"], ["/atlas/", "The Atlas"], ["/timeline/", "The Timeline"], ["/dna/", "The DNA"], ["/about/", "About"]]],
  ["Our line", [["/direct-line/", "The Spine"], ["/carlo/", "Carlo De Franceschi"], ["/cheryl-lerena/", "Cheryl Lerena — the poems"], ["/1948/", "Nineteen forty-eight"], ["/vodnjan/", "Vodnjan"], ["/carnia/", "1 · Carnia"], ["/gologorica-line/", "2 · Gologorica"], ["/the-eleven/", "3 · Gračišće — the Eleven"], ["/crikvenica-house/", "4 · Crikvenica"], ["/senj-line/", "5 · Senj"], ["/pfullingen/", "6 · Pfullingen"]]],
  ["The families", [["/lines/", "The Lines"], ["/omis-line/", "Out of Venice — Omiš"], ["/imotski/", "…and Imotski"], ["/seget/", "Out of Crete — Seget"], ["/liznjan/", "Southern Istria — Ližnjan"], ["/rijeka/", "The Kvarner — Rijeka and Bakar"], ["/dubrovnik/", "Ragusa — Dubrovnik"], ["/corsica/", "Corsica — a parallel"], ["/trentino/", "Trentino — a blind spot"], ["/lines/#regions", "Bakar, Fiume & the unplaced"]]],
  ["Go there", [["/walk/carnia/", "1 · Carnia — Val Degano"], ["/walk/gologorica/", "2 · Gologorica & Gračišće"], ["/emigration/", "Leaving"], ["/burials/", "Burials"], ["/walk/", "Walk the line"], ["/journeys/", "Journeys"], ["/mymap/", "David's Map"], ["/diaspora/", "Where the name went"], ["/istria-sweep/", "Every town"]]],
  ["People & places", [["/people/", "The People"], ["/who/", "Every Name"], ["/bloodline/", "Blood relatives, drawn"], ["/register/", "The Register"], ["/households/", "Households"], ["/marriages/", "The Marriages"], ["/graves/", "Graves"], ["/places/", "Places"], ["/explorer/", "Explorer"]]],
  ["The name", [["/name/", "The Name"], ["/your-name/", "Say Your Name"], ["/arms/", "Arms & Flags"], ["/julius/", "Julius — a naval career"], ["/imperial/", "The name in imperial service"], ["/fiume-1626/", "Fiume, 1626"], ["/at-sea/", "At sea — Lloyd's List"], ["/giornaletto/", "The Giornaletto di Pola"], ["/namesakes/", "Namesakes"]]],
  ["Evidence", [["/gallery/", "Gallery"], ["/archive/", "Archive"], ["/parish-books/", "Parish Books"], ["/the-library/", "The Library"], ["/carlos-letter/", "Carlo's Letter"], ["/carlos-book/", "Carlo's Book"], ["/photograph-these/", "Photograph these"], ["/gaps/", "What we cannot close"], ["/errands/", "Errands"], ["/old-site/", "defranceski.com"], ["/sources/", "Sources"], ["/searched/", "What Has Been Read"], ["/open-questions/", "Open Questions"], ["/worklist/", "The Work List"], ["/corrections/", "Corrections"], ["/changes/", "What changed"], ["/research-log/", "Research Log"], ["/method/", "Method"]]],
];

const here = Astro.url.pathname;
/* which of the seven this is, worked out the same way the ring does */
const thisArchive = ring.archives.find(
  (a) => a.base === (import.meta.env.BASE_URL || "/").replace(/\/$/, "")
);
---
<html lang="en" data-base={u("")}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title === SITE ? SITE : `${title} — ${SITE}`}</title>
<meta name="description" content={dek} />
<SocialHead title={title} description={dek || description} site={SITE} />
<JsonLd type={bare ? "WebSite" : "Article"} name={title} description={dek || description}
        url={Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname}
        site={SITE} about={Astro.props.person} />
    {noindex && <meta name="robots" content="noindex" />}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Libre+Franklin:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" />
<link rel="stylesheet" href={u("/styles.css") + v("styles.css")} />
</head>
<body class={bare ? "is-home" : ""}>
<SkipLink />
<header class="site">
  <div class="wrap sitein">
    <a class="brand" href={u("/")}>The Defranceschi <em>Archive</em></a>
    <button class="burger" type="button" aria-expanded="false" aria-controls="drawer">
      <span class="bars" aria-hidden="true"></span>Menu
    </button>
    <nav class="topnav" aria-label="Main">
      {nav.map(([label, links]) => (
        <details class="menu">
          <summary>{label}</summary>
          <div class="panel">
            {links.map(([h, l]) => <a href={u(h)} class={here === u(h) ? "on" : ""}>{l}</a>)}
          </div>
        </details>
      ))}
      <a class="findbtn" href={u("/search/")} aria-label="Search">Search</a>
    </nav>
  </div>
  <div class="drawer" id="drawer" hidden>
    <div class="wrap">{nav.map(([label, links]) => (
      <div class="dgrp"><span class="gl">{label}</span>
        {links.map(([h, l]) => <a href={u(h)} class={here === u(h) ? "on" : ""}>{l}</a>)}
      </div>
    ))}</div>
  </div>
</header>

<main id="main" tabindex="-1">
  <div class="wrap">
    {!bare && (
      <div class="pagehead">
        {eyebrow && <div class="lab">{eyebrow}</div>}
        <h1>{title}</h1>
        {dek && <p class="dek lead">{dek}</p>}
      </div>
    )}
    <div id="onthispage" hidden></div>
    <slot />
  </div>
</main>

<footer class="site">
  <div class="wrap">
    <SiblingArchives />
    <p class="foot">An evidence-first family archive for the Defranceschi, De Franceschi, Defranceski and de Franceski families of Istria, Kvarner, Carnia and the diaspora. Every claim carries its confidence. <strong>Living people are named</strong> — name and relationship only, never a date, a place, a photograph or a record.</p>
    <p class="foot dim">Built {new Date().getFullYear()} ·
      <a href={u("/sources/")}>Sources</a> ·
      <a href={u("/method/")}>Method</a> ·
      <a href={u("/open-questions/")}>Open questions</a> ·
      <a href={u("/corrections/")}>Corrections</a> ·
      Corrections are the most valuable thing you can send</p>
    <VisitCount code={thisArchive?.counter} />
  </div>
</footer>

<script define:vars={{ searchUrl: u("/search/") }}>
  /* "/" opens search from anywhere, the way an archive catalogue should.
     Ignored while the caret is in a field, so it never eats a typed slash. */
  document.addEventListener("keydown", (e) => {
    if (e.key !== "/" || e.metaKey || e.ctrlKey || e.altKey) return;
    const t = e.target;
    if (t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.isContentEditable)) return;
    e.preventDefault();
    location.href = searchUrl;
  });
</script>
<script is:inline>
  (function () {
    var bar = document.querySelector(".topnav");
    var burger = document.querySelector(".burger");
    var drawer = document.getElementById("drawer");
    if (burger && drawer) {
      burger.addEventListener("click", function () {
        var open = drawer.hasAttribute("hidden");
        if (open) { drawer.removeAttribute("hidden"); } else { drawer.setAttribute("hidden", ""); }
        burger.setAttribute("aria-expanded", open ? "true" : "false");
      });
    }
    if (!bar) return;
    var menus = [].slice.call(bar.querySelectorAll("details.menu"));
    menus.forEach(function (d) {
      d.addEventListener("toggle", function () {
        if (!d.open) return;
        menus.forEach(function (o) { if (o !== d) o.open = false; });
      });
    });
    document.addEventListener("click", function (e) {
      if (e.target.closest(".topnav")) return;
      menus.forEach(function (d) { d.open = false; });
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") menus.forEach(function (d) { d.open = false; });
    });
  })();
</script>

<script>
  /* On a long page, build a jump list from the section headings.
     Done in the browser so no page has to declare its own contents. */
  (function () {
    var host = document.getElementById("onthispage");
    if (!host) return;
    var hs = [].slice.call(document.querySelectorAll("main section > h2"));
    if (hs.length < 4) return;
    var slug = function (t) {
      return t.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "")
        .replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 48);
    };
    var seen = {}, items = [];
    hs.forEach(function (h) {
      var t = (h.textContent || "").trim();
      if (!t) return;
      var id = h.id || slug(t) || "s";
      if (seen[id]) id = id + "-" + (++seen[id]); else seen[id] = 1;
      h.id = id;
      items.push([id, t]);
    });
    if (items.length < 4) return;
    var det = document.createElement("details");
    det.className = "toc";
    var sum = document.createElement("summary");
    sum.textContent = "On this page · " + items.length + " sections";
    det.appendChild(sum);
    var nav = document.createElement("nav");
    items.forEach(function (it) {
      var a = document.createElement("a");
      a.href = "#" + it[0];
      a.textContent = it[1];
      nav.appendChild(a);
    });
    det.appendChild(nav);
    host.appendChild(det);
    host.hidden = false;
    var mq = window.matchMedia("(min-width: 901px)");
    det.open = false;
    det.addEventListener("click", function (ev) {
      if (!mq.matches && ev.target.closest("nav a")) det.open = false;
    });
  })();
</script>
  <script src={u("/wholink.js") + v("wholink.js")} defer></script>
</body>
</html>
