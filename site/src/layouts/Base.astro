---
import { u } from "../lib/url.js";
const { title, dek, eyebrow, bare } = Astro.props;
const SITE = "The Defranceschi Archive";
const nav = [
  ["Start", [["/", "Home"], ["/story/", "The Story"], ["/tree/", "The Tree"], ["/atlas/", "The Atlas"], ["/search/", "Search"]]],
  ["The line", [["/direct-line/", "The Spine"], ["/carnia/", "Carnia"], ["/gologorica-line/", "Gologorica"],
                ["/crikvenica-house/", "Crikvenica"], ["/pfullingen/", "Pfullingen"], ["/senj-line/", "Senj"]]],
  ["Other families", [["/lines/", "All lines"], ["/the-eleven/", "The Eleven"], ["/seget/", "Seget"],
                      ["/omis-line/", "Omiš"], ["/imotski/", "Imotski"], ["/istria-sweep/", "Every Town"],
                      ["/diaspora/", "Diaspora"], ["/namesakes/", "Namesakes"]]],
  ["People & places", [["/people/", "People"], ["/households/", "Households"], ["/explorer/", "Explorer"],
                       ["/marriages/", "Marriages"], ["/places/", "Places"], ["/journeys/", "Journeys"],
                       ["/emigration/", "Leaving"], ["/timeline/", "Timeline"]]],
  ["The dead", [["/burials/", "Burials"], ["/graves/", "Graves"]]],
  ["Names & signs", [["/name/", "The Name"], ["/your-name/", "Say Your Name"], ["/arms/", "Arms & Flags"]]],
  ["Sources", [["/gallery/", "Gallery"], ["/archive/", "Archive"], ["/parish-books/", "Parish Books"], ["/the-library/", "The Library"],
               ["/carlos-letter/", "Carlo's Letter"], ["/carlos-book/", "Carlo's Book"],
               ["/sources/", "Sources"], ["/research-log/", "Research Log"], ["/about/", "About"]]],
];
const here = Astro.url.pathname;
---
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title === SITE ? SITE : `${title} — ${SITE}`}</title>
<meta name="description" content={dek} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Libre+Franklin:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" />
<link rel="stylesheet" href={u("/styles.css")} />
</head>
<body>
<header class="site">
  <div class="wrap sitein">
    <a class="brand" href={u("/")}>The Defranceschi Archive</a>
    <details class="navbox" open>
      <summary><span class="bars" aria-hidden="true"></span>Menu</summary>
      <nav class="grouped">{nav.map(([label, links]) => (
        <span class="grp">
          <span class="gl">{label}</span>
          {links.map(([h, l]) => <a href={u(h)} class={here === u(h) ? "on" : ""}>{l}</a>)}
        </span>
      ))}</nav>
    </details>
  </div>
</header>

<main>
  <div class="wrap">
    {!bare && (
      <div class="pagehead">
        {eyebrow && <div class="lab">{eyebrow}</div>}
        <h1>{title}</h1>
        {dek && <p class="dek lead">{dek}</p>}
      </div>
    )}
    <div id="onthispage" hidden></div>
    <slot />
  </div>
</main>

<footer class="site">
  <div class="wrap">
    <p class="foot">An evidence-first family archive for the Defranceschi, De Franceschi, Defranceski and de Franceski families of Istria, Kvarner, Carnia and the diaspora. Every claim carries its confidence. Living people are excluded from this build.</p>
    <p class="foot dim">Built {new Date().getFullYear()} · Sources listed on <a href={u("/about/")}>About</a> · Corrections welcome</p>
  </div>
</footer>

<script define:vars={{ searchUrl: u("/search/") }}>
  /* "/" opens search from anywhere, the way an archive catalogue should.
     Ignored while the caret is in a field, so it never eats a typed slash. */
  document.addEventListener("keydown", (e) => {
    if (e.key !== "/" || e.metaKey || e.ctrlKey || e.altKey) return;
    const t = e.target;
    if (t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.isContentEditable)) return;
    e.preventDefault();
    location.href = searchUrl;
  });
</script>
<script is:inline>
  /* The nav ships open, so it works with no JavaScript at all. On a narrow
     screen we close it and let the Menu button drive it. */
  (function () {
    var d = document.querySelector(".navbox");
    if (!d) return;
    var mq = window.matchMedia("(max-width: 900px)");
    var sync = function (e) { if (e.matches) { d.open = false; } else { d.open = true; } };
    sync(mq);
    (mq.addEventListener ? mq.addEventListener("change", sync) : mq.addListener(sync));
    d.addEventListener("click", function (ev) {
      if (mq.matches && ev.target.closest("nav a")) d.open = false;
    });
  })();
</script>

<script>
  /* On a long page, build a jump list from the section headings.
     Done in the browser so no page has to declare its own contents. */
  (function () {
    var host = document.getElementById("onthispage");
    if (!host) return;
    var hs = [].slice.call(document.querySelectorAll("main section > h2"));
    if (hs.length < 4) return;
    var slug = function (t) {
      return t.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "")
        .replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 48);
    };
    var seen = {}, items = [];
    hs.forEach(function (h) {
      var t = (h.textContent || "").trim();
      if (!t) return;
      var id = h.id || slug(t) || "s";
      if (seen[id]) id = id + "-" + (++seen[id]); else seen[id] = 1;
      h.id = id;
      items.push([id, t]);
    });
    if (items.length < 4) return;
    var det = document.createElement("details");
    det.className = "toc";
    var sum = document.createElement("summary");
    sum.textContent = "On this page · " + items.length + " sections";
    det.appendChild(sum);
    var nav = document.createElement("nav");
    items.forEach(function (it) {
      var a = document.createElement("a");
      a.href = "#" + it[0];
      a.textContent = it[1];
      nav.appendChild(a);
    });
    det.appendChild(nav);
    host.appendChild(det);
    host.hidden = false;
    var mq = window.matchMedia("(min-width: 901px)");
    var sync = function (e) { det.open = e.matches; };
    sync(mq);
    (mq.addEventListener ? mq.addEventListener("change", sync) : mq.addListener(sync));
    det.addEventListener("click", function (ev) {
      if (!mq.matches && ev.target.closest("nav a")) det.open = false;
    });
  })();
</script>
</body>
</html>
