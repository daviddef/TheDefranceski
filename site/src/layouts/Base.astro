---
import { u } from "../lib/url.js";
const { title, dek, eyebrow, bare } = Astro.props;
const SITE = "The Defranceschi Archive";
const nav = [
  ["Start", [["/", "Home"], ["/story/", "The Story"], ["/dna/", "The DNA"], ["/tree/", "The Tree"], ["/atlas/", "The Atlas"], ["/search/", "Search"]]],
  ["Our line", [["/carlo/", "Carlo De Franceschi"], ["/1948/", "Nineteen forty-eight"], ["/vodnjan/", "Vodnjan"], ["/direct-line/", "The Spine"], ["/carnia/", "1 · Carnia"], ["/gologorica-line/", "2 · Gologorica"],
                ["/the-eleven/", "3 · Gračišće — the Eleven"], ["/crikvenica-house/", "4 · Crikvenica"],
                ["/senj-line/", "5 · Senj"], ["/pfullingen/", "6 · Pfullingen"]]],
  ["The families", [["/lines/", "All five, compared"], ["/carnia/", "Out of Carnia — ours"],
                ["/omis-line/", "Out of Venice — Omiš"], ["/imotski/", "…and Imotski"],
                ["/seget/", "Out of Crete — Seget"], ["/liznjan/", "Southern Istria — Ližnjan"], ["/corsica/", "Corsica — a parallel"],
                
                ["/fiume-1626/", "Fiume, 1626"],
                ["/at-sea/", "At sea — Lloyd's List"],
                ["/lines/#regions", "Bakar, Fiume & the unplaced"],
                ["/istria-sweep/", "Every town"], ["/diaspora/", "Where the name went"],
                ["/namesakes/", "Namesakes"]]],
  ["Go there", [["/walk/", "Walk the line"], ["/walk/carnia/", "1 · Carnia — Val Degano"],
                ["/walk/gologorica/", "2 · Gologorica & Gračišće"],
                ["/places/", "Places"], ["/atlas/", "The Atlas"], ["/journeys/", "Journeys"]]],
  ["People", [["/people/", "People"], ["/register/", "The Register"], ["/households/", "Households"], ["/explorer/", "Explorer"],
                       ["/marriages/", "Marriages"], ["/places/", "Places"], ["/journeys/", "Journeys"],
                       ["/emigration/", "Leaving"], ["/timeline/", "Timeline"]]],
  ["The dead", [["/burials/", "Burials"], ["/graves/", "Graves"]]],
  ["Names", [["/name/", "The Name"], ["/your-name/", "Say Your Name"], ["/arms/", "Arms & Flags"]]],
  ["Sources", [["/gallery/", "Gallery"], ["/archive/", "Archive"], ["/parish-books/", "Parish Books"], ["/the-library/", "The Library"],
               ["/carlos-letter/", "Carlo's Letter"], ["/carlos-book/", "Carlo's Book"],
               ["/sources/", "Sources"], ["/register/", "The Register"], ["/dna/", "The DNA"], ["/who/", "People"], ["/searched/", "Searched"], ["/research-log/", "Research Log"], ["/photograph-these/", "Photograph these"], ["/gaps/", "What we cannot close"], ["/changes/", "What changed"], ["/method/", "Method"], ["/corrections/", "Corrections"], ["/errands/", "Errands"], ["/old-site/", "defranceski.com"], ["/about/", "About"]]],
];
const here = Astro.url.pathname;
---
<html lang="en" data-base={u("")}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title === SITE ? SITE : `${title} — ${SITE}`}</title>
<meta name="description" content={dek} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Libre+Franklin:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" />
<link rel="stylesheet" href={u("/styles.css")} />
</head>
<body class={bare ? "is-home" : ""}>
<header class="site">
  <div class="wrap sitein">
    <a class="brand" href={u("/")}>The Defranceschi <em>Archive</em></a>
    <button class="burger" type="button" aria-expanded="false" aria-controls="drawer">
      <span class="bars" aria-hidden="true"></span>Menu
    </button>
    <nav class="topnav" aria-label="Main">
      {nav.map(([label, links]) => (
        <details class="menu">
          <summary>{label}</summary>
          <div class="panel">
            {links.map(([h, l]) => <a href={u(h)} class={here === u(h) ? "on" : ""}>{l}</a>)}
          </div>
        </details>
      ))}
      <a class="findbtn" href={u("/search/")} aria-label="Search">Search</a>
    </nav>
  </div>
  <div class="drawer" id="drawer" hidden>
    <div class="wrap">{nav.map(([label, links]) => (
      <div class="dgrp"><span class="gl">{label}</span>
        {links.map(([h, l]) => <a href={u(h)} class={here === u(h) ? "on" : ""}>{l}</a>)}
      </div>
    ))}</div>
  </div>
</header>

<main>
  <div class="wrap">
    {!bare && (
      <div class="pagehead">
        {eyebrow && <div class="lab">{eyebrow}</div>}
        <h1>{title}</h1>
        {dek && <p class="dek lead">{dek}</p>}
      </div>
    )}
    <div id="onthispage" hidden></div>
    <slot />
  </div>
</main>

<footer class="site">
  <div class="wrap">
    <p class="foot">An evidence-first family archive for the Defranceschi, De Franceschi, Defranceski and de Franceski families of Istria, Kvarner, Carnia and the diaspora. Every claim carries its confidence. Living people appear by name only — no dates, no places, no photographs.</p>
    <p class="foot dim">Built {new Date().getFullYear()} · Sources listed on <a href={u("/about/")}>About</a> · Everything this archive got wrong is on <a href={u("/corrections/")}>Corrections</a></p>
  </div>
</footer>

<script define:vars={{ searchUrl: u("/search/") }}>
  /* "/" opens search from anywhere, the way an archive catalogue should.
     Ignored while the caret is in a field, so it never eats a typed slash. */
  document.addEventListener("keydown", (e) => {
    if (e.key !== "/" || e.metaKey || e.ctrlKey || e.altKey) return;
    const t = e.target;
    if (t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.isContentEditable)) return;
    e.preventDefault();
    location.href = searchUrl;
  });
</script>
<script is:inline>
  (function () {
    var bar = document.querySelector(".topnav");
    var burger = document.querySelector(".burger");
    var drawer = document.getElementById("drawer");
    if (burger && drawer) {
      burger.addEventListener("click", function () {
        var open = drawer.hasAttribute("hidden");
        if (open) { drawer.removeAttribute("hidden"); } else { drawer.setAttribute("hidden", ""); }
        burger.setAttribute("aria-expanded", open ? "true" : "false");
      });
    }
    if (!bar) return;
    var menus = [].slice.call(bar.querySelectorAll("details.menu"));
    menus.forEach(function (d) {
      d.addEventListener("toggle", function () {
        if (!d.open) return;
        menus.forEach(function (o) { if (o !== d) o.open = false; });
      });
    });
    document.addEventListener("click", function (e) {
      if (e.target.closest(".topnav")) return;
      menus.forEach(function (d) { d.open = false; });
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") menus.forEach(function (d) { d.open = false; });
    });
  })();
</script>

<script>
  /* On a long page, build a jump list from the section headings.
     Done in the browser so no page has to declare its own contents. */
  (function () {
    var host = document.getElementById("onthispage");
    if (!host) return;
    var hs = [].slice.call(document.querySelectorAll("main section > h2"));
    if (hs.length < 4) return;
    var slug = function (t) {
      return t.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "")
        .replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 48);
    };
    var seen = {}, items = [];
    hs.forEach(function (h) {
      var t = (h.textContent || "").trim();
      if (!t) return;
      var id = h.id || slug(t) || "s";
      if (seen[id]) id = id + "-" + (++seen[id]); else seen[id] = 1;
      h.id = id;
      items.push([id, t]);
    });
    if (items.length < 4) return;
    var det = document.createElement("details");
    det.className = "toc";
    var sum = document.createElement("summary");
    sum.textContent = "On this page · " + items.length + " sections";
    det.appendChild(sum);
    var nav = document.createElement("nav");
    items.forEach(function (it) {
      var a = document.createElement("a");
      a.href = "#" + it[0];
      a.textContent = it[1];
      nav.appendChild(a);
    });
    det.appendChild(nav);
    host.appendChild(det);
    host.hidden = false;
    var mq = window.matchMedia("(min-width: 901px)");
    det.open = false;
    det.addEventListener("click", function (ev) {
      if (!mq.matches && ev.target.closest("nav a")) det.open = false;
    });
  })();
</script>
  <script src={u("/wholink.js")} defer></script>
</body>
</html>
